<!-- Explore Section (Hidden by default) -->
    <section id="explore-section" class="explore-section explore-page-section"> 
        <div class="container">
            <!-- Search Bar -->
            <div class="search-container">
                <input type="text" placeholder="Search books, authors, genres..." class="search-input" id="search-input">
                <button class="search-btn" id="search-submit-btn"><i class="fas fa-search"></i></button>
            </div>

            <!-- Actions and Categories -->
            <div class="explore-header-actions">
                <div class="left-action">
                    <button class="btn-toggle-filter" id="btn-toggle-filter">
                        <i class="fas fa-sliders-h"></i> Hide filters
                    </button>
                </div>
                
                <!-- Categories / Tags (Centered) -->
                <div class="category-tags">
                    <span class="tag active">All</span>
                    <span class="tag">Fiction</span>
                    <span class="tag">Skills</span>
                    <span class="tag">Economics</span>
                    <span class="tag">Psychology</span>
                    <span class="tag">History</span>
                </div>
                
                <div class="right-action" style="visibility: hidden;">
                    <!-- Spacer to keep center balanced -->
                    <button class="btn-toggle-filter">Hide filters</button>
                </div>
            </div>

            <div class="explore-layout" id="explore-layout">
                <!-- Sidebar Filter -->
                <aside class="filter-sidebar" id="filter-sidebar">
                    <div class="sidebar-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                        <h3 style="margin: 0;">Search Filters</h3>
                        <a href="#" class="clear-explore-filters" id="clear-explore-filters" style="color: #C2185B; font-size: 0.85rem; font-weight: 600; text-decoration: none; cursor: pointer;">Clear All</a>
                    </div>
                    
                    <div class="filter-group">
                        <h4>Author</h4>
                        <div class="filter-options" id="explore-author-checkbox-list">
                            <!-- Dynamically populated from JS -->
                        </div>
                    </div>

                    <div class="filter-group">
                        <h4>Genres</h4>
                        <div class="filter-options" id="explore-genre-checkbox-list">
                            <!-- Dynamically populated from JS -->
                        </div>
                    </div>

                    <div class="filter-group">
                        <h4>Price <span class="price-note">(thousands VNĐ)</span></h4>
                        <div class="price-range-wrapper">
                            <div class="dual-range-slider">
                                <div class="price-slider-track" id="explore-price-track"></div> 
                                <input type="range" min="0" max="1000" value="0" id="explore-price-min">
                                <div class="slider-tooltip" id="explore-tooltip-min">0</div>
                                
                                <input type="range" min="0" max="1000" value="1000" id="explore-price-max">
                                <div class="slider-tooltip" id="explore-tooltip-max">1000</div>
                            </div>
                            <div class="price-inputs" style="display: flex; gap: 10px; margin-top: 25px;">
                                <div class="price-field" style="flex: 1;">
                                    <input type="number" id="explore-price-min-input" value="0" min="0" class="price-num-input" style="width: 100%; padding: 5px; border: 1px solid #ddd; border-radius: 4px;">
                                </div>
                                <span style="align-self: center;">to</span>
                                <div class="price-field" style="flex: 1;">
                                    <input type="number" id="explore-price-max-input" value="1000" min="0" class="price-num-input" style="width: 100%; padding: 5px; border: 1px solid #ddd; border-radius: 4px;">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="filter-group">
                        <h4>Publisher</h4>
                        <div class="filter-options" id="explore-publisher-checkbox-list">
                            <!-- Dynamically populated from JS -->
                        </div>
                    </div>

                    <div class="filter-group">
                        <h4>Publish Year</h4>
                        <div class="year-range-inputs">
                            <div class="custom-dropdown" id="year-from-dropdown">
                                <div class="dropdown-header">
                                    <input type="text" id="publish-year-from" class="dropdown-input" placeholder="From" readonly>
                                    <i class="fas fa-chevron-down dropdown-icon"></i>
                                </div>
                                <ul class="dropdown-list">
                                    <!-- Dynamically populated from JS -->
                                </ul>
                            </div>
                            
                            <span>to</span>
                            
                            <div class="custom-dropdown" id="year-to-dropdown">
                                <div class="dropdown-header">
                                    <input type="text" id="publish-year-to" class="dropdown-input" placeholder="To" readonly>
                                    <i class="fas fa-chevron-down dropdown-icon"></i>
                                </div>
                                <ul class="dropdown-list">
                                    <!-- Dynamically populated from JS -->
                                </ul>
                            </div>
                        </div>
                    </div>
                    
                    <button class="btn-apply-filters" id="btn-apply-explore-filters" style="width: 100%; background: #C2185B; color: #fff; border: none; padding: 10px; border-radius: 20px; font-weight: 600; cursor: pointer; margin-top: 15px; transition: all 0.2s;">Apply</button>
                </aside>

                <div class="explore-content">

                    <!-- Book Grid -->
                    <div class="book-grid">
                        <!-- Real books will be loaded here dynamically by explore.js -->
                    </div>
                </div>
            </div>
        </div>
    </section>
