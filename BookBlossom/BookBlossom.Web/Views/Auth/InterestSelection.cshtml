@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta charset="utf-8" />
    <title>Chọn sở thích - Book Blossom</title>
    <link rel="stylesheet" href="~/css/globals.css">
    <link rel="stylesheet" href="~/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@700&family=Inter:wght@400;700&display=swap" rel="stylesheet">
    <style>
        /* Hiệu ứng ẩn/hiện mượt mà */
        .reveal-item {
            opacity: 0;
            max-height: 0;
            overflow: hidden;
            transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        
        .reveal-item.show {
            opacity: 1;
            max-height: 1000px;
            margin-top: 10px;
            margin-bottom: 10px;
        }

        /* Điều chỉnh cho layout lúc đầu (Căn giữa màn hình) */
        .header-area {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 70vh;
            transition: min-height 0.6s ease;
        }
        
        .header-area.shifted {
            min-height: 15vh; /* Thu nhỏ khoảng cách khi đã hiện list */
        }

        /* Font chữ TO lúc đầu và nhỏ lại sau */
        .welcome-text {
            font-family: 'Lora', serif;
            font-size: 55px; /* To lúc đầu */
            font-weight: 700;
            color: #000;
            margin: 15px 0;
            transition: font-size 0.6s ease;
        }
        
        .header-area.shifted .welcome-text {
            font-size: 35px; /* Nhỏ lại sau khi bấm */
        }

        /* Nút Ready to Bloom TO lúc đầu và nhỏ lại sau */
        .status-pill {
            display: inline-flex !important;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 25px; /* To lúc đầu */
            padding: 12px 30px; /* To lúc đầu */
            background-color: #EBBAB9;
            border-radius: 25px;
            font-weight: 700;
            color: #000;
            margin: 20px auto;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            transition: all 0.6s ease;
        }
        
        .header-area.shifted .status-pill {
            font-size: 14px; /* Nhỏ lại sau khi bấm */
            padding: 8px 20px;
            margin: 10px auto;
        }
        
        .status-pill:hover {
            transform: scale(1.05);
        }

        .actions-area {
            width: 100%;
            max-width: 600px;
            display: flex;
            justify-content: flex-end;
            margin-bottom: 10px;
        }
        
        .btn-small {
            padding: 6px 12px;
            border: 1px solid #000;
            border-radius: 20px;
            background: white;
            cursor: pointer;
            font-size: 12px;
            font-weight: 700;
            transition: all 0.2s;
        }
        
        .btn-small:hover {
            background-color: #f5f5f5;
        }

        /* Ẩn thanh bottom bar lúc đầu */
        .bottom-bar {
            transform: translateY(100%);
            transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .bottom-bar.show {
            transform: translateY(0);
        }
    </style>
</head>
<body>
    <div class="interest-page-container">
        <!-- Main Content (Scrollable) -->
        <div class="main-content">
            
            <!-- Header Area -->
            <div class="header-area" id="headerArea">
                <h1 class="brand-title">Book Blossom <span class="flower">🌸</span></h1>
                
                <!-- Sửa: Thanh line hồng nằm ở GIỮA Book Blossom và What makes you bloom (Ẩn lúc đầu) -->
                <div class="pink-line reveal-item" id="pinkLine" style="max-width: 600px; height: 4px; background-color: #EEC7C9; border-radius: 2px;"></div>
                
                <h2 class="welcome-text">What makes you bloom?</h2>
                
                <!-- Sửa: Dòng chữ Select nằm TRÊN nút Ready to bloom (Ẩn lúc đầu) -->
                <p class="subtitle reveal-item" id="subtitleText" style="font-size: 16px; color: #666; margin-bottom: 10px;">Select at least 3 genres to seed your discovery feed.</p>
                
                <!-- Nút bấm Kích hoạt (Ready to Bloom) -->
                <div class="status-pill" id="mainActionBtn">Ready to Bloom! 🌸</div>
            </div>

            <!-- Content Section cần được hé lộ (Ẩn lúc đầu) -->
            <div class="reveal-item" id="genresSection">
                
                <!-- Actions Area (Nút chọn hết) -->
                <div class="actions-area">
                    <button id="selectAllBtn" class="btn-small">Select All</button>
                </div>

                <!-- Tags Cloud -->
                <div class="tags-cloud" id="tagsCloud">
                    <!-- Tags will be loaded dynamically via API -->
                </div>
                
            </div>
            
        </div>

        <!-- Fixed Bottom Bar (Ẩn lúc đầu) -->
        <div class="bottom-bar" id="bottomBar">
            <button class="btn-explore" id="btnExplore">Start Exploring</button>
            <a href="javascript:void(0);" class="skip-link" id="skipLink">I'll let fate decide (Skip)</a>
        </div>
    </div>

    <script>
        const mainActionBtn = document.querySelector('#mainActionBtn');
        const headerArea = document.querySelector('#headerArea');
        const pinkLine = document.querySelector('#pinkLine');
        const subtitleText = document.querySelector('#subtitleText');
        const genresSection = document.querySelector('#genresSection');
        const bottomBar = document.querySelector('#bottomBar');
        
        const tagsCloud = document.querySelector('#tagsCloud');
        const selectAllBtn = document.querySelector('#selectAllBtn');
        const btnExplore = document.querySelector('#btnExplore');
        const skipLink = document.querySelector('#skipLink');

        let isRevealed = false;

        // Emoji mapping based on name
        const getEmoji = (name) => {
            const map = {
                'romance': '💓', 'sci-fi': '👽', 'fantasy': '🐉', 'thriller': '🔪',
                'self-help': '🧠', 'cookbooks': '🔍', 'manga': '📚', 'art': '🎨',
                'philosophy': '🦉', 'young adult': '🌱', 'true crime': '🕵️‍♂️',
                'history': '📜', 'biography': '✒️', 'poetry': '📝', 'business': '💼',
                'travel': '✈️', 'fiction': '📖', 'non-fiction': '📘', 'mystery': '🔍'
            };
            return map[name.toLowerCase()] || '✨';
        };

        // Load Tags from API
        async function loadTags() {
            try {
                const res = await fetch('/api/Onboarding/tags');
                if (res.ok) {
                    const categories = await res.json();
                    tagsCloud.innerHTML = '';
                    categories.forEach(cat => {
                        const tag = document.createElement('div');
                        tag.className = 'tag';
                        tag.innerHTML = `${cat.categoryName} ${getEmoji(cat.categoryName)}`;
                        tag.dataset.id = cat.categoryID;
                        
                        tag.addEventListener('click', () => {
                            tag.classList.toggle('selected');
                            updateCount();
                        });
                        
                        tagsCloud.appendChild(tag);
                    });
                } else {
                    console.error("Failed to load tags from API");
                }
            } catch (err) {
                console.error(err);
            }
        }
        
        // Fetch tags when page loads
        loadTags();

        // 1. Xử lý sự kiện bấm nút "Ready to Bloom!" để hiện danh sách
        mainActionBtn.addEventListener('click', () => {
            if (!isRevealed) {
                headerArea.classList.add('shifted');
                pinkLine.classList.add('show');
                subtitleText.classList.add('show');
                genresSection.classList.add('show');
                bottomBar.classList.add('show');
                
                isRevealed = true;
                updateCount(); // Cập nhật lại text đếm
            }
        });

        // 2. Hàm đếm số lượng đã chọn
        function updateCount() {
            if (!isRevealed) return;
            
            const selectedCount = document.querySelectorAll('.tag.selected').length;
            if (selectedCount < 3) {
                mainActionBtn.textContent = `${selectedCount}/3 selected`;
                mainActionBtn.style.backgroundColor = '#EBBAB9';
            } else {
                mainActionBtn.textContent = `Ready to Bloom! 🌸 (${selectedCount} selected)`;
                mainActionBtn.style.backgroundColor = '#EEC7C9';
            }
        }

        // 4. Xử lý nút Select All
        selectAllBtn.addEventListener('click', () => {
            const allTags = document.querySelectorAll('.tag');
            const allSelected = Array.from(allTags).every(tag => tag.classList.contains('selected'));
            
            allTags.forEach(tag => {
                if (allSelected) {
                    tag.classList.remove('selected');
                } else {
                    tag.classList.add('selected');
                }
            });
            
            updateCount();
            selectAllBtn.textContent = allSelected ? 'Select All' : 'Deselect All';
        });

        // Save preferences logic
        async function savePreferences(isSkipped) {
            const selectedTags = Array.from(document.querySelectorAll('.tag.selected')).map(tag => parseInt(tag.dataset.id));
            
            if (!isSkipped && selectedTags.length < 3) {
                alert('Please select at least 3 genres!');
                return;
            }

            // Disable buttons
            btnExplore.disabled = true;
            btnExplore.textContent = 'Saving...';
            
            const token = localStorage.getItem('accessToken');
            const guestId = localStorage.getItem('guestId');
            
            const payload = {
                selectedTagIds: isSkipped ? [] : selectedTags,
                isSkipped: isSkipped
            };

            try {
                if (token) {
                    // It's a User
                    const prefRes = await fetch('/api/Onboarding/preferences', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${token}`
                        },
                        body: JSON.stringify(payload)
                    });
                    
                    if (prefRes.ok) {
                        const finRes = await fetch('/api/Onboarding/finalize', {
                            method: 'POST',
                            headers: {
                                'Authorization': `Bearer ${token}`
                            }
                        });
                        
                        if (finRes.ok) {
                            window.location.href = '/';
                        } else {
                            alert("Failed to finalize onboarding");
                        }
                    } else {
                        alert("Failed to save preferences");
                    }
                } else if (guestId) {
                    // It's a Guest
                    const prefRes = await fetch('/api/Onboarding/guest/preferences', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Guest-Id': guestId
                        },
                        body: JSON.stringify(payload)
                    });
                    
                    if (prefRes.ok) {
                        window.location.href = '/';
                    } else {
                        alert("Failed to save guest preferences");
                    }
                } else {
                    // No user/guest info
                    window.location.href = '/Auth/Login';
                }
            } catch (err) {
                console.error(err);
                alert("An error occurred. Please try again.");
            } finally {
                btnExplore.disabled = false;
                btnExplore.textContent = 'Start Exploring';
            }
        }

        btnExplore.addEventListener('click', () => savePreferences(false));
        skipLink.addEventListener('click', (e) => {
            e.preventDefault();
            savePreferences(true);
        });
    </script>
</body>
</html>
