@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta charset="utf-8" />
    <title>Forgot Password - Book Blossom</title>
    <link rel="stylesheet" href="~/css/globals.css">
    <link rel="stylesheet" href="~/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@700&family=Inter:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="register-standalone-container">
        <div class="form-container" style="max-width: 440px;">
            
            <!-- Logo & Header -->
            <div class="header-area">
                <h1 class="brand-title">Book Blossom <span class="flower">🌸</span></h1>
                <h2 class="welcome-text" style="font-size: 30px;">Reset Password</h2>
                <p class="subtitle" id="formSubtitle">Enter your registered phone number to reset your password.</p>
            </div>

            <!-- Form -->
            <form asp-controller="Auth" asp-action="ForgotPassword" method="post" id="forgotForm">
                
                <!-- STEP 1: Enter Phone Number -->
                <div id="stepRequest" class="auth-step">
                    <div class="form-group">
                        <label for="PhoneNumber">Phone Number</label>
                        <input type="tel" id="PhoneNumber" name="PhoneNumber" placeholder="0901234567" pattern="[0-9]{10,11}" required />
                    </div>
                    <button type="button" class="btn-submit" id="btnSendOtp" style="margin-top: 10px;">Send Verification Code</button>
                </div>

                <!-- STEP 2: Enter OTP (Hidden initially) -->
                <div id="stepVerify" class="auth-step" style="display: none;">
                    <p class="otp-instruction" style="font-size: 14px; color: #666; margin-bottom: 20px; line-height: 1.5;">
                        We have sent a 6-digit verification code to <strong id="displayPhone" style="color: #000;"></strong>.
                    </p>
                    
                    <!-- 6-digit OTP fields -->
                    <div class="form-group">
                        <label style="display: block; font-size: 14px; margin-bottom: 10px; color: #000;">Verification Code</label>
                        <div class="otp-input-container">
                            <input type="text" class="otp-digit" maxlength="1" pattern="[0-9]" inputmode="numeric" />
                            <input type="text" class="otp-digit" maxlength="1" pattern="[0-9]" inputmode="numeric" />
                            <input type="text" class="otp-digit" maxlength="1" pattern="[0-9]" inputmode="numeric" />
                            <input type="text" class="otp-digit" maxlength="1" pattern="[0-9]" inputmode="numeric" />
                            <input type="text" class="otp-digit" maxlength="1" pattern="[0-9]" inputmode="numeric" />
                            <input type="text" class="otp-digit" maxlength="1" pattern="[0-9]" inputmode="numeric" />
                        </div>
                    </div>

                    <div class="otp-timer-container" style="margin-bottom: 25px; text-align: center;">
                        <p id="timerText">Resend code in <span id="timerCountdown" style="font-weight: 700; color: #EBBAB9;">300</span> seconds</p>
                        <button type="button" class="btn-resend-otp" id="resendOtpBtn" style="display: none;">Resend Code</button>
                    </div>

                    <button type="button" class="btn-submit" id="btnVerifyOtp" style="margin-top: 10px;">Verify Code</button>
                </div>

                <!-- STEP 3: Enter New Password (Hidden initially, shown after OTP is successfully verified) -->
                <div id="stepResetPassword" class="auth-step" style="display: none;">
                    <!-- New Password -->
                    <div class="form-group">
                        <label for="NewPassword">New Password</label>
                        <input type="password" id="NewPassword" name="NewPassword" placeholder="**********" required />
                    </div>

                    <!-- Confirm Password -->
                    <div class="form-group">
                        <label for="ConfirmPassword">Confirm Password</label>
                        <input type="password" id="ConfirmPassword" name="ConfirmPassword" placeholder="**********" required />
                    </div>

                    <button type="submit" class="btn-submit" id="btnSubmitReset" style="margin-top: 10px;">Reset Password</button>
                </div>

                <!-- Back to Login Link -->
                <p class="signup-prompt" id="backToLoginLink" style="margin-top: 25px;">
                    Back to <a href="/Auth/Login"><strong>Log In</strong></a>
                </p>

            </form>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Reusable Toast Helper function
            function showToast(message, type = 'success', title = '') {
                let container = document.getElementById('toastContainer');
                if (!container) {
                    container = document.createElement('div');
                    container.id = 'toastContainer';
                    container.className = 'toast-container';
                    document.body.appendChild(container);
                }

                const toast = document.createElement('div');
                toast.className = `custom-toast ${type}`;

                let iconSvg = '';
                if (type === 'success') {
                    iconSvg = `
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="#EBBAB9" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>`;
                    if (!title) title = 'Success';
                } else if (type === 'error') {
                    iconSvg = `
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="#EA4335" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>`;
                    if (!title) title = 'Error';
                } else {
                    iconSvg = `
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="#4285F4" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>`;
                    if (!title) title = 'Info';
                }

                toast.innerHTML = `
                    <div class="toast-icon">${iconSvg}</div>
                    <div class="toast-content">
                        <div class="toast-title">${title}</div>
                        <div class="toast-message">${message}</div>
                    </div>
                    <button class="toast-close" type="button">&times;</button>
                    <div class="toast-timer-bar">
                        <div class="toast-timer-fill"></div>
                    </div>
                `;

                container.appendChild(toast);

                // Trigger transition
                setTimeout(() => {
                    toast.classList.add('active');
                    const fill = toast.querySelector('.toast-timer-fill');
                    if (fill) fill.style.width = '0%';
                }, 10);

                // Close logic
                const closeBtn = toast.querySelector('.toast-close');
                const dismissToast = () => {
                    toast.classList.remove('active');
                    setTimeout(() => toast.remove(), 400);
                };

                closeBtn.addEventListener('click', dismissToast);

                // Auto remove after 4 seconds
                setTimeout(dismissToast, 4000);
            }

            const forgotForm = document.getElementById('forgotForm');
            const formSubtitle = document.getElementById('formSubtitle');
            
            const stepRequest = document.getElementById('stepRequest');
            const stepVerify = document.getElementById('stepVerify');
            const stepResetPassword = document.getElementById('stepResetPassword');
            
            const btnSendOtp = document.getElementById('btnSendOtp');
            const btnVerifyOtp = document.getElementById('btnVerifyOtp');
            
            const phoneInput = document.getElementById('PhoneNumber');
            const displayPhone = document.getElementById('displayPhone');
            
            const otpDigits = document.querySelectorAll('.otp-digit');
            const resendOtpBtn = document.getElementById('resendOtpBtn');
            const timerCountdown = document.getElementById('timerCountdown');
            const timerText = document.getElementById('timerText');
            
            const newPassword = document.getElementById('NewPassword');
            const confirmPassword = document.getElementById('ConfirmPassword');

            let timerInterval;
            let countdown = 300;

            // Step 1: Send OTP Click Action
            btnSendOtp.addEventListener('click', async function() {
                if (!phoneInput.checkValidity()) {
                    phoneInput.reportValidity();
                    return;
                }

                btnSendOtp.disabled = true;
                btnSendOtp.textContent = 'Sending...';

                try {
                    const response = await fetch('/api/auth/forgot-password/send-otp', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ PhoneNumber: phoneInput.value })
                    });
                    
                    const result = await response.json();
                    
                    if (response.ok) {
                        console.log("====== MÃ OTP TEST ======");
                        console.log("OTP của bạn là: ", result.otpCode);
                        console.log("=========================");

                        showToast(result.message || 'OTP sent!', 'success', 'Success');
                        // Show phone number in instruction
                        displayPhone.textContent = phoneInput.value;

                        // Animate slide/fade from Step 1 to Step 2
                        stepRequest.style.display = 'none';
                        
                        // Update subtitle text for verification
                        formSubtitle.textContent = 'Enter the verification code sent to your phone number.';

                        stepVerify.style.opacity = 0;
                        stepVerify.style.display = 'block';
                        
                        // Trigger smooth fade in
                        setTimeout(() => {
                            stepVerify.style.transition = 'opacity 0.4s ease';
                            stepVerify.style.opacity = 1;
                        }, 50);

                        // Start OTP Timer and focus first digit
                        startResendTimer();
                        setTimeout(() => otpDigits[0].focus(), 150);
                    } else {
                        showToast(result.message || 'Error sending OTP.', 'error', 'Error');
                    }
                } catch (err) {
                    showToast('Connection error.', 'error', 'Error');
                } finally {
                    btnSendOtp.disabled = false;
                    btnSendOtp.textContent = 'Send Verification Code';
                }
            });

            // Timer Countdown logic
            function startResendTimer() {
                clearInterval(timerInterval);
                countdown = 300;
                resendOtpBtn.style.display = 'none';
                timerText.style.display = 'block';
                timerCountdown.textContent = countdown;

                timerInterval = setInterval(() => {
                    countdown--;
                    timerCountdown.textContent = countdown;
                    if (countdown <= 0) {
                        clearInterval(timerInterval);
                        timerText.style.display = 'none';
                        resendOtpBtn.style.display = 'inline-block';
                    }
                }, 1000);
            }

            // Resend Click action
            resendOtpBtn.addEventListener('click', async function() {
                try {
                    const response = await fetch('/api/auth/forgot-password/send-otp', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ PhoneNumber: phoneInput.value })
                    });
                    
                    const result = await response.json();
                    if (response.ok) {
                        console.log("====== MÃ OTP TEST ======");
                        console.log("OTP mới của bạn là: ", result.otpCode);
                        console.log("=========================");

                        showToast('A new OTP verification code has been sent to ' + phoneInput.value, 'success', 'OTP Sent');
                        startResendTimer();
                        resetOtpInputs();
                        otpDigits[0].focus();
                    } else {
                        showToast(result.message || 'Error resending OTP', 'error', 'Error');
                    }
                } catch (err) {
                    showToast('Connection error.', 'error', 'Error');
                }
            });

            function resetOtpInputs() {
                otpDigits.forEach(input => input.value = '');
            }

            // Digit key/paste listeners
            otpDigits.forEach((digit, index) => {
                digit.addEventListener('input', function(e) {
                    if (e.target.value.length === 1 && index < otpDigits.length - 1) {
                        otpDigits[index + 1].focus();
                    }
                });

                digit.addEventListener('keydown', function(e) {
                    if (e.key === 'Backspace') {
                        if (digit.value === '' && index > 0) {
                            otpDigits[index - 1].value = '';
                            otpDigits[index - 1].focus();
                        } else {
                            digit.value = '';
                        }
                        e.preventDefault();
                    }
                });

                digit.addEventListener('paste', function(e) {
                    const pastedData = e.clipboardData.getData('text').trim();
                    if (/^\d{6}$/.test(pastedData)) {
                        for (let i = 0; i < otpDigits.length; i++) {
                            otpDigits[i].value = pastedData[i];
                        }
                        otpDigits[otpDigits.length - 1].focus();
                        e.preventDefault();
                    }
                });
            });

            // Step 2: Verify OTP Button Action
            btnVerifyOtp.addEventListener('click', async function() {
                let enteredOtp = '';
                otpDigits.forEach(input => enteredOtp += input.value);

                if (enteredOtp.length < 6) {
                    showToast('Please enter all 6 digits of the OTP code.', 'error', 'Invalid OTP');
                    return;
                }

                btnVerifyOtp.disabled = true;
                btnVerifyOtp.textContent = 'Verifying...';

                try {
                    const response = await fetch('/api/auth/forgot-password/verify-otp', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ PhoneNumber: phoneInput.value, OtpCode: enteredOtp })
                    });
                    
                    const result = await response.json();

                    if (response.ok) {
                        showToast(result.message || 'Verification successful! You can now reset your password.', 'success', 'Verified');
                        clearInterval(timerInterval);

                        // Transition to Step 3: Set New Password
                        stepVerify.style.display = 'none';
                        
                        // Update subtitle text for Step 3
                        formSubtitle.textContent = 'Create a secure new password for your account.';
                        
                        stepResetPassword.style.opacity = 0;
                        stepResetPassword.style.display = 'block';

                        setTimeout(() => {
                            stepResetPassword.style.transition = 'opacity 0.4s ease';
                            stepResetPassword.style.opacity = 1;
                            newPassword.focus();
                        }, 50);
                    } else {
                        showToast(result.message || 'OTP verification failed.', 'error', 'Error');
                    }
                } catch (err) {
                    showToast('Connection error.', 'error', 'Error');
                } finally {
                    btnVerifyOtp.disabled = false;
                    btnVerifyOtp.textContent = 'Verify Code';
                }
            });

            // Step 3: Form Reset Submit validation
            forgotForm.addEventListener('submit', async function(e) {
                e.preventDefault(); // Intercept default submit

                // Validate Password Matching
                if (newPassword.value !== confirmPassword.value) {
                    showToast('New Password and Confirm Password do not match.', 'error', 'Password Mismatch');
                    confirmPassword.focus();
                    return;
                }

                const btnSubmitReset = document.getElementById('btnSubmitReset');
                btnSubmitReset.disabled = true;
                btnSubmitReset.textContent = 'Resetting...';

                try {
                    const response = await fetch('/api/auth/forgot-password/reset', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ 
                            PhoneNumber: phoneInput.value, 
                            NewPassword: newPassword.value,
                            ConfirmPassword: confirmPassword.value
                        })
                    });
                    
                    const result = await response.json();

                    if (response.ok) {
                        showToast(result.message || 'Password reset successfully! Redirecting you to login page...', 'success', 'Success');
                        
                        // Redirect to login page
                        setTimeout(() => {
                            window.location.href = '/Auth/Login';
                        }, 2000);
                    } else {
                        showToast(result.message || 'Password reset failed.', 'error', 'Error');
                        btnSubmitReset.disabled = false;
                        btnSubmitReset.textContent = 'Reset Password';
                    }
                } catch (err) {
                    showToast('Connection error.', 'error', 'Error');
                    btnSubmitReset.disabled = false;
                    btnSubmitReset.textContent = 'Reset Password';
                }
            });
        });
    </script>
</body>
</html>
