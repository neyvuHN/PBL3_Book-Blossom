    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function() {
            const $navHome = $('#nav-home');
            const $navExplore = $('#nav-explore');
            const $navTindbook = $('#nav-tindbook');
            const $navCommunity = $('#nav-community');
            const $navLogo = $('#nav-logo');
            const $mainContent = $('#main-content');
            const $exploreSection = $('#explore-section');
            const $dedicatedCommunity = $('#dedicated-community');
            const $mainNavbar = $('#main-navbar');
            const $navLinks = $('.nav-links a');

            // Dropdown Toggle
            const $userDropdown = $('.user-dropdown');
            
            $userDropdown.on('click', function(e) {
                e.stopPropagation(); // Prevent event from bubbling up to document
                $(this).toggleClass('active');
            });
            
            // Close dropdown when clicking outside
            $(document).on('click', function(e) {
                if (!$userDropdown.is(e.target) && $userDropdown.has(e.target).length === 0) {
                    $userDropdown.removeClass('active');
                }
            });

            function setActiveTab($element) {
                $navLinks.removeClass('active');
                $element.addClass('active');
            }

            function showHome() {
                $mainContent.show();
                $exploreSection.hide();
                $dedicatedCommunity.hide();
                $mainNavbar.removeClass('navbar-light');
                setActiveTab($navHome);
            }

            function showExplore() {
                $mainContent.hide();
                $exploreSection.show();
                $dedicatedCommunity.hide();
                $mainNavbar.addClass('navbar-light');
                setActiveTab($navExplore);
            }

            function showDedicatedCommunity() {
                $mainContent.hide();
                $exploreSection.hide();
                $dedicatedCommunity.show();
                $mainNavbar.addClass('navbar-light');
                setActiveTab($navCommunity);
            }

            $navExplore.on('click', function(e) {
                e.preventDefault();
                showExplore();
            });

            $navHome.on('click', function(e) {
                e.preventDefault();
                showHome();
            });

            $navLogo.on('click', function(e) {
                e.preventDefault();
                showHome();
            });

            $navTindbook.on('click', function(e) {
                e.preventDefault();
                if ($exploreSection.is(':visible') || $dedicatedCommunity.is(':visible')) {
                    showHome();
                }
                $('html, body').animate({
                    scrollTop: $('#tindbook').offset().top - 80
                }, 500);
                setActiveTab($navTindbook);
            });

            $navCommunity.on('click', function(e) {
                e.preventDefault();
                showDedicatedCommunity();
            });

            // Filter Sidebar Toggle
            const $filterSidebar = $('#filter-sidebar');
            const $toggleFilterBtn = $('#btn-toggle-filter');
            
            $toggleFilterBtn.on('click', function() {
                $filterSidebar.toggle();
                const isVisible = $filterSidebar.is(':visible');
                $(this).html(isVisible ? '<i class="fas fa-sliders-h"></i> Hide filters' : '<i class="fas fa-sliders-h"></i> Show filters');
            });

            // Price Slider Logic
            const $priceMin = $('#price-min');
            const $priceMax = $('#price-max');
            const $priceMinInput = $('#price-min-input');
            const $priceMaxInput = $('#price-max-input');
            const $tooltipMin = $('#tooltip-min');
            const $tooltipMax = $('#tooltip-max');
            const $sliderTrack = $('#price-slider-track');
            
            function fillTrack() {
                const percent1 = ($priceMin.val() / $priceMin.attr('max')) * 100;
                const percent2 = ($priceMax.val() / $priceMax.attr('max')) * 100;
                $sliderTrack.css('background', `linear-gradient(to right, #e9ecef ${percent1}%, #EEC7C9 ${percent1}%, #EEC7C9 ${percent2}%, #e9ecef ${percent2}%)`);
            }
            
            function updateTooltips() {
                const val1 = $priceMin.val();
                const val2 = $priceMax.val();
                const percent1 = (val1 / $priceMin.attr('max')) * 100;
                const percent2 = (val2 / $priceMax.attr('max')) * 100;
                
                $tooltipMin.text(val1).css('left', `${percent1}%`);
                $tooltipMax.text(val2).css('left', `${percent2}%`);
            }

            function updateInputs() {
                $priceMinInput.val($priceMin.val());
                $priceMaxInput.val($priceMax.val());
            }

            $priceMin.on('input', function() {
                if (parseInt($priceMin.val()) > parseInt($priceMax.val())) {
                    $priceMin.val($priceMax.val());
                }
                updateInputs();
                updateTooltips();
                fillTrack();
            });

            $priceMax.on('input', function() {
                if (parseInt($priceMax.val()) < parseInt($priceMin.val())) {
                    $priceMax.val($priceMin.val());
                }
                updateInputs();
                updateTooltips();
                fillTrack();
            });
            
            // Manual Input Logic
            $priceMinInput.on('input', function() {
                let val = parseInt($(this).val());
                if (isNaN(val)) return;
                
                let sliderVal = val;
                if (sliderVal > 1000) sliderVal = 1000;
                if (sliderVal < 0) sliderVal = 0;
                
                const currentMax = parseInt($priceMax.val());
                if (sliderVal > currentMax) {
                    sliderVal = currentMax;
                }
                
                $priceMin.val(sliderVal);
                updateTooltips();
                fillTrack();
            });

            $priceMaxInput.on('input', function() {
                let val = parseInt($(this).val());
                if (isNaN(val)) return;
                
                let sliderVal = val;
                if (sliderVal > 1000) sliderVal = 1000;
                if (sliderVal < 0) sliderVal = 0;
                
                const currentMin = parseInt($priceMin.val());
                if (sliderVal < currentMin) {
                    sliderVal = currentMin;
                }
                
                $priceMax.val(sliderVal);
                updateTooltips();
                fillTrack();
            });
            
            // Initial fill
            fillTrack();
            updateInputs();
            updateTooltips();

            // Search logic (Mock)
            const $searchInput = $('#search-input');
            const $searchBtn = $('#search-submit-btn');

            $searchBtn.on('click', function() {
                const query = $searchInput.val().trim();
                if (query !== '') {
                    console.log(`Searching for: ${query}`);
                }
            });

            $searchInput.on('keypress', function(e) {
                if (e.which == 13) {
                    $searchBtn.click();
                }
            });

            // Slider logic
            function setupSlider(sliderId) {
                const $track = $(`#${sliderId} .slider-track`);
                const $prev = $(`#${sliderId} .slider-btn.prev`);
                const $next = $(`#${sliderId} .slider-btn.next`);
                
                $next.on('click', function() {
                    $track.animate({
                        scrollLeft: $track.scrollLeft() + $track.width() * 0.8
                    }, 500);
                });
                
                $prev.on('click', function() {
                    $track.animate({
                        scrollLeft: $track.scrollLeft() - $track.width() * 0.8
                    }, 500);
                });
            }
            
            setupSlider('featured-slider');
            setupSlider('community-slider');

            // See More buttons
            $('#see-more-books').on('click', function(e) {
                e.preventDefault();
                showExplore();
            });



            $('#see-more-community').on('click', function(e) {
                e.preventDefault();
                showDedicatedCommunity();
            });

            // Handle category tags click
            $('.category-tags .tag').on('click', function() {
                $('.category-tags .tag').removeClass('active');
                $(this).addClass('active');
            });

            // Custom Dropdown Logic
            $('.custom-dropdown').each(function() {
                const $dropdown = $(this);
                const $input = $dropdown.find('.dropdown-input');
                const $list = $dropdown.find('.dropdown-list');
                const $icon = $dropdown.find('.dropdown-icon');
                
                // Toggle open on click (header or arrow)
                $dropdown.find('.dropdown-header').on('click', function(e) {
                    if (e.target !== $input[0]) {
                        $dropdown.toggleClass('open');
                    }
                });
                
                // Open on focus
                $input.on('focus', function() {
                    $dropdown.addClass('open');
                });
                
                // Select item
                $dropdown.find('li').on('click', function() {
                    $input.val($(this).text());
                    $dropdown.removeClass('open');
                });
                
                // Close on click outside
                $(document).on('click', function(e) {
                    if (!$dropdown.is(e.target) && $dropdown.has(e.target).length === 0) {
                        $dropdown.removeClass('open');
                    }
                });
            });
        });
    </script>
</body>
</html>
