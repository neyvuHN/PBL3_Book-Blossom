                const otherBlindImages = demoBlindImages.filter(img => img !== blindBookData.imgSrc);
                const blindImagesArray = [blindBookData.imgSrc, ...otherBlindImages.slice(0, 2)];
                
                const $thumbs = $('.blind-condition-gallery img');
                $thumbs.each(function(index) {
                    if (index < blindImagesArray.length) {
                        $(this).parent().show();
                        $(this).attr('src', blindImagesArray[index]);
                    } else {
                        $(this).parent().hide();
                    }
                });
                
                // Reset border highlight of thumbnails to first element
                $('.blind-thumb-wrapper').css('border-color', 'transparent');
                $('.blind-thumb-wrapper').first().css('border-color', '#a291b5');
                currentBlindImageIndex = 0;

                // Show Section
                $('#blind-date-details-section').show();
                $mainNavbar.addClass('navbar-light');

                window.scrollTo(0, 0);

                if (push) {
                    history.pushState({ view: 'blind-date-details', blindBookData: blindBookData, previousActiveSection: previousActiveSection }, '', `#blind-details-${encodeURIComponent(blindBookData.hashtags.replace(/\s/g, ''))}`);
                }
            }

            // Click listener for Home/Explore book cards
            $(document).on('click', '.featured-books .book-card, #explore-section .book-grid .book-card', function(e) {
                e.preventDefault();
                
                const $card = $(this);
