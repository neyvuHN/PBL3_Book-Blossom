                                <h3>The Power of Now</h3>
                                <p>Eckhart Tolle</p>
                            </div>
                        </div>
                        <div class="book-card">
                            <img src="/images/Book/book1.jpg" alt="Book 7">
                            <div class="book-info">
                                <h3>Zero to One</h3>
