@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BookBlossom - Explore the World of Books</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Lora:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body class="homepage-container">

    <!-- Premium Navbar -->
    <nav class="premium-navbar" id="main-navbar">
        <a class="nav-logo" href="#" id="nav-logo">
            <span class="flower">🌸</span> BookBlossom
        </a>
        <ul class="nav-links">
            <li><a href="#" id="nav-home" class="active">Home</a></li>
            <li><a href="#" id="nav-explore">Explore</a></li>
            <li><a href="#" id="nav-tindbook">Tindbook</a></li>
            <li><a href="#" id="nav-community">Community</a></li>
        </ul>
        <div class="nav-actions">
            @if (true /* User.Identity.IsAuthenticated */)
            {
                <a href="#" class="nav-icon-btn"><i class="fas fa-shopping-cart"></i> Cart</a>
                <a href="#" class="nav-icon-btn notification-btn">
                    <i class="fas fa-bell"></i>
                    <span class="notification-dot"></span>
                </a>
                <div class="user-dropdown">
                    <img src="/images/Avatar/avatar1.jpg" alt="Avatar" class="avatar">
                    <span class="username">@(User.Identity.Name ?? "Jane Doe")</span>
                    <i class="fas fa-chevron-down"></i>
                    <div class="dropdown-menu">
                        <a href="/Profile" class="dropdown-item pink-bg"><i class="far fa-user-circle"></i> My Account</a>
                        <a href="/Orders" class="dropdown-item"><i class="fas fa-shopping-bag"></i> My Orders</a>
                        <a href="/Wishlist" class="dropdown-item"><i class="far fa-heart"></i> My Wishlist</a>
                        <a href="/Messages" class="dropdown-item"><i class="far fa-comment"></i> Messages</a>
                        <a href="/Settings" class="dropdown-item"><i class="fas fa-cog"></i> Settings</a>
                        <a href="/Help" class="dropdown-item"><i class="far fa-question-circle"></i> User Manual</a>
                        <a href="/Auth/Logout" class="dropdown-item grey-bg"><i class="fas fa-sign-out-alt"></i> Log Out</a>
                    </div>
                </div>
            }
            else
            {
                <a href="/Auth/Login" class="btn-login">Login</a>
                <a href="/Auth/Register" class="btn-register">Register</a>
            }
        </div>
    </nav>

    <!-- Main Content Wrapper (Homepage) -->
    <div id="main-content">
        <!-- Hero Section with Slider -->
        <div id="heroCarousel" class="carousel slide carousel-fade hero-carousel" data-bs-ride="carousel">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
            </div>
            <div class="carousel-inner">
                <div class="carousel-item active" style="background-image: url('/images/Homepage/homepage1.jpg')">
                    <div class="carousel-overlay">
                        <div class="carousel-caption">
                            <h1>Welcome to BookBlossom</h1>
                            <p>Where book lovers connect and spread knowledge.</p>
                            <a href="#featured" class="btn-cta">Explore Now</a>
                        </div>
                    </div>
                </div>
                <div class="carousel-item" style="background-image: url('/images/Homepage/homepage2.jpg')">
                    <div class="carousel-overlay">
                        <div class="carousel-caption">
                            <h1>Find Your Soulmate Book</h1>
                            <p>Use Tindbook to find the perfect book for you.</p>
                            <a href="#tindbook" class="btn-cta">Try Tindbook</a>
                        </div>
                    </div>
                </div>
                <div class="carousel-item" style="background-image: url('/images/Homepage/homepage3.jpg')">
                    <div class="carousel-overlay">
                        <div class="carousel-caption">
                            <h1>Join the Community</h1>
                            <p>Share your thoughts and discuss with other book lovers.</p>
                            <a href="/Auth/Register" class="btn-cta">Join Now</a>
                        </div>
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>

        <!-- Featured Books Section -->
