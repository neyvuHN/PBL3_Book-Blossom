@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BookBlossom - Explore the World of Books</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Lora:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body class="homepage-container">

    <!-- Premium Navbar -->
    <nav class="premium-navbar" id="main-navbar">
        <a class="nav-logo" href="#" id="nav-logo">
            <span class="flower">🌸</span> BookBlossom
        </a>
        <ul class="nav-links">
            <li><a href="#" id="nav-home" class="active">Home</a></li>
            <li><a href="#" id="nav-explore">Explore</a></li>
            <li><a href="#" id="nav-tindbook">Tindbook</a></li>
            <li><a href="#" id="nav-community">Thread</a></li>
        </ul>
        <div class="nav-actions">
            @if (true /* User.Identity.IsAuthenticated */)
            {
                <a href="#" class="nav-icon-btn"><i class="fas fa-shopping-cart"></i> Cart</a>
                <a href="#" class="nav-icon-btn notification-btn">
                    <i class="fas fa-bell"></i>
                    <span class="notification-dot"></span>
                </a>
                <div class="user-dropdown">
                    <img src="/images/Avatar/avatar1.jpg" alt="Avatar" class="avatar">
                    <span class="username">@(User.Identity.Name ?? "Jane Doe")</span>
                    <i class="fas fa-chevron-down"></i>
                    <div class="dropdown-menu">
                        <a href="/Profile" class="dropdown-item"><i class="far fa-user-circle"></i> My Account</a>
                        <a href="/Orders" class="dropdown-item"><i class="fas fa-shopping-bag"></i> My Orders</a>
                        <a href="/Wishlist" class="dropdown-item"><i class="far fa-heart"></i> My Wishlist</a>
                        <a href="/Messages" class="dropdown-item"><i class="far fa-comment"></i> Messages</a>
                        <a href="/Settings" class="dropdown-item"><i class="fas fa-cog"></i> Settings</a>
                        <a href="/Help" class="dropdown-item"><i class="far fa-question-circle"></i> User Manual</a>
                        <a href="/Auth/Logout" class="dropdown-item btn-logout"><i class="fas fa-sign-out-alt"></i> Log Out</a>
                    </div>
                </div>
            }
            else
            {
                <a href="/Auth/Login" class="btn-login">Login</a>
                <a href="/Auth/Register" class="btn-register">Register</a>
            }
        </div>
    </nav>

    <!-- Main Content Wrapper (Homepage) -->
    <div id="main-content">
        <!-- Hero Section with Slider -->
        <div id="heroCarousel" class="carousel slide carousel-fade hero-carousel" data-bs-ride="carousel">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
            </div>
            <div class="carousel-inner">
                <div class="carousel-item active" style="background-image: url('/images/Homepage/homepage1.jpg')">
                    <div class="carousel-overlay">
                        <div class="carousel-caption">
                            <h1>Welcome to BookBlossom</h1>
                            <p>Where book lovers connect and spread knowledge.</p>
                            <a href="#featured" class="btn-cta">Explore Now</a>
                        </div>
                    </div>
                </div>
                <div class="carousel-item" style="background-image: url('/images/Homepage/homepage2.jpg')">
                    <div class="carousel-overlay">
                        <div class="carousel-caption">
                            <h1>Find Your Soulmate Book</h1>
                            <p>Use Tindbook to find the perfect book for you.</p>
                            <a href="#tindbook" class="btn-cta">Try Tindbook</a>
                        </div>
                    </div>
                </div>
                <div class="carousel-item" style="background-image: url('/images/Homepage/homepage3.jpg')">
                    <div class="carousel-overlay">
                        <div class="carousel-caption">
                            <h1>Join the Community</h1>
                            <p>Share your thoughts and discuss with other book lovers.</p>
                            <a href="/Auth/Register" class="btn-cta">Join Now</a>
                        </div>
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>

        <!-- Featured Books Section -->
        <section id="featured" class="featured-books">
            <div class="container">
                <h2>Featured Books</h2>
                <div class="slider-container" id="featured-slider">
                    <button class="slider-btn prev"><i class="fas fa-chevron-left"></i></button>
                    <div class="slider-track">
                        <!-- 8 Books -->
                        <div class="book-card">
                            <img src="/images/Book/book1.jpg" alt="Book 1">
                            <div class="book-info">
                                <h3>How to Win Friends</h3>
                                <p>Dale Carnegie</p>
                            </div>
                        </div>
                        <div class="book-card">
                            <img src="/images/Book/book1.jpg" alt="Book 2">
                            <div class="book-info">
                                <h3>The Alchemist</h3>
                                <p>Paulo Coelho</p>
                            </div>
                        </div>
                        <div class="book-card">
                            <img src="/images/Book/book1.jpg" alt="Book 3">
                            <div class="book-info">
                                <h3>Think and Grow Rich</h3>
                                <p>Napoleon Hill</p>
                            </div>
                        </div>
                        <div class="book-card">
                            <img src="/images/Book/book1.jpg" alt="Book 4">
                            <div class="book-info">
                                <h3>The 7 Habits</h3>
                                <p>Stephen R. Covey</p>
                            </div>
                        </div>
                        <div class="book-card">
                            <img src="/images/Book/book1.jpg" alt="Book 5">
                            <div class="book-info">
                                <h3>Atomic Habits</h3>
                                <p>James Clear</p>
                            </div>
                        </div>
                        <div class="book-card">
                            <img src="/images/Book/book1.jpg" alt="Book 6">
                            <div class="book-info">
                                <h3>The Power of Now</h3>
                                <p>Eckhart Tolle</p>
                            </div>
                        </div>
                        <div class="book-card">
                            <img src="/images/Book/book1.jpg" alt="Book 7">
                            <div class="book-info">
                                <h3>Zero to One</h3>
                                <p>Peter Thiel</p>
                            </div>
                        </div>
                        <div class="book-card">
                            <img src="/images/Book/book1.jpg" alt="Book 8">
                            <div class="book-info">
                                <h3>Good to Great</h3>
                                <p>Jim Collins</p>
                            </div>
                        </div>
                    </div>
                    <button class="slider-btn next"><i class="fas fa-chevron-right"></i></button>
                </div>
                <div class="see-more-container">
                    <button id="see-more-books" class="btn-see-more">See More Books</button>
                </div>
            </div>
        </section>

        <!-- Tindbook Section -->
        <section id="tindbook" class="tindbook-section" style="background-image: url('/images/tindbook.jpg')">
            <div class="tindbook-overlay">
                <div class="tindbook-content">
                    <h2>Tindbook</h2>
                    <p>Don't know what to read next? Let Tindbook help you. Swipe right to save, swipe left to skip. Finding your soulmate book has never been this easy!</p>
                    <a href="#" id="btn-try-tindbook" class="btn-cta">Try It Now</a>
                </div>
            </div>
        </section>

        <!-- Community Section -->
        <section id="community" class="community-section">
            <div class="container">
                <h2>What the BookBlossom Community Says?</h2>
                <div class="slider-container" id="community-slider">
                    <button class="slider-btn prev"><i class="fas fa-chevron-left"></i></button>
                    <div class="slider-track">
                        <!-- 4 Reviews -->
                        <div class="testimonial-card">
                            <img src="/images/Avatar/avatar1.jpg" alt="User Avatar" class="avatar">
                            <p>"BookBlossom helped me find friends with the same reading interests and share great books. Highly recommended!"</p>
                            <span>- Minh Thu</span>
                        </div>
                        <div class="testimonial-card">
                            <img src="/images/Avatar/avatar1.jpg" alt="User Avatar" class="avatar">
                            <p>"The Tindbook feature is super fun! I found 3 great books in just a few minutes of swiping."</p>
                            <span>- Hoang Nam</span>
                        </div>
                        <div class="testimonial-card">
                            <img src="/images/Avatar/avatar1.jpg" alt="User Avatar" class="avatar">
                            <p>"I love the clean interface and the community discussions. It's my go-to site for book recommendations."</p>
                            <span>- Elena Smith</span>
                        </div>
                        <div class="testimonial-card">
                            <img src="/images/Avatar/avatar1.jpg" alt="User Avatar" class="avatar">
                            <p>"Great platform! I've read more books this year than ever before thanks to the challenges here."</p>
                            <span>- David Lee</span>
                        </div>
                    </div>
                    <button class="slider-btn next"><i class="fas fa-chevron-right"></i></button>
                </div>
                <div class="see-more-container">
                    <button id="see-more-community" class="btn-see-more">See All Reviews</button>
                </div>
            </div>
        </section>
    </div>

    <!-- Explore Section (Hidden by default) -->
    <section id="explore-section" class="explore-section" style="display: none;">
        <div class="container">
            <!-- Search Bar -->
            <div class="search-container">
                <input type="text" placeholder="Search books, authors, genres..." class="search-input" id="search-input">
                <button class="search-btn" id="search-submit-btn"><i class="fas fa-search"></i></button>
            </div>

            <!-- Actions and Categories -->
            <div class="explore-header-actions">
                <div class="left-action">
                    <button class="btn-toggle-filter" id="btn-toggle-filter">
                        <i class="fas fa-sliders-h"></i> Hide filters
                    </button>
                </div>
                
                <!-- Categories / Tags (Centered) -->
                <div class="category-tags">
                    <span class="tag active">All</span>
                    <span class="tag">Fiction</span>
                    <span class="tag">Skills</span>
                    <span class="tag">Economics</span>
                    <span class="tag">Psychology</span>
                    <span class="tag">History</span>
                </div>
                
                <div class="right-action" style="visibility: hidden;">
                    <!-- Spacer to keep center balanced -->
                    <button class="btn-toggle-filter">Hide filters</button>
                </div>
            </div>

            <div class="explore-layout" id="explore-layout">
                <!-- Sidebar Filter (Shown by default) -->
                <aside class="filter-sidebar" id="filter-sidebar">
                    <div class="sidebar-header">
                        <h3>Search Filters</h3>
                    </div>
                    
                    <div class="filter-group">
                        <h4>Author</h4>
                        <div class="filter-options">
                            <label><input type="checkbox"> J.K. Rowling</label>
                            <label><input type="checkbox"> Dale Carnegie</label>
                            <label><input type="checkbox"> Paulo Coelho</label>
                            <label><input type="checkbox"> Napoleon Hill</label>
                        </div>
                    </div>

                    <div class="filter-group">
                        <h4>Genres</h4>
                        <div class="filter-options">
                            <label><input type="checkbox"> Fiction</label>
                            <label><input type="checkbox"> Skills</label>
                            <label><input type="checkbox"> Economics</label>
                            <label><input type="checkbox"> Psychology</label>
                            <label><input type="checkbox"> History</label>
                        </div>
                    </div>

                    <div class="filter-group">
                        <h4>Price <span class="price-note">(thousands VNĐ)</span></h4>
                        <div class="price-slider-container">
                            <div class="slider-track" id="price-slider-track"></div>
                            <input type="range" min="0" max="1000" value="0" id="price-min" class="price-range-input">
                            <div class="slider-tooltip" id="tooltip-min">0</div>
                            
                            <input type="range" min="0" max="1000" value="1000" id="price-max" class="price-range-input">
                            <div class="slider-tooltip" id="tooltip-max">1000</div>
                        </div>
                        <div class="price-inputs">
                            <input type="number" id="price-min-input" value="0" min="0" class="price-num-input">
                            <span>to</span>
                            <input type="number" id="price-max-input" value="1000" min="0" class="price-num-input">
                        </div>
                    </div>

                    <div class="filter-group">
                        <h4>Publisher</h4>
                        <div class="filter-options">
                            <label><input type="checkbox"> NXB Trẻ</label>
                            <label><input type="checkbox"> NXB Kim Đồng</label>
                            <label><input type="checkbox"> NXB Tổng hợp</label>
                        </div>
                    </div>

                    <div class="filter-group">
                        <h4>Publish Year</h4>
                        <div class="year-range-inputs">
                            <div class="custom-dropdown" id="year-from-dropdown">
                                <div class="dropdown-header">
                                    <input type="text" id="publish-year-from" class="dropdown-input" placeholder="From">
                                    <i class="fas fa-chevron-down dropdown-icon"></i>
                                </div>
                                <ul class="dropdown-list">
                                    <li>2024</li>
                                    <li>2023</li>
                                    <li>2022</li>
                                    <li>2021</li>
                                    <li>2020</li>
                                    <li>2019</li>
                                    <li>2018</li>
                                </ul>
                            </div>
                            
                            <span>to</span>
                            
                            <div class="custom-dropdown" id="year-to-dropdown">
                                <div class="dropdown-header">
                                    <input type="text" id="publish-year-to" class="dropdown-input" placeholder="To">
                                    <i class="fas fa-chevron-down dropdown-icon"></i>
                                </div>
                                <ul class="dropdown-list">
                                    <li>2024</li>
                                    <li>2023</li>
                                    <li>2022</li>
                                    <li>2021</li>
                                    <li>2020</li>
                                    <li>2019</li>
                                    <li>2018</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    
                    <button class="btn-apply-filters">Apply</button>
                </aside>

                <div class="explore-content">

                    <!-- Book Grid -->
                    <div class="book-grid">
                        <!-- 8 Books -->
                        <div class="book-card">
                            <img src="/images/Book/book1.jpg" alt="Book 1">
                            <div class="book-info">
                                <h3>How to Win Friends</h3>
                                <p>Dale Carnegie</p>
                                <div class="book-meta">
                                    <span class="rating">⭐ 4.8</span>
                                    <span class="price">Free</span>
                                </div>
                            </div>
                        </div>
                        <div class="book-card">
                            <img src="/images/Book/book1.jpg" alt="Book 2">
                            <div class="book-info">
                                <h3>The Alchemist</h3>
                                <p>Paulo Coelho</p>
                                <div class="book-meta">
                                    <span class="rating">⭐ 4.7</span>
                                    <span class="price">Free</span>
                                </div>
                            </div>
                        </div>
                        <div class="book-card">
                            <img src="/images/Book/book1.jpg" alt="Book 3">
                            <div class="book-info">
                                <h3>Think and Grow Rich</h3>
                                <p>Napoleon Hill</p>
                                <div class="book-meta">
                                    <span class="rating">⭐ 4.5</span>
                                    <span class="price">Free</span>
                                </div>
                            </div>
                        </div>
                        <div class="book-card">
                            <img src="/images/Book/book1.jpg" alt="Book 4">
                            <div class="book-info">
                                <h3>The 7 Habits</h3>
                                <p>Stephen R. Covey</p>
                                <div class="book-meta">
                                    <span class="rating">⭐ 4.6</span>
                                    <span class="price">Free</span>
                                </div>
                            </div>
                        </div>
                        <div class="book-card">
                            <img src="/images/Book/book1.jpg" alt="Book 5">
                            <div class="book-info">
                                <h3>Atomic Habits</h3>
                                <p>James Clear</p>
                                <div class="book-meta">
                                    <span class="rating">⭐ 4.9</span>
                                    <span class="price">Free</span>
                                </div>
                            </div>
                        </div>
                        <div class="book-card">
                            <img src="/images/Book/book1.jpg" alt="Book 6">
                            <div class="book-info">
                                <h3>The Power of Now</h3>
                                <p>Eckhart Tolle</p>
                                <div class="book-meta">
                                    <span class="rating">⭐ 4.4</span>
                                    <span class="price">Free</span>
                                </div>
                            </div>
                        </div>
                        <div class="book-card">
                            <img src="/images/Book/book1.jpg" alt="Book 7">
                            <div class="book-info">
                                <h3>Zero to One</h3>
                                <p>Peter Thiel</p>
                                <div class="book-meta">
                                    <span class="rating">⭐ 4.6</span>
                                    <span class="price">Free</span>
                                </div>
                            </div>
                        </div>
                        <div class="book-card">
                            <img src="/images/Book/book1.jpg" alt="Book 8">
                            <div class="book-info">
                                <h3>Good to Great</h3>
                                <p>Jim Collins</p>
                                <div class="book-meta">
                                    <span class="rating">⭐ 4.7</span>
                                    <span class="price">Free</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Dedicated Community Section (Hidden by default) -->
    <section id="dedicated-community" class="explore-section" style="display: none;">
        <div class="container community-thread-container">
            <!-- Left Sidebar -->
            <div class="thread-left-sidebar" id="thread-left-sidebar">
                <ul class="sidebar-nav">
                    <li class="active"><a href="#"><i class="fas fa-rss"></i> <span>Feed</span></a></li>
                    <li><a href="#"><i class="fas fa-search"></i> <span>Explore</span></a></li>
                    <li><a href="#"><i class="fas fa-user-circle"></i> <span>Profile</span></a></li>
                    <li><a href="#" class="notification-item"><i class="fas fa-bell"></i> <span>Notifications</span> <span class="nav-dot"></span></a></li>
                </ul>
            </div>

            <!-- Main Content -->
            <div class="thread-main">
                <div class="thread-header">
                    <button id="btn-toggle-sidebar" class="btn-toggle-sidebar-action"><i class="fas fa-bars"></i></button>
                    <h1 class="thread-title">Community Thread Feed</h1>
                </div>
                
                <!-- Filters -->
                <div class="thread-filters">
                    <span class="filter-tag active">All</span>
                    <span class="filter-tag">Following</span>
                    <span class="filter-tag">For Sale</span>
                    <span class="filter-tag">Book Clubs</span>
                </div>
                
                <!-- Create Post -->
                <div class="create-post-card">
                    <h3>Create Post</h3>
                    <textarea placeholder="What's on your shelf?"></textarea>
                    <div class="create-post-actions">
                        <button class="btn-tag-book"><i class="fas fa-book"></i> Tag Book</button>

                    </div>
                </div>
                
                <!-- Post 1 -->
                <div class="thread-post">
                    <div class="hidden-post-overlay" style="display: none;">
                        <span>Post hidden.</span>
                        <button class="btn-undo-hide">Undo</button>
                        <div class="hide-progress"></div>
                    </div>
                    <div class="post-header">
                        <img src="/images/Avatar/avatar1.jpg" alt="Avatar" class="post-avatar">
                        <div class="post-user-info">
                            <div class="user-name-badge">
                                <span class="user-name">Sarah J.</span>
                            </div>
                            <span class="post-time">2h ago</span>
                        </div>
                        <div class="post-menu-btn">
                            <i class="fas fa-ellipsis-h"></i>
                            <div class="post-dropdown-menu" style="display: none;">
                                <a href="#" class="dropdown-item btn-report-post"><i class="far fa-flag"></i> Report Post</a>
                                <a href="#" class="dropdown-item btn-hide-post"><i class="far fa-eye-slash"></i> Hide Post</a>
                            </div>
                        </div>
                    </div>
                    <div class="post-content">
                        <p>Just finished reading "The Secret Garden" again. It's even better as an adult The themes of healing and nature are so beautiful. #ClassicLit #ComfortRead</p>
                        
                        <!-- Book Tagged -->
                        <div class="tagged-book-card">
                            <img src="/images/Book/book1.jpg" alt="Book Cover" class="tagged-book-img">
                            <div class="tagged-book-info">
                                <h4>The Secret Garden</h4>
                                <p>Frances Hodgson Burnett</p>
                            </div>
                            <button class="btn-view-book">View Book</button>
                        </div>
                    </div>
                    <div class="post-footer">
                        <button class="post-action btn-like"><i class="far fa-heart"></i> <span class="like-count">2</span></button>
                        <button class="post-action btn-comment"><i class="far fa-comment"></i> <span class="comment-count">1</span></button>
                        <button class="post-action btn-share"><i class="far fa-share-square"></i> Share</button>
                    </div>
                    
                    <!-- Comment Section -->
                    <div class="comment-section" style="display: none;">
                        <div class="comment-list">
                            <div class="comment-item">
                                <img src="/images/Avatar/avatar1.jpg" alt="Avatar" class="comment-avatar">
                                <div class="comment-content">
                                    <span class="comment-user">Alice M.</span>
                                    <p>I love this book too! The atmosphere is so magical.</p>
                                    <span class="comment-time">1h ago</span>
                                </div>
                            </div>
                        </div>
                        <div class="comment-input-area">
                            <img src="/images/Avatar/avatar1.jpg" alt="Avatar" class="comment-avatar">
                            <input type="text" placeholder="Write a comment...">
                            <button class="btn-send-comment"><i class="far fa-paper-plane"></i></button>
                        </div>
                    </div>
                </div>
                
                <!-- Post 2 -->
                <div class="thread-post">
                    <div class="hidden-post-overlay" style="display: none;">
                        <span>Post hidden.</span>
                        <button class="btn-undo-hide">Undo</button>
                        <div class="hide-progress"></div>
                    </div>
                    <div class="post-header">
                        <img src="/images/Avatar/avatar1.jpg" alt="Avatar" class="post-avatar">
                        <div class="post-user-info">
                            <div class="user-name-badge">
                                <span class="user-name">Mike B.</span>
                            </div>
                            <span class="post-time">Just now</span>
                        </div>
                        <div class="post-menu-btn">
                            <i class="fas fa-ellipsis-h"></i>
                            <div class="post-dropdown-menu" style="display: none;">
                                <a href="#" class="dropdown-item btn-report-post"><i class="far fa-flag"></i> Report Post</a>
                                <a href="#" class="dropdown-item btn-hide-post"><i class="far fa-eye-slash"></i> Hide Post</a>
                            </div>
                        </div>
                    </div>
                    <div class="post-content">
                        <p>Dune is a rich sci-fi classic about power, destiny, and survival—complex, slow-burn, and unforgettable. #Dune #SciFiClassic</p>
                        
                        <!-- Book Tagged -->
                        <div class="tagged-book-card">
