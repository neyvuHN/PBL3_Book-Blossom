@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BookBlossom - Explore the World of Books</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Lora:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <!-- PDF.js for secure digital preview rendering -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js"></script>
        @await Html.PartialAsync("Partials/Index/_HomeIndexStyles")
</head>
<body class="homepage-container">

    @await Html.PartialAsync("Partials/Index/_MainNavbar")

    @await Html.PartialAsync("Partials/Index/_HomeLanding")


    @await Html.PartialAsync("Partials/Index/_Footer")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await Html.PartialAsync("Partials/Index/_HomeIndexScripts")

    @await Html.PartialAsync("Partials/Index/_HomeIndexModals")

</body>
</html>
