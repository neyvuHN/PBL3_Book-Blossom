            // Global tracker for current active Blind Date detail image index
            let currentBlindImageIndex = 0;

            // Blind Date Detail Gallery Thumbnail Switching
            $(document).on('click', '.blind-thumb-wrapper', function() {
                const imgSrc = $(this).find('img').attr('src');
                $('#blind-detail-main-img').attr('src', imgSrc);
                
                // Track active index
                const $thumbs = $('.blind-thumb-wrapper');
                currentBlindImageIndex = $thumbs.index(this);
                
                // Update border highlight
                $thumbs.css('border-color', 'transparent');
                $(this).css('border-color', '#a291b5');
