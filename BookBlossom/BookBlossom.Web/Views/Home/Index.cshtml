                    title: 'Momo: Get 12k',
                    desc: 'Cashback on Momo',
                    textColor: '#d53f8c',
                    tagBg: '#fdf2f8',
                    borderColor: '#d53f8c',
                    bg: '#fffafc'
                },
                {
                    code: 'SUMMER20',
                    title: '20% OFF Summer',
                    desc: 'Max discount 50k',
                    textColor: '#dd6b20',
                    tagBg: '#feebc8',
                    borderColor: '#dd6b20',
                    bg: '#fffaf0'
                },
                {
                    code: 'FREESHIP',
                    title: 'Free Shipping',
                    desc: 'Min order 150k',
                    textColor: '#319795',
                    tagBg: '#e6fffa',
                    borderColor: '#319795',
                    bg: '#f0fdf4'
                }
            ];

            let selectedVouchers = new Set();

            function renderMainPageVouchers() {
                const $slider = $('.coupon-slider');
                if (!$slider.length) return;

                $slider.empty();

                // Sort: selected vouchers FIRST (1), unselected LATER (0)
                const sortedVouchers = [...VOUCHERS_DATA].sort((a, b) => {
                    const aSelected = selectedVouchers.has(a.code) ? 1 : 0;
                    const bSelected = selectedVouchers.has(b.code) ? 1 : 0;
                    return bSelected - aSelected; // descending (1 first)
                });

                sortedVouchers.forEach(v => {
                    const isSelected = selectedVouchers.has(v.code);
                    const selectedClass = isSelected ? 'selected' : '';
                    
                    const cardHtml = `
                        <div class="coupon-card ${selectedClass}" data-code="${v.code}" style="flex: 0 0 190px; background: ${v.bg}; border: 1.5px dashed ${v.borderColor}; border-radius: 10px; padding: 12px; position: relative; box-shadow: 0 2px 6px rgba(0,0,0,0.02); transition: all 0.2s; cursor: pointer; text-align: left;" onmouseover="this.style.transform='translateY(-2px)';" onmouseout="this.style.transform='none';">
                            <div style="font-size: 0.7rem; font-weight: 700; color: ${v.textColor}; background: ${v.tagBg}; padding: 2px 6px; border-radius: 4px; width: fit-content; margin-bottom: 6px;">${v.code}</div>
                            <div style="font-size: 0.82rem; font-weight: 700; color: #333; margin-bottom: 4px;">${v.title}</div>
                            <div style="font-size: 0.72rem; color: #888;">${v.desc}</div>
                        </div>
                    `;
                    $slider.append(cardHtml);
                });
            }

            function updateVoucherSync(code, isSelected) {
                // Find modal items matching this voucher code and toggle active styling classes
                $('.modal-voucher-item').each(function() {
                    const itemCode = $(this).attr('data-code');
                    if (itemCode === code) {
                        if (isSelected) {
                            $(this).addClass('selected');
                            $(this).find('.btn-modal-apply-voucher').text('Applied');
                        } else {
                            $(this).removeClass('selected');
                            $(this).find('.btn-modal-apply-voucher').text('Apply');
                        }
                    }
                });

                // Dynamically re-sort and render the main page slider cards
                renderMainPageVouchers();

                // Update selected count inside the modal footer
                $('#modal-selected-count').text(selectedVouchers.size);
            }

            // Click on main page coupon cards
            $(document).on('click', '.coupon-card', function() {
                const code = $(this).attr('data-code') || $(this).find('div').first().text().trim();
                
                if (selectedVouchers.has(code)) {
                    selectedVouchers.delete(code);
                    updateVoucherSync(code, false);
                    showToast(`Voucher "${code}" removed.`);
                } else {
                    selectedVouchers.add(code);
                    updateVoucherSync(code, true);
                    showToast(`Voucher "${code}" applied successfully!`);
                }
            });

            // See All Vouchers button click
            $(document).on('click', '.btn-see-all-vouchers', function(e) {
                e.preventDefault();
                
                // Set the initial selections in the modal list
                $('.modal-voucher-item').each(function() {
                    const code = $(this).attr('data-code');
                    const isSelected = selectedVouchers.has(code);
                    if (isSelected) {
                        $(this).addClass('selected');
                        $(this).find('.btn-modal-apply-voucher').text('Applied');
                    } else {
                        $(this).removeClass('selected');
                        $(this).find('.btn-modal-apply-voucher').text('Apply');
                    }
                });

                $('#modal-selected-count').text(selectedVouchers.size);
                $('#vouchers-modal').fadeIn(250);
            });

            // Close Voucher Modal
            $(document).on('click', '#btn-close-vouchers, #btn-confirm-vouchers, #vouchers-modal .modal-backdrop', function() {
                $('#vouchers-modal').fadeOut(250);
                if ($(this).attr('id') === 'btn-confirm-vouchers' && selectedVouchers.size > 0) {
                    showToast(`Successfully applied ${selectedVouchers.size} voucher(s) to order!`);
                }
            });

            // Click on a voucher item inside the See All Modal
            $(document).on('click', '.modal-voucher-item', function(e) {
                const code = $(this).attr('data-code');
                
                if (selectedVouchers.has(code)) {
                    selectedVouchers.delete(code);
                    updateVoucherSync(code, false);
                    showToast(`Voucher "${code}" removed.`);
                } else {
                    selectedVouchers.add(code);
                    updateVoucherSync(code, true);
                    showToast(`Voucher "${code}" applied!`);
                }
            });

            // Prevent double-trigger when clicking the inner Apply button
            $(document).on('click', '.btn-modal-apply-voucher', function(e) {
                e.stopPropagation(); // Stop bubble so we don't trigger .modal-voucher-item click twice
                $(this).closest('.modal-voucher-item').trigger('click');
            });

            // Initialize dynamic slider rendering on page load
            renderMainPageVouchers();

            // --- SECURE FLIPBOOK DIGITAL PREVIEW LOGIC ---
            let pdfDoc = null;
            let currentSheetIndex = 0;
            const maxSheets = 3;
            let pdfBlobUrl = null;
            let currentZoomScale = 1.0;

            // Load and render a specific page using PDF.js onto the target canvas
            async function renderPreviewPage(pdf, pageNum, canvasId, loaderId) {
                try {
                    const page = await pdf.getPage(pageNum);
                    
                    // Render page at high quality
                    const viewport = page.getViewport({ scale: 1.5 });
                    const canvas = document.getElementById(canvasId);
                    if (!canvas) return;
                    
                    const context = canvas.getContext('2d');
                    canvas.height = viewport.height;
                    canvas.width = viewport.width;

                    const renderContext = {
                        canvasContext: context,
                        viewport: viewport
                    };
                    
                    await page.render(renderContext).promise;
                    
                    // Hide loader once page is successfully rendered
                    $(`#${loaderId}`).fadeOut(200);
                } catch (error) {
                    console.error(`Error rendering page ${pageNum}:`, error);
                    $(`#${loaderId}`).html(`<span style="color: #ff4444;"><i class="fas fa-exclamation-triangle"></i> Failed to load page ${pageNum}</span>`);
                }
            }

            // Load PDF document from secure signed URL
            async function loadSecurePreview(bookId) {
                // Show loading states for all sheets
                $('.page-loader').show();
                $('.page-loader').siblings('canvas').each(function() {
                    const ctx = this.getContext('2d');
                    ctx.clearRect(0, 0, this.width, this.height);
                });

                // Generate watermark overlays
                renderWatermarks();

                try {
                    // Step 1: Call secure backend session to get signed URL
                    const sessionResponse = await $.getJSON(`/api/books/${bookId}/preview-session`);
                    const signedUrl = sessionResponse.signedUrl;

                    // Step 2: Fetch PDF securely using the signed URL (60 seconds limit)
                    const response = await fetch(signedUrl);
                    if (!response.ok) {
                        if (response.status === 403) {
                            throw new Error('Access Denied: The preview token is invalid or has expired.');
                        }
                        throw new Error('Failed to download secure preview.');
                    }

                    const blob = await response.blob();
                    pdfBlobUrl = URL.createObjectURL(blob);

                    // Step 3: Initialize PDF.js rendering
                    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.worker.min.js';
                    const loadingTask = pdfjsLib.getDocument(pdfBlobUrl);
                    
                    pdfDoc = await loadingTask.promise;
                    
                    // Revoke URL immediately after document is loaded in memory for absolute security!
                    URL.revokeObjectURL(pdfBlobUrl);
                    pdfBlobUrl = null;

                    // Render each of the first 5 pages concurrently
                    const totalPages = Math.min(pdfDoc.numPages, 5);
                    const renderPromises = [];
                    
                    for (let p = 1; p <= totalPages; p++) {
                        renderPromises.push(renderPreviewPage(pdfDoc, p, `canvas-page-${p}`, `loader-${p}`));
                    }
                    
                    await Promise.all(renderPromises);
                } catch (error) {
                    console.error('Secure preview error:', error);
                    showToast(error.message || 'An error occurred while opening the preview.');
                    closeSecurePreview();
                }
            }

            function renderWatermarks() {
                $('.watermark-overlay').each(function() {
                    const $overlay = $(this);
                    $overlay.empty();
                    for (let i = 0; i < 6; i++) {
                        $overlay.append('<div class="watermark-text">BookBlossom Preview</div>');
                    }
                });
            }

            function updateSheetZIndices() {
                const sheets = [
                    { el: $('#p-sheet-1'), index: 1 },
                    { el: $('#p-sheet-2'), index: 2 },
                    { el: $('#p-sheet-3'), index: 3 }
                ];
                
                sheets.forEach(sheet => {
                    if (sheet.el.hasClass('flipped')) {
                        sheet.el.css('z-index', sheet.index);
                    } else {
                        sheet.el.css('z-index', maxSheets - sheet.index + 1);
                    }
                });
            }

            function updatePreviewControls() {
                // Update buttons state
                $('#btn-prev-page').prop('disabled', currentSheetIndex === 0);
                $('#btn-next-page').prop('disabled', currentSheetIndex === maxSheets);
                
                // Update text indicator
                if (currentSheetIndex === 0) {
                    $('#preview-page-indicator').text('Cover');
                } else if (currentSheetIndex === 1) {
                    $('#preview-page-indicator').text('Pages 2 - 3');
                } else if (currentSheetIndex === 2) {
                    $('#preview-page-indicator').text('Pages 4 - 5');
                } else if (currentSheetIndex === maxSheets) {
                    $('#preview-page-indicator').text('End');
                }
            }

            function flipNext() {
                if (currentSheetIndex >= maxSheets) return;
                
                const nextSheet = currentSheetIndex + 1;
                $(`#p-sheet-${nextSheet}`).addClass('flipped');
                
                // Delayed z-index update for smooth visual overlay
                setTimeout(updateSheetZIndices, 400);
                
                currentSheetIndex = nextSheet;
                updatePreviewControls();
            }

            function flipPrev() {
                if (currentSheetIndex <= 0) return;
                
                const prevSheet = currentSheetIndex;
                $(`#p-sheet-${prevSheet}`).removeClass('flipped');
                
                // Immediate z-index update when turning back
                updateSheetZIndices();
                
                currentSheetIndex = prevSheet - 1;
                updatePreviewControls();
            }

            function closeSecurePreview() {
                $('#preview-modal-container').fadeOut(300, function() {
                    // Clear state
                    pdfDoc = null;
                    currentSheetIndex = 0;
                    $('.flipbook-sheet').removeClass('flipped');
                    updateSheetZIndices();
                    updatePreviewControls();
                    $('body').css('overflow', '');
                    setZoomScale(1.0); // Reset zoom
                });
            }

            // Zoom adjustment logic
            function setZoomScale(scale) {
                // Bound zoom between 0.8 (80%) and 3.0 (300%)
                currentZoomScale = Math.min(Math.max(scale, 0.8), 3.0);
                
                // Apply scaling to the flipbook container
                $('#flipbook-container').css('transform', `scale(${currentZoomScale})`);
                
                // Update percentage indicator text
                $('#zoom-indicator').text(`${Math.round(currentZoomScale * 100)}%`);
                
                // Update the dimensions of the zoom wrapper in layout flow so scrollbars trigger
                const baseWidth = 840;
                const baseHeight = 560;
                $('#flipbook-zoom-wrapper').css({
                    width: (baseWidth * currentZoomScale) + 'px',
                    height: (baseHeight * currentZoomScale) + 'px'
                });
                
                // Change the control bar background theme if scale is >= 100%
                if (currentZoomScale >= 1.0) {
                    $('.preview-controls').addClass('high-zoom');
                } else {
                    $('.preview-controls').removeClass('high-zoom');
                }
                
                // Enable/disable button states appropriately
                $('#btn-zoom-in').prop('disabled', currentZoomScale >= 3.0);
                $('#btn-zoom-out').prop('disabled', currentZoomScale <= 0.8);
            }

            // Launch Preview on Button Click
            $('.btn-read-preview').on('click', function() {
                const title = $('#detail-title').text();
                showToast(`Validating signed preview session for "${title}"...`);
                
                // Disable background scrolling
                $('body').css('overflow', 'hidden');
                
                // Reset sheet layout
                $('.flipbook-sheet').removeClass('flipped');
                currentSheetIndex = 0;
                setZoomScale(1.0); // Reset zoom scale to 100%
                updateSheetZIndices();
                updatePreviewControls();
                
                // Fade in modal
                $('#preview-modal-container').fadeIn(300);
                
                // Extract PDF filename from current main cover image dynamically (e.g. book1.jpg -> Book1)
                let bookId = 'Book1'; // fallback default
                const coverSrc = $('#detail-main-img').attr('src') || '';
                const match = coverSrc.match(/book(\d+)/i);
                if (match) {
                    bookId = 'Book' + match[1];
                }
                
                loadSecurePreview(bookId);
            });

            // Preview Controls click listeners
            $('#btn-next-page').on('click', function() {
                flipNext();
            });

            $('#btn-prev-page').on('click', function() {
                flipPrev();
            });

            // Zoom Controls click listeners
            $('#btn-zoom-in').on('click', function() {
                setZoomScale(currentZoomScale + 0.15);
            });

            $('#btn-zoom-out').on('click', function() {
                setZoomScale(currentZoomScale - 0.15);
            });

            // Overlay scrollbars fade-in trigger on scroll/swipe
            let scrollTimer = null;
            $('.flipbook-scroll-area').on('scroll', function() {
                const $scrollArea = $(this);
                $scrollArea.addClass('is-scrolling');
                
                clearTimeout(scrollTimer);
                scrollTimer = setTimeout(function() {
                    $scrollArea.removeClass('is-scrolling');
                }, 1000); // Fades out scrollbars 1 second after user stops scrolling/swiping
            });

            // Support click-to-flip directly on sheets
            $(document).on('click', '.flipbook-sheet', function(e) {
                // Ignore clicks on buttons inside pages
                if ($(e.target).closest('button').length > 0) return;
                
                const $sheet = $(this);
                const sheetIdNum = parseInt($sheet.attr('id').replace('p-sheet-', ''));
                
                if (sheetIdNum === currentSheetIndex + 1) {
                    flipNext();
                } else if (sheetIdNum === currentSheetIndex) {
                    flipPrev();
                }
            });

            // Close button and backdrop close
            $('#btn-close-preview, .preview-modal-backdrop').on('click', function() {
                closeSecurePreview();
            });

            // Buy Now button inside the preview page
            $('#btn-buy-from-preview').on('click', function() {
                closeSecurePreview();
                $('#btn-detail-buy').trigger('click');
            });

            // Keyboard navigation inside preview
            $(document).on('keydown', function(e) {
                if (!$('#preview-modal-container').is(':visible')) return;
                
                if (e.key === 'Escape') {
                    closeSecurePreview();
                } else if (e.key === 'ArrowLeft') {
                    flipPrev();
                } else if (e.key === 'ArrowRight') {
                    flipNext();
                }
            });

            // --- SECURITY ENFORCEMENT ON PREVIEW MODAL ---
            $(document).on('contextmenu', '#preview-modal-container', function(e) {
                e.preventDefault();
                showToast('Security Action: Right-click is restricted to protect content.');
                return false;
            });

            $(document).on('keydown', function(e) {
                if (!$('#preview-modal-container').is(':visible')) return;
                
                // Disable F12 (Developer Tools)
                if (e.key === 'F12') {
                    e.preventDefault();
                    showToast('Security Action: Developer Tools are restricted in preview mode.');
                    return false;
                }
                
                // Disable Ctrl+Shift+I, Ctrl+Shift+J, Ctrl+Shift+C (Inspect elements)
                if (e.ctrlKey && e.shiftKey && (e.key === 'I' || e.key === 'i' || e.key === 'J' || e.key === 'j' || e.key === 'C' || e.key === 'c')) {
                    e.preventDefault();
                    showToast('Security Action: Inspection tools are restricted.');
                    return false;
                }
                
                // Disable Ctrl+U (View source)
                if (e.ctrlKey && (e.key === 'U' || e.key === 'u')) {
                    e.preventDefault();
                    showToast('Security Action: View Source is restricted.');
                    return false;
                }

                // Disable Ctrl+S (Save), Ctrl+P (Print), Ctrl+C (Copy)
                if (e.ctrlKey && (e.key === 'S' || e.key === 's' || e.key === 'P' || e.key === 'p' || e.key === 'C' || e.key === 'c')) {
                    e.preventDefault();
                    showToast('Security Action: Copying, printing, and saving are restricted.');
                    return false;
                }
            });

            // Exclusive Voucher Clicks
            $(document).on('click', '.coupon-card', function() {
                const code = $(this).find('div').first().text().trim();
                showToast(`Coupon code "${code}" applied successfully!`);
            });

            // See All Vouchers Click
            $(document).on('click', '.btn-see-all-vouchers', function(e) {
                e.preventDefault();
                showToast('All currently available promotions are listed.');
            });

            // Address Change Click
            $(document).on('click', '#btn-change-shipping-addr', function(e) {
                e.preventDefault();
                showToast('Shipping destination selection is disabled in the online demo.');
            });

            // Blind Book Voucher Card Click
            $(document).on('click', '.blind-coupons-container .blind-coupon-card', function() {
                const code = $(this).find('div').first().text().trim();
                showToast(`Mystery Coupon "${code}" selected!`);
            });

            // Blind Book See All Vouchers Click
            $(document).on('click', '#btn-see-all-blind-vouchers', function(e) {
                e.preventDefault();
                showToast('All currently available mystery promotions are listed.');
            });

            // Blind Book Address Change Click
            $(document).on('click', '#btn-change-blind-shipping', function(e) {
                e.preventDefault();
                showToast('Shipping destination selection is disabled in the online demo.');
            });

        });
    </script>

