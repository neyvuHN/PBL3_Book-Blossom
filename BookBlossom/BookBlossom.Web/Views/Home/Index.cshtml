                </div>
            </div>

        </div>
    </section>

    <!-- Footer -->
    <footer class="premium-footer">
        <div class="container">
            <p>&copy; 2026 BookBlossom. All rights reserved.</p>
            <p>Developed by <a href="#">PBL3 Team</a></p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function() {
            const $navHome = $('#nav-home');
            const $navExplore = $('#nav-explore');
            const $navTindbook = $('#nav-tindbook');
            const $navCommunity = $('#nav-community');
            const $navBlindDate = $('#nav-blind-date');
            const $navReviews = $('#nav-reviews');
            const $navLogo = $('#nav-logo');
            const $mainContent = $('#main-content');
            const $exploreSection = $('#explore-section');
            const $dedicatedCommunity = $('#dedicated-community');
            const $tindbookFeature = $('#tindbook-feature');
            const $mainNavbar = $('#main-navbar');
            const $navLinks = $('.nav-links a');

            // Auto-play the main hero carousel on homepage load (interval of 3.5 seconds)
            try {
                var heroCarouselEl = document.getElementById('heroCarousel');
                if (heroCarouselEl) {
                    var carouselInstance = new bootstrap.Carousel(heroCarouselEl, {
                        interval:3500,
                        ride: 'carousel',
                        pause: false // Prevent pausing when mouse hovers over full-screen banner
                    });
                    carouselInstance.cycle();
                }
            } catch (e) {
                console.error("Vanilla Bootstrap Carousel init failed: ", e);
                // Fallback to jQuery
                $('#heroCarousel').carousel({
                    interval: 3500,
                    ride: 'carousel',
                    pause: false
                });
                $('#heroCarousel').carousel('cycle');
            }

            // Dropdown Toggle
            const $userDropdown = $('.user-dropdown');
            
            $userDropdown.on('click', function(e) {
                e.stopPropagation(); // Prevent event from bubbling up to document
                $(this).toggleClass('active');
            });
            
            // Close dropdown when clicking outside
            $(document).on('click', function(e) {
                if (!$userDropdown.is(e.target) && $userDropdown.has(e.target).length === 0) {
                    $userDropdown.removeClass('active');
                }
            });

            function setActiveTab($element) {
                $navLinks.removeClass('active');
                $element.addClass('active');
            }

            function showHome(push = true) {
                $mainContent.show();
                $exploreSection.hide();
                $dedicatedCommunity.hide();
                $tindbookFeature.hide();
                $('#blind-date-section').hide();
                $('#reviews-section').hide();
                $('#product-details-section').hide();
                $('#blind-date-details-section').hide(); // Hide blind date details
                $mainNavbar.removeClass('navbar-light');
                setActiveTab($navHome);
                window.scrollTo(0, 0);
                if (push) {
                    history.pushState({ view: 'home' }, '', '#home');
                }
                // Resume carousel autoplay when navigating back to the Home view
                try {
                    var heroCarouselEl = document.getElementById('heroCarousel');
                    if (heroCarouselEl) {
                        var carouselInstance = bootstrap.Carousel.getOrCreateInstance(heroCarouselEl);
                        carouselInstance.cycle();
                    }
                } catch (e) {
                    $('#heroCarousel').carousel('cycle');
                }
            }

            function showExplore(push = true) {
                $mainContent.hide();
                $exploreSection.show();
                $dedicatedCommunity.hide();
                $tindbookFeature.hide();
                $('#blind-date-section').hide();
                $('#reviews-section').hide();
                $('#product-details-section').hide();
                $('#blind-date-details-section').hide(); // Hide blind date details
                $mainNavbar.addClass('navbar-light');
                setActiveTab($navExplore);
                window.scrollTo(0, 0);
                if (push) {
                    history.pushState({ view: 'explore' }, '', '#explore');
                }
            }

            function showDedicatedCommunity(push = true) {
                $mainContent.hide();
                $exploreSection.hide();
                $dedicatedCommunity.show();
                $tindbookFeature.hide();
                $('#blind-date-section').hide();
                $('#reviews-section').hide();
                $('#product-details-section').hide();
                $('#blind-date-details-section').hide(); // Hide blind date details
                $mainNavbar.addClass('navbar-light');
                setActiveTab($navCommunity);
                window.scrollTo(0, 0);
                if (push) {
                    history.pushState({ view: 'community' }, '', '#community');
                }
            }

            function showTindbook(push = true) {
                $mainContent.hide();
                $exploreSection.hide();
                $dedicatedCommunity.hide();
                $tindbookFeature.show();
                $('#blind-date-section').hide();
                $('#reviews-section').hide();
                $('#product-details-section').hide();
                $('#blind-date-details-section').hide(); // Hide blind date details
                $mainNavbar.addClass('navbar-light');
                setActiveTab($navTindbook);
                updateCards(); // Ensure cards are positioned correctly
                window.scrollTo(0, 0);
                if (push) {
                    history.pushState({ view: 'tindbook' }, '', '#tindbook');
                }
            }

            function showBlindDate(push = true) {
                $mainContent.hide();
                $exploreSection.hide();
                $dedicatedCommunity.hide();
                $tindbookFeature.hide();
                $('#blind-date-section').show();
                $('#reviews-section').hide();
                $('#product-details-section').hide();
                $('#blind-date-details-section').hide(); // Hide blind date details
                $mainNavbar.addClass('navbar-light');
                setActiveTab($navBlindDate);
                window.scrollTo(0, 0);
                if (push) {
                    history.pushState({ view: 'blind-date' }, '', '#blind-date');
                }
            }

            function showReviews(push = true) {
                $mainContent.hide();
                $exploreSection.hide();
                $dedicatedCommunity.hide();
                $tindbookFeature.hide();
                $('#blind-date-section').hide();
                $('#reviews-section').show();
                $('#product-details-section').hide(); // Hide book details if open
                $('#blind-date-details-section').hide(); // Hide blind date details
                $mainNavbar.addClass('navbar-light');
                setActiveTab($navReviews);
                window.scrollTo(0, 0);
                if (push) {
                    history.pushState({ view: 'reviews' }, '', '#reviews');
                }
            }

            $navExplore.on('click', function(e) {
                e.preventDefault();
                showExplore();
            });

            $navHome.on('click', function(e) {
                e.preventDefault();
                showHome();
            });

            $navLogo.on('click', function(e) {
                e.preventDefault();
                showHome();
            });

            $navTindbook.on('click', function(e) {
                e.preventDefault();
                showTindbook();
            });

            $navCommunity.on('click', function(e) {
                e.preventDefault();
                showDedicatedCommunity();
            });

            $navBlindDate.on('click', function(e) {
                e.preventDefault();
                showBlindDate();
            });

            $navReviews.on('click', function(e) {
                e.preventDefault();
                showReviews();
            });

            $('#btn-try-tindbook').on('click', function(e) {
                e.preventDefault();
                showTindbook();
            });

            // SPA History & Routing Logic
            window.addEventListener('popstate', function(event) {
                const state = event.state;
                if (state && state.view) {
                    const view = state.view;
                    if (view === 'home') {
                        showHome(false);
                    } else if (view === 'explore') {
                        showExplore(false);
                    } else if (view === 'community') {
                        showDedicatedCommunity(false);
                    } else if (view === 'tindbook') {
                        showTindbook(false);
                    } else if (view === 'blind-date') {
                        showBlindDate(false);
                    } else if (view === 'reviews') {
                        showReviews(false);
                    } else if (view === 'product-details') {
                        if (state.previousActiveSection) {
                            previousActiveSection = state.previousActiveSection;
                        }
                        showProductDetails(state.bookData, false);
                    } else if (view === 'blind-date-details') {
                        if (state.previousActiveSection) {
                            previousActiveSection = state.previousActiveSection;
                        }
                        showBlindDateDetails(state.blindBookData, false);
                    }
                } else {
                    showHome(false);
                }
            });

            // Initial Router parsing on Page Load
            const initialHash = window.location.hash;
            if (initialHash === '#explore') {
                showExplore(false);
                history.replaceState({ view: 'explore' }, '', '#explore');
            } else if (initialHash === '#community') {
                showDedicatedCommunity(false);
                history.replaceState({ view: 'community' }, '', '#community');
            } else if (initialHash === '#tindbook') {
                showTindbook(false);
                history.replaceState({ view: 'tindbook' }, '', '#tindbook');
            } else if (initialHash === '#blind-date') {
                showBlindDate(false);
                history.replaceState({ view: 'blind-date' }, '', '#blind-date');
            } else if (initialHash === '#reviews') {
                showReviews(false);
                history.replaceState({ view: 'reviews' }, '', '#reviews');
            } else if (initialHash.startsWith('#book-details-')) {
                showHome(false);
                history.replaceState({ view: 'home' }, '', '#home');
            } else if (initialHash.startsWith('#blind-details-')) {
                showBlindDate(false);
                history.replaceState({ view: 'blind-date' }, '', '#blind-date');
            } else {
                showHome(false);
                history.replaceState({ view: 'home' }, '', '#home');
            }

            // Explore Filter Sidebar Toggle
            $('#btn-toggle-filter').on('click', function(e) {
                e.preventDefault();
                const $layout = $('#explore-layout');
                $layout.toggleClass('filters-hidden');
                const isHidden = $layout.hasClass('filters-hidden');
                $(this).html(isHidden ? '<i class="fas fa-sliders-h"></i> Show filters' : '<i class="fas fa-sliders-h"></i> Hide filters');
            });

            // Thread Slider & Button Logic
            const $threadTrack = $('#thread-slider .slider-track');
            $('#thread-slider .slider-btn.next').on('click', function() {
                $threadTrack.animate({
                    scrollLeft: $threadTrack.scrollLeft() + $threadTrack.width() * 0.8
                }, 500);
            });
            
            $('#thread-slider .slider-btn.prev').on('click', function() {
                $threadTrack.animate({
                    scrollLeft: $threadTrack.scrollLeft() - $threadTrack.width() * 0.8
                }, 500);
            });

            // Tindbook Logic
            let currentCardIndex = 0;
            const $cards = $('.tindbook-card');
            let isDragging = false;
            let startX, startY;
            let currentX, currentY;
            
            function updateCards() {
                $cards.each(function(index) {
                    const $card = $(this);
                    if (index < currentCardIndex) {
                        $card.css('opacity', '0');
                        $card.css('pointer-events', 'none');
                    } else if (index === currentCardIndex) {
                        $card.css('transform', 'translateX(0) translateY(0) rotate(0)');
                        $card.css('opacity', '1');
                        $card.css('z-index', '3');
                        $card.css('pointer-events', 'auto');
                    } else if (index === currentCardIndex + 1) {
                        $card.css('transform', 'translateX(0) translateY(15px) scale(0.95)');
                        $card.css('opacity', '0.8');
                        $card.css('z-index', '2');
                        $card.css('pointer-events', 'none');
                    } else if (index === currentCardIndex + 2) {
                        $card.css('transform', 'translateX(0) translateY(30px) scale(0.9)');
                        $card.css('opacity', '0.5');
                        $card.css('z-index', '1');
                        $card.css('pointer-events', 'none');
                    } else {
                        $card.css('transform', 'translateX(0) translateY(45px) scale(0.85)');
                        $card.css('opacity', '0');
                        $card.css('z-index', '0');
                        $card.css('pointer-events', 'none');
                    }
                });
            }
            
            function swipe(direction) {
                if (currentCardIndex >= $cards.length) return;
                
                const $card = $cards.eq(currentCardIndex);
                $card.css('transition', 'transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.5s');
                
                switch(direction) {
                    case 'right':
                        $card.css('transform', 'translateX(200%) rotate(30deg)');
                        console.log("Liked -> Saved to Wishlist");
                        break;
                    case 'left':
                        $card.css('transform', 'translateX(-200%) rotate(-30deg)');
                        console.log("Disliked -> Hidden");
                        break;
                    case 'up':
                        $card.css('transform', 'translateY(-200%) scale(1.1)');
                        console.log("Super Liked -> Added to Cart");
                        break;
                    case 'down':
                        $card.css('transform', 'translateY(200%)');
                        console.log("Skipped");
                        break;
                }
                
                $card.css('opacity', '0');
                currentCardIndex++;
                setTimeout(updateCards, 300);
            }
            
            $('#btn-nope').on('click', function() {
                swipe('left');
            });
            
            $('#btn-like').on('click', function() {
                swipe('right');
            });
            
            $('#btn-super').on('click', function() {
                swipe('up');
            });

            $('#btn-skip').on('click', function() {
                swipe('down');
            });

            $('#btn-undo').on('click', function() {
                if (currentCardIndex > 0) {
                    currentCardIndex--;
                    const $card = $cards.eq(currentCardIndex);
                    $card.css('transition', 'transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.5s');
                    updateCards();
                }
            });

            // Fullscreen toggle
            const $hoverOverlay = $('.tindbook-hover-overlay');

            $hoverOverlay.on('click', function() {
                $('#tindbook-feature').addClass('fullscreen-focus');
                $hoverOverlay.hide();
            });

            // Click outside to exit
            $(document).on('click', function(e) {
                if ($('#tindbook-feature').hasClass('fullscreen-focus')) {
                    if (!$(e.target).closest('.tindbook-app-container').length && !$(e.target).closest('.tindbook-controls').length && !$(e.target).closest('.tindbook-hover-overlay').length) {
                        $('#tindbook-feature').removeClass('fullscreen-focus');
                        $hoverOverlay.show();
                    }
                }
            });

            // Drag Gestures
            $cards.on('mousedown touchstart', function(e) {
                const cardIndex = $cards.index(this);
                if (cardIndex !== currentCardIndex) return;
                isDragging = true;
                const event = e.originalEvent && e.originalEvent.touches ? e.originalEvent.touches[0] : e;
                startX = event.clientX || event.pageX;
                startY = event.clientY || event.pageY;
                currentX = startX;
                currentY = startY;
                $(this).css('transition', 'none');
            });

            $(document).on('mousemove touchmove', function(e) {
                if (!isDragging) return;
                const event = e.originalEvent && e.originalEvent.touches ? e.originalEvent.touches[0] : e;
                currentX = event.clientX || event.pageX;
                currentY = event.clientY || event.pageY;
                
                const deltaX = currentX - startX;
                const deltaY = currentY - startY;
                const rotate = deltaX * 0.1;
                
                const $card = $cards.eq(currentCardIndex);
                $card.css('transform', `translate(${deltaX}px, ${deltaY}px) rotate(${rotate}deg)`);

                // Visual Feedback
                const threshold = 50;
                $('.control-btn').removeClass('active');
                $('.tindbook-action-label').text('').css('opacity', '0');

                if (Math.abs(deltaX) > Math.abs(deltaY)) {
                    if (deltaX > threshold) {
                        $('#btn-like').addClass('active');
                        $('.tindbook-action-label').text('Save to Wishlist').css('opacity', '1').css('color', '#4caf50');
                    } else if (deltaX < -threshold) {
                        $('#btn-nope').addClass('active');
                        $('.tindbook-action-label').text('Hide book').css('opacity', '1').css('color', '#f44336');
                    }
                } else {
                    if (deltaY > threshold) {
                        $('#btn-skip').addClass('active');
                        $('.tindbook-action-label').text('Skip').css('opacity', '1').css('color', '#9e9e9e');
                    } else if (deltaY < -threshold) {
                        $('#btn-super').addClass('active');
                        $('.tindbook-action-label').text('Add to Cart').css('opacity', '1').css('color', '#2196f3');
                    }
                }
            });

            $(document).on('mouseup touchend', function(e) {
                if (!isDragging) return;
                isDragging = false;
                
                const deltaX = currentX - startX;
                const deltaY = currentY - startY;
                const threshold = 100;
                
                const $card = $cards.eq(currentCardIndex);
                $card.css('transition', 'transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.5s');
                
                // Reset feedback
                $('.control-btn').removeClass('active');
                $('.tindbook-action-label').css('opacity', '0');

                if (Math.abs(deltaX) > Math.abs(deltaY)) {
                    if (deltaX > threshold) {
                        swipe('right');
                    } else if (deltaX < -threshold) {
                        swipe('left');
                    } else {
                        updateCards();
                    }
                } else {
                    if (deltaY > threshold) {
                        swipe('down');
                    } else if (deltaY < -threshold) {
                        swipe('up');
                    } else {
                        updateCards();
                    }
                }
            });

            // Click on Card
            $cards.on('click', function(e) {
                const deltaX = Math.abs(currentX - startX);
                const deltaY = Math.abs(currentY - startY);
                if (deltaX > 10 || deltaY > 10) return;
                
                const cardIndex = $cards.index(this);
                if (cardIndex === currentCardIndex) {
                    const $card = $(this);
                    const title = $card.find('h3').text().trim();
                    let author = $card.find('.author').text().trim();
                    if (author.startsWith('by ')) {
                        author = author.substring(3);
                    }
                    const imgSrc = $card.find('.card-image img').attr('src');
                    
                    showProductDetails({
                        title: title,
                        author: author,
                        imgSrc: imgSrc
                    });
                }
            });

            // Keyboard Shortcuts
            $(document).on('keydown', function(e) {
                if (!$('#tindbook-feature').hasClass('fullscreen-focus')) return;
                
                switch(e.key) {
                    case 'ArrowRight':
                        swipe('right');
                        break;
                    case 'ArrowLeft':
                        swipe('left');
                        break;
                    case 'ArrowUp':
                        swipe('up');
                        break;
                    case 'ArrowDown':
                        swipe('down');
                        break;
                }
            });

            // Slider logic
            function setupSlider(sliderId) {
                const $track = $(`#${sliderId} .slider-track`);
                const $prev = $(`#${sliderId} .slider-btn.prev`);
                const $next = $(`#${sliderId} .slider-btn.next`);
                
                if ($track.length) {
                    $next.on('click', function() {
                        $track.animate({
                            scrollLeft: $track.scrollLeft() + $track.width() * 0.8
                        }, 500);
                    });
                    
                    $prev.on('click', function() {
                        $track.animate({
                            scrollLeft: $track.scrollLeft() - $track.width() * 0.8
                        }, 500);
                    });
                }
            }
            
            setupSlider('featured-slider');
            setupSlider('community-slider');

            // Blind Date Books Redesign Logic
            const $blindSidebar = $('#blind-sidebar');
            const $btnToggleMatchmaker = $('#btn-toggle-matchmaker');
            const $btnHideSidebar = $('#btn-hide-sidebar');

            // Price Range Slider Reusable Logic
            function initPriceSlider(prefix, accentColor = '#a291b5') {
                const $minRange = $(`#${prefix}-price-min`);
                const $maxRange = $(`#${prefix}-price-max`);
                const $minInput = $(`#${prefix}-price-min-input`);
                const $maxInput = $(`#${prefix}-price-max-input`);
                const $tooltipMin = $(`#${prefix}-tooltip-min`);
                const $tooltipMax = $(`#${prefix}-tooltip-max`);
                const $track = $(`#${prefix}-price-track`);
                const maxRangeValue = 1000;

                if (!$minRange.length) return;

                function updateSlider() {
                    let minVal = parseInt($minRange.val()) || 0;
                    let maxVal = parseInt($maxRange.val()) || 0;

                    const movingId = $(this).attr('id') || "";
                    if (minVal > maxVal) {
                        if (movingId.includes('min')) {
                            $minRange.val(maxVal);
                            minVal = maxVal;
                        } else {
                            $maxRange.val(minVal);
                            maxVal = minVal;
                        }
                    }

                    const percent1 = (minVal / maxRangeValue) * 100;
                    const percent2 = (maxVal / maxRangeValue) * 100;

                    $track.css('background', `linear-gradient(to right, #eee ${percent1}%, ${accentColor} ${percent1}%, ${accentColor} ${percent2}%, #eee ${percent2}%)`);
                    
                    $tooltipMin.text(minVal).css('left', `${percent1}%`);
                    $tooltipMax.text(maxVal).css('left', `${percent2}%`);

                    $minInput.val(minVal);
                    $maxInput.val(maxVal);
                }

                function handleManualInput() {
                    let val = parseInt($(this).val()) || 0;
                    const clampedVal = Math.min(Math.max(val, 0), maxRangeValue);
                    
                    const movingId = $(this).attr('id') || "";
                    if (movingId.includes('min')) {
                        const currentMax = parseInt($maxRange.val()) || 1000;
                        $minRange.val(Math.min(clampedVal, currentMax));
                    } else {
                        const currentMin = parseInt($minRange.val()) || 0;
                        $maxRange.val(Math.max(clampedVal, currentMin));
                    }
                    
                    updateSlider.call(this);
                    $(this).val(val);
                }

                $minRange.on('input', updateSlider);
                $maxRange.on('input', updateSlider);
                $minInput.on('input', handleManualInput);
                $maxInput.on('input', handleManualInput);

                updateSlider.call($minRange[0]);
            }

            // Initialize sliders with error catching to prevent breaking other scripts
            try {
                initPriceSlider('explore', '#EEC7C9'); // Pink theme for Explore
                initPriceSlider('blind', '#a291b5');   // Purple theme for Blind Date
            } catch (err) {
                console.error("Price slider initialization failed:", err);
            }

            // Banner CTA Logic - High Performance Scroll
            $('#cta-join-community').on('click', function(e) {
                e.preventDefault();
                e.stopImmediatePropagation();

                // Stop carousel to prevent transition conflicts
                $('#heroCarousel').carousel('pause');
                
                const target = document.getElementById('community');
                if (target) {
                    // Immediate tab switch if needed
                    if (!$('#nav-home').hasClass('active')) {
                        $('#main-content').show();
                        $('#explore-section, #dedicated-community, #tindbook-feature, #blind-date-section, #reviews-section, #product-details-section, #blind-date-details-section').hide(); // Hide all sections including details
                        $('#main-navbar').removeClass('navbar-light');
                        $('.nav-links a').removeClass('active');
                        $('#nav-home').addClass('active');
                    }

                    // Native browser smooth scroll (bypass JS animation loop for speed)
                    const offset = 80;
                    const bodyRect = document.body.getBoundingClientRect().top;
                    const elementRect = target.getBoundingClientRect().top;
                    const elementPosition = elementRect - bodyRect;
                    const offsetPosition = elementPosition - offset;

                    window.scrollTo({
                        top: offsetPosition,
                        behavior: 'smooth'
                    });
                }
            });

            $('#cta-blind-date').on('click', function(e) {
                e.preventDefault();
                e.stopImmediatePropagation();
                $('#heroCarousel').carousel('pause');

                const target = document.getElementById('blind-date-promo');
                if (target) {
                    if (!$('#nav-home').hasClass('active')) {
                        showHome();
                    }

                    const offset = 80;
                    const bodyRect = document.body.getBoundingClientRect().top;
                    const elementRect = target.getBoundingClientRect().top;
                    const elementPosition = elementRect - bodyRect;
                    const offsetPosition = elementPosition - offset;

                    window.scrollTo({
                        top: offsetPosition,
                        behavior: 'smooth'
                    });
                }
            });

            $('#btn-try-blind-date').on('click', function(e) {
                e.preventDefault();
                showBlindDate();
            });

            $('#cta-thread').on('click', function(e) {
                e.preventDefault();
                e.stopImmediatePropagation();
                $('#heroCarousel').carousel('pause');

                const target = document.getElementById('thread-preview');
                if (target) {
                    if (!$('#nav-home').hasClass('active')) {
                        $('#main-content').show();
                        $('#explore-section, #dedicated-community, #tindbook-feature, #blind-date-section, #reviews-section, #product-details-section, #blind-date-details-section').hide(); // Hide all sections including details
                        $('#main-navbar').removeClass('navbar-light');
                        $('.nav-links a').removeClass('active');
                        $('#nav-home').addClass('active');
                    }

                    const offset = 80;
                    const bodyRect = document.body.getBoundingClientRect().top;
                    const elementRect = target.getBoundingClientRect().top;
                    const elementPosition = elementRect - bodyRect;
                    const offsetPosition = elementPosition - offset;

                    window.scrollTo({
                        top: offsetPosition,
                        behavior: 'smooth'
                    });
                }
