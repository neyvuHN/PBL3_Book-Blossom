                            <div class="book-info">
                                <h3>Think and Grow Rich</h3>
                                <p>Napoleon Hill</p>
                            </div>
                        </div>
                        <div class="book-card">
                            <img src="/images/Book/book1.jpg" alt="Book 4">
                            <div class="book-info">
