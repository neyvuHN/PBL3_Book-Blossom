    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function() {
            const $navHome = $('#nav-home');
            const $navExplore = $('#nav-explore');
            const $navTindbook = $('#nav-tindbook');
            const $navCommunity = $('#nav-community');
            const $navLogo = $('#nav-logo');
            const $mainContent = $('#main-content');
            const $exploreSection = $('#explore-section');
            const $dedicatedCommunity = $('#dedicated-community');
            const $tindbookFeature = $('#tindbook-feature');
            const $mainNavbar = $('#main-navbar');
            const $navLinks = $('.nav-links a');

            // Dropdown Toggle
            const $userDropdown = $('.user-dropdown');
            
            $userDropdown.on('click', function(e) {
                e.stopPropagation(); // Prevent event from bubbling up to document
                $(this).toggleClass('active');
            });
            
            // Close dropdown when clicking outside
            $(document).on('click', function(e) {
                if (!$userDropdown.is(e.target) && $userDropdown.has(e.target).length === 0) {
                    $userDropdown.removeClass('active');
                }
            });

            function setActiveTab($element) {
                $navLinks.removeClass('active');
                $element.addClass('active');
            }

            function showHome() {
                $mainContent.show();
                $exploreSection.hide();
                $dedicatedCommunity.hide();
                $tindbookFeature.hide();
                $mainNavbar.removeClass('navbar-light');
                setActiveTab($navHome);
            }

            function showExplore() {
                $mainContent.hide();
                $exploreSection.show();
                $dedicatedCommunity.hide();
                $tindbookFeature.hide();
                $mainNavbar.addClass('navbar-light');
                setActiveTab($navExplore);
            }

            function showDedicatedCommunity() {
                $mainContent.hide();
                $exploreSection.hide();
                $dedicatedCommunity.show();
                $tindbookFeature.hide();
                $mainNavbar.addClass('navbar-light');
                setActiveTab($navCommunity);
            }

            function showTindbook() {
                $mainContent.hide();
                $exploreSection.hide();
                $dedicatedCommunity.hide();
                $tindbookFeature.show();
                $mainNavbar.addClass('navbar-light');
                setActiveTab($navTindbook);
                updateCards(); // Ensure cards are positioned correctly
            }

            $navExplore.on('click', function(e) {
                e.preventDefault();
                showExplore();
            });

            $navHome.on('click', function(e) {
                e.preventDefault();
                showHome();
            });

            $navLogo.on('click', function(e) {
                e.preventDefault();
                showHome();
            });

            $navTindbook.on('click', function(e) {
                e.preventDefault();
                showTindbook();
            });

            $('#btn-try-tindbook').on('click', function(e) {
                e.preventDefault();
                showTindbook();
            });

            // Tindbook Logic
            let currentCardIndex = 0;
            const $cards = $('.tindbook-card');
            let isDragging = false;
            let startX, startY;
            let currentX, currentY;
            
            function updateCards() {
                $cards.each(function(index) {
                    const $card = $(this);
                    if (index < currentCardIndex) {
                        $card.css('opacity', '0');
                        $card.css('pointer-events', 'none');
                    } else if (index === currentCardIndex) {
                        $card.css('transform', 'translateX(0) translateY(0) rotate(0)');
                        $card.css('opacity', '1');
                        $card.css('z-index', '3');
                        $card.css('pointer-events', 'auto');
                    } else if (index === currentCardIndex + 1) {
                        $card.css('transform', 'translateX(0) translateY(15px) scale(0.95)');
                        $card.css('opacity', '0.8');
                        $card.css('z-index', '2');
                        $card.css('pointer-events', 'none');
                    } else if (index === currentCardIndex + 2) {
                        $card.css('transform', 'translateX(0) translateY(30px) scale(0.9)');
                        $card.css('opacity', '0.5');
                        $card.css('z-index', '1');
                        $card.css('pointer-events', 'none');
                    } else {
                        $card.css('transform', 'translateX(0) translateY(45px) scale(0.85)');
                        $card.css('opacity', '0');
                        $card.css('z-index', '0');
                        $card.css('pointer-events', 'none');
                    }
                });
            }
            
            function swipe(direction) {
                if (currentCardIndex >= $cards.length) return;
                
                const $card = $cards.eq(currentCardIndex);
                $card.css('transition', 'transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.5s');
                
                switch(direction) {
                    case 'right':
                        $card.css('transform', 'translateX(200%) rotate(30deg)');
                        console.log("Liked -> Saved to Wishlist");
                        break;
                    case 'left':
                        $card.css('transform', 'translateX(-200%) rotate(-30deg)');
                        console.log("Disliked -> Hidden");
                        break;
                    case 'up':
                        $card.css('transform', 'translateY(-200%) scale(1.1)');
                        console.log("Super Liked -> Added to Cart");
                        break;
                    case 'down':
                        $card.css('transform', 'translateY(200%)');
                        console.log("Skipped");
                        break;
                }
                
                $card.css('opacity', '0');
                currentCardIndex++;
                setTimeout(updateCards, 300);
            }
            
            $('#btn-nope').on('click', function() {
                swipe('left');
            });
            
            $('#btn-like').on('click', function() {
                swipe('right');
            });
            
            $('#btn-super').on('click', function() {
                swipe('up');
            });

            $('#btn-skip').on('click', function() {
                swipe('down');
            });

            $('#btn-undo').on('click', function() {
                if (currentCardIndex > 0) {
                    currentCardIndex--;
                    const $card = $cards.eq(currentCardIndex);
                    $card.css('transition', 'transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.5s');
                    updateCards();
                }
            });

            // Fullscreen toggle
            const $hoverOverlay = $('.tindbook-hover-overlay');

            $hoverOverlay.on('click', function() {
                $('#tindbook-feature').addClass('fullscreen-focus');
                $hoverOverlay.hide();
            });

            // Click outside to exit
            $(document).on('click', function(e) {
                if ($('#tindbook-feature').hasClass('fullscreen-focus')) {
                    if (!$(e.target).closest('.tindbook-app-container').length && !$(e.target).closest('.tindbook-controls').length && !$(e.target).closest('.tindbook-hover-overlay').length) {
                        $('#tindbook-feature').removeClass('fullscreen-focus');
                        $hoverOverlay.show();
                    }
                }
            });

            // Drag Gestures
            $cards.on('mousedown touchstart', function(e) {
                const cardIndex = $cards.index(this);
                if (cardIndex !== currentCardIndex) return;
                isDragging = true;
                const event = e.originalEvent && e.originalEvent.touches ? e.originalEvent.touches[0] : e;
                startX = event.clientX || event.pageX;
                startY = event.clientY || event.pageY;
                currentX = startX;
                currentY = startY;
                $(this).css('transition', 'none');
            });

            $(document).on('mousemove touchmove', function(e) {
                if (!isDragging) return;
                const event = e.originalEvent && e.originalEvent.touches ? e.originalEvent.touches[0] : e;
                currentX = event.clientX || event.pageX;
                currentY = event.clientY || event.pageY;
                
                const deltaX = currentX - startX;
                const deltaY = currentY - startY;
                const rotate = deltaX * 0.1;
                
                const $card = $cards.eq(currentCardIndex);
                $card.css('transform', `translate(${deltaX}px, ${deltaY}px) rotate(${rotate}deg)`);

                // Visual Feedback
                const threshold = 50;
                $('.control-btn').removeClass('active');
                $('.tindbook-action-label').text('').css('opacity', '0');

                if (Math.abs(deltaX) > Math.abs(deltaY)) {
                    if (deltaX > threshold) {
                        $('#btn-like').addClass('active');
                        $('.tindbook-action-label').text('Save to Wishlist').css('opacity', '1').css('color', '#4caf50');
                    } else if (deltaX < -threshold) {
                        $('#btn-nope').addClass('active');
                        $('.tindbook-action-label').text('Hide book').css('opacity', '1').css('color', '#f44336');
                    }
                } else {
                    if (deltaY > threshold) {
                        $('#btn-skip').addClass('active');
                        $('.tindbook-action-label').text('Skip').css('opacity', '1').css('color', '#9e9e9e');
                    } else if (deltaY < -threshold) {
                        $('#btn-super').addClass('active');
                        $('.tindbook-action-label').text('Add to Cart').css('opacity', '1').css('color', '#2196f3');
                    }
                }
            });

            $(document).on('mouseup touchend', function(e) {
                if (!isDragging) return;
                isDragging = false;
                
                const deltaX = currentX - startX;
                const deltaY = currentY - startY;
                const threshold = 100;
                
                const $card = $cards.eq(currentCardIndex);
                $card.css('transition', 'transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.5s');
                
                // Reset feedback
                $('.control-btn').removeClass('active');
                $('.tindbook-action-label').css('opacity', '0');

                if (Math.abs(deltaX) > Math.abs(deltaY)) {
                    if (deltaX > threshold) {
                        swipe('right');
                    } else if (deltaX < -threshold) {
                        swipe('left');
                    } else {
                        updateCards();
                    }
                } else {
                    if (deltaY > threshold) {
                        swipe('down');
                    } else if (deltaY < -threshold) {
                        swipe('up');
                    } else {
                        updateCards();
                    }
                }
            });

            // Click on Card
            $cards.on('click', function(e) {
                const deltaX = Math.abs(currentX - startX);
                const deltaY = Math.abs(currentY - startY);
                if (deltaX > 10 || deltaY > 10) return;
                
                const cardIndex = $cards.index(this);
                if (cardIndex === currentCardIndex) {
                    const bookId = $(this).data('book-id');
                    window.location.href = `/Book/Details/${bookId}`;
                }
            });

            // Keyboard Shortcuts
            $(document).on('keydown', function(e) {
                if (!$('#tindbook-feature').hasClass('fullscreen-focus')) return;
                
                switch(e.key) {
                    case 'ArrowRight':
                        swipe('right');
                        break;
                    case 'ArrowLeft':
                        swipe('left');
                        break;
                    case 'ArrowUp':
                        swipe('up');
                        break;
                    case 'ArrowDown':
                        swipe('down');
                        break;
                }
            });

            $navCommunity.on('click', function(e) {
                e.preventDefault();
                showDedicatedCommunity();
            });

            // Filter Sidebar Toggle
            const $filterSidebar = $('#filter-sidebar');
            const $toggleFilterBtn = $('#btn-toggle-filter');
            
            $toggleFilterBtn.on('click', function() {
                $filterSidebar.toggle();
                const isVisible = $filterSidebar.is(':visible');
                $(this).html(isVisible ? '<i class="fas fa-sliders-h"></i> Hide filters' : '<i class="fas fa-sliders-h"></i> Show filters');
            });

            // Price Slider Logic
            const $priceMin = $('#price-min');
            const $priceMax = $('#price-max');
            const $priceMinInput = $('#price-min-input');
            const $priceMaxInput = $('#price-max-input');
            const $tooltipMin = $('#tooltip-min');
            const $tooltipMax = $('#tooltip-max');
            const $sliderTrack = $('#price-slider-track');
            
            function fillTrack() {
                const percent1 = ($priceMin.val() / $priceMin.attr('max')) * 100;
                const percent2 = ($priceMax.val() / $priceMax.attr('max')) * 100;
                $sliderTrack.css('background', `linear-gradient(to right, #e9ecef ${percent1}%, #EEC7C9 ${percent1}%, #EEC7C9 ${percent2}%, #e9ecef ${percent2}%)`);
            }
            
            function updateTooltips() {
                const val1 = $priceMin.val();
                const val2 = $priceMax.val();
                const percent1 = (val1 / $priceMin.attr('max')) * 100;
                const percent2 = (val2 / $priceMax.attr('max')) * 100;
                
                $tooltipMin.text(val1).css('left', `${percent1}%`);
                $tooltipMax.text(val2).css('left', `${percent2}%`);
            }

            function updateInputs() {
                $priceMinInput.val($priceMin.val());
                $priceMaxInput.val($priceMax.val());
            }

            $priceMin.on('input', function() {
                if (parseInt($priceMin.val()) > parseInt($priceMax.val())) {
                    $priceMin.val($priceMax.val());
                }
                updateInputs();
                updateTooltips();
                fillTrack();
            });

            $priceMax.on('input', function() {
                if (parseInt($priceMax.val()) < parseInt($priceMin.val())) {
                    $priceMax.val($priceMin.val());
                }
                updateInputs();
                updateTooltips();
                fillTrack();
            });
            
            // Manual Input Logic
            $priceMinInput.on('input', function() {
                let val = parseInt($(this).val());
                if (isNaN(val)) return;
                
                let sliderVal = val;
                if (sliderVal > 1000) sliderVal = 1000;
                if (sliderVal < 0) sliderVal = 0;
                
                const currentMax = parseInt($priceMax.val());
                if (sliderVal > currentMax) {
                    sliderVal = currentMax;
                }
                
                $priceMin.val(sliderVal);
                updateTooltips();
                fillTrack();
            });

            $priceMaxInput.on('input', function() {
                let val = parseInt($(this).val());
                if (isNaN(val)) return;
                
                let sliderVal = val;
                if (sliderVal > 1000) sliderVal = 1000;
                if (sliderVal < 0) sliderVal = 0;
                
                const currentMin = parseInt($priceMin.val());
                if (sliderVal < currentMin) {
                    sliderVal = currentMin;
                }
                
                $priceMax.val(sliderVal);
                updateTooltips();
                fillTrack();
            });
            
            // Initial fill
            fillTrack();
            updateInputs();
            updateTooltips();

            // Search logic (Mock)
            const $searchInput = $('#search-input');
            const $searchBtn = $('#search-submit-btn');

            $searchBtn.on('click', function() {
                const query = $searchInput.val().trim();
                if (query !== '') {
                    console.log(`Searching for: ${query}`);
                }
            });

            $searchInput.on('keypress', function(e) {
                if (e.which == 13) {
                    $searchBtn.click();
                }
            });

            // Slider logic
            function setupSlider(sliderId) {
                const $track = $(`#${sliderId} .slider-track`);
                const $prev = $(`#${sliderId} .slider-btn.prev`);
                const $next = $(`#${sliderId} .slider-btn.next`);
                
                $next.on('click', function() {
                    $track.animate({
                        scrollLeft: $track.scrollLeft() + $track.width() * 0.8
                    }, 500);
                });
                
                $prev.on('click', function() {
                    $track.animate({
                        scrollLeft: $track.scrollLeft() - $track.width() * 0.8
                    }, 500);
                });
            }
            
            setupSlider('featured-slider');
            setupSlider('community-slider');

            // See More buttons
            $('#see-more-books').on('click', function(e) {
                e.preventDefault();
                showExplore();
            });



            $('#see-more-community').on('click', function(e) {
                e.preventDefault();
                showDedicatedCommunity();
            });

            // Handle category tags click
            $('.category-tags .tag').on('click', function() {
                $('.category-tags .tag').removeClass('active');
                $(this).addClass('active');
            });

            // Custom Dropdown Logic
            $('.custom-dropdown').each(function() {
                const $dropdown = $(this);
                const $input = $dropdown.find('.dropdown-input');
                const $list = $dropdown.find('.dropdown-list');
                const $icon = $dropdown.find('.dropdown-icon');
                
                // Toggle open on click (header or arrow)
                $dropdown.find('.dropdown-header').on('click', function(e) {
                    if (e.target !== $input[0]) {
                        $dropdown.toggleClass('open');
                    }
                });
                
                // Open on focus
                $input.on('focus', function() {
                    $dropdown.addClass('open');
                });
                
                // Select item
                $dropdown.find('li').on('click', function() {
                    $input.val($(this).text());
                    $dropdown.removeClass('open');
                });
                
                // Close on click outside
                $(document).on('click', function(e) {
                    if (!$dropdown.is(e.target) && $dropdown.has(e.target).length === 0) {
                        $dropdown.removeClass('open');
                    }
                });
            });

            // Spoiler Reveal Logic
            $('.btn-reveal').on('click', function() {
                const $post = $(this).closest('.thread-post');
                $post.find('.blurred-content').removeClass('blurred-content');
                $post.find('.spoiler-overlay').fadeOut(300);
            });

            // Toggle Sidebar Logic
            $('#btn-toggle-sidebar').on('click', function() {
                $('#thread-left-sidebar').toggleClass('collapsed');
                $('.community-thread-container').toggleClass('sidebar-collapsed');
            });

            // Like Button Logic
            $('.btn-like').on('click', function() {
                const $icon = $(this).find('i');
                const $count = $(this).find('.like-count');
                let count = parseInt($count.text());
                
                if ($icon.hasClass('far')) {
                    $icon.removeClass('far').addClass('fas').css('color', '#C2185B');
                    $count.text(count + 1);
                } else {
                    $icon.removeClass('fas').addClass('far').css('color', '');
                    $count.text(count - 1);
                }
            });

            // Comment Button Logic (Toggle)
            $('.btn-comment').on('click', function() {
                const $post = $(this).closest('.thread-post');
                $post.find('.comment-section').slideToggle(300);
            });

            // Send Comment Logic
            $('.btn-send-comment').on('click', function() {
                const $input = $(this).siblings('input');
                const text = $input.val().trim();
                
                if (text !== '') {
                    const $list = $(this).closest('.comment-section').find('.comment-list');
                    const newComment = `
                        <div class="comment-item">
                            <img src="/images/Avatar/avatar1.jpg" alt="Avatar" class="comment-avatar">
                            <div class="comment-content">
                                <span class="comment-user">You</span>
                                <p>${text}</p>
                                <span class="comment-time">Just now</span>
                            </div>
                        </div>
                    `;
                    $list.append(newComment);
                    $input.val('');
                    
                    // Update comment count
                    const $post = $(this).closest('.thread-post');
                    const $count = $post.find('.comment-count');
                    $count.text(parseInt($count.text()) + 1);
                }
            });

            function showToast(message) {
                const $toast = $(`
                    <div class="toast-notification">
                        <i class="fas fa-check-circle"></i>
                        <span>${message}</span>
                        <button class="btn-undo-share">Undo</button>
                        <div class="toast-progress"></div>
                    </div>
                `);
                $('body').append($toast);
                $toast.fadeIn(300);
                
                // Auto hide after 5 seconds
                const timeoutId = setTimeout(function() {
                    $toast.fadeOut(300, function() {
                        $(this).remove();
                    });
                }, 5000);
                
                // Undo action
                $toast.find('.btn-undo-share').on('click', function() {
                    clearTimeout(timeoutId);
                    $toast.fadeOut(200, function() {
                        $(this).remove();
                        // You can add further undo logic here if needed
                    });
                });
            }

            // Share Button Logic
            $('.btn-share').on('click', function() {
                $('#share-modal').fadeIn(200);
            });

            $('#btn-cancel-share').on('click', function() {
                $('#share-modal').fadeOut(200);
            });

            $('#btn-confirm-share').on('click', function() {
                $('#share-modal').fadeOut(200);
                showToast('Post shared successfully to your profile!');
            });

            // Post Menu Dropdown Toggle
            $('.post-menu-btn').on('click', function(e) {
                e.stopPropagation();
                $(this).find('.post-dropdown-menu').toggle();
            });

            // Close dropdown on click outside
            $(document).on('click', function() {
                $('.post-dropdown-menu').hide();
            });

            // Hide Post Logic
            $('.btn-hide-post').on('click', function(e) {
                e.preventDefault();
                const $post = $(this).closest('.thread-post');
                $post.find('.hidden-post-overlay').fadeIn(200);
                
                // Set timer to remove post
                const hideTimeout = setTimeout(function() {
                    $post.slideUp(300, function() {
                        $(this).remove();
                    });
                }, 5000); // 5 seconds
                
                // Store timeout ID on the post element
                $post.data('hideTimeout', hideTimeout);
            });

            $('.btn-undo-hide').on('click', function() {
                const $post = $(this).closest('.thread-post');
                const $overlay = $post.find('.hidden-post-overlay');
                
                // Clear timeout
                const hideTimeout = $post.data('hideTimeout');
                if (hideTimeout) {
                    clearTimeout(hideTimeout);
                }
                
                $overlay.fadeOut(200);
            });

            // Report Post Logic
            $('.btn-report-post').on('click', function(e) {
                e.preventDefault();
                $('#report-modal').fadeIn(200);
            });

            $('#btn-cancel-report').on('click', function() {
                $('#report-modal').fadeOut(200);
            });

            // Toggle other reason input
            $('input[name="report-reason"]').on('change', function() {
                if ($(this).val() === 'other') {
                    $('.other-reason-container').slideDown(200);
                } else {
                    $('.other-reason-container').slideUp(200);
                }
            });

            $('#btn-submit-report').on('click', function() {
                const reason = $('input[name="report-reason"]:checked').val();
                if (reason) {
                    if (reason === 'other') {
                        const otherText = $('#other-reason-text').val().trim();
                        if (otherText === '') {
                            alert('Please enter your reason.');
                            return;
                        }
                    }
                    $('#report-modal').fadeOut(200);
                    showToast('Thank you for reporting. We will review this post.');
                    
                    // Reset form after close
                    setTimeout(function() {
                        $('input[name="report-reason"]').prop('checked', false);
                        $('#other-reason-text').val('');
                        $('.other-reason-container').hide();
                    }, 200);
                } else {
                    alert('Please select a reason for reporting.');
                }
            });
        });
    </script>

    <!-- Share Confirmation Modal -->
    <div class="custom-modal" id="share-modal" style="display: none;">
        <div class="modal-backdrop"></div>
        <div class="modal-box">
            <h3>Share Post</h3>
            <p>Are you sure you want to share this post to your profile?</p>
            <div class="modal-btns">
                <button class="btn-modal-cancel" id="btn-cancel-share">Cancel</button>
                <button class="btn-modal-confirm" id="btn-confirm-share">Share</button>
            </div>
        </div>
    </div>

    <!-- Report Post Modal -->
    <div class="custom-modal" id="report-modal" style="display: none;">
        <div class="modal-backdrop"></div>
        <div class="modal-box">
            <h3>Report Post</h3>
            <p>Why are you reporting this post?</p>
            <div class="report-options" style="text-align: left; margin-bottom: 20px;">
                <label style="display: block; margin-bottom: 10px; cursor: pointer;"><input type="radio" name="report-reason" value="spam"> Spam</label>
                <label style="display: block; margin-bottom: 10px; cursor: pointer;"><input type="radio" name="report-reason" value="harassment"> Harassment</label>
                <label style="display: block; margin-bottom: 10px; cursor: pointer;"><input type="radio" name="report-reason" value="inappropriate"> Inappropriate Content</label>
                <label style="display: block; margin-bottom: 10px; cursor: pointer;"><input type="radio" name="report-reason" value="other"> Other</label>
                <div class="other-reason-container" style="display: none; margin-top: 10px;">
                    <textarea id="other-reason-text" placeholder="Please specify your reason..." style="width: 100%; border: 1px solid #ddd; padding: 10px; border-radius: 8px; font-size: 0.9rem; resize: vertical;"></textarea>
                </div>
            </div>
            <div class="modal-btns">
                <button class="btn-modal-cancel" id="btn-cancel-report">Cancel</button>
                <button class="btn-modal-confirm" id="btn-submit-report">Submit Report</button>
            </div>
        </div>
    </div>
</body>
</html>
