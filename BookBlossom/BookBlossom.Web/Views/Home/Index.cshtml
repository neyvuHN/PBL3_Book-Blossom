                    } else {
                        $(this).hide();
                    }
                });

                // Sort (Placeholder logic since we don't have real dates, but we can reverse the DOM order!)
                if (sortOrder === 'oldest') {
                    $reviewsList.append($reviews.reverse());
                } else {
                    $reviewsList.append($reviews);
                }
            });

            function showErrorToast(message) {
                const $toast = $(`
                    <div class="toast-notification" style="border-left-color: #ff4444;">
                        <i class="fas fa-exclamation-circle" style="color: #ff4444;"></i>
                        <span>${message}</span>
                        <div class="toast-progress" style="background-color: #ff4444;"></div>
                    </div>
                `);
                $('body').append($toast);
                $toast.fadeIn(300);
                
                // Auto hide after 3 seconds
                setTimeout(function() {
                    $toast.fadeOut(300, function() {
                        $(this).remove();
                    });
                }, 3000);
            }

            let hasSubmittedReview = false;

            $(document).on('click', '.btn-submit-review', function() {
                // Check if user is logged in (simulated)
                const isAuthenticated = true; // Simulated
                const isBuyer = true; // Simulated
                
                if (!isAuthenticated) {
                    showErrorToast('Please log in to submit a review.');
                    return;
                }
                
                if (!isBuyer) {
                    showErrorToast('Only buyers can submit a review.');
                    return;
                }

                if (hasSubmittedReview) {
                    showErrorToast('You have already submitted a review.');
                    return;
                }

                const $card = $(this).closest('.create-post-card');
                const rating = $card.find('.star-rating i.active').length;
                const text = $card.find('textarea').val().trim();

                if (rating === 0) {
                    showErrorToast('Please select a star rating.');
                    return;
                }

                if (text === '') {
                    showErrorToast('Please enter your review content.');
                    return;
                }

                // Create Review Card
                const newReview = `
                    <div class="thread-card review-item mb-3 user-own-review" style="flex: 1 1 100%;" data-rating="${rating}">
                        <div class="thread-header">
                            <img src="/images/Avatar/avatar1.jpg" alt="Avatar" class="avatar">
                            <div class="user-info">
                                <h4>You</h4>
                                <span>Just now</span>
                            </div>
                            <div class="ms-auto">
                                <span class="text-warning">${'⭐'.repeat(rating)}</span>
                            </div>
                        </div>
                        <p class="review-text">"${text}"</p>
                        <div class="thread-footer">
                            <div class="thread-actions">
                                <button class="post-action btn-like-review" style="background: none; border: none; color: #888; display: flex; align-items: center; gap: 5px; cursor: pointer;"><i class="far fa-heart"></i> <span class="like-count">0</span></button>
                                <button class="post-action btn-comment-review" style="background: none; border: none; color: #888; display: flex; align-items: center; gap: 5px; cursor: pointer;"><i class="far fa-comment"></i> <span class="comment-count">0</span></button>
                            </div>
                            <div class="ms-auto">
                                <button class="btn-edit-review" style="background: none; border: none; color: #666; margin-right: 10px;"><i class="fas fa-edit"></i> Edit</button>
                                <button class="btn-delete-review" style="background: none; border: none; color: #ff4444;"><i class="fas fa-trash"></i> Delete</button>
                            </div>
                        </div>
                        <!-- Comment Section -->
                        <div class="comment-section" style="display: none; padding-top: 15px; border-top: 1px solid #f0f0f0; margin-top: 15px;">
                            <div class="comment-list" style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 15px;">
                                <!-- Comments will appear here -->
                            </div>
                            <div class="comment-input-area" style="display: flex; gap: 10px; align-items: center;">
                                <img src="/images/Avatar/avatar1.jpg" alt="Avatar" class="comment-avatar" style="width: 30px; height: 30px; border-radius: 50%;">
                                <input type="text" placeholder="Write a comment..." class="form-control" style="flex: 1; font-size: 0.9rem;">
                                <button class="btn-send-comment-review" style="background: none; border: none; color: #C2185B; cursor: pointer;"><i class="far fa-paper-plane"></i></button>
                            </div>
                        </div>
                    </div>
                `;

                // Show toast with undo
                showToast('Review submitted successfully!');

                // Append review
                $('.reviews-list').prepend(newReview);
                
                // Clear form
                $('#create-review-card textarea').val('');
                $('#create-review-card .star-rating i').removeClass('active');
                $('#create-review-card .rating-value').text('0/5');

                hasSubmittedReview = true;
                
                // Hide or disable the form
                $('#create-review-card').html('<h3>Your Review</h3><p>You have already submitted a review. You can edit or delete it below.</p>');
            });

            // Thread Post Submit Logic
            $(document).on('click', '.btn-submit-thread-post', function() {
                const $card = $(this).closest('#create-thread-post-card');
                const text = $card.find('textarea').val().trim();
                const $taggedBook = $card.find('.tagged-book-card');

                if (text === '' && $taggedBook.length === 0) {
                    showErrorToast('Please enter your post content or tag a book.');
                    return;
                }

                let taggedBookHtml = '';
                if ($taggedBook.length > 0) {
                    taggedBookHtml = `
                        <div class="tagged-book-card" style="margin-top: 10px; display: flex; gap: 10px; align-items: center; background: #f5f5f5; padding: 10px; border-radius: 8px;">
                            <img src="${$taggedBook.data('img')}" alt="Book" style="width: 40px; height: 60px; object-fit: cover; border-radius: 4px;">
                            <div style="flex: 1;">
                                <h4 style="font-size: 0.95rem; font-weight: 700; margin: 0;">${$taggedBook.data('title')}</h4>
                                <p style="font-size: 0.8rem; color: #666; margin: 0;">${$taggedBook.data('author')}</p>
                            </div>
                        </div>
                    `;
                }

                // Create Post Card (Simulated)
                const newPost = `
                    <div class="thread-post user-own-post">
                        <div class="post-header">
                            <img src="/images/Avatar/avatar1.jpg" alt="Avatar" class="post-avatar">
                            <div class="post-user-info">
                                <div class="user-name-badge">
                                    <span class="user-name">You</span>
                                </div>
                                <span class="post-time">Just now</span>
                            </div>
                            <div class="post-menu-btn">
                                <i class="fas fa-ellipsis-h"></i>
                                <div class="post-dropdown-menu" style="display: none;">
                                    <a href="#" class="dropdown-item btn-report-post"><i class="far fa-flag"></i> Report Post</a>
                                    <a href="#" class="dropdown-item btn-hide-post"><i class="far fa-eye-slash"></i> Hide Post</a>
                                </div>
                            </div>
                        </div>
                        <div class="post-content">
                            <p class="post-text">${text}</p>
                            ${taggedBookHtml}
                        </div>
                        <div class="post-footer">
                            <button class="post-action btn-like"><i class="far fa-heart"></i> <span class="like-count">0</span></button>
                            <button class="post-action btn-comment"><i class="far fa-comment"></i> <span class="comment-count">0</span></button>
                            <button class="post-action btn-share"><i class="far fa-share-square"></i> Share</button>
                            <div class="ms-auto" style="display: flex; gap: 10px;">
                                <button class="btn-edit-thread-post" style="background: none; border: none; color: #666; cursor: pointer;"><i class="fas fa-edit"></i> Edit</button>
                                <button class="btn-delete-thread-post" style="background: none; border: none; color: #ff4444; cursor: pointer;"><i class="fas fa-trash"></i> Delete</button>
                            </div>
                        </div>
                        <!-- Comment Section -->
                        <div class="comment-section" style="display: none;">
                            <div class="comment-list"></div>
                            <div class="comment-input-area">
                                <img src="/images/Avatar/avatar1.jpg" alt="Avatar" class="comment-avatar">
                                <input type="text" placeholder="Write a comment...">
                                <button class="btn-send-comment"><i class="far fa-paper-plane"></i></button>
                            </div>
                        </div>
                    </div>
                `;

                // Show toast
                showToast('Post created successfully!');

                // Append post (after create post card)
                $card.after(newPost);
                
                // Clear form
                $card.find('textarea').val('');
            });

            // Delete Thread Post Logic
            $(document).on('click', '.btn-delete-thread-post', function() {
                if (confirm('Are you sure you want to delete this post?')) {
                    $(this).closest('.thread-post').remove();
                }
            });

            // Edit Thread Post Logic
            $(document).on('click', '.btn-edit-thread-post', function() {
                const $post = $(this).closest('.thread-post');
                const text = $post.find('.post-text').text();
                
                // Set text to form
                $('#create-thread-post-card textarea').val(text);
                
                // Remove post
                $post.remove();
                
                // Scroll to top of thread
                document.getElementById('dedicated-community').scrollIntoView({ behavior: 'auto' });
            });

            // Delete Review Logic
            $(document).on('click', '.btn-delete-review', function() {
                if (confirm('Are you sure you want to delete your review?')) {
                    $(this).closest('.review-item').remove();
                    hasSubmittedReview = false;
                    // Restore form
                    $('.create-post-card').html(`
                        <h3>Leave a Review</h3>
                        <div class="rating-input mb-3">
                            <span class="star-rating">
                                <i class="far fa-star" data-rating="1"></i>
                                <i class="far fa-star" data-rating="2"></i>
                                <i class="far fa-star" data-rating="3"></i>
                                <i class="far fa-star" data-rating="4"></i>
                                <i class="far fa-star" data-rating="5"></i>
                            </span>
                            <span class="rating-value ms-2">0/5</span>
                        </div>
                        <textarea placeholder="Share your thoughts about BookBlossom..." class="form-control mb-3" rows="3"></textarea>
                        <button class="btn-cta btn-submit-review">Submit Review</button>
                    `);
                    
                    bindStarRatingEvents();
                }
            });

            // Edit Review Logic
            $(document).on('click', '.btn-edit-review', function() {
                const $review = $(this).closest('.review-item');
                const text = $review.find('.review-text').text().replace(/^"|"$/g, ''); // Remove quotes
                
                // Restore form with text
                $('.create-post-card').html(`
                    <h3>Edit Your Review</h3>
                    <div class="rating-input mb-3">
                        <span class="star-rating">
                            <i class="far fa-star" data-rating="1"></i>
                            <i class="far fa-star" data-rating="2"></i>
                            <i class="far fa-star" data-rating="3"></i>
                            <i class="far fa-star" data-rating="4"></i>
                            <i class="far fa-star" data-rating="5"></i>
                        </span>
                        <span class="rating-value ms-2">0/5</span>
                    </div>
                    <textarea class="form-control mb-3" rows="3">${text}</textarea>
                    <button class="btn-cta btn-submit-review">Update Review</button>
                `);
                
                // Remove the card
                $review.remove();
                hasSubmittedReview = false; // Allow submitting again
                
                bindStarRatingEvents();
            });

            // Review Like Logic
            $(document).on('click', '.btn-like-review', function() {
                const $icon = $(this).find('i');
                const $count = $(this).find('.like-count');
                let count = parseInt($count.text());
                
                if ($icon.hasClass('far')) {
                    $icon.removeClass('far').addClass('fas').css('color', '#C2185B');
                    $count.text(count + 1);
                } else {
                    $icon.removeClass('fas').addClass('far').css('color', '');
                    $count.text(count - 1);
                }
            });

            // Review Comment Toggle Logic
            $(document).on('click', '.btn-comment-review', function() {
                const $post = $(this).closest('.review-item');
                $post.find('.comment-section').slideToggle(300);
            });

            // Review Send Comment Logic
            $(document).on('click', '.btn-send-comment-review', function() {
                const $input = $(this).siblings('input');
                const text = $input.val().trim();
                
                if (text !== '') {
                    const $list = $(this).closest('.comment-section').find('.comment-list');
                    const newComment = `
                        <div class="comment-item" style="display: flex; gap: 10px; align-items: flex-start;">
                            <img src="/images/Avatar/avatar1.jpg" alt="Avatar" class="comment-avatar" style="width: 30px; height: 30px; border-radius: 50%;">
                            <div class="comment-content" style="background: #f5f5f5; padding: 8px 12px; border-radius: 12px; flex: 1;">
                                <span class="comment-user" style="font-weight: 700; font-size: 0.85rem; color: #333;">You</span>
                                <p style="font-size: 0.85rem; color: #666; margin: 2px 0;">${text}</p>
                                <span class="comment-time" style="font-size: 0.75rem; color: #999;">Just now</span>
                            </div>
                        </div>
                    `;
                    $list.append(newComment);
                    $input.val('');
                    
                    // Update comment count
                    const $post = $(this).closest('.review-item');
                    const $count = $post.find('.comment-count');
                    $count.text(parseInt($count.text()) + 1);
                }
            });

            // Tag Book Modal Logic
            $(document).on('click', '.btn-tag-book', function() {
                $('#tag-book-modal').fadeIn(200);
            });

            $('#btn-cancel-tag-book').on('click', function() {
                $('#tag-book-modal').fadeOut(200);
                // Clear inputs
                $('#tag-book-link').val('');
                $('.book-select-item').removeClass('selected');
                $('#link-error').hide();
            });

            $('.btn-modal-tab').on('click', function() {
                $('.btn-modal-tab').removeClass('active');
                $(this).addClass('active');
                
                const target = $(this).data('target');
                $('.modal-tab-content').hide();
                $('#' + target).show();
            });

            $(document).on('click', '.book-select-item', function() {
                $('.book-select-item').removeClass('selected');
                $(this).addClass('selected');
            });

            $('#btn-confirm-tag-book').on('click', function() {
                const activeTab = $('.btn-modal-tab.active').data('target');
                let selectedBook = null;

                if (activeTab === 'tab-link') {
                    const link = $('#tag-book-link').val().trim();
                    if (link === '') {
                        showErrorToast('Please enter a book link.');
                        return;
                    }
                    // Validate link (must contain bookblossom or start with /)
                    if (!link.includes('bookblossom.com') && !link.startsWith('/')) {
                        $('#link-error').show();
                        return;
                    }
                    $('#link-error').hide();
                    
                    // Simulate getting book info from link
                    selectedBook = {
                        title: 'Linked Book (From URL)',
                        author: 'Author Name',
                        img: '/images/Book/book1.jpg'
                    };
                } else {
                    const $selected = $('.book-select-item.selected');
                    if ($selected.length === 0) {
                        showErrorToast('Please select a book.');
                        return;
                    }
                    selectedBook = {
                        title: $selected.data('title'),
                        author: $selected.data('author'),
                        img: $selected.data('img')
                    };
                }

                // Tag the book to the current create post card
                const $card = $('#create-thread-post-card');
                
                // Remove existing tag if any
                $card.find('.tagged-book-card').remove();
                
                // Append tag preview
                const tagHtml = `
                    <div class="tagged-book-card" style="margin-top: 10px; display: flex; gap: 10px; align-items: center; background: #f5f5f5; padding: 10px; border-radius: 8px;" data-title="${selectedBook.title}" data-author="${selectedBook.author}" data-img="${selectedBook.img}">
                        <img src="${selectedBook.img}" alt="Book" style="width: 40px; height: 60px; object-fit: cover; border-radius: 4px;">
                        <div style="flex: 1;">
                            <h4 style="font-size: 0.95rem; font-weight: 700; margin: 0;">${selectedBook.title}</h4>
                            <p style="font-size: 0.8rem; color: #666; margin: 0;">${selectedBook.author}</p>
                        </div>
                        <button class="btn-remove-tag" style="background: none; border: none; color: #ff4444; cursor: pointer;"><i class="fas fa-times"></i></button>
                    </div>
                `;
                $card.find('textarea').after(tagHtml);

                $('#tag-book-modal').fadeOut(200);
                
                // Clear inputs
                $('#tag-book-link').val('');
                $('.book-select-item').removeClass('selected');
            });

            // Remove Tag Logic
            $(document).on('click', '.btn-remove-tag', function() {
                $(this).closest('.tagged-book-card').remove();
            });

        });
    </script>

    <!-- Share Confirmation Modal -->
    <div class="custom-modal" id="share-modal" style="display: none;">
        <div class="modal-backdrop"></div>
        <div class="modal-box">
            <h3>Share Post</h3>
            <p>Are you sure you want to share this post to your profile?</p>
            <div class="modal-btns">
                <button class="btn-modal-cancel" id="btn-cancel-share">Cancel</button>
                <button class="btn-modal-confirm" id="btn-confirm-share">Share</button>
            </div>
        </div>
    </div>

    <!-- Report Post Modal -->
    <div class="custom-modal" id="report-modal" style="display: none;">
        <div class="modal-backdrop"></div>
        <div class="modal-box">
            <h3>Report Post</h3>
            <p>Why are you reporting this post?</p>
            <div class="report-options" style="text-align: left; margin-bottom: 20px;">
                <label style="display: block; margin-bottom: 10px; cursor: pointer;"><input type="radio" name="report-reason" value="spam"> Spam</label>
                <label style="display: block; margin-bottom: 10px; cursor: pointer;"><input type="radio" name="report-reason" value="harassment"> Harassment</label>
                <label style="display: block; margin-bottom: 10px; cursor: pointer;"><input type="radio" name="report-reason" value="inappropriate"> Inappropriate Content</label>
                <label style="display: block; margin-bottom: 10px; cursor: pointer;"><input type="radio" name="report-reason" value="other"> Other</label>
                <div class="other-reason-container" style="display: none; margin-top: 10px;">
                    <textarea id="other-reason-text" placeholder="Please specify your reason..." style="width: 100%; border: 1px solid #ddd; padding: 10px; border-radius: 8px; font-size: 0.9rem; resize: vertical;"></textarea>
                </div>
            </div>
            <div class="modal-btns">
                <button class="btn-modal-cancel" id="btn-cancel-report">Cancel</button>
                <button class="btn-modal-confirm" id="btn-submit-report">Submit Report</button>
            </div>
        </div>
    </div>

    <!-- Tag Book Modal -->
    <div class="custom-modal" id="tag-book-modal" style="display: none;">
        <div class="modal-backdrop"></div>
        <div class="modal-box" style="max-width: 500px;">
            <h3>Tag a Book</h3>
            
            <div class="modal-tabs" style="display: flex; gap: 10px; margin-bottom: 15px;">
                <button class="btn-modal-tab active" data-target="tab-link">By Link</button>
                <button class="btn-modal-tab" data-target="tab-recent">Recent</button>
                <button class="btn-modal-tab" data-target="tab-wishlist">Wishlist</button>
            </div>
            
            <!-- Tab Link -->
            <div id="tab-link" class="modal-tab-content">
                <p>Enter the link to the book page on BookBlossom:</p>
                <input type="text" id="tag-book-link" class="form-control mb-3" placeholder="https://bookblossom.com/book/123">
                <div id="link-error" style="color: #ff4444; font-size: 0.85rem; display: none;">Link must be from BookBlossom domain (contains 'bookblossom.com' or starts with '/').</div>
            </div>
            
            <!-- Tab Recent -->
            <div id="tab-recent" class="modal-tab-content" style="display: none;">
                <p>Select a recently viewed book:</p>
                <div class="book-select-list" style="max-height: 200px; overflow-y: auto;">
                    <div class="book-select-item" data-title="The Secret Garden" data-author="Frances Hodgson Burnett" data-img="/images/Book/book1.jpg">
                        <img src="/images/Book/book1.jpg" alt="Book">
                        <div>
                            <h4>The Secret Garden</h4>
                            <p>Frances Hodgson Burnett</p>
                        </div>
                    </div>
                    <div class="book-select-item" data-title="Think and Grow Rich" data-author="Napoleon Hill" data-img="/images/Book/book1.jpg">
                        <img src="/images/Book/book1.jpg" alt="Book">
                        <div>
                            <h4>Think and Grow Rich</h4>
                            <p>Napoleon Hill</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Tab Wishlist -->
            <div id="tab-wishlist" class="modal-tab-content" style="display: none;">
                <p>Select a book from your wishlist:</p>
                <div class="book-select-list" style="max-height: 200px; overflow-y: auto;">
                    <div class="book-select-item" data-title="Atomic Habits" data-author="James Clear" data-img="/images/Book/book1.jpg">
                        <img src="/images/Book/book1.jpg" alt="Book">
                        <div>
                            <h4>Atomic Habits</h4>
                            <p>James Clear</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="modal-btns mt-3">
                <button class="btn-modal-cancel" id="btn-cancel-tag-book">Cancel</button>
                <button class="btn-modal-confirm" id="btn-confirm-tag-book">Tag Book</button>
            </div>
        </div>
    </div>

</body>
</html>
