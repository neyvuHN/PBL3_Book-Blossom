            // Arrow navigation for Blind Date main image gallery
            $(document).on('click', '.blind-gallery-prev', function(e) {
                e.stopPropagation(); // Prevent triggering parent actions
                
                const $thumbs = $('.blind-thumb-wrapper');
                let currentIndex = -1;
                const mainSrc = $('#blind-detail-main-img').attr('src');
                
                $thumbs.each(function(index) {
                    const thumbSrc = $(this).find('img').attr('src');
                    if (mainSrc === thumbSrc) {
                        currentIndex = index;
                    }
                });
                
                if (currentIndex !== -1) {
                    let prevIndex = currentIndex - 1;
                    if (prevIndex < 0) prevIndex = $thumbs.length - 1;
                    $thumbs.eq(prevIndex).trigger('click');
                }
            });

            $(document).on('click', '.blind-gallery-next', function(e) {
                e.stopPropagation(); // Prevent triggering parent actions
                
                const $thumbs = $('.blind-thumb-wrapper');
                let currentIndex = -1;
                const mainSrc = $('#blind-detail-main-img').attr('src');
                
                $thumbs.each(function(index) {
                    const thumbSrc = $(this).find('img').attr('src');
                    if (mainSrc === thumbSrc) {
                        currentIndex = index;
                    }
                });
                
                if (currentIndex !== -1) {
                    let nextIndex = currentIndex + 1;
                    if (nextIndex >= $thumbs.length) nextIndex = 0;
                    $thumbs.eq(nextIndex).trigger('click');
                }
