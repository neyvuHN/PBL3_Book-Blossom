            let isDragging = false;
            let startX, startY;
            let currentX, currentY;
            
            function updateCards() {
                $cards.each(function(index) {
                    const $card = $(this);
                    if (index < currentCardIndex) {
                        $card.css('opacity', '0');
                        $card.css('pointer-events', 'none');
                    } else if (index === currentCardIndex) {
                        $card.css('transform', 'translateX(0) translateY(0) rotate(0)');
                        $card.css('opacity', '1');
                        $card.css('z-index', '3');
                        $card.css('pointer-events', 'auto');
                    } else if (index === currentCardIndex + 1) {
                        $card.css('transform', 'translateX(0) translateY(15px) scale(0.95)');
                        $card.css('opacity', '0.8');
                        $card.css('z-index', '2');
                        $card.css('pointer-events', 'none');
                    } else if (index === currentCardIndex + 2) {
                        $card.css('transform', 'translateX(0) translateY(30px) scale(0.9)');
                        $card.css('opacity', '0.5');
                        $card.css('z-index', '1');
                        $card.css('pointer-events', 'none');
                    } else {
                        $card.css('transform', 'translateX(0) translateY(45px) scale(0.85)');
                        $card.css('opacity', '0');
                        $card.css('z-index', '0');
                        $card.css('pointer-events', 'none');
                    }
                });
            }
            
            function swipe(direction) {
                if (currentCardIndex >= $cards.length) return;
                
                const $card = $cards.eq(currentCardIndex);
                $card.css('transition', 'transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.5s');
                
                switch(direction) {
                    case 'right':
                        $card.css('transform', 'translateX(200%) rotate(30deg)');
                        console.log("Liked -> Saved to Wishlist");
                        break;
                    case 'left':
                        $card.css('transform', 'translateX(-200%) rotate(-30deg)');
                        console.log("Disliked -> Hidden");
                        break;
                    case 'up':
                        $card.css('transform', 'translateY(-200%) scale(1.1)');
                        console.log("Super Liked -> Added to Cart");
                        break;
                    case 'down':
                        $card.css('transform', 'translateY(200%)');
                        console.log("Skipped");
                        break;
                }
                
                $card.css('opacity', '0');
                currentCardIndex++;
                setTimeout(updateCards, 300);
            }
            
