        <div class="container">
            <!-- Search Bar -->
            <div class="search-container">
                <input type="text" placeholder="Search books, authors, genres..." class="search-input">
                <button class="search-btn"><i class="fas fa-search"></i></button>
            </div>

            <!-- Categories / Tags -->
            <div class="category-tags">
                <span class="tag active">All</span>
                <span class="tag">Fiction</span>
                <span class="tag">Skills</span>
                <span class="tag">Economics</span>
                <span class="tag">Psychology</span>
                <span class="tag">History</span>
            </div>

            <!-- Book Grid -->
            <div class="book-grid">
                <!-- 8 Books -->
                <div class="book-card">
                    <img src="/images/Book/book1.jpg" alt="Book 1">
                    <div class="book-info">
                        <h3>How to Win Friends</h3>
                        <p>Dale Carnegie</p>
                        <div class="book-meta">
                            <span class="rating">⭐ 4.8</span>
                            <span class="price">Free</span>
                        </div>
                    </div>
                </div>
                <div class="book-card">
                    <img src="/images/Book/book1.jpg" alt="Book 2">
                    <div class="book-info">
                        <h3>The Alchemist</h3>
                        <p>Paulo Coelho</p>
                        <div class="book-meta">
                            <span class="rating">⭐ 4.7</span>
                            <span class="price">Free</span>
                        </div>
                    </div>
                </div>
                <div class="book-card">
                    <img src="/images/Book/book1.jpg" alt="Book 3">
                    <div class="book-info">
                        <h3>Think and Grow Rich</h3>
                        <p>Napoleon Hill</p>
                        <div class="book-meta">
                            <span class="rating">⭐ 4.5</span>
                            <span class="price">Free</span>
                        </div>
                    </div>
                </div>
                <div class="book-card">
                    <img src="/images/Book/book1.jpg" alt="Book 4">
                    <div class="book-info">
                        <h3>The 7 Habits</h3>
                        <p>Stephen R. Covey</p>
                        <div class="book-meta">
                            <span class="rating">⭐ 4.6</span>
                            <span class="price">Free</span>
                        </div>
                    </div>
                </div>
                <div class="book-card">
                    <img src="/images/Book/book1.jpg" alt="Book 5">
                    <div class="book-info">
                        <h3>Atomic Habits</h3>
                        <p>James Clear</p>
                        <div class="book-meta">
                            <span class="rating">⭐ 4.9</span>
                            <span class="price">Free</span>
                        </div>
                    </div>
                </div>
                <div class="book-card">
                    <img src="/images/Book/book1.jpg" alt="Book 6">
                    <div class="book-info">
                        <h3>The Power of Now</h3>
                        <p>Eckhart Tolle</p>
                        <div class="book-meta">
                            <span class="rating">⭐ 4.4</span>
                            <span class="price">Free</span>
                        </div>
                    </div>
                </div>
                <div class="book-card">
                    <img src="/images/Book/book1.jpg" alt="Book 7">
                    <div class="book-info">
                        <h3>Zero to One</h3>
                        <p>Peter Thiel</p>
                        <div class="book-meta">
                            <span class="rating">⭐ 4.6</span>
                            <span class="price">Free</span>
                        </div>
                    </div>
                </div>
                <div class="book-card">
                    <img src="/images/Book/book1.jpg" alt="Book 8">
                    <div class="book-info">
                        <h3>Good to Great</h3>
                        <p>Jim Collins</p>
                        <div class="book-meta">
                            <span class="rating">⭐ 4.7</span>
                            <span class="price">Free</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Dedicated Community Section (Hidden by default) -->
    <section id="dedicated-community" class="explore-section" style="display: none;">
        <div class="container">
            <h2 class="text-center mb-5">Full Community Reviews</h2>
            <div class="book-grid"> <!-- Reusing book-grid for masonry-like layout or just grid -->
                <!-- 6 Reviews -->
                <div class="testimonial-card">
                    <img src="/images/Avatar/avatar1.jpg" alt="User Avatar" class="avatar">
                    <p>"BookBlossom helped me find friends with the same reading interests and share great books. Highly recommended!"</p>
                    <span>- Minh Thu</span>
                </div>
                <div class="testimonial-card">
                    <img src="/images/Avatar/avatar1.jpg" alt="User Avatar" class="avatar">
                    <p>"The Tindbook feature is super fun! I found 3 great books in just a few minutes of swiping."</p>
                    <span>- Hoang Nam</span>
                </div>
                <div class="testimonial-card">
                    <img src="/images/Avatar/avatar1.jpg" alt="User Avatar" class="avatar">
                    <p>"I love the clean interface and the community discussions. It's my go-to site for book recommendations."</p>
                    <span>- Elena Smith</span>
                </div>
                <div class="testimonial-card">
                    <img src="/images/Avatar/avatar1.jpg" alt="User Avatar" class="avatar">
                    <p>"Great platform! I've read more books this year than ever before thanks to the challenges here."</p>
                    <span>- David Lee</span>
                </div>
                <div class="testimonial-card">
                    <img src="/images/Avatar/avatar1.jpg" alt="User Avatar" class="avatar">
                    <p>"A wonderful place for bibliophiles. The UI is just gorgeous."</p>
                    <span>- Sophia Chen</span>
                </div>
                <div class="testimonial-card">
                    <img src="/images/Avatar/avatar1.jpg" alt="User Avatar" class="avatar">
                    <p>"I've discovered so many indie authors through BookBlossom. Thank you!"</p>
                    <span>- Alex Turner</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="premium-footer">
        <div class="container">
            <p>&copy; 2026 BookBlossom. All rights reserved.</p>
            <p>Developed by <a href="#">PBL3 Team</a></p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function() {
            const $navHome = $('#nav-home');
            const $navExplore = $('#nav-explore');
            const $navTindbook = $('#nav-tindbook');
            const $navCommunity = $('#nav-community');
            const $navLogo = $('#nav-logo');
            const $mainContent = $('#main-content');
            const $exploreSection = $('#explore-section');
            const $dedicatedCommunity = $('#dedicated-community');
            const $mainNavbar = $('#main-navbar');
            const $navLinks = $('.nav-links a');

            function setActiveTab($element) {
                $navLinks.removeClass('active');
                $element.addClass('active');
            }

            function showHome() {
                $mainContent.show();
                $exploreSection.hide();
                $dedicatedCommunity.hide();
                $mainNavbar.removeClass('navbar-light');
                setActiveTab($navHome);
            }

            function showExplore() {
                $mainContent.hide();
                $exploreSection.show();
                $dedicatedCommunity.hide();
                $mainNavbar.addClass('navbar-light');
                setActiveTab($navExplore);
            }

            function showDedicatedCommunity() {
                $mainContent.hide();
                $exploreSection.hide();
                $dedicatedCommunity.show();
                $mainNavbar.addClass('navbar-light');
                setActiveTab($navCommunity);
            }

            $navExplore.on('click', function(e) {
                e.preventDefault();
                showExplore();
            });

            $navHome.on('click', function(e) {
                e.preventDefault();
                showHome();
            });

            $navLogo.on('click', function(e) {
                e.preventDefault();
                showHome();
            });

            $navTindbook.on('click', function(e) {
                e.preventDefault();
                if ($exploreSection.is(':visible') || $dedicatedCommunity.is(':visible')) {
                    showHome();
                }
                $('html, body').animate({
                    scrollTop: $('#tindbook').offset().top - 80
                }, 500);
                setActiveTab($navTindbook);
            });

            $navCommunity.on('click', function(e) {
                e.preventDefault();
                showDedicatedCommunity();
            });

            // Slider logic
            function setupSlider(sliderId) {
                const $track = $(`#${sliderId} .slider-track`);
                const $prev = $(`#${sliderId} .slider-btn.prev`);
                const $next = $(`#${sliderId} .slider-btn.next`);
                
                $next.on('click', function() {
                    $track.animate({
                        scrollLeft: $track.scrollLeft() + $track.width() * 0.8
                    }, 500);
                });
                
                $prev.on('click', function() {
                    $track.animate({
                        scrollLeft: $track.scrollLeft() - $track.width() * 0.8
                    }, 500);
                });
            }
            
            setupSlider('featured-slider');
            setupSlider('community-slider');

            // See More buttons
            $('#see-more-books').on('click', function(e) {
                e.preventDefault();
                showExplore();
            });

            $('#cta-explore').on('click', function(e) {
                e.preventDefault();
                $('html, body').animate({
                    scrollTop: $('#featured').offset().top - 80
                }, 500);
            });

            $('a[href="#tindbook"].btn-cta').on('click', function(e) {
                e.preventDefault();
                $('html, body').animate({
                    scrollTop: $('#tindbook').offset().top - 80
                }, 500);
            });

            $('#see-more-community').on('click', function(e) {
                e.preventDefault();
                showDedicatedCommunity();
            });

            // Handle category tags click
            $('.category-tags .tag').on('click', function() {
                $('.category-tags .tag').removeClass('active');
                $(this).addClass('active');
            });
        });
    </script>
</body>
</html>
