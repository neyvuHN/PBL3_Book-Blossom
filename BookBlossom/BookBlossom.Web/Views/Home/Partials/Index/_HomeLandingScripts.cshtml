<script>
    $(document).ready(function () {
        // Hero carousel autoplay
        try {
            const heroCarouselEl = document.getElementById('heroCarousel');

            if (heroCarouselEl) {
                const carouselInstance = bootstrap.Carousel.getOrCreateInstance(heroCarouselEl, {
                    interval: 3500,
                    ride: 'carousel',
                    pause: false
                });

                carouselInstance.cycle();
            }
        } catch (err) {
            console.error('Hero carousel init failed:', err);
        }

        // Smooth scroll helper
        function scrollToSection(sectionId) {
            const target = document.getElementById(sectionId);

            if (!target) return;

            const offset = 80;
            const top = target.getBoundingClientRect().top + window.pageYOffset - offset;

            window.scrollTo({
                top: top,
                behavior: 'smooth'
            });
        }

        // Hero CTA: scroll inside Home
        $(document).on('click', 'a[href^="#"]', function (e) {
            const href = $(this).attr('href');

            if (!href || href === '#') return;

            const sectionId = href.substring(1);
            const target = document.getElementById(sectionId);

            if (!target) return;

            e.preventDefault();

            try {
                const heroCarouselEl = document.getElementById('heroCarousel');
                if (heroCarouselEl) {
                    const carouselInstance = bootstrap.Carousel.getOrCreateInstance(heroCarouselEl);
                    carouselInstance.pause();
                }
            } catch (err) {
                console.warn('Could not pause carousel:', err);
            }

            scrollToSection(sectionId);
        });

        // Fallback for old Blind Date CTA if href is still "#"
        $('#cta-blind-date').on('click', function (e) {
            const href = $(this).attr('href');

            if (href === '#') {
                e.preventDefault();
                scrollToSection('blind-date-promo');
            }
        });

        // Horizontal sliders
        function setupSlider(sliderId) {
            const $track = $(`#${sliderId} .slider-track`);
            const $prev = $(`#${sliderId} .slider-btn.prev`);
            const $next = $(`#${sliderId} .slider-btn.next`);

            if (!$track.length) return;

            $next.on('click', function () {
                $track.animate({
                    scrollLeft: $track.scrollLeft() + $track.width() * 0.8
                }, 500);
            });

            $prev.on('click', function () {
                $track.animate({
                    scrollLeft: $track.scrollLeft() - $track.width() * 0.8
                }, 500);
            });
        }

        setupSlider('featured-slider');
        setupSlider('thread-slider');
        setupSlider('community-slider');

        // Buttons that go to real feature pages
        $('#see-more-books').on('click', function (e) {
            e.preventDefault();
            window.location.href = '/Explore';
        });

        $('#btn-try-tindbook').on('click', function (e) {
            e.preventDefault();
            window.location.href = '/Tindbook';
        });

        $('#see-more-thread').on('click', function (e) {
            e.preventDefault();
            window.location.href = '/Community';
        });

        $('#btn-try-blind-date').on('click', function (e) {
            e.preventDefault();
            window.location.href = '/BlindDate';
        });

        $('#see-more-community').on('click', function (e) {
            e.preventDefault();
            window.location.href = '/Reviews';
        });

        // Featured book card on Home -> product detail on Explore page
        $(document).on('click', '#featured .book-card', function () {
            const title = $(this).find('h3').text().trim();

            if (title) {
                window.location.href = `/Explore#book-details-${encodeURIComponent(title)}`;
            } else {
                window.location.href = '/Explore';
            }
        });

        // Testimonial card -> Reviews page
        $(document).on('click', '#community .testimonial-card', function () {
            window.location.href = '/Reviews';
        });

        // Fetch Featured Books
        function loadFeaturedBooks() {
            $.ajax({
                url: '/api/realbook/featured?count=10',
                type: 'GET',
                success: function (books) {
                    const track = $('#featured-books-track');
                    track.empty();
                    
                    if (books && books.length > 0) {
                        books.forEach(book => {
                            const imageUrl = (book.imageUrls && book.imageUrls.length > 0) ? book.imageUrls[0] : '/images/Book/book1.jpg';
                            const title = book.title || 'Unknown Title';
                            const author = book.authors || book.publisher || 'Unknown';
                            
                            const cardHtml = `
                                <div class="book-card" data-title="${title}">
                                    <img src="${imageUrl}" alt="${title}">
                                    <div class="book-info">
                                        <h3>${title}</h3>
                                        <p>${author}</p>
                                    </div>
                                </div>
                            `;
                            track.append(cardHtml);
                        });
                    } else {
                        track.append('<p>No featured books available at the moment.</p>');
                    }
                },
                error: function (err) {
                    console.error('Failed to load featured books:', err);
                }
            });
        }

        // Fetch Real Community Reviews
        function loadCommunityReviews() {
            $.ajax({
                url: '/api/Review',
                type: 'GET',
                success: function (reviews) {
                    const track = $('#community-slider .slider-track');
                    
                    if (reviews && reviews.length > 0) {
                        track.empty();
                        reviews.forEach(review => {
                            const avatarUrl = review.customerAvatar || '/images/Avatar/default-avatar.png';
                            const name = review.customerName || 'Anonymous';
                            const content = review.content || '';
                            
                            const isLong = content.length > 120;
                            const displayContent = isLong ? content.substring(0, 120) + '...' : content;
                            
                            const $card = $('<div class="testimonial-card"></div>');
                            $card.append(`<img src="${avatarUrl}" alt="User Avatar" class="avatar">`);
                            
                            const $p = $('<p class="review-text"></p>').text(`"${displayContent}"`);
                            $p.data('fullcontent', content);
                            
                            if (isLong) {
                                $p.append(' ');
                                $p.append($('<a href="#" class="see-more-btn" style="color: #C2185B; font-weight: 600; text-decoration: none; margin-left: 5px;">See More</a>'));
                            }
                            
                            $card.append($p);
                            $card.append(`<span>- ${name}</span>`);
                            track.append($card);
                        });
                    }
                },
                error: function (err) {
                    console.error('Failed to load community reviews:', err);
                }
            });
        }

        // See More / See Less Toggle Handlers
        $(document).on('click', '#community .see-more-btn', function (e) {
            e.preventDefault();
            e.stopPropagation();
            const $p = $(this).parent();
            const fullContent = $p.data('fullcontent');
            $p.text(`"${fullContent}"`).append(' ').append($('<a href="#" class="see-less-btn" style="color: #C2185B; font-weight: 600; text-decoration: none; margin-left: 5px;">See Less</a>'));
        });

        $(document).on('click', '#community .see-less-btn', function (e) {
            e.preventDefault();
            e.stopPropagation();
            const $p = $(this).parent();
            const fullContent = $p.data('fullcontent');
            const truncated = fullContent.substring(0, 120) + '...';
            $p.text(`"${truncated}"`).append(' ').append($('<a href="#" class="see-more-btn" style="color: #C2185B; font-weight: 600; text-decoration: none; margin-left: 5px;">See More</a>'));
        });

        // Call them immediately
        loadFeaturedBooks();
        loadCommunityReviews();
    });
</script>