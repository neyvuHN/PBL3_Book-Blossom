                            <div class="view-overlay">
                                <i class="fas fa-eye"></i>
                            </div>
                        </div>
                        <div class="blind-card-body">
                            <div class="card-hashtags">#Literary #FamilySaga #ComingOfAge</div>
                            <p class="card-desc">Three generations of women navigate secrets in a small town...</p>
                            <div class="card-status">
                                <span class="verified-badge"><i class="fas fa-leaf"></i> Verified Shop</span>
                                <span class="card-price">100.000 VNĐ</span>
                            </div>
                            <div class="card-condition">Condition: Well Loved</div>
                        </div>
                    </div>

                    <!-- Card 4 -->
                    <div class="blind-card">
                        <div class="blind-card-image">
                            <img src="/images/BlindDateBook/BlindBook4.jpg">
                            <div class="view-overlay">
                                <i class="fas fa-eye"></i>
                            </div>
                        </div>
                        <div class="blind-card-body">
                            <div class="card-hashtags">#SlowBurn #EnemiesToLovers #Paris</div>
                            <p class="card-desc">A baker and a grumpy food critic clash in the City of Light...</p>
                            <div class="card-status">
                                <span class="verified-badge"><i class="fas fa-leaf"></i> Verified Shop</span>
                                <span class="card-price">120.000 VNĐ</span>
                            </div>
                            <div class="card-condition">Condition: Well Loved - Has character</div>
                        </div>
                    </div>

                    <!-- Card 5 -->
                    <div class="blind-card">
                        <div class="blind-card-image">
                            <img src="/images/BlindDateBook/BlindBook5.jpg">
                            <div class="view-overlay">
                                <i class="fas fa-eye"></i>
                            </div>
                        </div>
                        <div class="blind-card-body">
                            <div class="card-hashtags">#SpaceOpera #AI #FirstContact</div>
                            <p class="card-desc">A pilot discovers an ancient alien artifact on a distant moon...</p>
                            <div class="card-status">
                                <span class="verified-badge"><i class="fas fa-leaf"></i> Verified Shop</span>
                                <span class="card-price">150.000 VNĐ</span>
                            </div>
                            <div class="card-condition">Condition: Gift-ready</div>
                        </div>
                    </div>

                    <!-- Card 6 -->
                    <div class="blind-card">
                        <div class="blind-card-image">
                            <img src="/images/BlindDateBook/BlindBook2.jpg">
                            <div class="view-overlay">
                                <i class="fas fa-eye"></i>
                            </div>
                        </div>
                        <div class="blind-card-body">
                            <div class="card-hashtags">#Literary #FamilySaga #ComingOfAge</div>
                            <p class="card-desc">Three generations of women navigate secrets in a small town...</p>
                            <div class="card-status">
                                <span class="verified-badge"><i class="fas fa-leaf"></i> Verified Shop</span>
                                <span class="card-price">100.000 VNĐ</span>
                            </div>
                            <div class="card-condition">Condition: Well Loved</div>
                        </div>
                    </div>
                </div>
            </main>
        </div>

        <!-- Toggle Button for Mobile/Control -->
        <button class="btn-toggle-matchmaker" id="btn-toggle-matchmaker">
            <i class="fas fa-filter"></i>
        </button>
    </section>
