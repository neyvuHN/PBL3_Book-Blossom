@using BookBlossom.Infrastructure.Data
@using System.Security.Claims
@inject ApplicationDbContext DbContext

@{
    string currentUsername = User.Identity?.Name ?? "Jane Doe";
    string currentAvatar = "/images/Avatar/default.jpg";

    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var userIdStr = User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (long.TryParse(userIdStr, out long userId))
        {
            var currentUser = DbContext.Users.Find(userId);
            if (currentUser != null)
            {
                currentUsername = currentUser.UserName ?? currentUsername;
                currentAvatar = string.IsNullOrEmpty(currentUser.Avatar) ? "/images/Avatar/default.jpg" : currentUser.Avatar;
            }
        }
    }
}

<!-- Premium Navbar -->
    <nav class="premium-navbar" id="main-navbar">
        <a class="nav-logo" href="/" id="nav-logo">
            <span class="flower">🌸</span> BookBlossom
        </a>
        <ul class="nav-links">
            <li><a href="/" id="nav-home" class="active">Home</a></li>
            <li><a href="/Explore" id="nav-explore">Explore</a></li>
            <li><a href="/Tindbook" id="nav-tindbook">Tindbook</a></li>
            <li><a href="/Community" id="nav-community">Thread</a></li>
            <li><a href="/BlindDate" id="nav-blind-date">Blind Date Books</a></li>
            <li><a href="/Reviews" id="nav-reviews">Reviews</a></li>
        </ul>
        <div class="nav-actions">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <a href="/Cart" class="nav-icon-btn nav-cart-btn" id="nav-cart-btn">
                    <i class="fas fa-shopping-cart"></i> Cart
                    <span class="cart-badge" id="cart-badge" style="display: none;">0</span>
                </a>
                <div class="notification-container">
                    <a href="#" class="nav-icon-btn notification-btn" id="notification-bell">
                        <i class="fas fa-bell"></i>
                        <span class="notification-dot" id="notification-dot" style="display: none;"></span>
                    </a>
                    <div class="notification-dropdown" id="notification-dropdown">
                        <!-- Dynamic content rendered by MVC View -->
                    </div>
                </div>
                <div class="user-dropdown">
                    <img src="@currentAvatar" alt="Avatar" class="avatar">
                    <span class="username">@currentUsername</span>
                    <i class="fas fa-chevron-down"></i>
                    <div class="dropdown-menu">
                        <a href="/Profile" class="dropdown-item"><i class="far fa-user-circle"></i> My Account</a>
                        <a href="/Orders" class="dropdown-item"><i class="fas fa-shopping-bag"></i> My Orders</a>
                        <a href="/Wishlist" class="dropdown-item"><i class="far fa-heart"></i> My Wishlist</a>
                        <a href="/Messages" class="dropdown-item"><i class="far fa-comment"></i> Messages</a>
                        <a href="/Settings" class="dropdown-item"><i class="fas fa-cog"></i> Settings</a>
                        <a href="/Help" class="dropdown-item"><i class="far fa-question-circle"></i> User Manual</a>
                        <a href="/Auth/Logout" class="dropdown-item btn-logout"><i class="fas fa-sign-out-alt"></i> Log Out</a>
                    </div>
                </div>
            }
            else
            {
                <a href="/Auth/Login" class="btn-login">Login</a>
                <a href="/Auth/Register" class="btn-register">Register</a>
            }
        </div>
    </nav>
