<!-- Main Content Wrapper (Homepage) -->
    <div id="main-content">
        <!-- Hero Section with Slider -->
        <div id="heroCarousel" class="carousel slide carousel-fade hero-carousel" data-bs-ride="carousel" data-bs-interval="3500" data-bs-pause="false">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="3" aria-label="Slide 4"></button>
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="4" aria-label="Slide 5"></button>
            </div>
            <div class="carousel-inner">
                <div class="carousel-item active" style="background-image: url('/images/Homepage/homepage1.jpg')">
                    <div class="carousel-overlay">
                        <div class="carousel-caption">
                            <h1>Welcome to BookBlossom</h1>
                            <p>Where book lovers connect and spread knowledge.</p>
                            <a href="#featured" class="btn-cta">Explore Now</a>
                        </div>
                    </div>
                </div>
                <div class="carousel-item" style="background-image: url('/images/Homepage/homepage2.jpg')">
                    <div class="carousel-overlay">
                        <div class="carousel-caption">
                            <h1>Find Your Soulmate Book</h1>
                            <p>Use Tindbook to find the perfect book for you.</p>
                            <a href="#tindbook" class="btn-cta">Try Tindbook</a>
                        </div>
                    </div>
                </div>
                <div class="carousel-item" style="background-image: url('/images/Homepage/homepage4.jpg')">
                    <div class="carousel-overlay">
                        <div class="carousel-caption">
                            <h1>Join the Conversation</h1>
                            <p>Share your thoughts and connect with other book lovers on Threads.</p>
                            <a href="#thread-preview" id="cta-thread" class="btn-cta">Go to Threads</a>
                        </div>
                    </div>
                </div>
                <div class="carousel-item" style="background-image: url('/images/Homepage/homepage5.jpg')">
                    <div class="carousel-overlay">
                        <div class="carousel-caption">
                            <h1>Blind Date with a Book</h1>
                            <p>Don't judge a book by its cover. Discover your next favorite read!</p>
                            <a href="#blind-date-promo" id="cta-blind-date" class="btn-cta">Explore Now</a>
                        </div>
                    </div>
                </div>
                <div class="carousel-item" style="background-image: url('/images/Homepage/homepage3.jpg')">
                    <div class="carousel-overlay">
                        <div class="carousel-caption">
                            <h1>Join the Community</h1>
                            <p>Share your thoughts and discuss with other book lovers.</p>
                            <a href="#community" id="cta-join-community" class="btn-cta">Join Now</a>
                        </div>
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>

        <!-- Featured Books Section -->
        <section id="featured" class="featured-books">
            <div class="container">
                <h2>Featured Books</h2>
                <div class="slider-container" id="featured-slider">
                    <button class="slider-btn prev"><i class="fas fa-chevron-left"></i></button>
                    <div class="slider-track" id="featured-books-track">
                        <!-- Books will be injected here via JavaScript -->
                    </div>
                    <button class="slider-btn next"><i class="fas fa-chevron-right"></i></button>
                </div>
                <div class="see-more-container">
                    <button id="see-more-books" class="btn-see-more">See More Books</button>
                </div>
            </div>
        </section>

        <!-- Tindbook Section -->
        <section id="tindbook" class="tindbook-section" style="background-image: url('/images/tindbook.jpg')">
            <div class="tindbook-overlay">
                <div class="tindbook-content">
                    <h2>Tindbook</h2>
                    <p>Don't know what to read next? Let Tindbook help you. Swipe right to save, swipe left to skip. Finding your soulmate book has never been this easy!</p>
                    <a href="#" id="btn-try-tindbook" class="btn-cta">Try It Now</a>
                </div>
            </div>
        </section>

        <!-- Thread Section -->
        <section id="thread-preview" class="community-section" style="background: #fff;">
            <div class="container">
                <h2>Community Threads</h2>
                <div class="slider-container" id="thread-slider">
                    <button class="slider-btn prev"><i class="fas fa-chevron-left"></i></button>
                    <div class="slider-track">
                        @if (ViewBag.RandomThreads != null)
                        {
                            var randomThreads = ViewBag.RandomThreads as IEnumerable<BookBlossom.Core.DTOs.Thread.ThreadPostDTO>;
                            if (randomThreads != null)
                            {
                                foreach (var thread in randomThreads)
                                {
                                    <div class="thread-card" onclick="window.location.href='/Community?postId=@thread.PostID'" style="cursor: pointer;">
                                        <div class="thread-header">
                                            <img src="@(string.IsNullOrEmpty(thread.CustomerAvatar) ? "/images/Avatar/default-avatar.png" : thread.CustomerAvatar)" alt="Avatar" class="avatar blurred-content">
                                            <div class="user-info">
                                                <h4 class="blurred-content">@thread.CustomerName</h4>
                                                <span>@thread.CreatedAt.ToString("MMM dd, yyyy")</span>
                                            </div>
                                        </div>
                                        <h3>@thread.Title</h3>
                                        <p class="blurred-content" style="user-select: none;">
                                            @(string.IsNullOrEmpty(thread.Content) ? "" : (thread.Content.Length > 100 ? thread.Content.Substring(0, 100) + "..." : thread.Content))
                                        </p>
                                        <div class="thread-footer">
                                            <span class="blurred-content">#@(string.IsNullOrEmpty(thread.Hashtags) ? "General" : thread.Hashtags.Split(',').FirstOrDefault())</span>
                                            <div class="thread-actions">
                                                <span><i class="far fa-heart"></i> @thread.LikeCount</span>
                                                <span><i class="far fa-comment"></i> @thread.CommentsCount</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        }
                    </div>
                    <button class="slider-btn next"><i class="fas fa-chevron-right"></i></button>
                </div>
                <div class="see-more-container">
                    <button id="see-more-thread" class="btn-see-more">Go to Threads</button>
                </div>
            </div>
        </section>

         <!-- Blind Date Book Promo Section -->
        <section id="blind-date-promo" class="blind-date-promo-section" style="background-image: url('/images/BlindDateBook/BlindBook.jpg')">
            <div class="blind-date-promo-overlay">
                <div class="blind-date-promo-content">
                    <h2>Blind Date with a Book</h2>
                    <p>Unbox a mystery read based on vibe, not cover. Let fate decide your next favorite story. No spoilers, just pure bookish excitement!</p>
                    <a href="#" id="btn-try-blind-date" class="btn-cta">Explore Mystery</a>
                </div>
            </div>
        </section>

        <!-- Community Section -->
        <section id="community" class="community-section">
            <div class="container">
                <h2>What the BookBlossom Community Says?</h2>
                <div class="slider-container" id="community-slider">
                    <button class="slider-btn prev"><i class="fas fa-chevron-left"></i></button>
                    <div class="slider-track">
                        <!-- 4 Reviews -->
                        <div class="testimonial-card">
                            <img src="/images/Avatar/avatar1.jpg" alt="User Avatar" class="avatar">
                            <p>"BookBlossom helped me find friends with the same reading interests and share great books. Highly recommended!"</p>
                            <span>- Minh Thu</span>
                        </div>
                        <div class="testimonial-card">
                            <img src="/images/Avatar/avatar1.jpg" alt="User Avatar" class="avatar">
                            <p>"The Tindbook feature is super fun! I found 3 great books in just a few minutes of swiping."</p>
                            <span>- Hoang Nam</span>
                        </div>
                        <div class="testimonial-card">
                            <img src="/images/Avatar/avatar1.jpg" alt="User Avatar" class="avatar">
                            <p>"I love the clean interface and the community discussions. It's my go-to site for book recommendations."</p>
                            <span>- Elena Smith</span>
                        </div>
                        <div class="testimonial-card">
                            <img src="/images/Avatar/avatar1.jpg" alt="User Avatar" class="avatar">
                            <p>"Great platform! I've read more books this year than ever before thanks to the challenges here."</p>
                            <span>- David Lee</span>
                        </div>
                    </div>
                    <button class="slider-btn next"><i class="fas fa-chevron-right"></i></button>
                </div>
                <div class="see-more-container">
                    <button id="see-more-community" class="btn-see-more">See All Reviews</button>
                </div>
            </div>
        </section>
    </div>
