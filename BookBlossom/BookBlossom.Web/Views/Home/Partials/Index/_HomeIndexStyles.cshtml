        /* Secure Flipbook Read Preview Modal Styles */
        .preview-modal-container {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: 10000;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            user-select: none;
            -webkit-user-select: none;
            -ms-user-select: none;
            -moz-user-select: none;
        }
        .preview-modal-backdrop {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(10, 10, 10, 0.94);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            z-index: 1;
        }
        .preview-modal-content {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 100vw;
            height: 100vh;
            max-width: 100vw;
            max-height: 100vh;
        }
        .preview-modal-close {
            position: fixed;
            top: 25px;
            right: 25px;
            z-index: 10010;
            background: rgba(255, 255, 255, 0.1);
            border: none;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            backdrop-filter: blur(5px);
        }
        .preview-modal-close:hover {
            background: rgba(255, 77, 77, 0.25);
            transform: rotate(90deg) scale(1.08);
            color: #ff4d4d;
        }
        /* Flipbook 3D Container */
        .flipbook-container {
            position: absolute;
            top: 0;
            left: 0;
            transform: scale(1);
            width: 840px;
            height: 560px;
            perspective: 2000px;
            box-shadow: 0 30px 60px rgba(0,0,0,0.5);
            border-radius: 8px;
            background: rgba(0,0,0,0.2);
            transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            transform-origin: top left;
        }
        /* Scroll area that contains the zoom wrapper and enables scrolls */
        .flipbook-scroll-area {
            width: 100%;
            height: 100%;
            overflow: auto;
            display: flex;
            /* Note: We rely purely on child 'margin: auto' for centering. */
            /* This avoids the flexbox 'justify-content: center' scroll cutoff bug on overflow */
            box-sizing: border-box;
            padding: 100px 40px; /* Space for fixed controls and close button */
            scroll-behavior: smooth;
        }
        /* Webkit scrollbar customization - invisible by default, fades in on scroll/swipe */
        .flipbook-scroll-area::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        .flipbook-scroll-area::-webkit-scrollbar-track {
            background: transparent;
        }
        .flipbook-scroll-area::-webkit-scrollbar-thumb {
            background: transparent;
            border-radius: 4px;
            transition: background 0.3s ease;
        }
        /* Active scrolling triggers the scrollbar thumb visual display */
        .flipbook-scroll-area.is-scrolling::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.28) !important;
        }
        .flipbook-scroll-area.is-scrolling::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.5) !important;
        }
        /* Zoom wrapper that scales in the layout flow to trigger parent scrollbars */
        #flipbook-zoom-wrapper {
            position: relative;
            box-sizing: border-box;
            flex-shrink: 0;
            margin: auto; /* Centering helper for flexbox scrolling */
            transition: width 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94), height 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }
        /* Cover center shadow line to make book spine 3D */
        .flipbook-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 50%;
            width: 12px;
            height: 100%;
            background: linear-gradient(to right, 
                rgba(0,0,0,0.25) 0%, 
                rgba(0,0,0,0) 40%, 
                rgba(0,0,0,0) 60%, 
                rgba(0,0,0,0.25) 100%
            );
            z-index: 100;
            pointer-events: none;
            transform: translateX(-50%);
        }
        .flipbook-sheet {
            position: absolute;
            width: 50%;
            height: 100%;
            top: 0;
            right: 0;
            transform-origin: left center;
            transform-style: preserve-3d;
            transition: transform 0.8s cubic-bezier(0.645, 0.045, 0.355, 1);
            z-index: 1;
        }
        .flipbook-sheet.flipped {
            transform: rotateY(-180deg);
        }
        .flipbook-side {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
            background: #fff;
            box-shadow: inset 3px 0 20px rgba(0,0,0,0.1), 0 5px 15px rgba(0,0,0,0.15);
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .flipbook-front {
            z-index: 2;
            transform: rotateY(0deg);
            border-radius: 0 8px 8px 0;
        }
        .flipbook-back {
            transform: rotateY(180deg);
            border-radius: 8px 0 0 8px;
            box-shadow: inset -3px 0 20px rgba(0,0,0,0.1), 0 5px 15px rgba(0,0,0,0.15);
