@using BookBlossom.Infrastructure.Data
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext


@{
    string defaultName = "John Doe";
    string defaultPhone = "0987654321";
    string defaultAddress = "Phường Bến Nghé, Quận 1, Hồ Chí Minh";

    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var userIdStr = User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (long.TryParse(userIdStr, out long userId))
        {
            var user = DbContext.Users.Find(userId);
            if (user != null)
            {
                defaultName = $"{user.LastName} {user.FirstName}".Trim();
                if (string.IsNullOrEmpty(defaultName)) defaultName = user.UserName;
                defaultPhone = user.PhoneNumber ?? defaultPhone;
            }

            var delAddress = DbContext.DeliveryAddresses
                .Where(da => da.CustomerID == userId)
                .OrderByDescending(da => da.IsDefault)
                .ThenByDescending(da => da.AddressID)
                .FirstOrDefault();

            if (delAddress != null)
            {
                defaultName = delAddress.ReceiverName;
                defaultPhone = delAddress.PhoneNumber;
                defaultAddress = delAddress.DetailAddress;
            }
        }
    }
}

<!-- Shipping Address Editor Modal -->
    <div id="address-modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(17, 17, 17, 0.7); z-index: 10000; align-items: center; justify-content: center; backdrop-filter: blur(5px);">
        <div id="address-modal-content" style="background: #fff; border-radius: 20px; width: 90%; max-width: 500px; box-shadow: 0 20px 50px rgba(0,0,0,0.25); display: flex; flex-direction: column; transform: scale(0.95); opacity: 0; transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);">
            <!-- Header -->
            <div style="padding: 20px 25px; border-bottom: 1px solid #f0f0f0; display: flex; justify-content: space-between; align-items: center;">
                <h3 style="margin: 0; font-family: 'Lora', serif; font-size: 1.3rem; font-weight: 700; color: #111;">Change Shipping Address</h3>
                <button id="btn-close-address" style="background: none; border: none; font-size: 1.3rem; color: #888; cursor: pointer; transition: color 0.2s;"><i class="fas fa-times"></i></button>
            </div>
            
            <!-- Body -->
            <div style="padding: 25px; display: flex; flex-direction: column; gap: 20px;">
                <div class="form-group">
                    <label style="display: block; font-size: 0.85rem; font-weight: 700; color: #555; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">Delivery Address</label>
                    <textarea id="address-input-text" style="width: 100%; padding: 12px 15px; border: 1px solid #ddd; border-radius: 8px; font-family: 'Inter', sans-serif; font-size: 0.95rem; resize: vertical; min-height: 80px; transition: border-color 0.2s;" placeholder="Enter your full shipping address...">@defaultAddress</textarea>
                </div>
                <div class="form-group">
                    <label style="display: block; font-size: 0.85rem; font-weight: 700; color: #555; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">Receiver Name</label>
                    <input type="text" id="address-input-name" style="width: 100%; padding: 12px 15px; border: 1px solid #ddd; border-radius: 8px; font-family: 'Inter', sans-serif; font-size: 0.95rem; transition: border-color 0.2s;" value="@defaultName">
                </div>
                <div class="form-group">
                    <label style="display: block; font-size: 0.85rem; font-weight: 700; color: #555; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">Phone Number</label>
                    <input type="tel" id="address-input-phone" style="width: 100%; padding: 12px 15px; border: 1px solid #ddd; border-radius: 8px; font-family: 'Inter', sans-serif; font-size: 0.95rem; transition: border-color 0.2s;" value="@defaultPhone">
                </div>
            </div>

            <!-- Footer -->
            <div style="padding: 20px 25px; border-top: 1px solid #f0f0f0; display: flex; justify-content: flex-end; gap: 12px; border-radius: 0 0 20px 20px; background: #fafafa;">
                <button id="btn-cancel-address" style="background: transparent; color: #555; border: 1.5px solid #ddd; padding: 10px 20px; border-radius: 30px; font-size: 0.95rem; font-weight: 700; cursor: pointer; transition: all 0.2s;">
                    Cancel
                </button>
                <button id="btn-save-address" style="background: linear-gradient(135deg, #C2185B 0%, #f07c7c 100%); color: #fff; border: none; padding: 10px 25px; border-radius: 30px; font-size: 0.95rem; font-weight: 700; cursor: pointer; transition: all 0.3s; box-shadow: 0 4px 12px rgba(194, 24, 91, 0.2);">
                    Save Changes
                </button>
            </div>
        </div>
    </div>


<!-- Checkout Modal Flow -->
    <!-- 1. Checkout Form Modal -->
    <div id="checkout-modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(17, 17, 17, 0.7); z-index: 9999; align-items: center; justify-content: center; backdrop-filter: blur(5px);">
        <div id="checkout-modal-content" style="background: #fff; border-radius: 20px; width: 95%; max-width: 850px; max-height: 90vh; overflow-y: auto; box-shadow: 0 20px 50px rgba(0,0,0,0.25); display: flex; flex-direction: column; transform: scale(0.95); opacity: 0; transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);">
            <!-- Header -->
            <div style="padding: 20px 30px; border-bottom: 1px solid #f0f0f0; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; background: rgba(255,255,255,0.95); backdrop-filter: blur(10px); z-index: 10;">
                <h3 style="margin: 0; font-family: 'Lora', serif; font-size: 1.5rem; font-weight: 700; color: #111;">Secure Checkout</h3>
                <button id="btn-close-checkout" style="background: none; border: none; font-size: 1.5rem; color: #888; cursor: pointer; transition: color 0.2s;"><i class="fas fa-times"></i></button>
            </div>
            
            <!-- Body -->
            <div style="padding: 30px; display: flex; flex-direction: column; gap: 30px;">
                <!-- Book Info -->
                <div id="checkout-book-info-container" style="display: flex; gap: 20px; align-items: center; background: #faf8f5; padding: 20px; border-radius: 12px; border: 1px solid #f2ede4;">
                    <img id="checkout-book-img" src="/images/Book/book4.jpg" style="width: 80px; height: 120px; object-fit: cover; border-radius: 6px; box-shadow: 0 4px 10px rgba(0,0,0,0.1);" alt="Book Cover">
                    <div style="flex-grow: 1;">
                        <h4 id="checkout-book-title" style="margin: 0 0 5px; font-size: 1.2rem; font-weight: 700; color: #333;">Harry Potter and the Sorcerer's Stone</h4>
                        <p id="checkout-book-author" style="margin: 0 0 10px; font-size: 0.9rem; color: #666;">J.K. Rowling</p>
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: 0.95rem; color: #555;">Quantity: <strong id="checkout-book-qty">1</strong></span>
                            <span id="checkout-book-price" style="font-size: 1.25rem; font-weight: 700; color: #C2185B;">297,000 VND</span>
                        </div>
                    </div>
                </div>

                <!-- Shipping Details -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <div class="form-group" style="grid-column: 1 / -1;">
                        <label style="display: block; font-size: 0.85rem; font-weight: 700; color: #555; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">Delivery Address</label>
                        <textarea id="checkout-address" style="width: 100%; padding: 12px 15px; border: 1px solid #ddd; border-radius: 8px; font-family: 'Inter', sans-serif; font-size: 0.95rem; resize: vertical; min-height: 80px; transition: border-color 0.2s;" placeholder="Enter your full address...">@defaultAddress</textarea>
                    </div>
                    <div class="form-group">
                        <label style="display: block; font-size: 0.85rem; font-weight: 700; color: #555; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">Receiver Name</label>
                        <input type="text" id="checkout-name" style="width: 100%; padding: 12px 15px; border: 1px solid #ddd; border-radius: 8px; font-family: 'Inter', sans-serif; font-size: 0.95rem; transition: border-color 0.2s;" value="@defaultName">
                    </div>
                    <div class="form-group">
                        <label style="display: block; font-size: 0.85rem; font-weight: 700; color: #555; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">Phone Number <span style="color: #999; font-size: 0.75rem; text-transform: none;">(Editable for shipper)</span></label>
                        <input type="tel" id="checkout-phone" style="width: 100%; padding: 12px 15px; border: 1px solid #ddd; border-radius: 8px; font-family: 'Inter', sans-serif; font-size: 0.95rem; transition: border-color 0.2s;" value="@defaultPhone">
                    </div>
                </div>

                <!-- [UPDATED] Order Note for buyer to leave instructions to the shop -->
                <div class="form-group">
                    <label for="checkout-order-note" style="display: block; font-size: 0.85rem; font-weight: 700; color: #555; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">
                        Order Note <span style="color: #999; font-size: 0.75rem; text-transform: none; font-weight: 400;">(Optional – leave instructions for the shop)</span>
                    </label>
                    <textarea id="checkout-order-note"
                              style="width: 100%; padding: 12px 15px; border: 1px solid #ddd; border-radius: 8px; font-family: 'Inter', sans-serif; font-size: 0.95rem; resize: vertical; min-height: 80px; transition: border-color 0.2s; color: #333; line-height: 1.5;"
                              placeholder="E.g. Please wrap carefully, gift wrap preferred, leave at door, specific edition needed..."></textarea>
                </div>

                <!-- Payment Method -->
                <div>
                    <label style="display: block; font-size: 0.85rem; font-weight: 700; color: #555; margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.5px;">Payment Method</label>
                    <div style="display: flex; gap: 15px;">
                        <!-- VNPay -->
                        <div class="payment-method-card active" data-method="vnpay" style="flex: 1; border: 2px solid #C2185B; border-radius: 12px; padding: 15px; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 10px; background: #fffafb; transition: all 0.2s;">
                            <img src="https://vnpay.vn/s1/statics.vnpay.vn/2023/6/0oxhzjmxbksr1686814746087.png" style="height: 30px; object-fit: contain;" alt="VNPay">
                            <span style="font-weight: 700; color: #333; font-size: 0.95rem;">VNPay</span>
                        </div>
                        <!-- COD -->
                        <div class="payment-method-card" id="pm-cod" data-method="cod" style="flex: 1; border: 1px solid #ddd; border-radius: 12px; padding: 15px; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 10px; background: #fff; transition: all 0.2s; position: relative; overflow: hidden;">
                            <i class="fas fa-truck-fast" style="font-size: 1.8rem; color: #555;"></i>
                            <span style="font-weight: 700; color: #333; font-size: 0.95rem;">Cash on Delivery</span>
                            <!-- Reputation overlay if score < 60 -->
                            <div id="cod-disabled-overlay" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255,255,255,0.8); display: flex; flex-direction: column; align-items: center; justify-content: center; backdrop-filter: blur(2px);">
                                <i class="fas fa-lock" style="color: #e74c3c; margin-bottom: 5px;"></i>
                                <span style="font-size: 0.75rem; color: #e74c3c; font-weight: 700; text-align: center; padding: 0 10px;">Reputation &lt; 60<br>COD Disabled</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Order Summary -->
                <div>
                    <label style="display: block; font-size: 0.85rem; font-weight: 700; color: #555; margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.5px;">Order Summary</label>
                    <div style="background: #faf8f5; border: 1px solid #f2ede4; border-radius: 12px; padding: 20px;">
                        <!-- Applied Vouchers List -->
                        <div id="checkout-applied-vouchers-container" style="margin-bottom: 20px; display: none;">
                            <div style="font-size: 0.85rem; font-weight: 700; color: #555; display: block; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">Applied Vouchers</div>
                            <div id="checkout-vouchers-list" style="display: flex; flex-wrap: wrap; gap: 8px;">
                                <!-- Badges dynamically added here -->
                            </div>
                        </div>

                        <div style="display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 0.95rem; color: #555;">
                            <span>Subtotal</span>
                            <span id="checkout-subtotal">297,000 VND</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 0.95rem; color: #555;">
                            <span>Shipping Fee</span>
                            <span id="checkout-shipping-fee">30,000 VND</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 15px; font-size: 0.95rem; color: #C2185B;">
                            <span>Voucher Discount</span>
                            <span id="checkout-voucher-discount">-0 VND</span>
                        </div>
                        
                        <div style="border-top: 1px dashed #ddd; padding-top: 15px; display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-weight: 700; color: #111; font-size: 1.05rem;">Total</span>
                            <span id="checkout-summary-total" style="font-weight: 700; color: #C2185B; font-size: 1.3rem;">327,000 VND</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div style="padding: 20px 30px; border-top: 1px solid #f0f0f0; display: flex; justify-content: space-between; align-items: center; position: sticky; bottom: 0; background: #fff; z-index: 10; border-radius: 0 0 20px 20px;">
                <div style="display: flex; flex-direction: column;">
                    <span style="font-size: 0.85rem; color: #666;">Total Payment</span>
                    <span id="checkout-total-price" style="font-size: 1.4rem; font-weight: 700; color: #C2185B;">297,000 VND</span>
                </div>
                <button id="btn-confirm-checkout" style="background: linear-gradient(135deg, #C2185B 0%, #f07c7c 100%); color: #fff; border: none; padding: 12px 30px; border-radius: 30px; font-size: 1.1rem; font-weight: 700; cursor: pointer; transition: all 0.3s; box-shadow: 0 6px 20px rgba(194, 24, 91, 0.3);">
                    Confirm & Pay
                </button>
            </div>
        </div>
    </div>

    <!-- 2. Loading Screen (VNPay Redirect) -->
    <div id="vnpay-loading-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #fff; z-index: 10000; align-items: center; justify-content: center; flex-direction: column; text-align: center;">
        <div style="width: 80px; height: 80px; border: 4px solid #f3f3f3; border-top: 4px solid #C2185B; border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 30px;"></div>
        <h2 style="font-family: 'Lora', serif; color: #111; margin-bottom: 10px;">Redirecting to VNPay payment gateway...</h2>
        <p style="color: #666; font-size: 1.1rem;">Please do not close your browser.</p>
        <style>@@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }</style>
    </div>

    <!-- 3. VNPay Return / Status Verification Screen -->
    <div id="vnpay-return-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #fff; z-index: 10000; align-items: center; justify-content: center; flex-direction: column; text-align: center;">
        <div class="pulse-ring" style="width: 100px; height: 100px; background: #e3f2fd; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 30px; animation: pulse 2s infinite;">
            <i class="fas fa-shield-halved" style="font-size: 2.5rem; color: #1976d2;"></i>
        </div>
        <h2 style="font-family: 'Lora', serif; color: #111; margin-bottom: 10px;">Verifying payment...</h2>
        <p style="color: #666; font-size: 1.1rem;">Please wait a moment.</p>
        <style>@@keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(33, 150, 243, 0.4); } 70% { box-shadow: 0 0 0 20px rgba(33, 150, 243, 0); } 100% { box-shadow: 0 0 0 0 rgba(33, 150, 243, 0); } }</style>
    </div>

    <!-- 4. Payment Success Screen -->
    <div id="payment-success-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(17, 17, 17, 0.8); z-index: 10000; align-items: center; justify-content: center; backdrop-filter: blur(8px);">
        <div style="background: #fff; border-radius: 20px; width: 90%; max-width: 500px; padding: 40px; text-align: center; box-shadow: 0 20px 50px rgba(0,0,0,0.25); animation: bounce-in 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);">
            <div style="width: 80px; height: 80px; background: #dcfce7; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 25px;">
                <i class="fas fa-check" style="font-size: 2.5rem; color: #166534;"></i>
            </div>
            <h2 style="font-family: 'Lora', serif; color: #111; margin-bottom: 20px;">Payment successful!</h2>
            
            <div style="background: #f8fafc; border-radius: 12px; padding: 20px; text-align: left; margin-bottom: 30px; border: 1px solid #e2e8f0;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                    <span style="color: #64748b;">Order ID:</span>
                    <strong style="color: #0f172a;">#BB12345</strong>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                    <span style="color: #64748b;">Amount:</span>
                    <strong id="payment-success-amount" style="color: #C2185B;">250,000 VND</strong>
                </div>
                <div style="display: flex; justify-content: space-between;">
                    <span style="color: #64748b;">Status:</span>
                    <strong style="color: #166534;">Paid, waiting for confirmation</strong>
                </div>
            </div>

            <div style="display: flex; gap: 15px; flex-direction: column;">
                <button class="btn-view-order" style="background: #111; color: #fff; border: none; padding: 12px; border-radius: 30px; font-weight: 700; font-size: 1.05rem; cursor: pointer; transition: all 0.2s;">View Order</button>
                <button class="btn-continue-shopping" style="background: #fff; color: #111; border: 1.5px solid #111; padding: 12px; border-radius: 30px; font-weight: 700; font-size: 1.05rem; cursor: pointer; transition: all 0.2s;">Continue Shopping</button>
            </div>
        </div>
    </div>

    <!-- 5. Payment Failed Screen -->
    <div id="payment-failed-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(17, 17, 17, 0.8); z-index: 10000; align-items: center; justify-content: center; backdrop-filter: blur(8px);">
        <div style="background: #fff; border-radius: 20px; width: 90%; max-width: 500px; padding: 40px; text-align: center; box-shadow: 0 20px 50px rgba(0,0,0,0.25); animation: shake 0.5s ease-in-out;">
            <div style="width: 80px; height: 80px; background: #fee2e2; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 25px;">
                <i class="fas fa-times" style="font-size: 2.5rem; color: #991b1b;"></i>
            </div>
            <h2 style="font-family: 'Lora', serif; color: #111; margin-bottom: 15px;">Payment failed</h2>
            <p style="color: #64748b; margin-bottom: 30px; line-height: 1.6;">Your order has not been recorded as paid. Please try again or choose another payment method.</p>
            
            <div style="display: flex; gap: 10px; flex-direction: column;">
                <button class="btn-retry-payment" style="background: #C2185B; color: #fff; border: none; padding: 12px; border-radius: 30px; font-weight: 700; font-size: 1.05rem; cursor: pointer; transition: all 0.2s;">Retry Payment</button>
                <button class="btn-change-method" style="background: #f1f5f9; color: #334155; border: none; padding: 12px; border-radius: 30px; font-weight: 700; font-size: 1.05rem; cursor: pointer; transition: all 0.2s;">Change Payment Method</button>
                <button class="btn-cancel-order" style="background: transparent; color: #94a3b8; border: none; padding: 12px; font-weight: 600; font-size: 0.95rem; cursor: pointer;">Cancel Order</button>
            </div>
        </div>
        <style>
            @@keyframes bounce-in { 0% { transform: scale(0.8); opacity: 0; } 80% { transform: scale(1.05); opacity: 1; } 100% { transform: scale(1); opacity: 1; } }
            @@keyframes shake { 0%, 100% { transform: translateX(0); } 20%, 60% { transform: translateX(-10px); } 40%, 80% { transform: translateX(10px); } }
        </style>
    </div>
