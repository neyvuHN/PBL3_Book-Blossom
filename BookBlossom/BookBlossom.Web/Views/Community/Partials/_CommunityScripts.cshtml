<script>
    $(document).ready(function () {
        function showToast(message, onUndo, undoText = 'Undo') {
            const $toast = $(`
                <div class="toast-notification">
                    <i class="fas fa-check-circle" style="color: #28a745;"></i>
                    <span>${message}</span>
                    <button class="btn-undo-share" style="${onUndo ? '' : 'display: none;'} background: none; border: none; color: #C2185B; font-weight: bold; cursor: pointer; text-decoration: underline; margin-left: 10px; font-size: 0.85rem; padding: 0;">${undoText}</button>
                    <div class="toast-progress"></div>
                </div>
            `);

            $('body').append($toast);
            $toast.fadeIn(300);

            const timeoutId = setTimeout(function () {
                $toast.fadeOut(300, function () {
                    $(this).remove();
                });
            }, 5000);

            $toast.find('.btn-undo-share').on('click', function () {
                clearTimeout(timeoutId);
                $toast.fadeOut(200, function () {
                    $(this).remove();

                    if (typeof onUndo === 'function') {
                        onUndo();
                    }
                });
            });
        }

        function showErrorToast(message) {
            const $toast = $(`
                <div class="toast-notification" style="border-left-color: #ff4444;">
                    <i class="fas fa-exclamation-circle" style="color: #ff4444;"></i>
                    <span>${message}</span>
                    <div class="toast-progress" style="background-color: #ff4444;"></div>
                </div>
            `);

            $('body').append($toast);
            $toast.fadeIn(300);

            setTimeout(function () {
                $toast.fadeOut(300, function () {
                    $(this).remove();
                });
            }, 3000);
        }

        // Load Thread Feed dynamically from C# API
        async function loadThreadFeed() {
            try {
                const posts = await window.apiClient.apiGet('/api/Thread/feed?page=1&pageSize=20');
                if (Array.isArray(posts)) {
                    // Remove static posts except the create-post-card
                    $('.thread-post').remove();
                    
                    if (posts.length === 0) {
                        $('.thread-main').append(`
                            <div class="thread-post" style="text-align: center; padding: 40px; color: #888;">
                                <i class="fas fa-comments" style="font-size: 3rem; color: #ccc; margin-bottom: 12px;"></i>
                                <p style="margin: 0; font-size: 1.1rem;">No community posts available yet.</p>
                                <p style="margin: 4px 0 0 0; font-size: 0.9rem;">Be the first to create a post above!</p>
                            </div>
                        `);
                        return;
                    }

                    posts.forEach(post => {
                        let imagesHtml = '';
                        if (post.images && post.images.length > 0) {
                            imagesHtml = post.images.map(img => `
                                <img src="${img.imagePath}" alt="Post Image" style="max-width:100%; border-radius:8px; margin-top:10px; max-height:300px; object-fit:cover;" />
                            `).join('');
                        }

                        const currentUserId = localStorage.getItem('userId');
                        const isOwner = currentUserId && parseInt(currentUserId) === post.customerID;
                        
                        const postHtml = `
                            <div class="thread-post" data-post-id="${post.postID}">
                                <div class="hidden-post-overlay" style="display: none;">
                                    <span>Post hidden.</span>
                                    <button class="btn-undo-hide">Undo</button>
                                    <div class="hide-progress"></div>
                                </div>

                                <div class="post-header">
                                    <img src="${post.customerAvatar || '/images/Avatar/avatar1.jpg'}" alt="Avatar" class="post-avatar">
                                    <div class="post-user-info">
                                        <div class="user-name-badge">
                                            <span class="user-name">${post.customerName || 'Community Member'}</span>
                                        </div>
                                        <span class="post-time">${new Date(post.createdAt).toLocaleDateString()}</span>
                                    </div>

                                    <div class="post-menu-btn" style="position:relative; cursor:pointer;">
                                        <i class="fas fa-ellipsis-h"></i>
                                        <div class="post-dropdown-menu" style="display: none;">
                                            <a href="#" class="dropdown-item btn-report-post" data-id="${post.postID}"><i class="far fa-flag"></i> Report Post</a>
                                            <a href="#" class="dropdown-item btn-hide-post"><i class="far fa-eye-slash"></i> Hide Post</a>
                                        </div>
                                    </div>
                                </div>

                                <div class="post-content">
                                    <h3 style="font-weight:700; font-size:1.15rem; color:#222; margin-bottom:8px;">${post.title}</h3>
                                    <p class="post-text" style="line-height:1.5; color:#444;">${post.content}</p>
                                    ${post.hashtags ? `<p style="color:#C2185B; font-weight:600; margin-top:8px; font-size:0.9rem;">${post.hashtags}</p>` : ''}
                                    ${imagesHtml}
                                </div>

                                <div class="post-footer">
                                    <button class="post-action btn-like"><i class="far fa-heart"></i> <span class="like-count">0</span></button>
                                    <button class="post-action btn-comment"><i class="far fa-comment"></i> <span class="comment-count">${post.commentsCount || 0}</span></button>
                                    <button class="post-action btn-share"><i class="far fa-share-square"></i> Share</button>

                                    ${isOwner ? `
                                    <div class="ms-auto" style="display: flex; gap: 10px; margin-left: auto;">
                                        <button class="btn-delete-thread-post" data-id="${post.postID}" style="background: none; border: none; color: #ff4444; cursor: pointer; display: flex; align-items: center; gap: 4px; font-size:0.9rem;">
                                            <i class="fas fa-trash"></i> Delete
                                        </button>
                                    </div>
                                    ` : ''}
                                </div>

                                <div class="comment-section" style="display: none;">
                                    <div class="comment-list" id="comments-${post.postID}"></div>
                                    <div class="comment-input-area" style="display:flex; gap:10px; align-items:center; margin-top:12px; border-t: 1px solid #eee; padding-top:10px;">
                                        <img src="/images/Avatar/avatar1.jpg" alt="Avatar" class="comment-avatar">
                                        <input type="text" placeholder="Write a comment..." class="comment-input" data-post-id="${post.postID}" style="flex:1; padding:8px 12px; border:1px solid #ddd; border-radius:20px; outline:none; font-size:0.9rem;">
                                        <button class="btn-send-comment-api" data-post-id="${post.postID}" style="background:#C2185B; border:none; color:white; width:34px; height:34px; border-radius:50%; cursor:pointer; display:flex; align-items:center; justify-content:center;"><i class="far fa-paper-plane" style="font-size:0.85rem;"></i></button>
                                    </div>
                                </div>
                            </div>
                        `;
                        
                        $('.thread-main').append(postHtml);
                    });
                }
            } catch (error) {
                console.error('Error loading threads:', error);
            }
        }

        // Toggle left sidebar
        $('#btn-toggle-sidebar').on('click', function () {
            $('#thread-left-sidebar').toggleClass('collapsed');
            $('.community-thread-container').toggleClass('sidebar-collapsed');
        });

        // Spoiler reveal
        $(document).on('click', '.btn-reveal', function () {
            const $post = $(this).closest('.thread-post');
            $post.find('.blurred-content').removeClass('blurred-content');
            $post.find('.spoiler-overlay').fadeOut(300);
        });

        // Like button
        $(document).on('click', '.btn-like', function () {
            const $icon = $(this).find('i');
            const $count = $(this).find('.like-count');
            let count = parseInt($count.text()) || 0;

            if ($icon.hasClass('far')) {
                $icon.removeClass('far').addClass('fas').css('color', '#C2185B');
                $count.text(count + 1);
            } else {
                $icon.removeClass('fas').addClass('far').css('color', '');
                $count.text(count - 1);
            }
        });

        // Toggle comments and load dynamically from backend
        $(document).on('click', '.btn-comment', async function () {
            const $post = $(this).closest('.thread-post');
            const postId = $post.attr('data-post-id');
            const $section = $post.find('.comment-section');
            
            if ($section.is(':hidden')) {
                try {
                    const postDetails = await window.apiClient.apiGet(`/api/Thread/${postId}`);
                    const $list = $post.find('.comment-list');
                    $list.empty();
                    
                    if (postDetails && postDetails.comments && postDetails.comments.length > 0) {
                        postDetails.comments.forEach(c => {
                            const cHtml = `
                                <div class="comment-item" style="display:flex; gap:10px; margin-bottom:12px; align-items:flex-start;">
                                    <img src="${c.customerAvatar || '/images/Avatar/avatar1.jpg'}" alt="Avatar" class="comment-avatar">
                                    <div class="comment-content" style="background:#f3f4f6; padding:8px 12px; border-radius:12px; flex:1;">
                                        <span class="comment-user" style="font-weight:600; font-size:0.85rem; color:#111; display:block; margin-bottom:2px;">${c.customerName}</span>
                                        <p style="margin:0; font-size:0.9rem; color:#333;">${c.content}</p>
                                        <span class="comment-time" style="font-size:0.75rem; color:#888; margin-top:2px; display:block;">${new Date(c.createdAt).toLocaleDateString()}</span>
                                    </div>
                                </div>
                            `;
                            $list.append(cHtml);
                        });
                    } else {
                        $list.append('<p style="color:#888; font-size:0.9rem; padding:10px 0; text-align:center;">No comments yet. Be the first to share your thoughts!</p>');
                    }
                } catch (error) {
                    console.error('Error loading comments:', error);
                }
            }
            $section.slideToggle(300);
        });

        // Submit comment to backend API
        $(document).on('click', '.btn-send-comment-api', async function () {
            const postId = $(this).attr('data-post-id');
            const $input = $(`.comment-input[data-post-id="${postId}"]`);
            const text = $input.val().trim();

            if (text === '') return;

            try {
                await window.apiClient.apiPost(`/api/Thread/${postId}/comment`, {
                    content: text
                });
                
                $input.val('');
                showToast('Comment added successfully!');
                
                // Reload comments
                const postDetails = await window.apiClient.apiGet(`/api/Thread/${postId}`);
                const $list = $(this).closest('.comment-section').find('.comment-list');
                $list.empty();
                
                postDetails.comments.forEach(c => {
                    const cHtml = `
                        <div class="comment-item" style="display:flex; gap:10px; margin-bottom:12px; align-items:flex-start;">
                            <img src="${c.customerAvatar || '/images/Avatar/avatar1.jpg'}" alt="Avatar" class="comment-avatar">
                            <div class="comment-content" style="background:#f3f4f6; padding:8px 12px; border-radius:12px; flex:1;">
                                <span class="comment-user" style="font-weight:600; font-size:0.85rem; color:#111; display:block; margin-bottom:2px;">${c.customerName}</span>
                                <p style="margin:0; font-size:0.9rem; color:#333;">${c.content}</p>
                                <span class="comment-time" style="font-size:0.75rem; color:#888; margin-top:2px; display:block;">${new Date(c.createdAt).toLocaleDateString()}</span>
                            </div>
                        </div>
                    `;
                    $list.append(cHtml);
                });
                
                // Update comment count
                const $post = $(this).closest('.thread-post');
                $post.find('.comment-count').text(postDetails.comments.length);
            } catch (err) {
                console.error(err);
                showErrorToast(err.message || 'Failed to submit comment. Points may be below 80.');
            }
        });

        // Share modal
        $(document).on('click', '.btn-share', function () {
            $('#share-modal').fadeIn(200);
        });

        $('#btn-cancel-share').on('click', function () {
            $('#share-modal').fadeOut(200);
        });

        $('#btn-confirm-share').on('click', function () {
            $('#share-modal').fadeOut(200);
            showToast('Post shared successfully to your profile!');
        });

        // Post dropdown menu
        $(document).on('click', '.post-menu-btn', function (e) {
            e.stopPropagation();
            $('.post-dropdown-menu').not($(this).find('.post-dropdown-menu')).hide();
            $(this).find('.post-dropdown-menu').toggle();
        });

        $(document).on('click', function () {
            $('.post-dropdown-menu').hide();
        });

        // Hide post locally
        $(document).on('click', '.btn-hide-post', function (e) {
            e.preventDefault();

            const $post = $(this).closest('.thread-post');
            $post.find('.hidden-post-overlay').fadeIn(200);

            const hideTimeout = setTimeout(function () {
                $post.slideUp(300, function () {
                    $(this).remove();
                });
            }, 5000);

            $post.data('hideTimeout', hideTimeout);
        });

        $(document).on('click', '.btn-undo-hide', function () {
            const $post = $(this).closest('.thread-post');
            const hideTimeout = $post.data('hideTimeout');

            if (hideTimeout) {
                clearTimeout(hideTimeout);
            }

            $post.find('.hidden-post-overlay').fadeOut(200);
        });

        // Report post modal with real API
        let activePostIdToReport = null;
        $(document).on('click', '.btn-report-post', function (e) {
            e.preventDefault();
            activePostIdToReport = $(this).attr('data-id') || $(this).closest('.thread-post').attr('data-post-id');
            $('#report-modal').fadeIn(200);
        });

        $('#btn-cancel-report').on('click', function () {
            $('#report-modal').fadeOut(200);
            activePostIdToReport = null;
        });

        $('input[name="report-reason"]').on('change', function () {
            if ($(this).val() === 'other') {
                $('.other-reason-container').slideDown(200);
            } else {
                $('.other-reason-container').slideUp(200);
            }
        });

        $('#btn-submit-report').on('click', async function () {
            const reason = $('input[name="report-reason"]:checked').val();

            if (!reason) {
                alert('Please select a reason for reporting.');
                return;
            }

            let reasonEnum = 0; // Spam
            if (reason === 'inappropriate') {
                reasonEnum = 1; // Content18Plus
            } else if (reason === 'harassment' || reason === 'other') {
                reasonEnum = 2; // Fraud
            }

            const description = reason === 'other' ? $('#other-reason-text').val().trim() : `Báo cáo vi phạm lý do: ${reason}`;

            if (reason === 'other' && description === '') {
                alert('Please enter your reason.');
                return;
            }

            try {
                await window.apiClient.apiPost(`/api/Thread/${activePostIdToReport}/report`, {
                    reason: reasonEnum,
                    description: description
                });

                $('#report-modal').fadeOut(200);
                showToast('Thank you for reporting. The moderator will review this post.');
                
                // Clear input
                $('input[name="report-reason"]').prop('checked', false);
                $('#other-reason-text').val('');
                $('.other-reason-container').hide();
                
                // Reload feed to show updated count (or automatically hidden if reports >= 5)
                await loadThreadFeed();
            } catch (err) {
                console.error(err);
                showErrorToast(err.message || 'Failed to submit report. Please log in.');
            }
        });

        // Submit new thread post to C# Web API
        $(document).on('click', '.btn-submit-thread-post', async function () {
            const $card = $('#create-thread-post-card');
            const text = $card.find('textarea').val().trim();

            if (text === '') {
                showErrorToast('Please enter your post content.');
                return;
            }

            try {
                const formData = new FormData();
                formData.append('title', text.length > 50 ? text.substring(0, 50) + '...' : text);
                formData.append('content', text);
                formData.append('hashtags', '#BookBlossom');

                await window.apiClient.apiUpload('/api/Thread', formData);
                showToast('Post created successfully!');
                $card.find('textarea').val('');
                await loadThreadFeed();
            } catch (err) {
                console.error(err);
                showErrorToast(err.message || 'Failed to create post. Points may be below 80.');
            }
        });

        // Delete thread post permanently via API
        $(document).on('click', '.btn-delete-thread-post', async function () {
            const postId = $(this).attr('data-id');
            if (confirm("Are you sure you want to delete this post permanently?")) {
                try {
                    await window.apiClient.apiDelete(`/api/Thread/${postId}`);
                    showToast('Post deleted successfully!');
                    await loadThreadFeed();
                } catch (err) {
                    console.error(err);
                    showErrorToast(err.message || 'Failed to delete post.');
                }
            }
        });

        // Initialize feed
        loadThreadFeed();
    });
</script>