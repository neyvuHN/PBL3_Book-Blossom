<!-- Tindbook Feature Section (Hidden by default) -->
    <section id="tindbook-feature" class="explore-section tindbook-page-section">
        <div class="container">
            <h2 class="text-center mb-4" style="font-family: 'Lora', serif; font-size: 2.5rem;">Tindbook</h2>
            <p class="text-center text-muted mb-5">Swipe RIGHT to like, LEFT to hide, UP to add and DOWN to skip. Find your soulmate book now!</p>
            
            <div class="tindbook-app-container">
                <div class="tindbook-action-label"></div>
                <div class="tindbook-card-stack">
                    <div class="tindbook-hover-overlay">
                        <span>Start Swiping</span>
                    </div>
                    <!-- Book Card 1 -->
                    <div class="tindbook-card" data-book-id="1">
                        <div class="card-image">
                            <img src="/images/Book/book1.jpg" alt="Book Cover" draggable="false">
                            <div class="card-tags">
                                <span class="tag-genre">Self-Help</span>
                            </div>
                        </div>
                        <div class="card-content">
                            <div>
                                <h3>How to Win Friends</h3>
                                <p class="author">by Dale Carnegie</p>
                                <div class="rating">
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star-half-alt"></i>
                                    <span>4.8</span>
                                </div>
                            </div>
                            <p class="summary">A classic book on how to improve your human relations skills and become more influential.</p>
                        </div>
                    </div>

                    <!-- Book Card 2 -->
                    <div class="tindbook-card" data-book-id="2">
                        <div class="card-image">
                            <img src="/images/Book/book1.jpg" alt="Book Cover" draggable="false">
                            <div class="card-tags">
                                <span class="tag-genre">Fiction</span>
                            </div>
                        </div>
                        <div class="card-content">
                            <div>
                                <h3>The Alchemist</h3>
                                <p class="author">by Paulo Coelho</p>
                                <div class="rating">
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <span>5.0</span>
                                </div>
                            </div>
                            <p class="summary">A magical story about an Andalusian shepherd boy who yearns to travel in search of a worldly treasure.</p>
                        </div>
                    </div>

                    <!-- Book Card 3 -->
                    <div class="tindbook-card" data-book-id="3">
                        <div class="card-image">
                            <img src="/images/Book/book1.jpg" alt="Book Cover" draggable="false">
                            <div class="card-tags">
                                <span class="tag-genre">Psychology</span>
                            </div>
                        </div>
                        <div class="card-content">
                            <div>
                                <h3>Atomic Habits</h3>
                                <p class="author">by James Clear</p>
                                <div class="rating">
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <span>4.9</span>
                                </div>
                            </div>
                            <p class="summary">No matter your goals, Atomic Habits offers a proven framework for improving every day.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="tindbook-controls">
                <button class="control-btn btn-back" id="btn-undo">
                    <i class="fas fa-undo"></i>
                </button>
                <button class="control-btn btn-nope" id="btn-nope">
                    <i class="fas fa-times"></i>
                </button>
                <button class="control-btn btn-super" id="btn-super">
                    <i class="fas fa-star"></i>
                </button>
                <button class="control-btn btn-like" id="btn-like">
                    <i class="fas fa-heart"></i>
                </button>
                <button class="control-btn btn-skip" id="btn-skip">
                    <i class="fas fa-arrow-down"></i>
                </button>
            </div>
        </div>
    </section>
