<script>
    $(document).ready(function () {
        // State variables
        let currentCardIndex = 0;
        let $cards = $();
        let booksData = [];
        
        let isDragging = false;
        let wasDragged = false;
        let startX = 0;
        let startY = 0;
        let currentX = 0;
        let currentY = 0;

        // 1. Fetch recommendations from API and render cards
        async function loadRecommendations() {
            try {
                // Show a clean loading state in stack while loading
                $('.tindbook-card-stack').html(`
                    <div class="tindbook-loading-spinner text-center py-5" style="z-index: 10; width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; position: absolute; top: 0; left: 0; background: rgba(255,255,255,0.9); border-radius: 20px;">
                        <div class="spinner-border text-primary" role="status" style="color: #D99593 !important; width: 3rem; height: 3rem;"></div>
                        <p class="text-muted mt-3" style="font-family: 'Outfit', sans-serif; font-weight: 500;">Đang tìm các cuốn sách tri kỷ...</p>
                    </div>
                `);

                const books = await window.apiClient.apiGet('/api/Tindbook/recommendations');
                
                // Clear stack
                $('.tindbook-card-stack').empty();
                
                // Re-append the hover overlay
                $('.tindbook-card-stack').append(`
                    <div class="tindbook-hover-overlay" style="display: none;">
                        <span>Start Swiping</span>
                    </div>
                `);

                if (!books || books.length === 0) {
                    $('.tindbook-card-stack').html(`
                        <div class="tindbook-no-more text-center py-5" style="font-family: 'Lora', serif; padding: 60px 20px; width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                            <i class="fas fa-book-reader fa-3x mb-3" style="color: #D99593;"></i>
                            <h3 style="font-size: 1.6rem; font-weight: bold; color: #2c3e50; margin-bottom: 10px;">Hết gợi ý cho hôm nay!</h3>
                            <p class="text-muted mt-2" style="font-size: 14px; max-width: 320px; line-height: 1.5; margin: 0 auto;">Bạn đã quẹt hết các sách gợi ý. Hãy quay lại vào ngày mai hoặc nâng cấp tài khoản để quẹt tiếp!</p>
                        </div>
                    `);
                    $cards = $();
                    booksData = [];
                    currentCardIndex = 0;
                    return;
                }

                booksData = books;
                
                // Render the books (backwards: first element of array should be on top, so append in order)
                books.forEach((book, index) => {
                    const isBlind = book.blindBookID !== null;
                    const bookId = isBlind ? book.blindBookID : book.bookID;
                    
                    // Correct image fallbacks
                    const imgUrl = isBlind 
                        ? '/images/BlindDateBook/BlindBook.jpg' 
                        : (book.imageUrl || `/images/Book/cover_${bookId}.jpg`);
                        
                    const genreTag = book.categoryName || 'Sách Hay';
                    const priceFormatted = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(book.price);
                    const publisherText = book.publisher || 'BookBlossom Curator';
                    
                    const cardHtml = `
                        <div class="tindbook-card" data-book-id="${bookId}" data-is-blind="${isBlind}" data-array-index="${index}">
                            <div class="card-image">
                                <img src="${imgUrl}" alt="Book Cover" draggable="false" onerror="this.onerror=null; this.src='/images/Book/book1.jpg';">
                                <div class="card-tags">
                                    <span class="tag-genre">${genreTag}</span>
                                </div>
                            </div>
                            <div class="card-content">
                                <div>
                                    <h3 style="font-family: 'Lora', serif; font-weight: 700; font-size: 1.3rem; margin-bottom: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${book.title}</h3>
                                    <p class="author" style="margin-bottom: 6px;">by ${publisherText}</p>
                                    <div class="rating" style="margin-bottom: 8px;">
                                        <i class="fas fa-star" style="color: #ffc107;"></i>
                                        <i class="fas fa-star" style="color: #ffc107;"></i>
                                        <i class="fas fa-star" style="color: #ffc107;"></i>
                                        <i class="fas fa-star" style="color: #ffc107;"></i>
                                        <i class="fas fa-star" style="color: #ffc107;"></i>
                                        <span style="font-weight: 600; margin-left: 5px;">5.0</span>
                                    </div>
                                    <p class="price-tag text-primary mt-1" style="font-weight: 700; color: #D99593 !important; font-size: 1.1rem; margin-bottom: 8px;">${priceFormatted}</p>
                                </div>
                                <p class="summary" style="-webkit-line-clamp: 3; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; font-size: 13px; line-height: 1.5; color: #666; margin: 0;">${book.description || 'Chưa có mô tả chi tiết cho cuốn sách này.'}</p>
                            </div>
                        </div>
                    `;
                    $('.tindbook-card-stack').append(cardHtml);
                });

                // Update jQuery object references
                $cards = $('.tindbook-card');
                currentCardIndex = 0;
                updateCards();

                // Start overlay logic
                if (sessionStorage.getItem('tindbook_started') !== 'true') {
                    $('.tindbook-hover-overlay').show();
                } else {
                    $('.tindbook-hover-overlay').hide();
                    $('#tindbook-feature').addClass('fullscreen-focus');
                }

            } catch (error) {
                console.error("Error loading recommendations:", error);
                
                let errorHtml = `
                    <div class="tindbook-no-more text-center py-5" style="padding: 60px 20px; width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                        <i class="fas fa-exclamation-triangle fa-3x mb-3 text-warning"></i>
                        <h3 style="font-size: 1.5rem; color: #2c3e50; font-weight: 700;">Không thể tải gợi ý</h3>
                        <p class="text-muted mt-2" style="font-size: 14px;">${error.message || 'Vui lòng kiểm tra lại kết nối mạng.'}</p>
                    </div>
                `;
                
                if (error.message && error.message.includes("FREE_LIMIT_REACHED")) {
                    errorHtml = `
                        <div class="tindbook-no-more text-center py-5" style="padding: 60px 20px; width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; font-family: 'Outfit', sans-serif;">
                            <i class="fas fa-crown fa-3x mb-3" style="color: #ffb300;"></i>
                            <h3 style="font-size: 1.5rem; font-weight: bold; color: #2c3e50; margin-bottom: 10px;">Đạt giới hạn lượt quẹt!</h3>
                            <p class="text-muted mt-2" style="font-size: 14px; max-width: 320px; line-height: 1.5; margin-bottom: 20px;">Thành viên gói <strong>Free</strong> bị giới hạn 50 lượt quẹt mỗi ngày. Nâng cấp gói dịch vụ để nhận thêm đặc quyền!</p>
                            <a href="/Profile?openUpgrade=true" class="btn btn-primary px-4 py-2" style="background: linear-gradient(135deg, #ffb300, #ff8f00); border: none; border-radius: 50px; font-weight: 600; box-shadow: 0 4px 10px rgba(255, 143, 0, 0.3);">Nâng Cấp Ngay</a>
                        </div>
                    `;
                }
                
                $('.tindbook-card-stack').html(errorHtml);
                $cards = $();
                booksData = [];
                currentCardIndex = 0;
            }
        }

        // 2. CSS-based Card stack rendering logic (Kept intact!)
        function updateCards() {
            $cards.each(function (index) {
                const $card = $(this);

                if (index < currentCardIndex) {
                    $card.css({
                        opacity: '0',
                        pointerEvents: 'none'
                    });
                } else if (index === currentCardIndex) {
                    $card.css({
                        transform: 'translateX(0) translateY(0) rotate(0) scale(1)',
                        opacity: '1',
                        zIndex: '3',
                        pointerEvents: 'auto'
                    });
                } else if (index === currentCardIndex + 1) {
                    $card.css({
                        transform: 'translateX(0) translateY(15px) scale(0.95)',
                        opacity: '0.8',
                        zIndex: '2',
                        pointerEvents: 'none'
                    });
                } else if (index === currentCardIndex + 2) {
                    $card.css({
                        transform: 'translateX(0) translateY(30px) scale(0.9)',
                        opacity: '0.5',
                        zIndex: '1',
                        pointerEvents: 'none'
                    });
                } else {
                    $card.css({
                        transform: 'translateX(0) translateY(45px) scale(0.85)',
                        opacity: '0',
                        zIndex: '0',
                        pointerEvents: 'none'
                    });
                }
            });
        }

        // 3. Swipe handler calling backend API and playing transitions
        async function swipe(direction) {
            if (currentCardIndex >= $cards.length) return;

            const $card = $cards.eq(currentCardIndex);
            const isBlind = $card.attr('data-is-blind') === 'true';
            const bookId = parseInt($card.attr('data-book-id'));
            const arrayIndex = parseInt($card.attr('data-array-index'));
            const bookData = booksData[arrayIndex];

            // Map direction to SwipeIntent enum (0: Wishlist, 1: Hide, 2: AddToCart, 3: Skip)
            let intent;
            switch (direction) {
                case 'right':
                    intent = 0; // SwipeIntent.Wishlist
                    break;
                case 'left':
                    intent = 1; // SwipeIntent.Hide
                    break;
                case 'up':
                    intent = 2; // SwipeIntent.AddToCart
                    break;
                case 'down':
                    intent = 3; // SwipeIntent.Skip
                    break;
            }

            try {
                // Call swipe API first
                const res = await window.apiClient.apiPost('/api/Tindbook/swipe', {
                    bookID: isBlind ? null : bookId,
                    blindBookID: isBlind ? bookId : null,
                    intent: intent
                });

                // play animation based on swipe
                $card.css('transition', 'transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.5s');

                switch (direction) {
                    case 'right':
                        $card.css('transform', 'translateX(200%) rotate(30deg)');
                        window.apiClient.showToast(`Đã thêm "${bookData.title}" vào Wishlist!`, 'success');
                        
                        // Sync wishlist UI/store
                        if (window.BookBlossomWishlist) {
                            window.BookBlossomWishlist.getWishlistItems();
                        }
                        break;
                    case 'left':
                        $card.css('transform', 'translateX(-200%) rotate(-30deg)');
                        break;
                    case 'up':
                        $card.css('transform', 'translateY(-200%) scale(1.1)');
                        window.apiClient.showToast(`Đã thêm "${bookData.title}" vào Giỏ hàng!`, 'success');
                        
                        // Sync cart UI/store badge
                        if (window.BookBlossomCart) {
                            window.BookBlossomCart.loadCartFromServer();
                        }
                        break;
                    case 'down':
                        $card.css('transform', 'translateY(200%)');
                        break;
                }

                $card.css('opacity', '0');
                currentCardIndex++;
                setTimeout(updateCards, 300);

                // Auto reload if out of cards
                if (currentCardIndex >= $cards.length) {
                    setTimeout(loadRecommendations, 600);
                }

                if (res && res.requiresLogin) {
                    setTimeout(() => {
                        showLoginRequiredModal();
                    }, 650);
                }

            } catch (error) {
                console.error(`Swipe ${direction} action failed:`, error);
                
                // Return card to center position
                $card.css('transition', 'transform 0.3s ease-out');
                $card.css('transform', 'translateX(0) translateY(0) rotate(0)');
                
                if (error.status === 401 || (error.message && (error.message.toLowerCase().includes("chưa đăng nhập") || error.message.toLowerCase().includes("phiên đăng nhập") || error.message.toLowerCase().includes("vui lòng đăng nhập")))) {
                    showLoginRequiredModal();
                } else if (error.message && error.message.includes("giỏ hàng")) {
                    // Requires login/register for cart
                    showLoginRequiredModal();
                } else {
                    window.apiClient.showToast(error.message || "Không thể thực hiện hành động này.", "error", "Lỗi quẹt");
                }
            }
        }

        // Helper to show modern login invitation modal for Guests
        function showLoginRequiredModal() {
            let $loginModal = $('#tindbook-login-modal');
            if ($loginModal.length === 0) {
                $loginModal = $(`
                    <div id="tindbook-login-modal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered" role="document">
                            <div class="modal-content" style="border-radius: 20px; border: none; box-shadow: 0 15px 30px rgba(0,0,0,0.15); font-family: 'Outfit', sans-serif;">
                                <div class="modal-header" style="border-bottom: none; padding: 25px 25px 10px;">
                                    <h5 class="modal-title" style="font-family: 'Lora', serif; font-weight: 700; font-size: 1.5rem; color: #2c3e50;">Cần đăng nhập tài khoản</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body" style="padding: 10px 25px 25px; color: #555;">
                                    <p style="font-size: 15px; line-height: 1.6;">Tính năng thêm sách trực tiếp vào giỏ hàng từ <strong>Tindbook</strong> chỉ dành riêng cho thành viên Buyer. Hãy đăng nhập hoặc đăng ký tài khoản mới để trải nghiệm đầy đủ!</p>
                                </div>
                                <div class="modal-footer" style="border-top: none; padding: 10px 25px 25px; gap: 10px;">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="border-radius: 50px; padding: 8px 20px; font-weight: 600;">Hủy</button>
                                    <a href="/Auth/Login" class="btn btn-primary" style="background: linear-gradient(135deg, #EBBAB9, #D99593); border: none; border-radius: 50px; padding: 8px 25px; font-weight: 600; color: white; text-decoration: none; box-shadow: 0 4px 10px rgba(217, 149, 147, 0.3);">Đăng Nhập Ngay</a>
                                </div>
                            </div>
                        </div>
                    </div>
                `);
                $('body').append($loginModal);
            }
            
            const m = new bootstrap.Modal(document.getElementById('tindbook-login-modal'));
            m.show();
        }

        function closeTindbookUpgradeModal() {
            const overlay = document.getElementById('tindbook-upgrade-modal-overlay');
            const content = document.getElementById('tindbook-upgrade-modal-content');
            if (content && overlay) {
                content.style.opacity = '0';
                content.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    overlay.style.display = 'none';
                }, 300);
            }
        }

        // Show Upgrade Subscription modal when undo limit is reached
        async function showUpgradeSubscriptionModal() {
            let $upgradeModal = $('#tindbook-upgrade-modal-overlay');
            if ($upgradeModal.length === 0) {
                $upgradeModal = $(`
                    <div id="tindbook-upgrade-modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.76); z-index: 9999; align-items: center; justify-content: center; backdrop-filter: blur(8px); transition: all 0.3s ease;">
                        <div id="tindbook-upgrade-modal-content" style="background: #fff; border-radius: 24px; width: 95%; max-width: 920px; box-shadow: 0 25px 60px rgba(0, 0, 0, 0.3); display: flex; flex-direction: column; transform: scale(0.95); opacity: 0; transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1); overflow: hidden; font-family: 'Outfit', sans-serif;">
                            <!-- Header -->
                            <div style="padding: 24px 30px; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center; background: #fff;">
                                <div>
                                    <h3 style="margin: 0; font-family: 'Lora', serif; font-size: 1.6rem; font-weight: 800; color: #0f172a;">Upgrade Your Package</h3>
                                    <p style="margin: 4px 0 0; color: #64748b; font-size: 0.9rem;">Choose the perfect plan to unlock premium privileges on BookBlossom.</p>
                                </div>
                                <button id="btn-close-tindbook-upgrade" style="background: #f1f5f9; border: none; font-size: 1.1rem; color: #475569; width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s;"><i class="fas fa-times"></i></button>
                            </div>
                            
                            <!-- Body -->
                            <div id="tindbook-plans-grid" style="padding: 30px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; background: #f8fafc; max-height: 70vh; overflow-y: auto;">
                                <!-- Free Plan -->
                                <div class="sub-plan-card" data-plan-card="Free" style="background: #fff; border: 2px solid #e2e8f0; border-radius: 20px; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; transition: all 0.3s ease; position: relative;">
                                    <div>
                                        <span style="background: #f1f5f9; color: #475569; font-size: 0.75rem; font-weight: 700; padding: 4px 10px; border-radius: 20px; text-transform: uppercase;">Standard</span>
                                        <h4 style="margin: 12px 0 6px; font-family: 'Lora', serif; font-size: 1.4rem; font-weight: 750; color: #0f172a;">Free Plan</h4>
                                        <div style="margin: 15px 0 20px;">
                                            <span class="plan-price-display" style="font-size: 1.8rem; font-weight: 800; color: #0f172a;">0 VND</span>
                                            <span style="color: #64748b; font-size: 0.85rem;">/month</span>
                                        </div>
                                        <ul class="plan-benefits-list" style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; font-size: 0.88rem; color: #475569;">
                                            <li><i class="fas fa-check-circle" style="color: #10b981; margin-right: 8px;"></i> <span class="plan-thread-limit">3</span> threads / month</li>
                                            <li><i class="fas fa-check-circle" style="color: #10b981; margin-right: 8px;"></i> <span class="plan-undo-limit">2</span> Tindbook undos / day</li>
                                            <li style="color: #94a3b8; text-decoration: line-through;"><i class="fas fa-times-circle" style="margin-right: 8px;"></i> Critic Badge & sharing honors</li>
                                            <li style="color: #94a3b8; text-decoration: line-through;"><i class="fas fa-times-circle" style="margin-right: 8px;"></i> Mystic Destiny glow aura</li>
                                        </ul>
                                    </div>
                                    <button class="btn-select-tindbook-plan" data-plan="Free" style="margin-top: 30px; width: 100%; background: #f1f5f9; color: #475569; border: none; padding: 12px; border-radius: 30px; font-weight: 700; font-size: 0.95rem; cursor: pointer; transition: all 0.2s;">Activate Standard</button>
                                </div>

                                <!-- Basic Plan -->
                                <div class="sub-plan-card" data-plan-card="Basic" style="background: #fff; border: 2px solid #e2e8f0; border-radius: 20px; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; transition: all 0.3s ease; position: relative;">
                                    <div>
                                        <span style="background: #fdf2f8; color: #c2185b; font-size: 0.75rem; font-weight: 700; padding: 4px 10px; border-radius: 20px; text-transform: uppercase;">Most Popular</span>
                                        <h4 style="margin: 12px 0 6px; font-family: 'Lora', serif; font-size: 1.4rem; font-weight: 750; color: #0f172a;">Basic Plan</h4>
                                        <div style="margin: 15px 0 20px;">
                                            <span class="plan-price-display" style="font-size: 1.8rem; font-weight: 800; color: #c2185b;">50,000 VND</span>
                                            <span style="color: #64748b; font-size: 0.85rem;">/month</span>
                                        </div>
                                        <ul class="plan-benefits-list" style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; font-size: 0.88rem; color: #475569;">
                                            <li><i class="fas fa-check-circle" style="color: #10b981; margin-right: 8px;"></i> <span class="plan-thread-limit">20</span> threads / month</li>
                                            <li><i class="fas fa-check-circle" style="color: #10b981; margin-right: 8px;"></i> <span class="plan-undo-limit">5</span> Tindbook undos / day</li>
                                            <li><i class="fas fa-check-circle" style="color: #10b981; margin-right: 8px;"></i> Critic Badge & sharing honors</li>
                                            <li style="color: #94a3b8; text-decoration: line-through;"><i class="fas fa-times-circle" style="margin-right: 8px;"></i> Mystic Destiny glow aura</li>
                                        </ul>
                                    </div>
                                    <button class="btn-select-tindbook-plan select-premium" data-plan="Basic" style="margin-top: 30px; width: 100%; background: linear-gradient(135deg, #c2185b 0%, #ec4899 100%); color: #fff; border: none; padding: 12px; border-radius: 30px; font-weight: 700; font-size: 0.95rem; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 12px rgba(194, 24, 91, 0.25);">Upgrade Now</button>
                                </div>

                                <!-- Pro Plan -->
                                <div class="sub-plan-card" data-plan-card="Pro" style="background: #fff; border: 2px solid #e2e8f0; border-radius: 20px; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; transition: all 0.3s ease; position: relative;">
                                    <div>
                                        <span style="background: #f3e5f5; color: #7b1fa2; font-size: 0.75rem; font-weight: 700; padding: 4px 10px; border-radius: 20px; text-transform: uppercase;">Best Value</span>
                                        <h4 style="margin: 12px 0 6px; font-family: 'Lora', serif; font-size: 1.4rem; font-weight: 750; color: #0f172a;">Pro Plan</h4>
                                        <div style="margin: 15px 0 20px;">
                                            <span class="plan-price-display" style="font-size: 1.8rem; font-weight: 800; color: #7b1fa2;">200,000 VND</span>
                                            <span style="color: #64748b; font-size: 0.85rem;">/month</span>
                                        </div>
                                        <ul class="plan-benefits-list" style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; font-size: 0.88rem; color: #475569;">
                                            <li><i class="fas fa-check-circle" style="color: #10b981; margin-right: 8px;"></i> <span class="plan-thread-limit">Unlimited</span> monthly threads</li>
                                            <li><i class="fas fa-check-circle" style="color: #10b981; margin-right: 8px;"></i> <span class="plan-undo-limit">Unlimited</span> Tindbook undos</li>
                                            <li><i class="fas fa-check-circle" style="color: #10b981; margin-right: 8px;"></i> Sage Badge & sharing honors</li>
                                            <li><i class="fas fa-check-circle" style="color: #10b981; margin-right: 8px;"></i> Mystic Destiny glow aura active</li>
                                        </ul>
                                    </div>
                                    <button class="btn-select-tindbook-plan select-premium" data-plan="Pro" style="margin-top: 30px; width: 100%; background: linear-gradient(135deg, #7b1fa2 0%, #c084fc 100%); color: #fff; border: none; padding: 12px; border-radius: 30px; font-weight: 700; font-size: 0.95rem; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 12px rgba(123, 31, 162, 0.25);">Upgrade Now</button>
                                </div>
                            </div>
                        </div>
                    </div>
                `);
                $('body').append($upgradeModal);
                
                // Add click handler to select buttons
                $(document).on('click', '.btn-select-tindbook-plan', function () {
                    const isAuthenticated = @(User.Identity != null && User.Identity.IsAuthenticated ? "true" : "false");
                    if (!isAuthenticated) {
                        // Guest -> redirect to Login page
                        window.location.href = '/Auth/Login';
                    } else {
                        // Logged in user -> redirect to Profile page to process payment/subscribe
                        window.location.href = `/Profile?openUpgrade=true`;
                    }
                });

                // Add close handlers
                $(document).on('click', '#btn-close-tindbook-upgrade', function () {
                    closeTindbookUpgradeModal();
                });
                
                $(document).on('click', '#tindbook-upgrade-modal-overlay', function (e) {
                    if (e.target === this) {
                        closeTindbookUpgradeModal();
                    }
                });
            }
            
            // Dynamic package loading
            try {
                const packages = await window.apiClient.apiGet('/api/ServicePackage/all');
                if (packages && Array.isArray(packages)) {
                    packages.forEach(pkg => {
                        const planName = pkg.packageName;
                        const $card = $upgradeModal.find(`.sub-plan-card[data-plan-card="${planName}"]`);
                        if ($card.length) {
                            const priceFormatted = new Intl.NumberFormat('vi-VN').format(pkg.price);
                            $card.find('.plan-price-display').text(`${priceFormatted} VND`);
                            
                            const $btn = $card.find('.btn-select-tindbook-plan');
                            $btn.attr('data-package-id', pkg.packageID);
                            $btn.attr('data-price', pkg.price);
                            
                            const isUnlimitedThread = pkg.threadLimit >= 999999;
                            const isUnlimitedUndo = pkg.undoLimit >= 999999;
                            
                            $card.find('.plan-thread-limit').text(isUnlimitedThread ? 'Unlimited' : pkg.threadLimit);
                            $card.find('.plan-undo-limit').text(isUnlimitedUndo ? 'Unlimited' : pkg.undoLimit);
                        }
                    });
                }
            } catch (err) {
                console.error("Failed to load dynamic packages in Tindbook upgrade modal", err);
            }
            
            $upgradeModal.css('display', 'flex');
            void $upgradeModal[0].offsetWidth; // force reflow
            const content = document.getElementById('tindbook-upgrade-modal-content');
            content.style.opacity = '1';
            content.style.transform = 'scale(1)';
        }

        // 4. Action button triggers (nope, like, super, skip)
        $('#btn-nope').off('click').on('click', function () {
            swipe('left');
        });

        $('#btn-like').off('click').on('click', function () {
            swipe('right');
        });

        $('#btn-super').off('click').on('click', function () {
            swipe('up');
        });

        $('#btn-skip').off('click').on('click', function () {
            swipe('down');
        });

        // 5. Undo last swipe via Backend API
        $('#btn-undo').off('click').on('click', async function () {
            try {
                // Call backend undo swipe API
                await window.apiClient.apiPost('/api/Tindbook/undo');
                
                if (currentCardIndex > 0) {
                    currentCardIndex--;
                    const $card = $cards.eq(currentCardIndex);
                    
                    // Reset positions and animate back beautifully
                    $card.css('transition', 'transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.5s');
                    updateCards();
                    
                    window.apiClient.showToast("Đã hoàn tác hành động quẹt gần nhất.", "success");
                    
                    // Reload stores to sync cart/wishlist subtractions
                    if (window.BookBlossomCart) window.BookBlossomCart.loadCartFromServer();
                    if (window.BookBlossomWishlist) window.BookBlossomWishlist.getWishlistItems();
                } else {
                    window.apiClient.showToast("Không có hành động nào gần đây để hoàn tác.", "info");
                }
            } catch (error) {
                console.error("Undo failed:", error);
                
                if (error.message && (error.message.includes("lượt Hoàn tác") || error.message.includes("nâng cấp gói") || error.message.includes("hết lượt"))) {
                    showUpgradeSubscriptionModal();
                } else {
                    window.apiClient.showToast(error.message || "Không thể hoàn tác hành động.", "error", "Không thể hoàn tác");
                }
            }
        });

        // 6. Navigation overlay & click handlers
        const $hoverOverlay = $('.tindbook-hover-overlay');

        $(document).on('click', '.tindbook-hover-overlay', function () {
            $('#tindbook-feature').addClass('fullscreen-focus');
            $(this).hide();
            sessionStorage.setItem('tindbook_started', 'true');
        });

        $(document).on('click', function (e) {
            if (wasDragged || isDragging) return;
            if ($('#tindbook-feature').hasClass('fullscreen-focus')) {
                if (
                    !$(e.target).closest('.tindbook-app-container').length &&
                    !$(e.target).closest('.tindbook-controls').length &&
                    !$(e.target).closest('.tindbook-hover-overlay').length &&
                    !$(e.target).closest('.modal').length // do not close fullscreen when modal is clicked
                ) {
                    $('#tindbook-feature').removeClass('fullscreen-focus');
                    $('.tindbook-hover-overlay').show();
                    sessionStorage.removeItem('tindbook_started');
                }
            }
        });

        // 7. Click card to view real book details
        $(document).on('click', '.tindbook-card', function (e) {
            if (wasDragged || isDragging) {
                e.preventDefault();
                e.stopPropagation();
                return;
            }
            
            const target = $(e.target);
            if (target.closest('.control-btn').length || target.closest('.tindbook-hover-overlay').length) return;
            
            const cardIndex = $('.tindbook-card').index(this);
            if (cardIndex !== currentCardIndex) return;

            const isBlind = $(this).attr('data-is-blind') === 'true';
            const bookId = $(this).attr('data-book-id');
            
            if (isBlind) {
                window.location.href = `/BlindDate/Details?id=${bookId}`;
            } else {
                window.location.href = `/Explore#book-details-${bookId}`;
            }
        });

        // 8. Dynamic Touch / Mouse Drag handlers (Using Event Delegation!)
        $(document).on('mousedown touchstart', '.tindbook-card', function (e) {
            const cardIndex = $('.tindbook-card').index(this);
            if (cardIndex !== currentCardIndex) return;

            isDragging = true;
            wasDragged = false;

            const event = e.originalEvent && e.originalEvent.touches
                ? e.originalEvent.touches[0]
                : e;

            startX = event.clientX || event.pageX;
            startY = event.clientY || event.pageY;
            currentX = startX;
            currentY = startY;

            $(this).css('transition', 'none');
        });

        $(document).on('mousemove touchmove', function (e) {
            if (!isDragging) return;

            const event = e.originalEvent && e.originalEvent.touches
                ? e.originalEvent.touches[0]
                : e;

            currentX = event.clientX || event.pageX;
            currentY = event.clientY || event.pageY;

            const deltaX = currentX - startX;
            const deltaY = currentY - startY;
            const rotate = deltaX * 0.1;

            if (Math.abs(deltaX) > 10 || Math.abs(deltaY) > 10) {
                wasDragged = true;
            }

            const $card = $cards.eq(currentCardIndex);
            $card.css('transform', `translate(${deltaX}px, ${deltaY}px) rotate(${rotate}deg)`);

            const threshold = 50;
            $('.control-btn').removeClass('active');
            $('.tindbook-action-label').text('').css('opacity', '0');

            if (Math.abs(deltaX) > Math.abs(deltaY)) {
                if (deltaX > threshold) {
                    $('#btn-like').addClass('active');
                    $('.tindbook-action-label')
                        .text('Save to Wishlist')
                        .css('opacity', '1')
                        .css('color', '#4caf50');
                } else if (deltaX < -threshold) {
                    $('#btn-nope').addClass('active');
                    $('.tindbook-action-label')
                        .text('Hide book')
                        .css('opacity', '1')
                        .css('color', '#f44336');
                }
            } else {
                if (deltaY > threshold) {
                    $('#btn-skip').addClass('active');
                    $('.tindbook-action-label')
                        .text('Skip')
                        .css('opacity', '1')
                        .css('color', '#9e9e9e');
                } else if (deltaY < -threshold) {
                    $('#btn-super').addClass('active');
                    $('.tindbook-action-label')
                        .text('Add to Cart')
                        .css('opacity', '1')
                        .css('color', '#2196f3');
                }
            }
        });

        $(document).on('mouseup touchend', function () {
            if (!isDragging) return;

            isDragging = false;
            setTimeout(() => {
                wasDragged = false;
            }, 100);

            const deltaX = currentX - startX;
            const deltaY = currentY - startY;
            const threshold = 100;

            const $card = $cards.eq(currentCardIndex);
            $card.css('transition', 'transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.5s');

            $('.control-btn').removeClass('active');
            $('.tindbook-action-label').css('opacity', '0');

            if (Math.abs(deltaX) > Math.abs(deltaY)) {
                if (deltaX > threshold) {
                    swipe('right');
                } else if (deltaX < -threshold) {
                    swipe('left');
                } else {
                    updateCards();
                }
            } else {
                if (deltaY > threshold) {
                    swipe('down');
                } else if (deltaY < -threshold) {
                    swipe('up');
                } else {
                    updateCards();
                }
            }
        });

        // 9. Key handlers
        $(document).on('keydown', function (e) {
            if (!$('#tindbook-feature').hasClass('fullscreen-focus')) return;

            switch (e.key) {
                case 'ArrowRight':
                    swipe('right');
                    break;
                case 'ArrowLeft':
                    swipe('left');
                    break;
                case 'ArrowUp':
                    swipe('up');
                    break;
                case 'ArrowDown':
                    swipe('down');
                    break;
            }
        });

        // 10. Initial trigger
        loadRecommendations();
    });
</script>