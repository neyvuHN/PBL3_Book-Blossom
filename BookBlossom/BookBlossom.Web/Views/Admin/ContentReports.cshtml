@{
    ViewData["Title"] = "Content & Reports";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/content-reports.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/orders.css" asp-append-version="true" />
}

<div class="content-reports-layout" id="contentReportsLayout">
    
    <!-- Sub Sidebar -->
    <div class="sub-sidebar" id="reportsSidebar">
        <div class="sub-sidebar-header">
            <h3>Content Management</h3>
        </div>
        <div class="sub-sidebar-menu">
            <div class="menu-section-title">Moderation</div>
            <div class="sub-menu-item active" data-target="tab-moderation">
                <i class="ph ph-shield-warning"></i>
                Moderation
                <span class="badge-count" id="badgeModeration">3</span>
            </div>
            
            <div class="menu-section-title">Customer Service</div>
            <div class="sub-menu-item" data-target="tab-feedback">
                <i class="ph ph-chat-teardrop-text"></i>
                Feedback
                <span class="badge-count" id="badgeFeedback" style="background:#3B82F6;">5</span>
            </div>
            <div class="sub-menu-item" data-target="tab-returns">
                <i class="ph ph-package"></i>
                Return Claims
                <span class="badge-count" id="badgeReturns" style="background:#F59E0B;">2</span>
            </div>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="content-area" id="mainContentArea">
        <button class="toggle-sidebar-btn" id="btnToggleSidebar" title="Toggle Sidebar">
            <i class="ph ph-list"></i>
        </button>

        <!-- Moderation Tab -->
        <div class="content-tab active" id="tab-moderation">
            <div class="section-header d-flex justify-content-between align-items-center flex-wrap gap-3" style="margin-bottom: 24px;">
                <div class="section-title" style="margin-bottom: 0;">
                    <h2>Thread/Review Moderation</h2>
                    <p style="margin-bottom: 0;">Process reported content and monitor for community guideline violations.</p>
                </div>
                <div class="filter-wrapper">
                    <select id="filterReportStatus" class="form-select" style="width: 320px; border-radius: 20px; height: 42px; font-size: 0.9rem; border-color: #e2e8f0; background-color: #f8fafc; cursor: pointer; padding: 0 16px; font-weight: 500; color: #4B5563;">
                        <option value="all">All Reports</option>
                        <option value="high">High Risk (≥ 5 Reports - Hidden from Buyers)</option>
                        <option value="low">Low Risk (< 5 Reports - Visible)</option>
                    </select>
                </div>
            </div>
            
            <div id="moderationListContainer">
                <!-- Dynamically populated by MVC View -->
            </div>
        </div>

        <!-- Feedback Tab -->
        <div class="content-tab" id="tab-feedback">
            <div class="section-header">
                <div class="section-title">
                    <h2>Receipt and Feedback</h2>
                    <p>Reply to buyer product reviews and community posts. Transfer to complaints if necessary.</p>
                </div>
            </div>
            
            <div id="feedbackListContainer">
                <!-- Dynamically populated by MVC View -->
            </div>
        </div>

        <!-- Return Claims Tab -->
        <div class="content-tab" id="tab-returns">
            <div class="section-header">
                <div class="section-title">
                    <h2>Return Complaint Processing</h2>
                    <p>Review evidence for return and refund requests.</p>
                </div>
            </div>
            
            <div id="returnsListContainer">
                <!-- Dynamically populated by MVC View -->
            </div>
        </div>
    </div>
    </div>
</div>

<!-- Premium Order Details Modal -->
<div class="modal-overlay" id="orderDetailsModal" style="display:none; z-index: 9999;">
    <div class="modal-card" style="max-width: 900px; max-height: 90vh; display: flex; flex-direction: column;">
        <div class="modal-header-premium" style="display:flex; justify-content:space-between; align-items:center; border-bottom: 1px solid #E6E1EA; padding-bottom: 10px;">
            <h3 style="margin:0;">Order Details <span id="detail-order-id" style="font-size: 0.9em; opacity: 0.8;"></span></h3>
            <button class="btn-close-modal" id="btnCloseOrderDetailsModal" style="background:none; border:none; font-size:1.5rem; cursor:pointer;">&times;</button>
        </div>
        <div class="modal-body-premium" style="overflow-y: auto; flex: 1; padding: 20px;">
            <div style="display: flex; gap: 20px; flex-wrap: wrap;">
                <!-- Left Column: Shipping & Payment Info -->
                <div style="flex: 1; min-width: 300px;">
                    <div style="background: #f8f9fa; border-radius: 8px; padding: 15px; margin-bottom: 15px;">
                        <h6 style="margin-top: 0; color: #2C2630; font-weight: 700;"><i class="ph ph-map-pin" style="color:#2F80ED;"></i> Shipping Information</h6>
                        <p style="margin: 5px 0; font-size: 0.9rem;"><strong>Receiver:</strong> <span id="detail-receiver"></span></p>
                        <p style="margin: 5px 0; font-size: 0.9rem;"><strong>Phone:</strong> <span id="detail-phone"></span></p>
                        <p style="margin: 5px 0; font-size: 0.9rem;"><strong>Address:</strong> <span id="detail-address"></span></p>
                    </div>

                    <div style="background: #f8f9fa; border-radius: 8px; padding: 15px; margin-bottom: 15px;">
                        <h6 style="margin-top: 0; color: #2C2630; font-weight: 700;"><i class="ph ph-credit-card" style="color:#2F80ED;"></i> Payment Details</h6>
                        <p style="margin: 5px 0; font-size: 0.9rem;"><strong>Method:</strong> <span id="detail-payment-method"></span></p>
                        <p style="margin: 5px 0; font-size: 0.9rem;"><strong>Note:</strong> <span id="detail-note" style="color: #82758D; font-style: italic;"></span></p>
                    </div>
                </div>

                <!-- Right Column: Order Summary -->
                <div style="flex: 1; min-width: 350px;">
                    <div style="border: 1px solid #E6E1EA; border-radius: 8px; padding: 15px;">
                        <h6 style="margin-top: 0; color: #2C2630; font-weight: 700;">Order Summary</h6>
                        
                        <div id="detail-items-list" style="max-height: 250px; overflow-y: auto; margin-bottom: 15px;">
                            <!-- Items injected here -->
                        </div>

                        <hr style="border: none; border-top: 1px solid #E6E1EA; margin: 15px 0;">

                        <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 0.9rem;">
                            <span style="color: #82758D;">Subtotal (before voucher)</span>
                            <span style="font-weight: 600;" id="detail-subtotal"></span>
                        </div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 0.9rem;">
                            <span style="color: #82758D;">Shipping Fee</span>
                            <span style="font-weight: 600;" id="detail-shipping-fee"></span>
                        </div>

                        <div style="display: flex; justify-content: space-between; margin-bottom: 15px; font-size: 0.9rem; color: #27AE60;">
                            <div>
                                <span>Discount (Voucher)</span>
                                <div id="detail-global-vouchers" style="margin-top: 4px;"></div>
                            </div>
                            <span style="font-weight: 600;" id="detail-discount">-<span id="detail-discount-val"></span></span>
                        </div>
                        
                        <hr style="border: none; border-top: 1px solid #E6E1EA; margin: 15px 0;">

                        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 15px;">
                            <h5 style="margin: 0; font-weight: 700; color: #2C2630;">Total Amount</h5>
                            <h4 style="margin: 0; font-weight: 700; color: #2F80ED;" id="detail-total"></h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-footer-premium" style="display:flex; justify-content:flex-end; padding-top: 15px; border-top: 1px solid #E6E1EA;">
            <button class="btn-outline-action" id="btnCancelOrderDetails" style="padding: 8px 16px; border-radius: 6px; border: 1px solid #ccc; cursor:pointer;">Close</button>
        </div>
    </div>
</div>

@section Scripts {
    <!-- MVC Frontend Architecture for Content Reports -->
    <script src="~/js/admin/content-reports/content-reports-model.js" asp-append-version="true"></script>
    <script src="~/js/admin/content-reports/content-reports-view.js" asp-append-version="true"></script>
    <script src="~/js/admin/content-reports/content-reports-controller.js" asp-append-version="true"></script>
    
    <script>
        (() => {
            // Initialize MVC
            const model = new ContentReportsModel();
            const view = new ContentReportsView();
            const controller = new ContentReportsController(model, view);
            controller.init();
        })();
    </script>
}
