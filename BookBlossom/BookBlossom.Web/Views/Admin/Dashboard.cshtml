@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <h2>Admin Dashboard (System Overview)</h2>
    </div>

    <div class="dashboard-filter-section">
        <span class="filter-label">FILTER:</span>
        <div class="filter-group">
            <label>From</label>
            <input type="date" class="custom-date-input" value="2026-05-01">
        </div>
        <div class="filter-group">
            <label>To</label>
            <input type="date" class="custom-date-input" value="2026-05-31">
        </div>
        <div class="filter-dropdown">
            <i class="fas fa-layer-group"></i>
            <select class="custom-select">
                <option>All Models</option>
                <option>Real Book</option>
                <option>Blind Date</option>
            </select>
        </div>
        <button class="btn-export-pdf"><i class="fas fa-file-pdf"></i> EXPORT PDF</button>
    </div>

    <!-- Top Statistic Cards -->
    @await Html.PartialAsync("Partials/_StatCards")

    <!-- Charts -->
    @await Html.PartialAsync("Partials/_Charts")

    <!-- Trending Books -->
    @await Html.PartialAsync("Partials/_TrendingBooks")
</div>

@section Scripts {
    <script>
        // Dummy data for Growth Chart
        const ctxGrowth = document.getElementById('growthChart').getContext('2d');
        new Chart(ctxGrowth, {
            type: 'line', // Changed to line chart
            data: {
                // The labels array represents 12 evenly divided periods based on the date filter
                labels: ['Period 1', 'Period 2', 'Period 3', 'Period 4', 'Period 5', 'Period 6', 'Period 7', 'Period 8', 'Period 9', 'Period 10', 'Period 11', 'Period 12'],
                datasets: [
                    {
                        label: 'Real Book Revenue',
                        data: [150, 230, 180, 290, 210, 310, 340, 280, 350, 420, 380, 450],
                        borderColor: '#27AE60',
                        backgroundColor: 'rgba(39, 174, 96, 0.1)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.4
                    },
                    {
                        label: 'Blind Date Book Revenue',
                        data: [80, 120, 150, 140, 180, 170, 220, 240, 210, 260, 280, 320],
                        borderColor: '#E3597D',
                        backgroundColor: 'rgba(227, 89, 125, 0.1)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });

        // Dummy data for Pie Chart
        const ctxPie = document.getElementById('pieChart').getContext('2d');
        new Chart(ctxPie, {
            type: 'doughnut',
            data: {
                labels: ['Circulating', 'Locked', 'Burned'],
                datasets: [{
                    data: [60, 25, 15],
                    backgroundColor: ['#E3597D', '#F2C94C', '#27AE60']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '60%'
            }
        });
    </script>
}
