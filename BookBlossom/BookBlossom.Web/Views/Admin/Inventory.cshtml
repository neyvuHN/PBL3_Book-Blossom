@model BookBlossom.Web.ViewModels.Admin.InventoryManagementViewModel
@{
    ViewData["Title"] = "Inventory Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/inventory.css" asp-append-version="true" />
}

<div class="container-fluid py-4" style="font-family: 'Inter', sans-serif;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 style="font-family: 'Lora', serif; font-weight: 700; color: #2C2630;">Inventory Management</h2>
            <p class="text-muted mb-0">Manage your book stock, suppliers, and categories.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null || TempData["ErrorMessage"] != null)
    {
        <div class="custom-alert-container">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="custom-alert alert-success-premium show" role="alert">
                    <div class="alert-icon-box">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <div class="alert-content-box">
                        <h6 class="alert-heading">Success</h6>
                        <p class="alert-message">@TempData["SuccessMessage"]</p>
                    </div>
                    <button type="button" class="btn-close-alert" onclick="this.parentElement.remove();">&times;</button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="custom-alert alert-danger-premium show" role="alert">
                    <div class="alert-icon-box">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <div class="alert-content-box">
                        <h6 class="alert-heading">Error</h6>
                        <p class="alert-message">@TempData["ErrorMessage"]</p>
                    </div>
                    <button type="button" class="btn-close-alert" onclick="this.parentElement.remove();">&times;</button>
                </div>
            }
        </div>
    }

    <div class="inventory-container bg-white shadow-sm">
        <ul class="nav nav-tabs mb-4" id="inventoryTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="books-tab" data-bs-toggle="tab" data-bs-target="#books" type="button" role="tab" aria-controls="books" aria-selected="true">
                    Books Inventory
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="categories-tab" data-bs-toggle="tab" data-bs-target="#categories" type="button" role="tab" aria-controls="categories" aria-selected="false">
                    Categories
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="blinddate-tab" data-bs-toggle="tab" data-bs-target="#blinddate" type="button" role="tab" aria-controls="blinddate" aria-selected="false">
                    Blind Date
                </button>
            </li>
        </ul>

        <div class="tab-content" id="inventoryTabsContent">
            <!-- Books Tab -->
            <div class="tab-pane fade show active" id="books" role="tabpanel" aria-labelledby="books-tab">
                <div class="d-flex justify-content-between mb-3 align-items-center">
                    <div class="d-flex gap-2 align-items-center">
                        <div class="search-box-wrapper" style="width: 350px;">
                            <input type="text" id="searchBooksInput" class="form-control" placeholder="Search books by title, ISBN or author...">
                            <i class="bi bi-search"></i>
                        </div>
                        <select id="filterCategory" class="form-select" style="width: 180px; border-radius: 20px; height: 42px; font-size: 0.9rem; border-color: #e2e8f0; background-color: #f8fafc; cursor: pointer;">
                            <option value="">All Categories</option>
                            @if(Model?.Categories != null)
                            {
                                foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.CategoryName">@cat.CategoryName</option>
                                }
                            }
                        </select>
                        <select id="filterBookStatus" class="form-select" style="width: 160px; border-radius: 20px; height: 42px; font-size: 0.9rem; border-color: #e2e8f0; background-color: #f8fafc; cursor: pointer;">
                            <option value="">All Statuses</option>
                            <option value="In Stock">In Stock</option>
                            <option value="Low Stock">Low Stock</option>
                            <option value="Out of Stock">Out of Stock</option>
                            <option value="Discontinued">Discontinued</option>
                        </select>
                    </div>
                    <button class="btn btn-primary action-btn" id="btn-add-book" style="background-color: #E3597D; border: none;">
                        <i class="bi bi-plus-circle me-1"></i> Add New Book
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Book ID</th>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Stock</th>
                                <th>Reserved</th>
                                <th>Price</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="booksTableBody">
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="spinner-border text-primary mb-2" role="status"></div>
                                    <div class="text-muted small">Đang tải dữ liệu kho sách từ API...</div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Categories Tab -->
            <div class="tab-pane fade" id="categories" role="tabpanel" aria-labelledby="categories-tab">
                <div class="d-flex justify-content-between mb-3 align-items-center">
                    <div class="d-flex gap-2 align-items-center">
                        <div class="search-box-wrapper" style="width: 300px;">
                            <input type="text" id="searchCategoriesInput" class="form-control" placeholder="Search categories...">
                            <i class="bi bi-search"></i>
                        </div>
                        <select id="filterCategoryStatus" class="form-select" style="width: 160px; border-radius: 20px; height: 42px; font-size: 0.9rem; border-color: #e2e8f0; background-color: #f8fafc; cursor: pointer;">
                            <option value="">All Statuses</option>
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                    <button class="btn btn-primary action-btn" id="btn-add-category" style="background-color: #E3597D; border: none;">
                        <i class="bi bi-plus-circle me-1"></i> Add Category
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Category ID</th>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th>Total Books</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="categoriesTableBody">
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="spinner-border" style="color: #E3597D;" role="status"></div>
                                    <div class="text-muted small mt-2">Đang tải danh mục...</div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Blind Date Tab -->
            <div class="tab-pane fade" id="blinddate" role="tabpanel" aria-labelledby="blinddate-tab">
                <div class="d-flex justify-content-between mb-3 align-items-center">
                    <div class="d-flex gap-2 align-items-center w-100">
                        <div class="search-box-wrapper flex-grow-1" style="max-width: 400px;">
                            <input type="text" id="searchBlindDateInput" class="form-control" placeholder="Search by keywords, quotes, hashtags...">
                            <i class="bi bi-search"></i>
                        </div>
                        <select id="filterBlindDateCategory" class="form-select" style="width: 200px; border-radius: 20px; height: 42px; font-size: 0.9rem; border-color: #e2e8f0; background-color: #f8fafc; cursor: pointer;">
                            <option value="">All Categories</option>
                            @if(Model?.Categories != null)
                            {
                                foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.CategoryName">@cat.CategoryName</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Package Image</th>
                                <th>Package Name</th>
                                <th>Real Book</th>
                                <th>Price</th>
                                <th>Qty</th>
                                <th>Barcode</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="blindDateTableBody">
                            <!-- JS MVC will render items here -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Book Modal -->
<div class="modal fade" id="addBookModal" tabindex="-1" aria-labelledby="addBookModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold" id="addBookModalLabel" style="font-family: 'Lora', serif;">Add New Book</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addBookForm" method="post" action="/Admin/AddBook" enctype="multipart/form-data">
                    <div class="row g-3">
                        <div class="col-md-6">
                                                            <label class="form-label">Title <span class="text-danger">*</span></label>
                                                            <input type="text" name="Title" id="bookTitle" class="form-control" required>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="form-label">Category <span class="text-danger">*</span></label>
                                                            <select name="CategoryID" id="bookCategory" class="form-select" required>
                                                                <option value="">Select Category</option>
                                                                @if(Model?.Categories != null)
                                                                {
                                                                    foreach (var cat in Model.Categories)
                                                                    {
                                                                        <option value="@cat.CategoryID">@cat.CategoryName</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                        <div class="col-md-12">
                                                            <label class="form-label">Author(s) <span class="text-danger">*</span></label>
                                                            <input type="text" name="Authors" id="bookAuthors" class="form-control" required placeholder="e.g. F. Scott Fitzgerald, James Clear (separated by commas for multiple authors)">
                                                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Publisher</label>
                            <input type="text" name="Publisher" id="bookPublisher" class="form-control">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">ISBN</label>
                            <input type="text" name="ISBN" id="bookIsbn" class="form-control">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Publish Year</label>
                            <input type="number" name="PublishYear" id="bookPublishYear" class="form-control" min="0" max="2100">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Price (VND) <span class="text-danger">*</span></label>
                            <input type="number" name="Price" id="bookPrice" class="form-control" min="0" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Weight (grams)</label>
                            <input type="number" name="Weight" id="bookWeight" class="form-control" min="0">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Initial Stock <span class="text-danger">*</span></label>
                            <input type="number" name="UnitsInStock" id="bookStock" class="form-control" value="0" min="0" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Sample File (Optional)</label>
                            <input type="file" name="SampleFile" class="form-control">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Book Images</label>
                            <input type="file" class="form-control" name="BookImages" id="bookImagesInput" multiple accept="image/*">
                            <div class="form-text text-muted small">You can upload multiple files (jpg, jpeg, png). The first image will be marked as primary.</div>
                            <div id="bookImagesPreviewContainer" class="d-flex flex-wrap gap-2 mt-2"></div>
                            
                            <!-- Existing Cover Image Preview when Editing -->
                            <div id="currentBookCoverContainer" class="mt-3" style="display: none;">
                                <label class="form-label text-muted small d-block">Current Cover Image:</label>
                                <div class="image-preview-wrapper" style="width: 80px; height: 100px;">
                                    <img id="currentBookCoverImg" src="" style="width: 100%; height: 100%; object-fit: cover;" />
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Description</label>
                            <textarea name="Description" id="bookDescription" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="col-12 mt-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="IsContinued" id="isContinued" value="true" checked>
                                <label class="form-check-label" for="isContinued">Currently Selling (IsContinued)</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="addBookForm" class="btn btn-primary" style="background-color: #E3597D; border: none;">Save Book</button>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Category Modal -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-labelledby="addCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold" id="addCategoryModalLabel" style="font-family: 'Lora', serif;">Add Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addCategoryForm" method="post" action="/Admin/AddCategory">
                    <div class="mb-3">
                        <label class="form-label">Category Name <span class="text-danger">*</span></label>
                        <input type="text" name="CategoryName" id="categoryNameInput" class="form-control" required placeholder="e.g. Literature, Skills...">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description (Optional)</label>
                        <textarea name="Description" id="categoryDescInput" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select name="Status" id="categoryStatusInput" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="addCategoryForm" class="btn btn-primary" style="background-color: #E3597D; border: none;">Save Category</button>
            </div>
        </div>
    </div>
</div>

<!-- Custom Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-body text-center p-4">
                <div class="mb-3 text-danger">
                    <i class="bi bi-exclamation-triangle-fill" style="font-size: 3rem;"></i>
                </div>
                <h4 class="fw-bold mb-2" id="deleteConfirmTitle" style="color: #2C2630; font-family: 'Lora', serif;">Are you sure?</h4>
                <p class="text-muted mb-4" id="deleteConfirmMessage">Do you really want to delete this item? This action cannot be undone.</p>
                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-light px-4 py-2 fw-semibold" data-bs-dismiss="modal" style="border-radius: 10px;">Cancel</button>
                    <button type="button" id="deleteConfirmBtn" class="btn btn-danger px-4 py-2 fw-semibold" style="border-radius: 10px; background-color: #fa5252; border: none;">Delete</button>
                </div>
            </div>      
        </div>
    </div>
</div>

<!-- Create Blind Date Modal -->
<div class="modal fade" id="createBlindDateModal" tabindex="-1" aria-labelledby="createBlindDateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="createBlindDateModalLabel" style="font-family: 'Lora', serif;">Create Blind Date Package</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="createBlindDateForm">
                    <input type="hidden" name="RealBookID" id="bdRealBookID">
                    <input type="hidden" name="RealBookCategoryName" id="bdRealBookCategoryName">
                    
                    <div class="d-flex align-items-center p-3 mb-4 rounded" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                        <img id="bdRealBookImage" src="" class="rounded shadow-sm me-3" style="width: 60px; height: 80px; object-fit: cover;" onerror="this.onerror=null; this.src='/images/Book/book1.jpg';" />
                        <div>
                            <h6 id="bdRealBookTitle" class="fw-bold mb-1">Book Title</h6>
                            <div id="bdRealBookPrice" class="text-success fw-bold small mb-1">Current price: 0 ₫</div>
                            <div id="bdRealBookStockInfo" class="text-muted small">Current stock: 0</div>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Quantity to Sell <span class="text-danger">*</span></label>
                            <input type="number" name="Quantity" id="bdQuantity" class="form-control" min="1" required>
                            <div class="form-text text-muted small">Must be less than or equal to current stock.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Selling Price (VND) <span class="text-danger">*</span></label>
                            <input type="number" name="Price" id="bdPrice" class="form-control" min="0" required>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Keywords <span class="text-muted small">(Multiple)</span></label>
                            <input type="text" name="Keywords" class="form-control" placeholder="e.g. Romance, Thriller, Fast-paced">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Quotes <span class="text-muted small">(Format: "...")</span></label>
                            <textarea name="Quotes" class="form-control" rows="2" placeholder='e.g. "A thrilling ride from start to finish"&#10;"Unputdownable"'></textarea>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Hashtags <span class="text-muted small">(Format: #...)</span></label>
                            <input type="text" name="Hashtags" class="form-control" placeholder="e.g. #mystery #mustread">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Blind Date Images <span class="text-muted small">(Multiple)</span></label>
                            <input type="file" class="form-control" name="BlindDateImages" id="bdImagesInput" multiple accept="image/*">
                            <div class="form-text text-muted small">You can upload multiple files for the blind date package cover.</div>
                            <div id="bdImagesPreviewContainer" class="d-flex flex-wrap gap-2 mt-2"></div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="createBlindDateForm" class="btn btn-primary" style="background-color: #0dcaf0; color: white; border: none;">Approve & Create</button>
            </div>
        </div>
    </div>
</div>

<!-- Restock Book Modal -->
<div class="modal fade" id="restockBookModal" tabindex="-1" aria-labelledby="restockBookModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold" id="restockBookModalLabel" style="font-family: 'Lora', serif;">Restock Sách (Nhập Kho)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="restockBookForm">
                    <input type="hidden" id="restockBookId" />
                    <div class="mb-3">
                        <label class="form-label">Tên sách</label>
                        <input type="text" id="restockBookTitle" class="form-control" readonly disabled />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nhà cung cấp <span class="text-danger">*</span></label>
                        <input type="text" id="restockSupplierName" class="form-control" required placeholder="Ví dụ: Fahasa, Nhà sách Phương Nam..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Địa chỉ giao hàng (Tùy chọn)</label>
                        <input type="text" id="restockShipAddress" class="form-control" placeholder="Ví dụ: Quận 5, TP.HCM..." />
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">Số lượng nhập <span class="text-danger">*</span></label>
                            <input type="number" id="restockQuantity" class="form-control" min="1" required value="10" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Đơn giá nhập (VND) <span class="text-danger">*</span></label>
                            <input type="number" id="restockUnitPrice" class="form-control" min="1" required placeholder="Ví dụ: 50000" />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" form="restockBookForm" class="btn btn-primary" style="background-color: #E3597D; border: none;">Nhập kho</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/inventory.js" asp-append-version="true"></script>
    <script src="~/js/admin/inventory/blind-date/blind-date-model.js" asp-append-version="true"></script>
    <script src="~/js/admin/inventory/blind-date/blind-date-view.js" asp-append-version="true"></script>
    <script src="~/js/admin/inventory/blind-date/blind-date-controller.js" asp-append-version="true"></script>
}
