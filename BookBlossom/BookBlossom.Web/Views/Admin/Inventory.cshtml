@model IEnumerable<BookBlossom.Core.DTOs.Importing.ImportingDTO>
@{
    ViewData["Title"] = "Inventory Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4" style="font-family: 'Inter', sans-serif;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 style="font-family: 'Lora', serif; font-weight: 700; color: #2C2630;">Inventory Management</h2>
    </div>
    
    <div class="card border-0 shadow-sm p-4" style="border-radius: 16px; background-color: #ffffff;">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Staff Name</th>
                    <th>Supplier Name</th>
                    <th>Import Date</th>
                    <th>Total Cost</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ImportingID</td>
                            <td>@item.StaffName</td>
                            <td>@item.SupplierName</td>
                            <td>@item.ImportDate.ToString("g")</td>
                            <td>@item.TotalCost.ToString("C")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">No inventory records found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
