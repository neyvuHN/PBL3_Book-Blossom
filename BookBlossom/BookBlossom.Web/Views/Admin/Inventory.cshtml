@{
    ViewData["Title"] = "Inventory Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4" style="font-family: 'Inter', sans-serif;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 style="font-family: 'Lora', serif; font-weight: 700; color: #2C2630;">Inventory Management</h2>
    </div>
    
    <div class="card border-0 shadow-sm p-5 text-center" style="border-radius: 16px; background-color: #ffffff;">
        <div class="mb-4">
            <span style="font-size: 4rem;">📚</span>
        </div>
        <h4 style="font-family: 'Lora', serif; font-weight: 600; color: #2C2630;" class="mb-2">Manage Your Book Stock</h4>
        <p class="text-muted mx-auto" style="max-width: 500px;">
            This is a separate dedicated module for stock monitoring, suppliers, and incoming shipments. Use this area to track item counts, manage low stock alerts, and perform bulk price adjustments.
        </p>
        <button class="btn btn-primary mt-3 px-4 py-2" style="background-color: #E3597D; border-color: #E3597D; border-radius: 30px; font-weight: 500;">
            View Stock Catalog
        </button>
    </div>
</div>
