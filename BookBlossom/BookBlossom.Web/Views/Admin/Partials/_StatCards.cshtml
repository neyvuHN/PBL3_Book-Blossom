<div class="stat-cards-grid">
    <div class="stat-card total-revenue">
        <h3>Total Revenue</h3>
        <div class="value">0 <span>VND</span></div>
        <p class="desc">Based on selected filter.</p>
        <div class="icon-lock">💰</div>
    </div>
    
    <div class="stat-card total-orders">
        <h3>Total Orders</h3>
        <div class="value">0 <span>Orders</span></div>
        <p class="desc">Based on selected filter.</p>
    </div>

    <div class="stat-card pending-orders" style="--card-color: #F2C94C;">
        <h3>Pending Orders</h3>
        <div class="value">0 <span>Orders</span></div>
        <p class="desc">Active pending orders.</p>
    </div>

    <div class="stat-card completed-orders" style="--card-color: #27AE60;">
        <h3>Completed Orders</h3>
        <div class="value">0 <span>Orders</span></div>
        <p class="desc">Successfully delivered.</p>
    </div>

    <div class="stat-card return-rate">
        <h3>Return Rate</h3>
        <div class="value">0 <span>%</span></div>
        <p class="desc">Based on selected filter.</p>
    </div>

    <div class="stat-card low-stock" style="--card-color: #F2994A;">
        <h3>Low Stock Books</h3>
        <div class="value">0 <span>Items</span></div>
        <p class="desc">Stock under 10 units.</p>
    </div>

    <div class="stat-card out-of-stock" style="--card-color: #EB5757;">
        <h3>Out of Stock</h3>
        <div class="value">0 <span>Items</span></div>
        <p class="desc">Units currently at 0.</p>
    </div>

    <div class="stat-card users">
        <h3>Lifetime Buyers</h3>
        <div class="value">0 <span>Buyers</span></div>
        <p class="desc">Total registered customers.</p>
    </div>
</div>
