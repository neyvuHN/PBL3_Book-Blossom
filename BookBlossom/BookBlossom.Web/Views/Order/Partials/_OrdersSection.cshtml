<div class="orders-container container mt-4 mb-5">
    <h2 class="mb-4 font-weight-bold orders-title">My Orders</h2>
    
    <div class="orders-tabs-wrapper mb-4">
        <ul class="nav nav-tabs orders-tabs border-0" id="ordersTab" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" id="to-confirm-tab" data-tab="to-confirm" data-toggle="tab" href="#to-confirm" role="tab" aria-controls="to-confirm" aria-selected="true">To Confirm</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="to-ship-tab" data-tab="to-ship" data-toggle="tab" href="#to-ship" role="tab" aria-controls="to-ship" aria-selected="false">To Ship</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="to-receive-tab" data-tab="to-receive" data-toggle="tab" href="#to-receive" role="tab" aria-controls="to-receive" aria-selected="false">To Receive <span class="badge badge-pill badge-danger" id="to-receive-badge" style="display:none;">0</span></a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="completed-tab" data-tab="completed" data-toggle="tab" href="#completed" role="tab" aria-controls="completed" aria-selected="false">Completed</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="cancelled-return-tab" data-tab="cancelled-return" data-toggle="tab" href="#cancelled-return" role="tab" aria-controls="cancelled-return" aria-selected="false">Cancelled/Return</a>
            </li>
        </ul>
    </div>

    <div class="orders-search-wrapper mb-4">
        <div class="search-box-container">
            <i class="fas fa-search search-icon text-muted"></i>
            <input type="text" class="form-control orders-search-input" id="orders-search-input" placeholder="Search by Shop Name, Order ID, Book Title ...">
        </div>
    </div>

    <div class="orders-content" id="orders-list-container">
        <!-- Order items will be dynamically rendered here -->
    </div>

    <div class="orders-empty-state text-center py-5" id="orders-empty-state" style="display:none;">
        <i class="fas fa-shopping-cart fa-5x text-muted mb-3 opacity-50"></i>
        <p class="text-muted">Your order history is blank</p>
    </div>
</div>
