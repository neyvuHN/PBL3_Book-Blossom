<script>
    $(document).ready(function () {

        function showToast(message, onUndo, undoText = 'Undo') {
            const $toast = $(`
                <div class="toast-notification" style="z-index: 10500 !important;">
                    <i class="fas fa-check-circle" style="color: #28a745;"></i>
                    <span>${message}</span>
                    <button class="btn-undo-share" style="${onUndo ? '' : 'display: none;'} background: none; border: none; color: #C2185B; font-weight: bold; cursor: pointer; text-decoration: underline; margin-left: 10px; font-size: 0.85rem; padding: 0;">${undoText}</button>
                    <div class="toast-progress"></div>
                </div>
            `);

            $('body').append($toast);
            $toast.fadeIn(300);

            const timeoutId = setTimeout(function () {
                $toast.fadeOut(300, function () {
                    $(this).remove();
                });
            }, 5000);

            $toast.find('.btn-undo-share').on('click', function () {
                clearTimeout(timeoutId);
                $toast.fadeOut(200, function () {
                    $(this).remove();

                    if (typeof onUndo === 'function') {
                        onUndo();
                    }
                });
            });
        }

        // [UPDATED] Helper function to show styled custom confirmation modal
        function showCartConfirm(message, onConfirm) {
            $('#cart-confirm-message').text(message);
            $('#cart-confirm-modal').fadeIn(200);

            // Unbind previous click events to prevent duplicates
            $('#btn-cart-confirm-ok').off('click').on('click', function () {
                $('#cart-confirm-modal').fadeOut(200);
                if (typeof onConfirm === 'function') {
                    onConfirm();
                }
            });

            $('#btn-cart-confirm-cancel, #cart-confirm-modal .modal-backdrop').off('click').on('click', function () {
                $('#cart-confirm-modal').fadeOut(200);
            });
        }

        
        // =========================================================
            // [UPDATED] SHOPPING CART INTERFACE SPA LOGIC
            // Moved here from the second DOMContentLoaded block so that
            // showCart() and all cart handlers can access the SPA
            // section variables ($mainContent, $exploreSection, etc.)
            // that are scoped to this $(document).ready() block.
            // =========================================================
            // [UPDATED] Support multiple applied vouchers
            let cartItems = [];
            let appliedVouchers = [];

            function formatVnd(value) {
                return new Intl.NumberFormat('vi-VN').format(Number(value) || 0) + ' VND';
            }

            function getItemPriceVnd(item) {
                return Number(item.priceVnd) || Math.round((Number(item.price) || 0) * 20000);
            }

            let globalCartCount = 4;

            // Dynamically view details from cart items
            window.viewBookDetails = function(title) {
                const item = cartItems.find(i => i.title === title);
                if (!item) return;

                if (item.isBlind) {
                    const targetId = item.blindBookID || item.id;
                    window.location.href = `/BlindDate#blind-details-${encodeURIComponent(targetId)}`;
                } else {
                    window.location.href = `/Explore#book-details-${encodeURIComponent(item.title)}`;
                }
            };

            async function renderCart(skipFetch = false) {
                if (skipFetch && window.BookBlossomCart) {
                    cartItems = window.BookBlossomCart.getCartItems();
                } else {
                    cartItems = await BookBlossomCart.loadCartFromServer();
                }
                const $itemsWrapper = $('#cart-items-wrapper');
                const $emptyState = $('#empty-cart-state');
                const $layoutContainer = $('#cart-layout-container');

                if (cartItems.length === 0) {
                    $layoutContainer.hide();
                    $emptyState.show();
                    syncCartBadge();
                    return;
                }

                $layoutContainer.show();
                $emptyState.hide();
                $itemsWrapper.empty();

                // [UPDATED] Group items by custom Book Types instead of generic individual shops
                const groups = {};
                cartItems.forEach(item => {
                    // Fallback to ensure correct categorization
                    let typeName = item.shop;
                    if (typeName !== 'Normal Books' && typeName !== 'Blind Date Books') {
                        typeName = item.isBlind ? 'Blind Date Books' : 'Normal Books';
                        item.shop = typeName;
                    }
                    if (!groups[typeName]) {
                        groups[typeName] = [];
                    }
                    groups[typeName].push(item);
                });

                // [UPDATED] Render each book type group (Normal Books & Blind Date Books)
                Object.keys(groups).forEach(groupName => {
                    const items = groups[groupName];
                    const allSelected = items.every(i => i.selected);

                    // Choose an appropriate icon for each type (book icon for normal, gift/mystery icon for blind date)
                    const groupIcon = groupName === 'Blind Date Books' ? 'fas fa-gift' : 'fas fa-book';

                    let groupHtml = `
                        <div class="shop-group-card mb-4" style="background: #fff; border-radius: 16px; border: 1px solid #f0f0f0; box-shadow: 0 4px 15px rgba(0,0,0,0.02); overflow: hidden;">
                            <!-- [UPDATED] Type Header (replacing generic store header and chat feature) -->
                            <div class="shop-header d-flex align-items-center justify-content-between px-4 py-3" style="background: #fafaf9; border-bottom: 1px solid #f2ede4;">
                                <div class="d-flex align-items-center gap-3">
                                    <input type="checkbox" class="shop-checkbox" data-shop="${groupName}" ${allSelected ? 'checked' : ''} style="width: 18px; height: 18px; accent-color: #C2185B; cursor: pointer;">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="${groupIcon}" style="color: #C2185B; font-size: 1.1rem;"></i>
                                        <span style="font-weight: 700; color: #111; font-size: 1rem;">${groupName}</span>
                                    </div>
                                </div>
                            </div>
                            <div class="shop-items-list">
                    `;

                    items.forEach(item => {
                        groupHtml += `
                            <div class="cart-item-row d-flex align-items-center justify-content-between p-4" data-id="${item.id}" style="border-bottom: 1px solid #f9f9f8; transition: all 0.3s ease;">
                                <div class="d-flex align-items-center gap-3 flex-grow-1">
                                    <!-- Checkbox -->
                                    <input type="checkbox" class="item-checkbox" data-id="${item.id}" ${item.selected ? 'checked' : ''} style="width: 18px; height: 18px; accent-color: #C2185B; cursor: pointer;">

                                    <!-- Cover -->
                                    <div class="book-cover-wrapper" style="width: 70px; height: 100px; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.06); border: 1px solid #eee; flex-shrink: 0; cursor: pointer;" onclick="viewBookDetails('${item.title}')">
                                        <img src="${item.img}" alt="${item.title}" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                                    </div>

                                    <!-- Info -->
                                    <div class="book-info d-flex flex-column gap-2" style="max-width: 320px; text-align: left;">
                                        ${item.isBlind ? `
                                            <div class="d-flex flex-wrap gap-1 mb-1">
                                                ${item.hashtags.map(h => `<span class="badge" style="background: #111; color: #fff; font-size: 0.7rem; font-weight: 700; padding: 3px 8px; border-radius: 4px;">#${h}</span>`).join('')}
                                            </div>
                                        ` : ''}
                                        <h4 class="book-title mb-0" style="font-size: 1rem; font-weight: 700; color: #111; line-height: 1.4; cursor: pointer;" onclick="viewBookDetails('${item.title}')">${item.title}</h4>
                                        <span class="condition-badge" style="width: fit-content; background: ${item.condition.includes('Like New') || item.condition.includes('New') ? '#e6fffa' : '#f5f4f0'}; color: ${item.condition.includes('Like New') || item.condition.includes('New') ? '#319795' : '#555'}; font-size: 0.8rem; font-weight: 600; padding: 2px 10px; border-radius: 12px;">${item.condition}</span>
                                    </div>
                                </div>

                                <!-- Quantity & Price -->
                                <div class="d-flex align-items-center gap-4 flex-shrink-0">
                                    <div class="quantity-selector-container text-center">
                                        <div class="quantity-selector d-flex align-items-center" style="background: #f5f4f0; border-radius: 20px; padding: 4px 8px; border: 1px solid #e2dcd0;">
                                            <button class="btn-qty-minus" data-id="${item.id}" style="background: none; border: none; font-size: 0.9rem; color: #666; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; cursor: pointer;"><i class="fas fa-minus"></i></button>
                                            <span class="qty-val" style="width: 30px; font-weight: 700; font-size: 0.95rem; color: #111;">${item.qty}</span>
                                            <button class="btn-qty-plus" data-id="${item.id}" style="background: none; border: none; font-size: 0.9rem; color: #666; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; cursor: pointer;"><i class="fas fa-plus"></i></button>
                                        </div>
                                        ${item.limit ? `<span style="font-size: 0.72rem; color: #888; display: block; margin-top: 4px;">Limit ${item.limit}</span>` : ''}
                                    </div>

                                    <div class="price-action-box d-flex flex-column align-items-end gap-2" style="min-width: 120px;">
                                        <!-- [UPDATED] Unit price remains constant in VND -->
                                        <span style="font-size: 1.15rem; font-weight: 800; color: #111;">${formatVnd(getItemPriceVnd(item))}</span>
                                        <button class="btn-delete-item" data-id="${item.id}" title="Remove item" style="background: none; border: none; color: #bbb; transition: all 0.2s; cursor: pointer; padding: 3px;" onmouseover="this.style.color='#e74c3c'" onmouseout="this.style.color='#bbb'">
                                            <i class="far fa-trash-alt"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        `;
                    });

                    groupHtml += `
                            </div>
                        </div>
                    `;

                    $itemsWrapper.append(groupHtml);
                });

                calculateTotals();
                syncCartBadge();
            }

            // [NEW] Dynamically load and calculate vouchers from backend API
            window.activeVouchers = [];

            async function fetchActiveVouchers() {
                if (window.apiClient) {
                    try {
                        const res = await window.apiClient.apiGet('/api/VoucherAPI/active');
                        window.activeVouchers = res.data || res;
                    } catch (e) {
                        console.error("Failed to prefetch wallet vouchers", e);
                    }
                }
            }
            fetchActiveVouchers();

            function getVoucherDiscount(v, subtotalVnd) {
                const detail = window.activeVouchers ? window.activeVouchers.find(cv => cv.voucherCode === v.code) : null;
                const globalVoucher = window.VOUCHERS_DATA ? window.VOUCHERS_DATA.find(gv => gv.code === v.code) : null;

                if (detail) {
                    if (detail.discountType === 'Fixed') {
                        return Number(detail.discountValue) || 0;
                    } else { // 'Percentage'
                        const discount = Math.round(subtotalVnd * (Number(detail.discountValue) || 0) / 100);
                        if (detail.maxDiscountAmount > 0 && discount > detail.maxDiscountAmount) {
                            return detail.maxDiscountAmount;
                        }
                        return discount;
                    }
                }

                if (globalVoucher) {
                    if (globalVoucher.type === 'fixed') {
                        return Number(globalVoucher.discount) || 0;
                    } else {
                        const discount = Math.round(subtotalVnd * (Number(globalVoucher.discount) || 0));
                        if (globalVoucher.maxDiscount > 0 && discount > globalVoucher.maxDiscount) {
                            return globalVoucher.maxDiscount;
                        }
                        return discount;
                    }
                }

                return 0;
            }

            async function loadActiveVouchers() {
                if (!window.apiClient) return;
                try {
                    const res = await window.apiClient.apiGet('/api/VoucherAPI/active');
                    window.activeVouchers = res.data || res;

                    const $productVouchersList = $('#product-vouchers-list');
                    const $platformVouchersList = $('#platform-vouchers-list');
                    
                    $productVouchersList.empty();
                    $platformVouchersList.empty();

                    if (window.activeVouchers.length === 0) {
                        $productVouchersList.html('<div style="text-align: center; padding: 20px; color: #888;">No product vouchers available.</div>');
                        $platformVouchersList.html('<div style="text-align: center; padding: 20px; color: #888;">No platform vouchers available.</div>');
                        return;
                    }

                    window.activeVouchers.forEach(v => {
                        const code = v.voucherCode;
                        const name = v.voucherName || 'Special Discount';
                        const valueDisplay = v.discountType === 'Percentage' ? `${v.discountValue}%` : `${new Intl.NumberFormat('vi-VN').format(v.discountValue)} VND`;
                        const isStackable = v.isStackable;
                        const stackableBadge = isStackable ? 
                            `<span style="background: #e8f5e9; color: #2e7d32; font-size: 0.65rem; padding: 2px 6px; border-radius: 4px; font-weight: 600;">Stackable</span>` : 
                            `<span style="background: #ffebee; color: #c62828; font-size: 0.65rem; padding: 2px 6px; border-radius: 4px; font-weight: 600;">Non-stackable</span>`;

                        const itemHtml = `
                            <div class="modal-voucher-item" data-code="${code}" data-stackable="${isStackable}" style="display: flex; border: 1.5px dashed #f07c7c; border-radius: 12px; overflow: hidden; background: #fffdfb; transition: all 0.25s; cursor: pointer; position: relative;">
                                <div style="background: #ffebee; padding: 20px; display: flex; flex-direction: column; align-items: center; justify-content: center; min-width: 110px; border-right: 1.5px dashed #f07c7c; text-align: center;">
                                    <span style="font-size: 0.85rem; font-weight: 700; color: #f07c7c; letter-spacing: 0.5px;">${code}</span>
                                    <span style="font-size: 0.65rem; color: #f07c7c; font-weight: 600; margin-top: 4px; background: #fff; padding: 2px 6px; border-radius: 10px;">Code</span>
                                </div>
                                <div style="padding: 15px; flex-grow: 1; display: flex; flex-direction: column; justify-content: center; text-align: left;">
                                    <div style="display: flex; gap: 5px; align-items: center; margin-bottom: 4px; flex-wrap: wrap;">
                                        <h4 style="font-size: 0.95rem; font-weight: 700; color: #333; margin: 0;">${name} (Save ${valueDisplay})</h4>
                                        ${stackableBadge}
                                        ${v.isAutoRefundable ? '<span style="background: #e6f7ff; color: #0050b3; font-size: 0.65rem; padding: 2px 6px; border-radius: 4px; font-weight: 600;">Refundable</span>' : '<span style="background: #fff0f6; color: #c41d7f; font-size: 0.65rem; padding: 2px 6px; border-radius: 4px; font-weight: 600;">Non-refundable</span>'}
                                        ${v.minPlan > 0 && window.getPlanName ? '<span style="background: #f6ffed; color: #389e0d; font-size: 0.65rem; padding: 2px 6px; border-radius: 4px; font-weight: 600;">Min Plan: ' + window.getPlanName(v.minPlan) + '</span>' : ''}
                                        ${v.membershipRankRequired > 0 && window.getRankName ? '<span style="background: #fff7e6; color: #d46b08; font-size: 0.65rem; padding: 2px 6px; border-radius: 4px; font-weight: 600;">Min Rank: ' + window.getRankName(v.membershipRankRequired) + '</span>' : ''}
                                        ${v.minReputationRequired > 0 ? '<span style="background: #f9f0ff; color: #531dab; font-size: 0.65rem; padding: 2px 6px; border-radius: 4px; font-weight: 600;">Min Rep: ' + v.minReputationRequired + '</span>' : ''}
                                    </div>
                                    <p style="font-size: 0.78rem; color: #666; margin: 0 0 6px 0;">Min order ${new Intl.NumberFormat('vi-VN').format(v.minOrderValue)} VND.${v.maxDiscountAmount > 0 ? ' Max discount ' + new Intl.NumberFormat('vi-VN').format(v.maxDiscountAmount) + ' VND.' : ''}</p>
                                    <span style="font-size: 0.7rem; color: #aaa;">Expiry: ${new Date(v.endDate).toLocaleDateString()}</span>
                                </div>
                                <div style="padding: 15px; display: flex; align-items: center; justify-content: center; min-width: 90px; z-index: 2;">
                                    <button class="btn-modal-apply-voucher" style="background: #fff; color: #C2185B; border: 1.5px solid #C2185B; border-radius: 20px; padding: 6px 14px; font-size: 0.8rem; font-weight: 700; cursor: pointer; transition: all 0.2s;">Apply</button>
                                </div>
                            </div>
                        `;

                        // Determine if it's a product or platform voucher
                        const hasCategory = v.applicableCategoryIDs && v.applicableCategoryIDs.length > 0;
                        const hasBook = v.applicableBookIDs && v.applicableBookIDs.length > 0;
                        
                        if (hasCategory || hasBook) {
                            $productVouchersList.append(itemHtml);
                        } else {
                            $platformVouchersList.append(itemHtml);
                        }
                    });
                    
                    if ($productVouchersList.children().length === 0) {
                        $productVouchersList.html('<div style="text-align: center; padding: 20px; color: #888;">No product vouchers available.</div>');
                    }
                    if ($platformVouchersList.children().length === 0) {
                        $platformVouchersList.html('<div style="text-align: center; padding: 20px; color: #888;">No platform vouchers available.</div>');
                    }
                } catch (e) {
                    console.error("Failed to load customer vouchers", e);
                }
            }

            // Tab switching logic
            $(document).on('click', '.cart-voucher-tab-btn', function() {
                $('.cart-voucher-tab-btn').removeClass('active');
                $(this).addClass('active');
                const target = $(this).attr('data-target');
                $('.cart-voucher-tab-content').removeClass('active');
                $('#' + target).addClass('active');
            });

            // [UPDATED] Calculate totals dynamically with sequential discounting
            function calculateTotals() {
                let subtotalVnd = 0;
                let cartLines = [];

                cartItems.forEach(item => {
                    if (item.selected) {
                        const itemPriceVnd = getItemPriceVnd(item);
                        subtotalVnd += itemPriceVnd * item.qty;
                        cartLines.push({
                            id: item.id,
                            bookID: item.isBlind ? item.blindBookID : item.bookID,
                            categoryID: item.categoryID,
                            currentValue: itemPriceVnd * item.qty,
                            originalValue: itemPriceVnd * item.qty,
                            isBlind: item.isBlind
                        });
                    }
                });

                $('#cart-subtotal').text(new Intl.NumberFormat('vi-VN').format(subtotalVnd) + ' VND');

                let totalDiscountVnd = 0;
                let platformDiscountLines = []; // [UPDATED] Only store platform vouchers for the order summary
                let validVouchers = [];

                if (appliedVouchers && appliedVouchers.length > 0) {
                    // Filter stackable conflict: if any voucher is non-stackable, keep only the first one selected
                    let nonStackable = appliedVouchers.find(v => v.isStackable === false);
                    if (nonStackable && appliedVouchers.length > 1) {
                        showToast(`Voucher ${nonStackable.code} cannot be combined. Removed other vouchers.`);
                        appliedVouchers = [nonStackable];
                        updateModalFooterSelection(); // Update UI
                    }

                    // Sort vouchers: Product first, Platform next
                    let productVouchersToApply = [];
                    let platformVouchersToApply = [];

                    appliedVouchers.forEach(v => {
                        const detail = window.activeVouchers ? window.activeVouchers.find(cv => cv.voucherCode === v.code) : null;
                        if (!detail) return;

                        const hasCat = detail.applicableCategoryIDs && detail.applicableCategoryIDs.length > 0;
                        const hasBook = detail.applicableBookIDs && detail.applicableBookIDs.length > 0;

                        if (hasCat || hasBook) productVouchersToApply.push(detail);
                        else platformVouchersToApply.push(detail);
                    });

                    // Sort Product Vouchers: Percentage first, then Fixed desc
                    productVouchersToApply.sort((a, b) => {
                        if (a.discountType === 'Percentage' && b.discountType !== 'Percentage') return -1;
                        if (a.discountType !== 'Percentage' && b.discountType === 'Percentage') return 1;
                        return b.discountValue - a.discountValue;
                    });

                    // 1. Apply Product Vouchers
                    productVouchersToApply.forEach(v => {
                        const reqCatIds = v.applicableCategoryIDs || [];
                        const reqBookIds = v.applicableBookIDs || [];

                        let eligibleLines = cartLines.filter(cl => {
                            if (cl.isBlind) {
                                return reqCatIds.length > 0 && reqCatIds.includes(cl.categoryID);
                            } else {
                                return (reqCatIds.length > 0 && reqCatIds.includes(cl.categoryID)) ||
                                       (reqBookIds.length > 0 && reqBookIds.includes(cl.bookID));
                            }
                        });

                        let eligibleTotal = eligibleLines.reduce((sum, cl) => sum + cl.currentValue, 0);

                        if (eligibleTotal >= v.minOrderValue && eligibleLines.length > 0) {
                            // Sort by current value desc
                            eligibleLines.sort((a, b) => b.currentValue - a.currentValue);
                            let targetLine = eligibleLines[0];

                            let discount = 0;
                            if (v.discountType === 'Fixed') discount = v.discountValue;
                            else {
                                discount = targetLine.currentValue * v.discountValue / 100;
                                if (v.maxDiscountAmount > 0 && discount > v.maxDiscountAmount) discount = v.maxDiscountAmount;
                            }

                            discount = Math.min(discount, targetLine.currentValue);
                            targetLine.currentValue -= discount;
                            totalDiscountVnd += discount;
                            
                            // [UPDATED] DO NOT add to platformDiscountLines. Product vouchers are shown under the book items.
                            
                            if (!targetLine.appliedVouchers) targetLine.appliedVouchers = [];
                            targetLine.appliedVouchers.push({ code: v.voucherCode, discount: discount });
                            
                            validVouchers.push({ code: v.voucherCode, isStackable: v.isStackable });
                        } else {
                            showToast(`Min order for product voucher ${v.voucherCode} is ${new Intl.NumberFormat('vi-VN').format(v.minOrderValue)} VND of applicable books!`);
                        }
                    });

                    // 2. Apply Platform Vouchers sequentially
                    let currentSubTotal = cartLines.reduce((sum, cl) => sum + cl.currentValue, 0);
                    
                    platformVouchersToApply.forEach(v => {
                        if (currentSubTotal >= v.minOrderValue) {
                            let discount = 0;
                            if (v.discountType === 'Fixed') discount = v.discountValue;
                            else {
                                discount = currentSubTotal * v.discountValue / 100;
                                if (v.maxDiscountAmount > 0 && discount > v.maxDiscountAmount) discount = v.maxDiscountAmount;
                            }
                            discount = Math.min(discount, currentSubTotal);
                            currentSubTotal -= discount;
                            totalDiscountVnd += discount;
                            
                            // [UPDATED] Add platform vouchers to the order summary list
                            platformDiscountLines.push(`${v.voucherCode} (-${new Intl.NumberFormat('vi-VN').format(discount)}đ)`);
                            
                            validVouchers.push({ code: v.voucherCode, isStackable: v.isStackable });
                        } else {
                            showToast(`Min order for platform voucher ${v.voucherCode} is ${new Intl.NumberFormat('vi-VN').format(v.minOrderValue)} VND remaining!`);
                        }
                    });
                }

                appliedVouchers = validVouchers;

                // Shipping fee calculation in VND only
                let shippingFeeVnd = subtotalVnd > 0 ? 30000 : 0;
                if (subtotalVnd > 0) {
                    $('#cart-shipping').text('30,000 VND');
                } else {
                    $('#cart-shipping').text('0 VND');
                }

                let totalVnd = Math.max(0, subtotalVnd + shippingFeeVnd - totalDiscountVnd);
                $('#cart-total').text(new Intl.NumberFormat('vi-VN').format(totalVnd) + ' VND');

                window.cartCalculatedSubtotalVnd = subtotalVnd;
                window.cartCalculatedShippingVnd = shippingFeeVnd;
                window.cartCalculatedDiscountVnd = totalDiscountVnd;
                window.cartPlatformDiscountLines = platformDiscountLines; // [UPDATED] Export only platform lines
                window.cartLinesWithVouchers = cartLines;

                if (totalDiscountVnd > 0) {
                    const discountText = "Vouchers applied successfully!";
                    $('#cart-discount-badge').html('<i class="fas fa-check-circle"></i> ' + discountText).show();
                    $('#voucher-message').html('<i class="fas fa-tags"></i> ' + discountText).css('color', '#2e7d32').show();
                } else {
                    $('#cart-discount-badge').hide();
                    $('#voucher-message').hide();
                }

                if (appliedVouchers && appliedVouchers.length > 0) {
                    const codes = appliedVouchers.map(v => v.code).join(', ');
                    $('#selected-voucher-label').text(`Vouchers: ${codes} applied`);
                    $('#btn-select-cart-voucher').css({
                        'background': '#e8f5e9',
                        'color': '#2e7d32',
                        'borderColor': '#2e7d32'
                    });
                    $('#btn-select-cart-voucher i').css('color', '#2e7d32');
                } else {
                    $('#selected-voucher-label').text('Apply Voucher');
                    $('#btn-select-cart-voucher').css({
                        'background': '#fffdfb',
                        'color': '#C2185B',
                        'borderColor': '#C2185B'
                    });
                    $('#btn-select-cart-voucher i').css('color', '#C2185B');
                }
            }

            // Helper to update unified voucher modal footer selection list
            function updateModalFooterSelection() {
                const selectedCodes = [];
                $('#cart-vouchers-modal .modal-voucher-item.selected').each(function() {
                    const code = $(this).attr('data-code');
                    selectedCodes.push(code);
                });
                if (selectedCodes.length > 0) {
                    $('#cart-modal-selected-code').text(selectedCodes.join(', '));
                } else {
                    $('#cart-modal-selected-code').text('None');
                }
            }

            function updateVoucherAvailability() {
                const selectedItems = cartItems.filter(i => i.selected);
                const $vouchers = $('#cart-vouchers-modal .modal-voucher-item');
                
                if (selectedItems.length === 0) {
                    $vouchers.each(function() {
                        $(this).css({ 'opacity': '1', 'pointer-events': 'auto', 'filter': 'none' });
                        $(this).find('.btn-modal-apply-voucher').css({ 'background': '#fff', 'color': '#C2185B', 'border': '1.5px solid #C2185B' }).text('Apply');
                    });
                    return;
                }

                $vouchers.each(function() {
                    const code = $(this).attr('data-code');
                    const detail = window.activeVouchers ? window.activeVouchers.find(cv => cv.voucherCode === code) : null;
                    if (!detail) return;

                    const minOrderVal = detail.minOrderValue || 0;
                    const applicableBooks = detail.applicableBookIDs || [];
                    const applicableCategories = detail.applicableCategoryIDs || [];

                    const hasBookConstraint = applicableBooks.length > 0;
                    const hasCategoryConstraint = applicableCategories.length > 0;

                    let applicableSubtotalVnd = 0;
                    let hasApplicableItem = false;

                    selectedItems.forEach(item => {
                        const bookIdToCheck = item.isBlind ? item.blindBookID : item.bookID;
                        const categoryIdToCheck = item.categoryID;
                        
                        let isItemApplicable = false;

                        if (!hasBookConstraint && !hasCategoryConstraint) {
                            isItemApplicable = true;
                        } else {
                            if (item.isBlind) {
                                const matchCategory = hasCategoryConstraint && applicableCategories.includes(categoryIdToCheck);
                                if (matchCategory) isItemApplicable = true;
                            } else {
                                const matchBook = hasBookConstraint && applicableBooks.includes(bookIdToCheck);
                                const matchCategory = hasCategoryConstraint && applicableCategories.includes(categoryIdToCheck);
                                if (matchBook || matchCategory) isItemApplicable = true;
                            }
                        }

                        if (isItemApplicable) {
                            applicableSubtotalVnd += getItemPriceVnd(item) * item.qty;
                            hasApplicableItem = true;
                        }
                    });
                    
                    let isValid = hasApplicableItem && applicableSubtotalVnd >= minOrderVal;

                    if (!isValid) {
                        $(this).css({ 'opacity': '0.5', 'pointer-events': 'none', 'filter': 'grayscale(100%)' });
                        $(this).removeClass('selected');
                        $(this).find('.btn-modal-apply-voucher').css({ 'background': '#eee', 'color': '#999', 'border': '1.5px solid #ccc' }).text('Not Eligible');
                    } else {
                        $(this).css({ 'opacity': '1', 'pointer-events': 'auto', 'filter': 'none' });
                        $(this).find('.btn-modal-apply-voucher').css({ 'background': '#fff', 'color': '#C2185B', 'border': '1.5px solid #C2185B' }).text('Apply');
                        if ($(this).hasClass('selected')) $(this).find('.btn-modal-apply-voucher').text('Applied');
                    }
                });
            }

            // Open Cart Vouchers modal
            $(document).on('click', '#btn-select-cart-voucher', async function() {
                $('#cart-vouchers-modal .modal-voucher-item').removeClass('selected');
                $('#cart-vouchers-modal .btn-modal-apply-voucher').text('Apply');

                // Re-fetch and populate vouchers every time modal opens
                await loadActiveVouchers();

                if (appliedVouchers && appliedVouchers.length > 0) {
                    appliedVouchers.forEach(v => {
                        const $item = $(`#cart-vouchers-modal .modal-voucher-item[data-code="${v.code}"]`);
                        $item.addClass('selected');
                    });
                }
                
                updateVoucherAvailability();
                updateModalFooterSelection();
                $('#cart-vouchers-modal').fadeIn(250);
            });

            $(document).on('click', '#btn-close-cart-vouchers, #cart-vouchers-modal .modal-backdrop', function() {
                $('#cart-vouchers-modal').fadeOut(250);
            });

            // Handle voucher click and conflict logic
            $(document).on('click', '#cart-vouchers-modal .modal-voucher-item', function() {
                const code = $(this).attr('data-code');
                const isStackable = $(this).attr('data-stackable') === 'true';
                const currentlySelected = $(this).hasClass('selected');
                
                if (!currentlySelected) {
                    // About to select
                    if (!isStackable) {
                        // If selecting a non-stackable, deselect all others
                        $('#cart-vouchers-modal .modal-voucher-item').removeClass('selected');
                        $('#cart-vouchers-modal .btn-modal-apply-voucher').text('Apply');
                        showToast(`Voucher ${code} cannot be combined with others.`);
                    } else {
                        // If selecting a stackable, ensure no non-stackable is selected
                        const hasNonStackable = $('#cart-vouchers-modal .modal-voucher-item.selected[data-stackable="false"]').length > 0;
                        if (hasNonStackable) {
                            showToast("You have selected a non-stackable voucher. Please remove it first to select multiple vouchers.");
                            return; // Prevent selection
                        }
                    }
                    $(this).addClass('selected');
                    $(this).find('.btn-modal-apply-voucher').text('Applied');
                } else {
                    // Deselecting
                    $(this).removeClass('selected');
                    $(this).find('.btn-modal-apply-voucher').text('Apply');
                }
                updateModalFooterSelection();
            });

            $(document).on('click', '#cart-vouchers-modal .btn-modal-apply-voucher', function(e) {
                e.stopPropagation();
                $(this).closest('.modal-voucher-item').trigger('click');
            });

            $(document).on('click', '#btn-confirm-cart-vouchers', function() {
                appliedVouchers = [];
                $('#cart-vouchers-modal .modal-voucher-item.selected').each(function() {
                    appliedVouchers.push({
                        code: $(this).attr('data-code'),
                        isStackable: $(this).attr('data-stackable') === 'true'
                    });
                });

                if (appliedVouchers.length > 0) {
                    const codes = appliedVouchers.map(v => v.code).join(', ');
                    showToast(`Applied vouchers: ${codes}`);
                } else {
                    showToast("No vouchers applied.");
                }

                $('#cart-vouchers-modal').fadeOut(250);
                calculateTotals();
            });

            $(document).on('click', '#btn-remove-cart-voucher', function() {
                appliedVouchers = [];
                $('#cart-vouchers-modal .modal-voucher-item').removeClass('selected');
                $('#cart-vouchers-modal .btn-modal-apply-voucher').text('Apply');
                $('#cart-modal-selected-code').text('None');
                $('#cart-vouchers-modal').fadeOut(250);
                showToast("All vouchers removed!");
                calculateTotals();
            });

            // Toggle shop items selection
            $(document).on('change', '.shop-checkbox', function() {
                const shopName = $(this).attr('data-shop');
                const isChecked = $(this).is(':checked');

                cartItems.forEach(item => {
                    if (item.shop === shopName) {
                        item.selected = isChecked;
                    }
                });
                BookBlossomCart.saveCartItems(cartItems);
                renderCart();
            });

            // Toggle individual item selection
            $(document).on('change', '.item-checkbox', function() {
                const itemId = $(this).attr('data-id');
                const isChecked = $(this).is(':checked');

                const item = cartItems.find(i => i.id === itemId);
                if (item) {
                    item.selected = isChecked;
                }
                BookBlossomCart.saveCartItems(cartItems);
                renderCart();
            });

            // Quantity Minus Click
            $(document).on('click', '.btn-qty-minus', function() {
                const itemId = $(this).attr('data-id');
                const item = cartItems.find(i => i.id === itemId);

                if (item) {
                    if (item.qty > 1) {
                        try {
                            item.qty -= 1;
                            // Fire and forget API call
                            BookBlossomCart.updateQuantity(itemId, item.qty);
                            renderCart(true); // skip fetch
                        } catch(e) { }
                    } else {
                        // [UPDATED] Replaced native confirm dialog with premium styled custom confirmation modal
                        showCartConfirm(`Remove "${item.title}" from your cart?`, async function () {
                            try {
                                await BookBlossomCart.removeItem(itemId);
                                renderCart();
                                showToast("Item removed from cart");
                            } catch(e) { }
                        });
                    }
                }
            });

            // Quantity Plus Click
            $(document).on('click', '.btn-qty-plus', function() {
                const itemId = $(this).attr('data-id');
                const item = cartItems.find(i => i.id === itemId);

                if (item) {
                    if (item.limit && item.qty >= item.limit) {
                        showToast(`Limit ${item.limit} copy for this item.`);
                        return;
                    }
                    try {
                        item.qty += 1;
                        // Fire and forget API call
                        BookBlossomCart.updateQuantity(itemId, item.qty);
                        renderCart(true); // skip fetch
                    } catch(e) { }
                }
            });

            // Delete Cart Item Click
            $(document).on('click', '.btn-delete-item', async function() {
                const itemId = $(this).attr('data-id');
                const item = cartItems.find(i => i.id === itemId);

                if (item) {
                    // [UPDATED] Replaced native confirm dialog with premium styled custom confirmation modal
                    showCartConfirm(`Remove "${item.title}" from your cart?`, async function () {
                        try {
                            await BookBlossomCart.removeItem(itemId);
                            renderCart();
                            showToast("Item removed from cart");
                        } catch(e) { }
                    });
                }
            });

            // Shop Now click handler
            $(document).on('click', '#btn-cart-shop-now', function() {
                window.location.href = '/Explore';
            });

            // [UPDATED] Global callback for cart checkout success to clear items and vouchers from the cart
            window.onCartCheckoutSuccess = function() {
                cartItems = cartItems.filter(i => !i.selected);
                appliedVouchers = [];
                BookBlossomCart.saveCartItems(cartItems);
                renderCart();
            };

            // [UPDATED] Checkout click handler aligned with direct VND calculations
            $(document).on('click', '#btn-cart-checkout', function() {
                const selectedItems = cartItems.filter(i => i.selected);
                if (selectedItems.length === 0) {
                    showToast("Please select at least one item to checkout!");
                    return;
                }

                let hasBlind = false;
                selectedItems.forEach(item => {
                    if (item.isBlind) hasBlind = true;
                });

                window.checkoutState = {
                    isCart: true,
                    isBlind: hasBlind,
                    subtotal: window.cartCalculatedSubtotalVnd,
                    shippingFee: window.cartCalculatedShippingVnd,
                    discount: window.cartCalculatedDiscountVnd,
                    appliedVouchers: appliedVouchers
                };

                const container = document.getElementById('checkout-applied-vouchers-container');
                const list = document.getElementById('checkout-vouchers-list');
                list.innerHTML = '';
                if (window.cartPlatformDiscountLines && window.cartPlatformDiscountLines.length > 0) {
                    container.style.display = 'block';
                    
                    window.cartPlatformDiscountLines.forEach(lineText => {
                        const badge = document.createElement('div');
                        const bg = '#ffebee';
                        const border = '1px solid #f07c7c';
                        const textCol = '#C2185B';

                        badge.style.cssText = `background: ${bg}; border: ${border}; color: ${textCol}; font-weight: 700; font-size: 0.8rem; padding: 4px 10px; border-radius: 6px; display: flex; align-items: center; gap: 5px;`;
                        badge.innerHTML = `<i class="fas fa-ticket"></i> ${lineText}`;
                        list.appendChild(badge);
                    });
                } else {
                    container.style.display = 'none';
                }

                if (typeof window.populateCheckoutBookInfo === 'function') {
                    // Inject applied vouchers from cart calculation
                    if (window.cartLinesWithVouchers) {
                        selectedItems.forEach(item => {
                            const line = window.cartLinesWithVouchers.find(cl => cl.id === item.id);
                            if (line) {
                                item.appliedVouchers = line.appliedVouchers || [];
                            }
                        });
                    }
                    window.populateCheckoutBookInfo(selectedItems);
                }
                if (typeof window.updateCheckoutTotals === 'function') {
                    window.updateCheckoutTotals();
                }
                if (typeof window.openCheckout === 'function') {
                    window.openCheckout();
                }
            });
            // =========================================================
            // [END UPDATED] SHOPPING CART INTERFACE SPA LOGIC
            // =========================================================

        // Standalone Cart page initialization
        $('#cart-section').show();

        if (window.BookBlossomLayout) {
            window.BookBlossomLayout.refreshNavbar();
            window.BookBlossomLayout.refreshCartBadge();
        } else {
            $('#main-navbar').addClass('navbar-light');
            $('.nav-links a').removeClass('active');
            $('#nav-cart-btn').addClass('active');
        }

        history.replaceState({ view: 'cart' }, '', '/Cart');

        renderCart();
    });
</script>