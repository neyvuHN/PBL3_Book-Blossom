<!-- Shopping Cart Section -->
    <section id="cart-section" class="explore-section cart-page-section" style="padding: 120px 0 80px 0; background: #faf9f6; min-height: 100vh;">
        <div class="container animate__animated animate__fadeIn">
            <!-- Header Banner -->
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <h1 class="cart-title" style="font-family: 'Lora', serif; font-size: 2.5rem; font-weight: 700; color: #111;">Shopping Cart</h1>
                <div class="secure-checkout-badge" style="background: #eef7fc; color: #2b6cb0; padding: 8px 16px; border-radius: 30px; font-weight: 600; font-size: 0.9rem; display: flex; align-items: center; gap: 8px; border: 1px solid #bee3f8;">
                    <i class="fas fa-shield-alt"></i> Secure Checkout
                </div>
            </div>

            <div class="row" id="cart-layout-container">
                <!-- Left: Cart Items -->
                <div class="col-lg-8" id="cart-items-wrapper">
                    <!-- Grouped shop containers will be rendered dynamically -->
                </div>

                <!-- Right: Order Summary -->
                <div class="col-lg-4">
                    <div class="order-summary-card" style="background: #fff; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.03); border: 1px solid #f0f0f0; padding: 24px; position: sticky; top: 100px; transition: all 0.3s ease;">
                        <h3 style="font-family: 'Lora', serif; font-weight: 700; font-size: 1.4rem; color: #111; margin-bottom: 20px; border-bottom: 1px solid #f5f5f5; padding-bottom: 12px;">Order Summary</h3>
                        
                        <!-- [UPDATED] Subtotal in VND -->
                        <div class="d-flex justify-content-between mb-3" style="font-size: 1rem; color: #555;">
                            <span>Subtotal</span>
                            <span id="cart-subtotal" style="font-weight: 600; color: #111;">0 VND</span>
                        </div>

                        <!-- [UPDATED] Shipping Fee in VND -->
                        <div class="d-flex justify-content-between mb-3" style="font-size: 1rem; color: #555;">
                            <span>Shipping Fee</span>
                            <span id="cart-shipping" style="font-weight: 600; color: #111;">30,000 VND</span>
                        </div>

                        <!-- [UPDATED] Premium Voucher Selection Button (Replacing manual textbox input and apply button) -->
                        <div class="voucher-box mb-4">
                            <label style="font-size: 0.85rem; color: #777; font-weight: 600; margin-bottom: 8px; display: block;">Select Voucher Discount</label>
                            <button id="btn-select-cart-voucher" class="btn w-100 d-flex align-items-center justify-content-between" style="border: 1.5px dashed #C2185B; background: #fffdfb; color: #C2185B; font-weight: 600; border-radius: 20px; padding: 10px 16px; font-size: 0.9rem; transition: all 0.2s; cursor: pointer; text-align: left;">
                                <span class="d-flex align-items-center gap-2">
                                    <i class="fas fa-ticket-alt"></i>
                                    <span id="selected-voucher-label">Apply Voucher</span>
                                </span>
                                <i class="fas fa-chevron-right" style="font-size: 0.8rem; color: #C2185B;"></i>
                            </button>
                            <div id="voucher-message" style="font-size: 0.8rem; margin-top: 8px; display: none;"></div>
                        </div>

                        <!-- Separator -->
                        <hr style="border-top: 1.5px dashed #ddd; margin: 20px 0;">

                        <!-- [UPDATED] Total in VND -->
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span style="font-weight: 700; font-size: 1.2rem; color: #111;">Total</span>
                            <div class="text-end">
                                <span id="cart-total" style="font-weight: 800; font-size: 1.6rem; color: #C2185B;">0 VND</span>
                                <div id="cart-discount-badge" style="font-size: 0.8rem; color: #2e7d32; font-weight: 600; display: none;"></div>
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex flex-column gap-3">
                            <button id="btn-cart-checkout" class="btn btn-block" style="background: #C2185B; color: #fff; font-weight: 700; font-size: 1.1rem; padding: 12px; border-radius: 30px; transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1); box-shadow: 0 4px 15px rgba(194, 24, 91, 0.25); border: none;">
                                Checkout
                            </button>
                        </div>

                        <p class="text-center text-muted mt-3" style="font-size: 0.8rem; font-style: italic;">*Shipping calculated at checkout.</p>
                    </div>
                </div>
            </div>

            <!-- Empty State -->
            <div id="empty-cart-state" class="text-center py-5" style="display: none; background: #fff; border-radius: 16px; border: 1px solid #f0f0f0; box-shadow: 0 4px 15px rgba(0,0,0,0.02); padding: 50px 20px;">
                <div style="font-size: 4.5rem; color: #eed5d7; margin-bottom: 20px;"><i class="fas fa-shopping-basket"></i></div>
                <h3 style="font-family: 'Lora', serif; font-weight: 700; font-size: 1.6rem; color: #333; margin-bottom: 10px;">Your Shopping Cart is Empty</h3>
                <p class="text-muted mb-4" style="font-size: 1rem; max-width: 450px; margin: 0 auto 25px auto;">Looks like you haven't added any books to your cart yet. Let's find your next favorite read!</p>
                <button id="btn-cart-shop-now" class="btn" style="background: #C2185B; color: #fff; font-weight: 700; font-size: 1rem; padding: 10px 30px; border-radius: 30px; transition: all 0.2s; border: none;">Shop Now</button>
            </div>
        </div>
    </section>

    <!-- Custom Confirmation Modal for Cart Deletions -->
    <div class="custom-modal" id="cart-confirm-modal" style="display: none; z-index: 11000;">
        <div class="modal-backdrop" style="background: rgba(0, 0, 0, 0.4); backdrop-filter: blur(4px);"></div>
        <div class="modal-box" style="border-radius: 16px; max-width: 420px; padding: 30px; box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15); border: 1px solid #f0f0f0;">
            <h3 style="font-family: 'Lora', serif; font-weight: 700; color: #111; font-size: 1.4rem; margin-bottom: 12px;">Remove Item</h3>
            <p id="cart-confirm-message" style="font-size: 0.95rem; color: #666; line-height: 1.5; margin-bottom: 24px; padding: 0 10px;"></p>
            <div class="modal-btns" style="display: flex; justify-content: center; gap: 12px;">
                <button class="btn-modal-cancel" id="btn-cart-confirm-cancel">Cancel</button>
                <button class="btn-modal-confirm" id="btn-cart-confirm-ok">Remove</button>
            </div>
        </div>
    </div>

    <style>
        .shop-group-card {
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        }
        .shop-group-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.05) !important;
        }
        .cart-item-row:last-child {
            border-bottom: none !important;
        }
        .cart-item-row:hover {
            background-color: #fdfdfd !important;
        }
        .quantity-selector button {
            transition: background 0.2s ease;
        }
        .quantity-selector button:hover {
            background-color: #e2dcd0 !important;
        }
        .btn-qty-minus, .btn-qty-plus {
            border-radius: 50%;
        }
        .order-summary-card {
            transition: all 0.3s ease;
        }
        .mini-voucher-item {
            transition: all 0.2s ease;
        }
        .mini-voucher-item:hover {
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        }

        /* Custom Cart Confirmation Modal Button Styling */
        #cart-confirm-modal .btn-modal-confirm {
            background: #C2185B !important;
            color: #fff !important;
            border: none;
            padding: 10px 24px;
            border-radius: 24px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
        }
        #cart-confirm-modal .btn-modal-confirm:hover {
            background: #a01048 !important;
        }
        #cart-confirm-modal .btn-modal-cancel {
            background: #f5f4f0 !important;
            color: #555 !important;
            border: 1px solid #e2dcd0 !important;
            padding: 10px 24px;
            border-radius: 24px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }
        #cart-confirm-modal .btn-modal-cancel:hover {
            background: #e2dcd0 !important;
            color: #333 !important;
        }
    </style>
