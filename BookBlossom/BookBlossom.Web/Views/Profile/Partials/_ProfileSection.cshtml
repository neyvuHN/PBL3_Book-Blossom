@model BookBlossom.Web.ViewModels.Profile.ProfileViewModel

<!-- Core SVG Definitions for Badge Medals (Common Gradient & DropShadow Definitions) -->
<svg style="position: absolute; width: 0; height: 0; overflow: hidden; pointer-events: none;">
    <defs>
        <!-- Ribbons Gradients -->
        <linearGradient id="ribbonLeftGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#E53935" />
            <stop offset="100%" stop-color="#B71C1C" />
        </linearGradient>
        <linearGradient id="ribbonRightGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#FF5252" />
            <stop offset="100%" stop-color="#C62828" />
        </linearGradient>

        <!-- Gold Medallion Gradient -->
        <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#FFE082" />
            <stop offset="30%" stop-color="#FFB300" />
            <stop offset="70%" stop-color="#FFA000" />
            <stop offset="100%" stop-color="#FF6F00" />
        </linearGradient>
        <linearGradient id="goldInner" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#FFF9C4" />
            <stop offset="40%" stop-color="#FBC02D" />
            <stop offset="100%" stop-color="#F57F17" />
        </linearGradient>

        <!-- Silver Medallion Gradient -->
        <linearGradient id="silverGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#E0E0E0" />
            <stop offset="30%" stop-color="#BDBDBD" />
            <stop offset="70%" stop-color="#9E9E9E" />
            <stop offset="100%" stop-color="#757575" />
        </linearGradient>
        <linearGradient id="silverInner" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#F5F5F5" />
            <stop offset="40%" stop-color="#CFD8DC" />
            <stop offset="100%" stop-color="#90A4AE" />
        </linearGradient>

        <!-- Bronze Medallion Gradient -->
        <linearGradient id="bronzeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#FFCCBC" />
            <stop offset="40%" stop-color="#D84315" />
            <stop offset="100%" stop-color="#BF360C" />
        </linearGradient>
        <linearGradient id="bronzeInner" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#FFE0B2" />
            <stop offset="40%" stop-color="#FFB74D" />
            <stop offset="100%" stop-color="#E65100" />
        </linearGradient>

        <!-- Blue Gradient -->
        <linearGradient id="blueGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#B3E5FC" />
            <stop offset="40%" stop-color="#0288D1" />
            <stop offset="100%" stop-color="#01579B" />
        </linearGradient>
        <linearGradient id="blueInner" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#E1F5FE" />
            <stop offset="40%" stop-color="#29B6F6" />
            <stop offset="100%" stop-color="#0288D1" />
        </linearGradient>

        <!-- Purple Gradient -->
        <linearGradient id="purpleGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#E1BEE7" />
            <stop offset="40%" stop-color="#7B1FA2" />
            <stop offset="100%" stop-color="#4A148C" />
        </linearGradient>
        <linearGradient id="purpleInner" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#F3E5F5" />
            <stop offset="40%" stop-color="#BA68C8" />
            <stop offset="100%" stop-color="#7B1FA2" />
        </linearGradient>

        <!-- Green Gradient -->
        <linearGradient id="greenGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#C8E6C9" />
            <stop offset="40%" stop-color="#388E3C" />
            <stop offset="100%" stop-color="#1B5E20" />
        </linearGradient>
        <linearGradient id="greenInner" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#E8F5E9" />
            <stop offset="40%" stop-color="#81C784" />
            <stop offset="100%" stop-color="#388E3C" />
        </linearGradient>

        <!-- Teal Gradient -->
        <linearGradient id="tealGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#B2DFDB" />
            <stop offset="40%" stop-color="#00796B" />
            <stop offset="100%" stop-color="#004D40" />
        </linearGradient>
        <linearGradient id="tealInner" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#E0F2F1" />
            <stop offset="40%" stop-color="#4DB6AC" />
            <stop offset="100%" stop-color="#00796B" />
        </linearGradient>

        <!-- Crimson Gradient -->
        <linearGradient id="crimsonGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#FFCDD2" />
            <stop offset="40%" stop-color="#D32F2F" />
            <stop offset="100%" stop-color="#B71C1C" />
        </linearGradient>
        <linearGradient id="crimsonInner" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#FFEBEE" />
            <stop offset="40%" stop-color="#E57373" />
            <stop offset="100%" stop-color="#C62828" />
        </linearGradient>
    </defs>
</svg>

<!-- My Account Profile Section -->
<section class="profile-page-section">
    <div class="container profile-container animate__animated animate__fadeIn">
        
        <!-- Header Top Greeting Banner -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center pb-3 border-bottom">
                    <div>
                        <h1 style="font-family: 'Lora', serif; font-size: 2.2rem; font-weight: 700; color: #111; margin-bottom: 5px;">My Account</h1>
                        <p class="text-muted mb-0" style="font-size: 0.95rem;">Manage your public identity, track your privileges, and monitor your membership status.</p>
                    </div>
                    <div class="d-flex gap-2">
                        <button id="btn-edit-profile-toggle" class="btn btn-profile-outline">
                            <i class="fas fa-user-edit me-1"></i> Edit Profile
                        </button>
                        <button id="btn-upgrade-pkg" class="btn btn-profile-theme">
                            <i class="fas fa-rocket me-1"></i> Upgrade Package
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            
            <!-- LEFT COLUMN: Profile Header & Details -->
            <div class="col-lg-4">
                <div class="d-flex flex-column gap-4">
                    
                    <!-- Card 1: Avatar & Bio (Public Identity) -->
                    <div class="profile-card profile-header-card">
                        <div class="profile-header-banner"></div>
                        @{
                            var hasMysticAura = Model.Badges.Contains("Blind Date Adventurer - Destiny");
                            var mysticClass = hasMysticAura ? "mystic-aura" : "";
                        }
                        <div class="profile-avatar-wrapper @mysticClass">
                            <img src="@Model.Avatar" alt="Avatar" class="profile-avatar" id="display-avatar-img">
                            <div class="avatar-edit-badge" title="Change Avatar" id="btn-change-avatar">
                                <i class="fas fa-camera"></i>
                            </div>
                        </div>
                        
                        <h3 id="display-fullname" style="font-family: 'Lora', serif; font-weight: 700; color: #111; margin-bottom: 2px;">@Model.FullName</h3>
                        <span id="display-username" style="color: #C2185B; font-weight: 600; font-size: 0.92rem; display: block; margin-bottom: 12px;">@@@Model.Username</span>
                        
                        <div class="badge-row mb-3">
                            <span class="sub-tier-@Model.SubscriptionPackage" id="display-sub-badge">@Model.SubscriptionPackage Package</span>
                        </div>

                        <p id="display-bio" class="text-muted px-2" style="font-size: 0.9rem; line-height: 1.6; font-style: italic; margin-bottom: 20px;">
                            "@Model.Bio"
                        </p>
                        
                        <div class="text-muted pt-3" style="font-size: 0.82rem; border-top: 1px solid #f6f5f2; font-weight: 500;">
                            <i class="far fa-calendar-alt me-1"></i> Member since @Model.MemberSince.ToString("MMMM dd, yyyy")
                        </div>

                        <!-- Embedded Edit Profile Inline Form (Toggles dynamically) -->
                        <form id="edit-profile-form">
                            <h4 style="font-family: 'Lora', serif; font-weight: 700; font-size: 1.1rem; color: #111; border-bottom: 1px solid #eee; padding-bottom: 10px; margin-bottom: 15px;">Edit Profile</h4>
                            
                            <div class="form-group-custom">
                                <label for="input-fullname">Full Name</label>
                                <input type="text" id="input-fullname" class="form-input-custom" value="@Model.FullName">
                            </div>
                            
                            <div class="form-group-custom">
                                <label for="input-username">Username</label>
                                <input type="text" id="input-username" class="form-input-custom" value="@Model.Username">
                            </div>
                            
                            <div class="form-group-custom">
                                <label for="input-bio">Biography (Bio)</label>
                                <textarea id="input-bio" class="form-input-custom" rows="3" style="resize: none;">@Model.Bio</textarea>
                            </div>
                            
                            <div class="form-group-custom">
                                <label for="input-phone">Phone Number</label>
                                <input type="text" id="input-phone" class="form-input-custom" value="@Model.PhoneNumber" disabled>
                            </div>
                            
                            <div class="form-group-custom">
                                <label for="input-email">Email Address</label>
                                <input type="email" id="input-email" class="form-input-custom" value="@Model.Email" disabled>
                            </div>

                            <div class="form-group-custom">
                                <label for="input-gender">Gender</label>
                                <select id="input-gender" class="form-input-custom">
                                    <option value="Female" selected="@(Model.Gender == "Female")">Female</option>
                                    <option value="Male" selected="@(Model.Gender == "Male")">Male</option>
                                    <option value="Other" selected="@(Model.Gender == "Other")">Other</option>
                                </select>
                            </div>
                            
                            <div class="form-group-custom">
                                <label for="input-birthdate">Birthdate</label>
                                <input type="date" id="input-birthdate" class="form-input-custom" value="@Model.Birthdate.ToString("yyyy-MM-dd")">
                            </div>

                            <div class="d-flex gap-2 mt-3 justify-content-end">
                                <button type="button" id="btn-edit-profile-cancel" class="btn btn-profile-secondary btn-sm">Cancel</button>
                                <button type="submit" id="btn-edit-profile-save" class="btn btn-profile-theme btn-sm">Save Changes</button>
                            </div>
                        </form>
                    </div>

                    <!-- Card 2: Contact & Personal Info -->
                    <div class="profile-card">
                        <h4 style="font-family: 'Lora', serif; font-weight: 700; font-size: 1.25rem; color: #111; margin-bottom: 20px; border-bottom: 1px solid #f6f5f2; padding-bottom: 12px;">Contact & Personal Info</h4>
                        
                        <div class="profile-info-row">
                            <span class="profile-info-label">Phone Number</span>
                            <span class="profile-info-value" id="display-phone">@Model.PhoneNumber</span>
                        </div>
                        
                        <div class="profile-info-row">
                            <span class="profile-info-label">Email Address</span>
                            <span class="profile-info-value" id="display-email">@Model.Email</span>
                        </div>
                        
                        <div class="profile-info-row">
                            <span class="profile-info-label">Gender</span>
                            <span class="profile-info-value" id="display-gender">@Model.Gender</span>
                        </div>
                        
                        <div class="profile-info-row">
                            <span class="profile-info-label">Birthdate</span>
                            <span class="profile-info-value" id="display-birthdate">@Model.Birthdate.ToString("MMMM dd, yyyy")</span>
                        </div>
                    </div>

                    <!-- Card 3: Delivery Addresses -->
                    <div class="profile-card">
                        <div class="d-flex justify-content-between align-items-center mb-3" style="border-bottom: 1px solid #f6f5f2; padding-bottom: 12px;">
                            <h4 style="font-family: 'Lora', serif; font-weight: 700; font-size: 1.25rem; color: #111; margin-bottom: 0;">
                                <i class="fas fa-map-marker-alt me-2" style="color: #C2185B;"></i>Delivery Addresses
                            </h4>
                            <button id="btn-add-address" type="button"
                                style="background: linear-gradient(135deg, #C2185B 0%, #f07c7c 100%); color: #fff; border: none; padding: 6px 14px; border-radius: 20px; font-size: 0.82rem; font-weight: 700; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; gap: 6px;">
                                <i class="fas fa-plus"></i> Add New
                            </button>
                        </div>

                        <div id="address-list-container">
                            @if (!Model.DeliveryAddresses.Any())
                            {
                                <div id="address-empty-hint" style="text-align: center; padding: 20px 0; color: #aaa; font-size: 0.88rem;">
                                    <i class="fas fa-map-marked-alt" style="font-size: 2rem; margin-bottom: 8px; display: block; color: #ddd;"></i>
                                    No saved addresses yet. Add one to speed up checkout!
                                </div>
                            }
                            else
                            {
                                <div id="address-empty-hint" style="display: none; text-align: center; padding: 20px 0; color: #aaa; font-size: 0.88rem;">
                                    <i class="fas fa-map-marked-alt" style="font-size: 2rem; margin-bottom: 8px; display: block; color: #ddd;"></i>
                                    No saved addresses yet. Add one to speed up checkout!
                                </div>
                            }

                            @foreach (var addr in Model.DeliveryAddresses)
                            {
                                <div class="profile-address-item" data-address-id="@addr.AddressID"
                                    style="background: @(addr.IsDefault ? "#fff8fb" : "#fafafa"); border: 1.5px solid @(addr.IsDefault ? "#f5c6d8" : "#eee"); border-radius: 12px; padding: 14px 16px; margin-bottom: 10px; transition: all 0.2s;">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div style="flex: 1;">
                                            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                                                <span style="font-weight: 700; color: #222; font-size: 0.95rem;">@addr.ReceiverName</span>
                                                @if (addr.IsDefault)
                                                {
                                                    <span style="background: #C2185B; color: #fff; font-size: 0.68rem; font-weight: 700; padding: 2px 8px; border-radius: 10px; text-transform: uppercase; letter-spacing: 0.3px;">Default</span>
                                                }
                                            </div>
                                            <div style="color: #666; font-size: 0.85rem; margin-bottom: 2px;"><i class="fas fa-phone me-1" style="color: #aaa; font-size: 0.75rem;"></i>@addr.PhoneNumber</div>
                                            <div style="color: #555; font-size: 0.85rem; line-height: 1.4;"><i class="fas fa-map-pin me-1" style="color: #C2185B; font-size: 0.75rem;"></i>@addr.DetailAddress</div>
                                        </div>
                                        <div style="display: flex; flex-direction: column; gap: 6px; margin-left: 10px;">
                                            <button type="button" class="btn-edit-address"
                                                data-id="@addr.AddressID"
                                                data-name="@addr.ReceiverName"
                                                data-phone="@addr.PhoneNumber"
                                                data-address="@addr.DetailAddress"
                                                data-default="@(addr.IsDefault ? "true" : "false")"
                                                style="background: #f1f5f9; border: none; color: #475569; width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 0.8rem; transition: all 0.2s;" title="Edit">
                                                <i class="fas fa-pen"></i>
                                            </button>
                                            <button type="button" class="btn-delete-address"
                                                data-id="@addr.AddressID"
                                                style="background: #fee2e2; border: none; color: #dc2626; width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 0.8rem; transition: all 0.2s;" title="Delete">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Address Add/Edit Modal -->
                    <div id="profile-address-modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.65); z-index: 10000; align-items: center; justify-content: center; backdrop-filter: blur(5px);">
                        <div id="profile-address-modal-content" style="background: #fff; border-radius: 20px; width: 90%; max-width: 480px; box-shadow: 0 20px 50px rgba(0,0,0,0.2); transform: scale(0.95); opacity: 0; transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);">
                            <div style="padding: 20px 24px; border-bottom: 1px solid #f0f0f0; display: flex; justify-content: space-between; align-items: center;">
                                <h4 id="profile-addr-modal-title" style="margin: 0; font-family: 'Lora', serif; font-size: 1.2rem; font-weight: 700; color: #111;">Add New Address</h4>
                                <button id="btn-close-profile-addr" style="background: none; border: none; font-size: 1.2rem; color: #888; cursor: pointer;"><i class="fas fa-times"></i></button>
                            </div>
                            <div style="padding: 24px; display: flex; flex-direction: column; gap: 16px;">
                                <input type="hidden" id="profile-addr-edit-id" value="">
                                <div class="form-group-custom">
                                    <label for="profile-addr-name">Receiver Name</label>
                                    <input type="text" id="profile-addr-name" class="form-input-custom" placeholder="Full name of receiver">
                                </div>
                                <div class="form-group-custom">
                                    <label for="profile-addr-phone">Phone Number</label>
                                    <input type="tel" id="profile-addr-phone" class="form-input-custom" placeholder="e.g. 0987654321">
                                </div>
                                <div class="form-group-custom">
                                    <label for="profile-addr-detail">Detail Address</label>
                                    <textarea id="profile-addr-detail" class="form-input-custom" rows="3" style="resize: none;" placeholder="Street, Ward, District, City..."></textarea>
                                </div>
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <input type="checkbox" id="profile-addr-default" style="width: 16px; height: 16px; accent-color: #C2185B; cursor: pointer;">
                                    <label for="profile-addr-default" style="margin: 0; font-size: 0.9rem; font-weight: 600; color: #444; cursor: pointer;">Set as default address</label>
                                </div>
                            </div>
                            <div style="padding: 16px 24px; border-top: 1px solid #f0f0f0; display: flex; justify-content: flex-end; gap: 10px; background: #fafafa; border-radius: 0 0 20px 20px;">
                                <button id="btn-cancel-profile-addr" type="button" style="background: transparent; color: #555; border: 1.5px solid #ddd; padding: 9px 20px; border-radius: 20px; font-weight: 700; font-size: 0.9rem; cursor: pointer;">Cancel</button>
                                <button id="btn-save-profile-addr" type="button" style="background: linear-gradient(135deg, #C2185B 0%, #f07c7c 100%); color: #fff; border: none; padding: 9px 22px; border-radius: 20px; font-weight: 700; font-size: 0.9rem; cursor: pointer; box-shadow: 0 4px 12px rgba(194,24,91,0.2);">Save Address</button>
                            </div>
                        </div>
                    </div>

                    <!-- Change Password Modal -->
                    <div id="profile-password-modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.65); z-index: 10000; align-items: center; justify-content: center; backdrop-filter: blur(5px);">
                        <div id="profile-password-modal-content" style="background: #fff; border-radius: 20px; width: 90%; max-width: 480px; box-shadow: 0 20px 50px rgba(0,0,0,0.2); transform: scale(0.95); opacity: 0; transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);">
                            <div style="padding: 20px 24px; border-bottom: 1px solid #f0f0f0; display: flex; justify-content: space-between; align-items: center;">
                                <h4 style="margin: 0; font-family: 'Lora', serif; font-size: 1.2rem; font-weight: 700; color: #111;">Đổi Mật Khẩu</h4>
                                <button id="btn-close-profile-pwd" style="background: none; border: none; font-size: 1.2rem; color: #888; cursor: pointer;"><i class="fas fa-times"></i></button>
                            </div>
                            <div style="padding: 24px; display: flex; flex-direction: column; gap: 16px;">
                                <div class="form-group-custom">
                                    <label for="profile-pwd-old">Mật khẩu hiện tại</label>
                                    <input type="password" id="profile-pwd-old" class="form-input-custom" placeholder="Nhập mật khẩu hiện tại" required>
                                    <span id="err-profile-pwd-old" class="validation-error-msg" style="color: #C2185B; font-size: 0.78rem; margin-top: 4px; display: none;"></span>
                                </div>
                                <div class="form-group-custom">
                                    <label for="profile-pwd-new">Mật khẩu mới</label>
                                    <input type="password" id="profile-pwd-new" class="form-input-custom" placeholder="Tối thiểu 6 ký tự" required>
                                    <span id="err-profile-pwd-new" class="validation-error-msg" style="color: #C2185B; font-size: 0.78rem; margin-top: 4px; display: none;"></span>
                                </div>
                                <div class="form-group-custom">
                                    <label for="profile-pwd-confirm">Xác nhận mật khẩu mới</label>
                                    <input type="password" id="profile-pwd-confirm" class="form-input-custom" placeholder="Nhập lại mật khẩu mới" required>
                                    <span id="err-profile-pwd-confirm" class="validation-error-msg" style="color: #C2185B; font-size: 0.78rem; margin-top: 4px; display: none;"></span>
                                </div>
                            </div>
                            <div style="padding: 16px 24px; border-top: 1px solid #f0f0f0; display: flex; justify-content: flex-end; gap: 10px; background: #fafafa; border-radius: 0 0 20px 20px;">
                                <button id="btn-cancel-profile-pwd" type="button" style="background: transparent; color: #555; border: 1.5px solid #ddd; padding: 9px 20px; border-radius: 20px; font-weight: 700; font-size: 0.9rem; cursor: pointer;">Hủy bỏ</button>
                                <button id="btn-save-profile-pwd" type="button" style="background: linear-gradient(135deg, #C2185B 0%, #f07c7c 100%); color: #fff; border: none; padding: 9px 22px; border-radius: 20px; font-weight: 700; font-size: 0.9rem; cursor: pointer; box-shadow: 0 4px 12px rgba(194,24,91,0.2);">Đổi Mật Khẩu</button>
                            </div>
                        </div>
                    </div>

                    <!-- Custom Delete Confirmation Modal -->
                    <div id="profile-address-delete-modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.65); z-index: 10000; align-items: center; justify-content: center; backdrop-filter: blur(5px);">
                        <div id="profile-address-delete-modal-content" style="background: #fff; border-radius: 20px; width: 90%; max-width: 400px; box-shadow: 0 20px 50px rgba(0,0,0,0.2); transform: scale(0.95); opacity: 0; transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1); text-align: center; padding: 30px 24px;">
                            <div style="width: 60px; height: 60px; background: #fee2e2; color: #dc2626; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; font-size: 1.8rem;">
                                <i class="fas fa-exclamation-triangle"></i>
                            </div>
                            <h4 style="margin: 0 0 10px; font-family: 'Lora', serif; font-size: 1.25rem; font-weight: 700; color: #111;">Delete Address</h4>
                            <p style="color: #666; font-size: 0.9rem; margin-bottom: 24px; line-height: 1.5;">Are you sure you want to delete this address? This action cannot be undone.</p>
                            <div style="display: flex; gap: 12px; justify-content: center;">
                                <button id="btn-cancel-delete-addr" style="flex: 1; background: #f1f5f9; color: #475569; border: none; padding: 10px; border-radius: 20px; font-weight: 700; font-size: 0.9rem; cursor: pointer; transition: all 0.2s;">Cancel</button>
                                <button id="btn-confirm-delete-addr" style="flex: 1; background: #dc2626; color: #fff; border: none; padding: 10px; border-radius: 20px; font-weight: 700; font-size: 0.9rem; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 12px rgba(220,38,38,0.2);">Delete</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: Account Status & Progression metrics -->
            <div class="col-lg-8">
                <div class="d-flex flex-column gap-4">
                    
                    <!-- Row 1: Membership Tier & Reputation Metrics -->
                    <div class="row g-4">
                        
                        <!-- Col 1.1: Membership Level Card -->
                        <div class="col-md-6">
                            <div class="profile-card d-flex flex-column justify-content-between">
                                <div>
                                    <h4 style="font-family: 'Lora', serif; font-weight: 700; font-size: 1.25rem; color: #111; margin-bottom: 10px;">Membership Tier</h4>
                                    
                                    <div class="d-flex align-items-center gap-3 mb-3">
                                        <span class="tier-badge tier-@Model.MembershipTier" id="display-tier-badge">
                                            <i class="fas fa-crown"></i> <span id="display-tier-text">@Model.MembershipTier</span> Tier
                                        </span>
                                    </div>
                                    
                                    <p class="text-muted" style="font-size: 0.88rem; line-height: 1.5;">
                                        Maintain Diamond status to receive priority customer care, early access to Blind Date Books events, and free monthly delivery!
                                    </p>
                                </div>
                                
                                <div class="premium-progress-container pt-3" style="border-top: 1px solid #f6f5f2;">
                                    <div class="progress-label-row">
                                        <span>Spending Progress</span>
                                        <span id="display-spending-text">@Model.TotalSpending.ToString("N0") / @Model.NextTierThreshold.ToString("N0") VND</span>
                                    </div>
                                    <div class="premium-progress-bg">
                                        @{
                                            var spendingPercent = (Model.TotalSpending / Model.NextTierThreshold) * 100;
                                        }
                                        <div class="premium-progress-fill" id="display-spending-progress" style="width: @spendingPercent.ToString("0")%;"></div>
                                    </div>
                                    <span class="text-muted" style="font-size: 0.78rem; display: block; font-style: italic;" id="display-spending-hint">
                                        @if (Model.MembershipTier == "Diamond")
                                        {
                                            <span>🎉 You have reached the maximum Tier spending milestone!</span>
                                        }
                                        else
                                        {
                                            <span>Spend <strong>@((Model.NextTierThreshold - Model.TotalSpending).ToString("N0")) VND</strong> more to reach @Model.NextTierName Tier!</span>
                                        }
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Col 1.2: Reputation System Card -->
                        <div class="col-md-6">
                            <div class="profile-card text-center">
                                <h4 style="font-family: 'Lora', serif; font-weight: 700; font-size: 1.25rem; color: #111; margin-bottom: 15px; text-align: left;">Reputation Score</h4>
                                
                                <div class="reputation-circle-container">
                                    <!-- Embedded dynamic custom indicator element -->
                                    <svg viewBox="0 0 36 36" style="width: 100%; height: 100%; transform: rotate(-90deg);">
                                        <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" 
                                              fill="none" stroke="#f0ebe1" stroke-width="2.5" />
                                        @{
                                            var repPercent = ((double)Model.ReputationScore / Model.MaxReputationScore) * 100;
                                        }
                                        <path id="reputation-svg-fill" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" 
                                              fill="none" stroke="#C2185B" stroke-width="2.5" stroke-dasharray="@repPercent.ToString("0"), 100" />
                                    </svg>
                                    <div class="reputation-value-box">
                                        <span class="reputation-score-big" id="display-rep-score">@Model.ReputationScore</span>
                                        <span class="reputation-score-max">/ @Model.MaxReputationScore pts</span>
                                    </div>
                                </div>

                                <!-- Privilege warnings -->
                                @{
                                    var warningClass = "warning-safe";
                                    var warningIcon = "fa-check-circle";
                                    var warningMessage = "Your reputation score is stellar! You have full commenting, posting privileges and COD checkout active.";
                                    
                                    if (Model.ReputationScore < 60)
                                    {
                                        warningClass = "warning-danger";
                                        warningIcon = "fa-exclamation-triangle";
                                        warningMessage = "Warning: Reputation score too low (< 60). Commenting & Thread posting is BANNED, and Cash on Delivery (COD) method is DISABLED.";
                                    }
                                    else if (Model.ReputationScore < 80)
                                    {
                                        warningClass = "warning-warning";
                                        warningIcon = "fa-exclamation-circle";
                                        warningMessage = "Warning: Reputation score low (< 80). Thread posting & Commenting are BANNED. Keep score above 80 to restore community privileges.";
                                    }
                                }
                                <div class="reputation-warning-card @warningClass" id="reputation-warning-box">
                                    <i class="fas @warningIcon" style="margin-top: 3px; font-size: 1.1rem;"></i>
                                    <span id="reputation-warning-message">@warningMessage</span>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Row 2: Order Streak & Limits Progression -->
                    <div class="row g-4">
                        
                        <!-- Col 2.1: Order Streak Progress -->
                        <div class="col-md-5">
                            <div class="profile-card d-flex flex-column justify-content-between">
                                <div>
                                    <h4 style="font-family: 'Lora', serif; font-weight: 700; font-size: 1.25rem; color: #111; margin-bottom: 8px;">Order Streak</h4>
                                    <p class="text-muted" style="font-size: 0.85rem; line-height: 1.5;">
                                        Deliver 3 successful consecutive orders to secure a <strong>+10 Reputation points bonus!</strong>
                                    </p>
                                </div>
                                
                                <div class="streak-box py-3">
                                    <div class="streak-steps-container">
                                        <div class="streak-line-bg"></div>
                                        @{
                                            var totalStreak = 3;
                                            var currentStreak = Math.Clamp(Model.CurrentOrderStreak, 1, totalStreak);

                                            var streakProgress = (currentStreak - 1) * 1.0 / (totalStreak - 1);
                                        }

                                        <div class="streak-line-fill"
                                            id="display-streak-line"
                                            style="--streak-progress: @streakProgress.ToString(System.Globalization.CultureInfo.InvariantCulture);">
                                        </div>
                                        
                                        <div class="streak-step @(Model.CurrentOrderStreak >= 1 ? "completed" : "active")" id="streak-step-1">
                                            @if (Model.CurrentOrderStreak >= 1)
                                            {
                                                <i class="fas fa-check"></i>
                                            }
                                            else
                                            {
                                                <span>1</span>
                                            }
                                        </div>
                                        <div class="streak-step @(Model.CurrentOrderStreak >= 2 ? "completed" : (Model.CurrentOrderStreak == 1 ? "active" : ""))" id="streak-step-2">
                                            @if (Model.CurrentOrderStreak >= 2)
                                            {
                                                <i class="fas fa-check"></i>
                                            }
                                            else
                                            {
                                                <span>2</span>
                                            }
                                        </div>
                                        <div class="streak-step @(Model.CurrentOrderStreak >= 3 ? "completed" : (Model.CurrentOrderStreak == 2 ? "active" : ""))" id="streak-step-3">
                                            @if (Model.CurrentOrderStreak >= 3)
                                            {
                                                <i class="fas fa-trophy"></i>
                                            }
                                            else
                                            {
                                                <span>3</span>
                                            }
                                        </div>
                                    </div>
                                    
                                    <div class="text-center mt-3">
                                        <span class="text-muted" style="font-size: 0.8rem; font-weight: 600;" id="display-streak-status">
                                            @if (Model.CurrentOrderStreak >= 3)
                                            {
                                                <span>🎉 Streak Goal Achieved! Bonus claimed.</span>
                                            }
                                            else
                                            {
                                                <span>Current Streak: <strong>@Model.CurrentOrderStreak/3 successful orders</strong></span>
                                            }
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Col 2.2: Limits Display Card (Threads & Undos) -->
                        <div class="col-md-7">
                            <div class="profile-card">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h4 style="font-family: 'Lora', serif; font-weight: 700; font-size: 1.25rem; color: #111; margin-bottom: 0;">Subscription Limits</h4>
                                    <span style="font-size: 0.78rem; background: #eef7fc; color: #2b6cb0; border-radius: 12px; padding: 3px 10px; font-weight: 600; border: 1px solid #bee3f8;">
                                        <i class="fas fa-info-circle me-1"></i> Based on @Model.SubscriptionPackage
                                    </span>
                                </div>

                                <!-- Thread Posting Limit -->
                                <div class="limit-item-box">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="limit-icon-header">
                                            <i class="fas fa-comments"></i> Monthly Thread Limit
                                        </span>
                                        @{
                                            var isProPlan = Model.SubscriptionPackage == "Pro";
                                            var threadLabelText = isProPlan ? $"{Model.CurrentMonthThreadCount} / Unlimited" : $"{Model.CurrentMonthThreadCount} / {Model.MaxMonthlyThreadLimit} posts";
                                            var threadFillPercent = isProPlan ? 100.0 : Math.Min(100.0, ((double)Model.CurrentMonthThreadCount / Model.MaxMonthlyThreadLimit) * 100);
                                        }
                                        <span id="display-thread-counter" style="font-size: 0.85rem; font-weight: 700; color: #333;">@threadLabelText</span>
                                    </div>
                                    <div class="premium-progress-bg" style="height: 6px;">
                                        <div class="premium-progress-fill" id="display-thread-progress" style="width: @threadFillPercent.ToString("0")%;"></div>
                                    </div>
                                    <div class="d-flex justify-content-between" style="font-size: 0.72rem; color: #888;">
                                        <span>Usage: @(isProPlan ? "0" : threadFillPercent.ToString("0"))%</span>
                                        <span id="display-thread-reset">Resets: @Model.LastThreadResetDate.AddMonths(1).ToString("MM/dd/yyyy")</span>
                                    </div>
                                </div>

                                <!-- Daily Undo Tindbook Limit -->
                                <div class="limit-item-box mb-0">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="limit-icon-header">
                                            <i class="fas fa-undo"></i> Daily Tindbook Undo Limit
                                        </span>
                                        @{
                                            var undoLabelText = isProPlan ? $"{Model.DailyUndoCount} / Unlimited" : $"{Model.DailyUndoCount} / {Model.MaxDailyUndoLimit} undos";
                                            var undoFillPercent = isProPlan ? 100.0 : Math.Min(100.0, ((double)Model.DailyUndoCount / Model.MaxDailyUndoLimit) * 100);
                                        }
                                        <span id="display-undo-counter" style="font-size: 0.85rem; font-weight: 700; color: #333;">@undoLabelText</span>
                                    </div>
                                    <div class="premium-progress-bg" style="height: 6px;">
                                        <div class="premium-progress-fill" id="display-undo-progress" style="width: @undoFillPercent.ToString("0")%;"></div>
                                    </div>
                                    <div class="d-flex justify-content-between" style="font-size: 0.72rem; color: #888;">
                                        <span>Usage: @(isProPlan ? "0" : undoFillPercent.ToString("0"))%</span>
                                        <span id="display-undo-reset">Resets: Tonight at 12:00 AM</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Row 3: Badges Showcase Cabinet -->
                    <div class="row">
                        <div class="col-12">
                            <div class="profile-card">
                                <h4 style="font-family: 'Lora', serif; font-weight: 700; font-size: 1.25rem; color: #111; margin-bottom: 8px;">Badge Cabinet Collection</h4>
                                <p class="text-muted" style="font-size: 0.88rem; margin-bottom: 15px;">
                                    Stand out in the community! Collect badges by contributing quality reviews, shopping blind dates, or keeping high streaks.
                                </p>
                                
                                <div class="badges-grid" id="display-badges-cabinet">
                                    @{
                                        var displayCount = 0;
                                        var maxDisplay = 4;
                                        var sortedBadges = Model.AllBadgeNames
                                            .OrderByDescending(b => Model.Badges.Contains(b))
                                            .ToList();
                                        foreach (var badge in sortedBadges)
                                        {
                                            if (displayCount >= maxDisplay) break;
                                            var isEarned = Model.Badges.Contains(badge);
                                            @Html.Raw(GetMedalHtml(badge, "small", isEarned))
                                            displayCount++;
                                        }
                                    }
                                    
                                    <div class="badge-medal-view-all" data-bs-toggle="modal" data-bs-target="#allBadgesModal">
                                        <div class="view-all-circle">
                                            <i class="fas fa-eye" style="font-size: 1.15rem; margin-bottom: 0;"></i>
                                        </div>
                                        <span class="view-all-label">View All</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>

    </div>
</section>

<!-- Modal for All Badges -->
<div class="modal fade" id="allBadgesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content custom-modal-content" style="border-radius: 16px; border: none; box-shadow: 0 15px 40px rgba(0,0,0,0.12);">
            <div class="modal-header border-0 pb-0" style="padding: 24px 24px 10px;">
                <h5 class="modal-title" style="font-family: 'Lora', serif; font-weight: 700; color: #111; font-size: 1.5rem;">All Earned Badges</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding: 10px 24px 24px;">
                <p class="text-muted" style="font-size: 0.9rem; margin-bottom: 20px;">All badges in the BookBlossom community. Earned: <strong>@Model.Badges.Count</strong> / @Model.AllBadgeNames.Count</p>
                <div class="d-flex flex-column gap-3">
                    @foreach (var badge in Model.AllBadgeNames.OrderByDescending(b => Model.Badges.Contains(b)))
                    {
                        var earned = Model.Badges.Contains(badge);
                        @Html.Raw(GetMedalHtml(badge, "large", earned))
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Premium Subscriptions Upgrade Plan (Full Screen dark-dimmed backdrop popup) -->
<div id="subscription-modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.76); z-index: 9999; align-items: center; justify-content: center; backdrop-filter: blur(8px); transition: all 0.3s ease;">
    <div id="subscription-modal-content" style="background: #fff; border-radius: 24px; width: 95%; max-width: 920px; box-shadow: 0 25px 60px rgba(0, 0, 0, 0.3); display: flex; flex-direction: column; transform: scale(0.95); opacity: 0; transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1); overflow: hidden;">
