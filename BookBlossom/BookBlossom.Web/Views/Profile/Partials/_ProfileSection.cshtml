                        <li><i class="fas fa-check-circle" style="color: #10b981; margin-right: 8px;"></i> <span class="plan-undo-limit">Unlimited</span> Tindbook undos</li>
                        <li><i class="fas fa-check-circle" style="color: #10b981; margin-right: 8px;"></i> Sage Badge & sharing honors</li>
                        <li><i class="fas fa-check-circle" style="color: #10b981; margin-right: 8px;"></i> Mystic Destiny glow aura active</li>
                    </ul>
                </div>
                <button class="btn-select-plan select-premium" data-plan="Pro" data-package-id="0" data-price="200000" style="margin-top: 30px; width: 100%; background: linear-gradient(135deg, #7b1fa2 0%, #c084fc 100%); color: #fff; border: none; padding: 12px; border-radius: 30px; font-weight: 700; font-size: 0.95rem; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 12px rgba(123, 31, 162, 0.25);">Upgrade Now</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Changing Avatar (Fullscreen Overlay) -->
<div id="avatar-cropper-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.85); z-index: 10000; align-items: center; justify-content: center; backdrop-filter: blur(10px); transition: all 0.3s ease;">
    <div id="avatar-cropper-content" style="background: #ffffff; border-radius: 24px; width: 90%; max-width: 600px; box-shadow: 0 25px 60px rgba(0, 0, 0, 0.4); display: flex; flex-direction: column; transform: scale(0.95); opacity: 0; transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1); overflow: hidden;">
        <!-- Header -->
        <div style="padding: 20px 24px; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h3 style="margin: 0; font-family: 'Lora', serif; font-size: 1.4rem; font-weight: 800; color: #0f172a;">Update Profile Avatar</h3>
                <p style="margin: 4px 0 0; color: #64748b; font-size: 0.85rem;">Upload and crop your avatar image to fit perfectly.</p>
            </div>
            <button id="btn-close-cropper" style="background: #f1f5f9; border: none; font-size: 1rem; color: #475569; width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s;"><i class="fas fa-times"></i></button>
        </div>
        
        <!-- Body -->
        <div style="padding: 24px; display: flex; flex-direction: column; align-items: center; gap: 20px; background: #f8fafc;">
            <!-- Hidden File Input -->
            <input type="file" id="avatar-file-input" accept="image/*" style="display: none;">
            
            <!-- Upload Placeholder (shown when no image selected) -->
            <div id="cropper-upload-placeholder" style="width: 100%; height: 300px; border: 2px dashed #cbd5e1; border-radius: 16px; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; background: #ffffff; transition: all 0.2s ease;">
                <i class="fas fa-cloud-upload-alt" style="font-size: 3rem; color: #C2185B; margin-bottom: 12px;"></i>
                <span style="font-weight: 700; color: #0f172a; font-size: 1rem;">Click to upload an image</span>
                <span style="color: #64748b; font-size: 0.8rem; margin-top: 4px;">Supports PNG, JPG, JPEG</span>
            </div>
            
            <!-- Crop Container (shown when image is loaded) -->
            <div id="cropper-workspace" style="display: none; width: 100%; height: 300px; background: #0f172a; border-radius: 16px; position: relative; overflow: hidden; justify-content: center; align-items: center;">
                <!-- Target Image -->
                <img id="cropper-image" src="" style="position: absolute; cursor: move; user-select: none; max-width: none; max-height: none; transform-origin: center center;" alt="Avatar Cropper">
                
                <!-- Crop Grid Overlay -->
                <div id="cropper-grid" style="position: absolute; width: 200px; height: 200px; border: 2px solid #ffffff; border-radius: 50%; box-shadow: 0 0 0 9999px rgba(15, 23, 42, 0.7); pointer-events: none; display: flex; align-items: center; justify-content: center;">
                    <!-- Grid Lines inside the crop circle -->
                    <div style="position: absolute; top: 0; bottom: 0; left: 33.33%; width: 1px; border-left: 1px dashed rgba(255, 255, 255, 0.45);"></div>
                    <div style="position: absolute; top: 0; bottom: 0; left: 66.66%; width: 1px; border-left: 1px dashed rgba(255, 255, 255, 0.45);"></div>
                    <div style="position: absolute; left: 0; right: 0; top: 33.33%; height: 1px; border-top: 1px dashed rgba(255, 255, 255, 0.45);"></div>
                    <div style="position: absolute; left: 0; right: 0; top: 66.66%; height: 1px; border-top: 1px dashed rgba(255, 255, 255, 0.45);"></div>
                </div>
            </div>
            
            <!-- Controls (Zoom Slider & Re-upload) -->
            <div id="cropper-controls" style="display: none; width: 100%; flex-direction: column; gap: 12px;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <button type="button" id="btn-zoom-out" style="background: #ffffff; border: 1px solid #cbd5e1; border-radius: 50%; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; cursor: pointer; color: #475569;"><i class="fas fa-minus"></i></button>
                    <input type="range" id="zoom-range" min="0.1" max="3" step="0.05" value="1" style="flex: 1; height: 6px; background: #e2e8f0; border-radius: 3px; outline: none; accent-color: #C2185B;">
                    <button type="button" id="btn-zoom-in" style="background: #ffffff; border: 1px solid #cbd5e1; border-radius: 50%; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; cursor: pointer; color: #475569;"><i class="fas fa-plus"></i></button>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-size: 0.8rem; color: #64748b;"><i class="fas fa-info-circle me-1"></i> Drag the image to reposition it</span>
                    <button type="button" id="btn-reupload" style="background: transparent; border: none; color: #C2185B; font-weight: 700; font-size: 0.85rem; cursor: pointer;"><i class="fas fa-redo me-1"></i> Choose another photo</button>
                </div>
            </div>
        </div>
        
        <!-- Footer Actions -->
        <div style="padding: 20px 24px; border-top: 1px solid #f1f5f9; display: flex; justify-content: flex-end; gap: 12px;">
            <button type="button" id="btn-cancel-cropper" class="btn btn-profile-secondary btn-sm" style="padding: 10px 24px; border-radius: 30px;">Cancel</button>
            <button type="button" id="btn-save-cropper" class="btn btn-profile-theme btn-sm" style="padding: 10px 24px; border-radius: 30px;" disabled>Apply Changes</button>
        </div>
    </div>
</div>

@functions {
    public string GetMedalHtml(string badgeName, string sizeClass, bool isEarned = true) {
        string scallopGrad = "goldGrad";
        string innerGrad = "goldInner";
        string iconClass = "fa-medal";
        string desc = "A well-deserved badge of honor.";
        string themeClass = "theme-gold";
        string levelClass = "";

        // Define mapping for earned dates
        var earnedDates = new Dictionary<string, string> {
            { "Review Champion - Explorer", "February 14, 2025" },
            { "Review Champion - Critic", "April 18, 2025" },
            { "Review Champion - Sage", "May 12, 2026" },
            { "Knowledge Ambassador", "March 05, 2025" },
            { "Blind Date Adventurer - Curious", "January 20, 2025" },
            { "Blind Date Adventurer - Seeker", "March 22, 2025" },
            { "Blind Date Adventurer - Destiny", "November 15, 2025" },
            { "True Bookworm", "February 01, 2025" },
            { "Exemplary User", "August 10, 2025" },
            { "Moderator Assistant", "December 05, 2025" }
        };

        string earnedDate = Model.BadgeEarnedDates.ContainsKey(badgeName) ? Model.BadgeEarnedDates[badgeName] : (earnedDates.ContainsKey(badgeName) ? earnedDates[badgeName] : "May 29, 2026");

        if (badgeName == "Review Champion - Explorer") {
            scallopGrad = "bronzeGrad";
            innerGrad = "bronzeInner";
            iconClass = "fa-star";
            desc = "Write 5 book reviews with photos.";
            themeClass = "theme-bronze";
            levelClass = "medal-lvl1";
        } else if (badgeName == "Review Champion - Critic") {
            scallopGrad = "silverGrad";
            innerGrad = "silverInner";
            iconClass = "fa-star";
            desc = "Write 20 high-quality reviews (with >= 5 likes).";
            themeClass = "theme-silver";
            levelClass = "medal-lvl2";
        } else if (badgeName == "Review Champion - Sage") {
            scallopGrad = "goldGrad";
            innerGrad = "goldInner";
            iconClass = "fa-star";
            desc = "Write 50 high-quality reviews and rank in the Top 'Reviews of the Month'.";
            themeClass = "theme-gold";
            levelClass = "medal-lvl3";
        } else if (badgeName == "Knowledge Ambassador") {
            scallopGrad = "blueGrad";
            innerGrad = "blueInner";
            iconClass = "fa-share-nodes";
            desc = "Actively share book links or posts to Facebook or Instagram from Web.";
            themeClass = "theme-blue";
        } else if (badgeName == "Blind Date Adventurer - Curious") {
            scallopGrad = "purpleGrad";
            innerGrad = "purpleInner";
            iconClass = "fa-mask";
            desc = "Purchase 3 Blind Date book orders.";
            themeClass = "theme-purple";
            levelClass = "medal-lvl1";
        } else if (badgeName == "Blind Date Adventurer - Seeker") {
            scallopGrad = "purpleGrad";
            innerGrad = "purpleInner";
            iconClass = "fa-mask";
            desc = "Purchase 10 Blind Date book orders.";
            themeClass = "theme-purple";
            levelClass = "medal-lvl2";
        } else if (badgeName == "Blind Date Adventurer - Destiny") {
            scallopGrad = "purpleGrad";
            innerGrad = "purpleInner";
            iconClass = "fa-mask";
            desc = "Purchase 25 Blind Date book orders to unlock a mysterious purple avatar glow.";
            themeClass = "theme-purple theme-destiny";
            levelClass = "medal-lvl3";
        } else if (badgeName == "True Bookworm") {
            scallopGrad = "greenGrad";
            innerGrad = "greenInner";
            iconClass = "fa-book-open";
            desc = "Purchase books across 5 diverse genres (e.g. Psychology, Novel, Horror).";
            themeClass = "theme-green";
        } else if (badgeName == "Exemplary User") {
            scallopGrad = "tealGrad";
            innerGrad = "tealInner";
            iconClass = "fa-shield-halved";
            desc = "Maintain the maximum reputation score of 150 points for 3 consecutive months.";
            themeClass = "theme-teal";
        } else if (badgeName == "Moderator Assistant") {
            scallopGrad = "crimsonGrad";
            innerGrad = "crimsonInner";
            iconClass = "fa-hands-helping";
            desc = "Submit more than 10 accurate violation reports to help keep the community clean.";
            themeClass = "theme-crimson";
        }

        if (sizeClass == "small") {
            var lockedStyle = isEarned ? "" : "filter: grayscale(100%) opacity(0.45);";
            var lockedTitle = isEarned ? $"{badgeName}: {desc}" : $"🔒 {badgeName} (Locked)";
            return $@"
                <div class=""badge-medal {themeClass} {levelClass}"" title=""{lockedTitle}"" style=""{lockedStyle}"">
                    <div class=""medal-container"">
                        <svg class=""medal-svg"" viewBox=""0 0 100 100"">
                            <path class=""ribbon-tail-left"" d=""M 36 50 L 15 92 L 32 83 L 45 92 Z"" fill=""url(#ribbonLeftGrad)"" />
                            <path class=""ribbon-tail-right"" d=""M 64 50 L 85 92 L 68 83 L 55 92 Z"" fill=""url(#ribbonRightGrad)"" />
                            <polygon class=""medal-scallop-base"" fill=""url(#{scallopGrad})"" points=""
                                50,5 53.5,10 58.7,6.3 60.9,12.1 67.2,10.2 68.1,16.7 75,16.4 74.4,22.9 81.3,24.1 79.2,30.3 85.7,32.7 82.2,38.4 87.7,41.9 83,47.1 87.2,51.5 81.5,55.9 84.4,61.4 78,64.8 79.5,70.9 72.8,73.1 73.1,79.5 66.2,80.5 65.1,86.9 58.5,86.4 56.4,92.5 50,90.5 43.6,92.5 41.5,86.4 34.9,86.9 33.8,80.5 26.9,79.5 27.2,73.1 20.5,70.9 22,64.8 15.6,61.4 18.5,55.9 12.8,51.5 17,47.1 12.3,41.9 17.8,38.4 14.3,32.7 20.8,30.3 18.7,24.1 25.6,22.9 25,16.4 31.9,16.7 32.8,10.2 39.1,12.1 41.3,6.3 46.5,10
                            "" />
                            <circle class=""medal-center"" cx=""50"" cy=""50"" r=""31.5"" fill=""url(#{innerGrad})"" />
                            <circle cx=""50"" cy=""50"" r=""28"" fill=""none"" stroke=""#FFFFFF"" stroke-opacity=""0.4"" stroke-width=""0.75"" />
                            <path class=""medal-gloss"" d=""M 23 35 A 31.5 31.5 0 0 1 77 35 A 31.5 28 0 0 0 23 35 Z"" fill=""rgba(255,255,255,0.18)"" />
                        </svg>
                        <div class=""medal-icon-container"">
                            <i class=""fas {(isEarned ? iconClass : "fa-lock")}""></i>
                        </div>
                    </div>
                    <span class=""medal-title"">{badgeName}</span>
                </div>";
        } else {
            var lockedRowStyle = isEarned ? "" : "filter: grayscale(100%) opacity(0.5);";
            var dateHtml = isEarned
                ? $@"<span class=""badge-earned-date""><i class=""far fa-calendar-alt""></i> Earned on: {earnedDate}</span>"
                : $@"<span class=""badge-earned-date"" style=""color:#b0b0b0;""><i class=""fas fa-lock""></i> Not yet earned</span>";
            return $@"
                <div class=""badge-modal-medal-row {themeClass} {levelClass}"" style=""{lockedRowStyle}"">
                    <div class=""medal-container"" style=""width: 70px; height: 80px;"">
                        <svg class=""medal-svg"" viewBox=""0 0 100 100"">
