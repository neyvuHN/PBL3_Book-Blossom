<!-- Report Review Modal -->
<div class="custom-modal" id="report-review-modal" style="display: none;">
    <div class="modal-backdrop"></div>
    <div class="modal-box">
        <h3>Report Review</h3>
        <p>Why are you reporting this review?</p>

        <div class="report-review-options" style="text-align: left; margin-bottom: 20px;">
            <label style="display: block; margin-bottom: 10px; cursor: pointer;">
                <input type="radio" name="report-review-reason" value="spam"> Spam
            </label>

            <label style="display: block; margin-bottom: 10px; cursor: pointer;">
                <input type="radio" name="report-review-reason" value="harassment"> Harassment
            </label>

            <label style="display: block; margin-bottom: 10px; cursor: pointer;">
                <input type="radio" name="report-review-reason" value="inappropriate"> Inappropriate Content
            </label>

            <label style="display: block; margin-bottom: 10px; cursor: pointer;">
                <input type="radio" name="report-review-reason" value="other"> Other
            </label>

            <div class="other-review-reason-container" style="display: none; margin-top: 10px;">
                <textarea id="other-review-reason-text"
                          placeholder="Please specify your reason..."
                          style="width: 100%; border: 1px solid #ddd; padding: 10px; border-radius: 8px; font-size: 0.9rem; resize: vertical;"></textarea>
            </div>
        </div>

        <div class="modal-btns">
            <button class="btn-modal-cancel" id="btn-cancel-review-report">Cancel</button>
            <button class="btn-modal-confirm" id="btn-submit-review-report">Submit Report</button>
        </div>
    </div>
</div>

<!-- Delete Review Modal -->
<div class="custom-modal" id="delete-review-modal" style="display: none;">
    <div class="modal-backdrop"></div>
    <div class="modal-box">
        <h3>Delete Review</h3>
        <p>Are you sure you want to delete this review?</p>

        <div class="modal-btns">
            <button class="btn-modal-cancel" id="btn-cancel-delete-review">Cancel</button>
            <button class="btn-modal-confirm btn-modal-danger" id="btn-confirm-delete-review">Delete</button>
        </div>
    </div>
</div>