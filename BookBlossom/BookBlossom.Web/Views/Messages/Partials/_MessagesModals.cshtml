<!-- Tag Book Modal -->
    <div class="custom-modal" id="tag-book-modal" style="display: none;">
        <div class="modal-backdrop"></div>
        <div class="modal-box" style="max-width: 500px;">
            <h3>Tag a Book</h3>
            
            <div class="modal-tabs" style="display: flex; gap: 10px; margin-bottom: 15px;">
                <button class="btn-modal-tab active" data-target="tab-link">By Link</button>
                <button class="btn-modal-tab" data-target="tab-recent">Recent</button>
                <button class="btn-modal-tab" data-target="tab-wishlist">Wishlist</button>
            </div>
            
            <!-- Tab Link -->
            <div id="tab-link" class="modal-tab-content active">
                <p>Enter the link to the book page on BookBlossom:</p>
                <input type="text" id="tag-book-link" class="form-control mb-3" placeholder="https://bookblossom.com/book/123" style="width: 100%; border: 1px solid #f0e2e5; padding: 10px 15px; border-radius: 8px; font-size: 0.9rem; margin-bottom: 10px;">
                <div id="link-error" style="color: #ff4444; font-size: 0.85rem; display: none; margin-bottom: 10px; text-align: left;">Link must be from BookBlossom domain (contains 'bookblossom.com' or starts with '/').</div>
            </div>
            
                        <!-- Tab Recent -->
            <div id="tab-recent" class="modal-tab-content" style="display: none;">
                <p>Select a recently viewed book:</p>
                <div class="book-select-list" id="recent-books-list" style="max-height: 200px; overflow-y: auto;">
                    <div style="text-align: center; padding: 20px; color: #888;">Loading recent books...</div>
                </div>
            </div>
            
                        <!-- Tab Wishlist -->
            <div id="tab-wishlist" class="modal-tab-content" style="display: none;">
                <p>Select a book from your wishlist:</p>
                <div class="book-select-list" id="wishlist-books-list" style="max-height: 200px; overflow-y: auto;">
                    <div style="text-align: center; padding: 20px; color: #888;">Loading wishlist...</div>
                </div>
            </div>
            
            <div class="modal-btns mt-3">
                <button class="btn-modal-cancel" id="btn-cancel-tag-book">Cancel</button>
                <button class="btn-modal-confirm" id="btn-confirm-tag-book">Tag Book</button>
            </div>
        </div>
    </div>

    <style>
        .shared-picture-card:hover .shared-grid-img {
            transform: scale(1.08);
        }
        .shared-picture-card:hover .shared-card-overlay {
            opacity: 1 !important;
        }
        .shared-picture-card:hover .btn-hover-eye-icon {
            transform: translateY(0) !important;
        }
        .shared-picture-card:hover {
            border-color: #C2185B !important;
            box-shadow: 0 6px 20px rgba(194, 24, 91, 0.15) !important;
        }
    </style>

    <!-- Shared Pictures Modal -->
    <div class="custom-modal" id="shared-pictures-modal" style="display: none; z-index: 9999;">
        <div class="modal-backdrop" style="background: rgba(10, 4, 6, 0.85); backdrop-filter: blur(8px);"></div>
        <div class="modal-box" style="max-width: 600px; background: #fff; border-radius: 20px; border: 1.5px solid #EEC7C9; box-shadow: 0 10px 40px rgba(194, 24, 91, 0.15); padding: 25px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 2px solid #F4E1E2; padding-bottom: 12px;">
                <h3 style="margin: 0; font-size: 1.3rem; font-weight: 800; color: #C2185B; display: flex; align-items: center; gap: 8px;"><i class="far fa-images"></i> Shared Pictures</h3>
                <button class="btn-close-shared-modal" style="background: none; border: none; font-size: 1.25rem; color: #888; cursor: pointer; transition: color 0.2s;" onmouseover="this.style.color='#C2185B'" onmouseout="this.style.color='#888'"><i class="fas fa-times"></i></button>
            </div>
            
            <div class="shared-pictures-grid-container" id="shared-pictures-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 15px; max-height: 400px; overflow-y: auto; padding: 5px;">
                <!-- Populated dynamically via JS -->
            </div>
            
            <div id="shared-pictures-empty" style="display: none; text-align: center; padding: 40px 20px; color: #999;">
                <i class="far fa-image" style="font-size: 3rem; color: #EEC7C9; margin-bottom: 12px; display: block;"></i>
                <p style="margin: 0; font-size: 0.95rem; font-weight: 500;">No pictures have been shared in this chat yet. 🌸</p>
            </div>
        </div>
    </div>

    <!-- Shared Book Links Modal -->
    <div class="custom-modal" id="shared-links-modal" style="display: none; z-index: 9999;">
        <div class="modal-backdrop" style="background: rgba(10, 4, 6, 0.85); backdrop-filter: blur(8px);"></div>
        <div class="modal-box" style="max-width: 500px; background: #fff; border-radius: 20px; border: 1.5px solid #EEC7C9; box-shadow: 0 10px 40px rgba(194, 24, 91, 0.15); padding: 25px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 2px solid #F4E1E2; padding-bottom: 12px;">
                <h3 style="margin: 0; font-size: 1.3rem; font-weight: 800; color: #C2185B; display: flex; align-items: center; gap: 8px;"><i class="fas fa-link"></i> Shared Book Links</h3>
                <button class="btn-close-shared-modal" style="background: none; border: none; font-size: 1.25rem; color: #888; cursor: pointer; transition: color 0.2s;" onmouseover="this.style.color='#C2185B'" onmouseout="this.style.color='#888'"><i class="fas fa-times"></i></button>
            </div>
            
            <div class="shared-links-list-container" id="shared-links-list" style="display: flex; flex-direction: column; gap: 12px; max-height: 400px; overflow-y: auto; padding: 5px;">
                <!-- Populated dynamically via JS -->
            </div>
            
            <div id="shared-links-empty" style="display: none; text-align: center; padding: 40px 20px; color: #999;">
                <i class="fas fa-link" style="font-size: 3rem; color: #EEC7C9; margin-bottom: 12px; display: block;"></i>
                <p style="margin: 0; font-size: 0.95rem; font-weight: 500;">No book links have been shared in this chat yet. 🌸</p>
            </div>
        </div>
    </div>

    <!-- Lightbox Modal -->
    <div id="chat-image-lightbox" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(10, 4, 6, 0.9); backdrop-filter: blur(10px); z-index: 9999; justify-content: center; align-items: center; cursor: zoom-out;">
        <img id="lightbox-img" src="" style="max-width: 90%; max-height: 90%; object-fit: contain; border-radius: 8px; box-shadow: 0 10px 40px rgba(0,0,0,0.5); transition: transform 0.3s ease;">
        <video id="lightbox-video" src="" controls style="display: none; max-width: 90%; max-height: 90%; object-fit: contain; border-radius: 8px; box-shadow: 0 10px 40px rgba(0,0,0,0.5); outline: none;"></video>
        <button style="position: absolute; top: 20px; right: 20px; background: none; border: none; color: #fff; font-size: 2rem; cursor: pointer; opacity: 0.8; transition: opacity 0.2s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.8'"><i class="fas fa-times"></i></button>
        
        <!-- View in Chat button inside Lightbox -->
        <button id="btn-lightbox-scroll-to-msg" style="position: absolute; bottom: 30px; left: 50%; transform: translateX(-50%); background: #C2185B; color: #fff; border: none; padding: 12px 28px; border-radius: 30px; font-weight: 700; font-size: 0.9rem; cursor: pointer; display: none; align-items: center; gap: 8px; box-shadow: 0 6px 20px rgba(194, 24, 91, 0.4); transition: all 0.2s; outline: none; z-index: 10000;" onmouseover="this.style.background='#a0134a'; this.style.transform='translateX(-50%) scale(1.05)';" onmouseout="this.style.background='#C2185B'; this.style.transform='translateX(-50%)';">
            <i class="fas fa-eye"></i> View in Chat
        </button>
    </div>

    <!-- Support / Call Center Modal -->
    <div class="custom-modal" id="call-center-modal" style="display: none; z-index: 9999;">
        <div class="modal-backdrop" style="background: rgba(10, 4, 6, 0.85); backdrop-filter: blur(8px);"></div>
        <div class="modal-box" style="max-width: 500px; background: #fff; border-radius: 20px; border: 1.5px solid #EEC7C9; box-shadow: 0 10px 40px rgba(194, 24, 91, 0.15); padding: 25px; box-sizing: border-box;">
            
            <!-- Header -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 2px solid #F4E1E2; padding-bottom: 12px;">
                <h3 style="margin: 0; font-size: 1.25rem; font-weight: 800; color: #C2185B; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-headset"></i> Support Request
                </h3>
                <button type="button" class="btn-close-call-modal" style="background: none; border: none; font-size: 1.25rem; color: #888; cursor: pointer; transition: color 0.2s;" onmouseover="this.style.color='#C2185B'" onmouseout="this.style.color='#888'"><i class="fas fa-times"></i></button>
            </div>
            
            <!-- Content Form -->
            <form id="call-center-form" style="display: flex; flex-direction: column; gap: 15px;">
                
                <!-- Subtitle -->
                <div style="font-size: 0.9rem; font-weight: 600; color: #444; margin-bottom: 2px;">
                    Request support from BookBlossom Shop
                </div>
                
                <!-- Question / Category Select -->
                <div>
                    <label style="display: block; font-size: 0.82rem; font-weight: 700; color: #C2185B; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">
                        What do you need help with?
                    </label>
                    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px;">
                        <label style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: #555; cursor: pointer; padding: 8px 12px; border: 1.5px solid #F4E1E2; border-radius: 10px; transition: all 0.2s;" class="support-checkbox-label" onmouseover="this.style.borderColor='#EEC7C9'" onmouseout="if(!$(this).find('input').is(':checked')) this.style.borderColor='#F4E1E2'">
                            <input type="checkbox" name="supportTopic" value="Product / Book" style="accent-color: #C2185B;"> Product / Book
                        </label>
                        <label style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: #555; cursor: pointer; padding: 8px 12px; border: 1.5px solid #F4E1E2; border-radius: 10px; transition: all 0.2s;" class="support-checkbox-label" onmouseover="this.style.borderColor='#EEC7C9'" onmouseout="if(!$(this).find('input').is(':checked')) this.style.borderColor='#F4E1E2'">
                            <input type="checkbox" name="supportTopic" value="Order" style="accent-color: #C2185B;"> Order
                        </label>
                        <label style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: #555; cursor: pointer; padding: 8px 12px; border: 1.5px solid #F4E1E2; border-radius: 10px; transition: all 0.2s;" class="support-checkbox-label" onmouseover="this.style.borderColor='#EEC7C9'" onmouseout="if(!$(this).find('input').is(':checked')) this.style.borderColor='#F4E1E2'">
                            <input type="checkbox" name="supportTopic" value="Payment" style="accent-color: #C2185B;"> Payment
                        </label>
                        <label style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: #555; cursor: pointer; padding: 8px 12px; border: 1.5px solid #F4E1E2; border-radius: 10px; transition: all 0.2s;" class="support-checkbox-label" onmouseover="this.style.borderColor='#EEC7C9'" onmouseout="if(!$(this).find('input').is(':checked')) this.style.borderColor='#F4E1E2'">
                            <input type="checkbox" name="supportTopic" value="Shipping" style="accent-color: #C2185B;"> Shipping
                        </label>
                        <label style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: #555; cursor: pointer; padding: 8px 12px; border: 1.5px solid #F4E1E2; border-radius: 10px; transition: all 0.2s;" class="support-checkbox-label" onmouseover="this.style.borderColor='#EEC7C9'" onmouseout="if(!$(this).find('input').is(':checked')) this.style.borderColor='#F4E1E2'">
                            <input type="checkbox" name="supportTopic" value="Complaint / Refund" style="accent-color: #C2185B;"> Complaint / Refund
                        </label>
                        <label style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: #555; cursor: pointer; padding: 8px 12px; border: 1.5px solid #F4E1E2; border-radius: 10px; transition: all 0.2s;" class="support-checkbox-label" onmouseover="this.style.borderColor='#EEC7C9'" onmouseout="if(!$(this).find('input').is(':checked')) this.style.borderColor='#F4E1E2'">
                            <input type="checkbox" name="supportTopic" value="Other" style="accent-color: #C2185B;"> Other
                        </label>
                    </div>
                </div>
                
                <!-- Phone Input -->
                <div>
                    <label style="display: block; font-size: 0.82rem; font-weight: 700; color: #C2185B; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">
                        Phone Number for Callback
                    </label>
                    <input type="tel" id="support-phone" placeholder="09xxxxxxxx" required style="width: 100%; border: 1.5px solid #EEC7C9; border-radius: 10px; padding: 10px 14px; font-size: 0.9rem; outline: none; transition: border-color 0.2s; box-sizing: border-box;" onfocus="this.style.borderColor='#C2185B'" onblur="this.style.borderColor='#EEC7C9'">
                </div>
                
                <!-- Additional Notes -->
                <div>
                    <label style="display: block; font-size: 0.82rem; font-weight: 700; color: #C2185B; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">
                        Additional Notes
                    </label>
                    <textarea id="support-notes" placeholder="I'd like to know more about this Blind Date Book..." rows="3" style="width: 100%; border: 1.5px solid #EEC7C9; border-radius: 10px; padding: 10px 14px; font-size: 0.9rem; outline: none; transition: border-color 0.2s; box-sizing: border-box; resize: none;" onfocus="this.style.borderColor='#C2185B'" onblur="this.style.borderColor='#EEC7C9'"></textarea>
                </div>
                
                <!-- Footer / Actions -->
                <div style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 10px; border-top: 2px solid #F4E1E2; padding-top: 15px;">
                    <button type="button" class="btn-close-call-modal" style="border: none; background: #f5f5f5; color: #666; padding: 10px 20px; border-radius: 10px; font-size: 0.88rem; font-weight: 700; cursor: pointer; transition: background 0.2s;" onmouseover="this.style.background='#e0e0e0'" onmouseout="this.style.background='#f5f5f5'">Cancel</button>
                    <button type="submit" style="border: none; background: #C2185B; color: #fff; padding: 10px 24px; border-radius: 10px; font-size: 0.88rem; font-weight: 700; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 12px rgba(194, 24, 91, 0.25);" onmouseover="this.style.background='#a0134a'; this.style.transform='translateY(-1px)';" onmouseout="this.style.background='#C2185B'; this.style.transform='none';">Submit Support Request</button>
                </div>
            </form>
        </div>
    </div>