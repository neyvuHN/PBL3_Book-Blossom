<!-- Blind Date Books Section (Hidden by default) -->
    <section id="blind-date-section" class="explore-section blind-date-page-section">
        <!-- Hero Banner -->
        <div class="blind-hero">
            <div class="blind-hero-content">
                <div class="blind-hero-text">
                    <h1>Find Your Next Bookish Love.</h1>
                    <p>Unbox a mystery read based on vibe, not cover.</p>
                    <span>Blind Date with a Book.</span>
                    <a href="#" class="btn-how-it-works">How it works <i class="fas fa-chevron-down"></i></a>
                </div>
                <div class="blind-hero-illustration">
                    <img src="/images/BlindDateBook/Vector.png">
                </div>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="blind-container">
            <!-- Sidebar Filters: The Matchmaker -->
            <aside class="blind-sidebar" id="blind-sidebar">
                <div class="sidebar-header-flex" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                    <h2 class="sidebar-title" style="margin-bottom: 0;">The Matchmaker</h2>
                    <button class="btn-hide-sidebar" id="btn-hide-sidebar" style="background: none; border: none; color: #a291b5; cursor: pointer; font-size: 0.9rem;">
                        <i class="fas fa-times"></i> Hide
                    </button>
                </div>

                <div class="filter-section">
                    <h4>Vibe Tag Cloud</h4>
                    <div class="tag-cloud" id="blind-vibe-tag-cloud">
                        <!-- Dynamically populated from database -->
                    </div>
                </div>

                <div class="filter-section">
                    <h4>Price Slider (thousand VNĐ)</h4>
                    <div class="price-range-wrapper">
                        <div class="dual-range-slider">
                            <div class="price-slider-track" id="blind-price-track"></div>
                            <input type="range" min="0" max="1000" value="0" class="min-range" id="blind-price-min">
                            <input type="range" min="0" max="1000" value="1000" class="max-range" id="blind-price-max">
                            <div class="slider-tooltip" id="blind-tooltip-min">0</div>
                            <div class="slider-tooltip" id="blind-tooltip-max">1000</div>
                        </div>
                        <div class="price-input-group" style="display: flex; gap: 10px; margin-top: 25px;">
                            <div class="price-field">
                                <span style="font-size: 0.8rem; color: #888;">Min</span>
                                <input type="number" id="blind-price-min-input" value="0" style="width: 100%; padding: 5px; border: 1px solid #ddd; border-radius: 4px;">
                            </div>
                            <div class="price-field">
                                <span style="font-size: 0.8rem; color: #888;">Max</span>
                                <input type="number" id="blind-price-max-input" value="1000" style="width: 100%; padding: 5px; border: 1px solid #ddd; border-radius: 4px;">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="filter-section">
                    <h4>Genre</h4>
                    <div class="filter-checkbox-list" id="blind-genre-checkbox-list">
                        <!-- Dynamically populated from database -->
                    </div>
                </div>

                <div class="filter-section">
                    <h4>Condition</h4>
                    <div class="filter-checkbox-list">
                        <label class="filter-checkbox-item">
                            <input type="checkbox" id="cond-pristine" value="Pristine - Like new" checked> ✨ Pristine - Like new
                        </label>
                        <label class="filter-checkbox-item">
                            <input type="checkbox" id="cond-gift" value="Gift-ready" checked> 🎁 Gift-ready
                        </label>
                        <label class="filter-checkbox-item">
                            <input type="checkbox" id="cond-loved" value="Well Loved" checked> 💓 Well Loved
                        </label>
                        <label class="filter-checkbox-item">
                            <input type="checkbox" id="cond-gently" value="Gently read" checked> 📖 Gently read
                        </label>
                    </div>
                </div>
            </aside>

            <!-- Main Content Grid -->
            <main class="blind-main">
                <a href="#" class="clear-filters">Clear All Filters</a>

                <div class="blind-grid" id="blind-date-grid">
                    <!-- Cards will be populated dynamically from the API -->
                    <div class="loading-placeholder text-center" style="grid-column: 1 / -1; padding: 50px; color: #a291b5;">
                        <i class="fas fa-spinner fa-spin fa-3x" style="margin-bottom: 15px;"></i>
                        <p style="font-size: 1.1rem; font-weight: 600;">Loading book matches...</p>
                    </div>
                </div>
            </main>
        </div>

        <!-- Toggle Button for Mobile/Control -->
        <button class="btn-toggle-matchmaker" id="btn-toggle-matchmaker">
            <i class="fas fa-filter"></i>
        </button>
    </section>
