            // 4. Star Filtering & Hearts Sorting logic
            function filterAndSortDetailReviews() {
                const activeStar = $('.btn-star-filter.active').data('star').toString();
                const sortOption = $('#detail-review-sort').val();
                const $reviewsList = $('.product-reviews-list');
                const $reviews = $('.prod-review-item').get();
                
                // Filter reviews
                $reviews.forEach(function(item) {
                    const $item = $(item);
                    const rating = $item.attr('data-rating').toString();
                    
                    const starMatch = (activeStar === 'all' || rating === activeStar);
                    
                    if (starMatch) {
                        $item.show();
                    } else {
                        $item.hide();
                    }
                });
                
                // Sort reviews based on data-likes or original order
                if (sortOption === 'most-hearts') {
                    $reviews.sort(function(a, b) {
                        const likesA = parseInt($(a).attr('data-likes')) || 0;
                        const likesB = parseInt($(b).attr('data-likes')) || 0;
                        return likesB - likesA; // Descending
                    });
                    $reviewsList.append($reviews);
                } else if (sortOption === 'least-hearts') {
                    $reviews.sort(function(a, b) {
                        const likesA = parseInt($(a).attr('data-likes')) || 0;
                        const likesB = parseInt($(b).attr('data-likes')) || 0;
                        return likesA - likesB; // Ascending
                    });
                    $reviewsList.append($reviews);
                } else {
                    // Default order: restore original elements by data-index
                    $reviews.sort(function(a, b) {
                        const indexA = parseInt($(a).attr('data-index')) || 0;
                        const indexB = parseInt($(b).attr('data-index')) || 0;
                        return indexA - indexB;
                    });
                    $reviewsList.append($reviews);
                }
            }
            
