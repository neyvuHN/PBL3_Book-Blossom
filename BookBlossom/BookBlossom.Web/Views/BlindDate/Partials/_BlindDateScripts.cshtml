            // --- BLIND DATE FULLSCREEN LIGHTBOX INTERACTIVE LOGIC ---
            function openBlindLightbox() {
                const $modal = $('#blind-lightbox-modal');
                $modal.fadeIn(300);
                
                updateBlindLightboxImage(currentBlindImageIndex);
                $('body').css('overflow', 'hidden');
            }

            function closeBlindLightbox() {
                $('#blind-lightbox-modal').fadeOut(250, function() {
                    $('body').css('overflow', '');
                });
            }

            function updateBlindLightboxImage(index) {
                const $thumbs = $('.blind-thumb-wrapper');
                if (index < 0 || index >= $thumbs.length) return;
                
                currentBlindImageIndex = index;
                
                $('#blind-lightbox-current-idx').text(index + 1);
                $('#blind-lightbox-total-idx').text($thumbs.length);
                
                const clickedImgSrc = $thumbs.eq(index).find('img').attr('src');
                const $lightboxImg = $('#blind-lightbox-main-img');
                
                $lightboxImg.css('transform', 'scale(0.95)').css('opacity', '0.7');
                setTimeout(function() {
                    $lightboxImg.attr('src', clickedImgSrc);
                    $lightboxImg.css('transform', 'scale(1)').css('opacity', '1');
                }, 150);
                
                // Sync the main page details gallery view perfectly
                $thumbs.css('border-color', 'transparent');
                $thumbs.eq(index).css('border-color', '#a291b5');
                $('#blind-detail-main-img').attr('src', clickedImgSrc);
            }

            // Click main cover image to open fullscreen lightbox
            $(document).on('click', '#blind-detail-main-img', function() {
                openBlindLightbox();
            });

            // Close actions for Blind Date Lightbox
            $(document).on('click', '.blind-lightbox-close, #blind-lightbox-modal .modal-backdrop', function() {
                closeBlindLightbox();
            });

            // Close lightbox when clicking background areas
            $(document).on('click', '#blind-lightbox-wrapper', function(e) {
                if ($(e.target).closest('#blind-lightbox-main-img, .lightbox-arrow, .lightbox-toolbar, button').length === 0) {
                    closeBlindLightbox();
                }
            });

            // Inside Lightbox arrow clicks
            $(document).on('click', '.blind-lightbox-prev', function(e) {
                e.stopPropagation();
                const $thumbs = $('.blind-thumb-wrapper');
                let targetIndex = currentBlindImageIndex - 1;
                if (targetIndex < 0) {
                    targetIndex = $thumbs.length - 1;
                }
                updateBlindLightboxImage(targetIndex);
            });
            
