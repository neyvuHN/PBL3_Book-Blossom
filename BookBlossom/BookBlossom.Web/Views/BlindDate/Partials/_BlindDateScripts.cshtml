            // --- PREMIUM PRODUCT DETAILS SPA LOGIC ---
            let previousActiveSection = '#main-content';
            let detailImagesArray = [];
            let currentDetailImageIndex = 0;

            function showProductDetails(bookData, push = true) {
                // Determine current visible section to save as return point
                if ($mainContent.is(':visible')) {
                    previousActiveSection = '#main-content';
                } else if ($exploreSection.is(':visible')) {
                    previousActiveSection = '#explore-section';
                } else if ($dedicatedCommunity.is(':visible')) {
                    previousActiveSection = '#dedicated-community';
                } else if ($tindbookFeature.is(':visible')) {
                    previousActiveSection = '#tindbook-feature';
                } else if ($('#blind-date-section').is(':visible')) {
                    previousActiveSection = '#blind-date-section';
                } else if ($('#reviews-section').is(':visible')) {
                    previousActiveSection = '#reviews-section';
                } else if ($('#cart-section').is(':visible')) {
                    previousActiveSection = '#cart-section';
                }

                // Hide other sections
                $mainContent.hide();
                $exploreSection.hide();
                $dedicatedCommunity.hide();
                $tindbookFeature.hide();
                $('#blind-date-section').hide();
                $('#reviews-section').hide();
                $('#cart-section').hide();
                
                // Populate data
                $('#detail-title').text(bookData.title);
                $('#breadcrumb-title').text(bookData.title);
                $('#detail-author').text(bookData.author);
                
                // Reset active thumbnail & tracking array
                currentDetailImageIndex = 0;
                
                // Update covers and thumbnails with actual distinct book images from wwwroot/images/Book for demo
                const demoImages = [
                    '/images/Book/book1.jpg',
                    '/images/Book/book2.webp',
                    '/images/Book/book3.avif',
                    '/images/Book/book4.jpg',
                    '/images/Book/book5.jpg',
                    '/images/Book/book6.webp'
                ];
                
                // Filter out the current main image to avoid duplicating it in subsequent thumbnails
                const otherImages = demoImages.filter(img => img !== bookData.imgSrc);
                
                // We want 4 images in total: main image + 3 distinct other images
                detailImagesArray = [bookData.imgSrc, ...otherImages.slice(0, 3)];
                
                // Update the thumbnails
                $('.thumb-item').each(function(index) {
                    if (index < detailImagesArray.length) {
                        $(this).show();
                        $(this).find('img').attr('src', detailImagesArray[index]);
                    } else {
                        $(this).hide();
                    }
                });
                
                $('#detail-main-img').attr('src', bookData.imgSrc);
                
                // Reset active thumbnail class
                $('.thumb-item').removeClass('active');
                $('.thumb-item').first().addClass('active');

                // Dynamic details based on title hash for realistic feel
                let hash = 0;
                for (let i = 0; i < bookData.title.length; i++) {
                    hash = bookData.title.charCodeAt(i) + ((hash << 5) - hash);
                }
                hash = Math.abs(hash);
                
                // Set overall rating stars and counts
                const baseRating = 4.2 + ((hash % 8) / 10);
                const ratingString = baseRating.toFixed(1);
                $('#detail-rating-num').text(ratingString);
                
                // Stars rendering in html
                let starsHtml = '';
                const fullStars = Math.floor(baseRating);
                const hasHalf = (baseRating % 1) >= 0.4;
                for (let s = 1; s <= 5; s++) {
                    if (s <= fullStars) {
                        starsHtml += '<i class="fas fa-star"></i>';
                    } else if (s === fullStars + 1 && hasHalf) {
                        starsHtml += '<i class="fas fa-star-half-alt"></i>';
                    } else {
                        starsHtml += '<i class="far fa-star"></i>';
                    }
                }
                starsHtml += `<strong id="detail-rating-num" style="color: #111; margin-left: 6px;">${ratingString}</strong>`;
                $('.rating-stars').html(starsHtml);

                const reviewsCount = (hash % 120) + 18;
                $('#detail-reviews-count').text(`${reviewsCount} Reviews`);
                $('#detail-tab-rev-count').text(reviewsCount);
                
                const soldCount = (hash % 1800) + 140;
                $('#detail-sold-count').html(`<i class="fas fa-shopping-bag"></i> ${soldCount.toLocaleString()} Sold`);

                // Generate consistent price and discount tag
                let discountPercent = (hash % 4) * 10; // 0%, 10%, 20%, 30%
                if (discountPercent === 0) discountPercent = 20; // default 20%
                
                let numericPrice = 120000 + ((hash % 15) * 15000);
                let discountedPrice = Math.round(numericPrice * (100 - discountPercent) / 100);
                
                $('#detail-price').text(discountedPrice.toLocaleString() + ' VND');
                $('#detail-original-price').text(numericPrice.toLocaleString() + ' VND');
                $('#detail-discount').text(`-${discountPercent}%`);

                // Specs table dynamic population
                const categories = ["Fiction", "Psychology", "Self-Help", "Economics", "History"];
                const selectedGenre = categories[hash % categories.length];
                $('#breadcrumb-genre').text(selectedGenre);

                const publishers = ["Ace Books", "NXB Trẻ", "NXB Kim Đồng", "Penguin Books", "HarperCollins"];
                const selectedPublisher = publishers[hash % publishers.length];
                $('#spec-publisher').text(selectedPublisher);

                const isbnSeed = 9780000000000 + (hash * 1337);
                $('#spec-isbn').text(isbnSeed.toString().replace(/(\d{3})(\d{1})(\d{6})(\d{3})/, '$1-$2-$3-$4'));

                // Populate new premium bookstore details
                $('#meta-author').text(bookData.author);
                $('#meta-publisher').text(selectedPublisher);
                $('#meta-supplier').text(selectedPublisher);
                
                const coverFormats = ["Paperback", "Hardcover", "Deluxe Edition", "Leatherbound"];
                $('#meta-format').text(coverFormats[hash % coverFormats.length]);
                
                // Dynamically calculate shipping estimate date (3 days from now)
                const estDate = new Date();
                estDate.setDate(estDate.getDate() + 3);
                const dateOptions = { weekday: 'long', day: '2-digit', month: '2-digit' };
                const dateFormatted = estDate.toLocaleDateString('en-US', dateOptions);
                $('#shipping-est-date').text(`Estimated delivery inside 2-3 business days (by ${dateFormatted})`);

                // Descriptions custom text
                const sampleTexts = [
                    "A timeless masterpiece exploring power, legacy, and human struggle. Richly characterized and highly praised by the BookBlossom community for its depth and emotional resonance.",
                    "An insightful study of human nature, habits, and resilience. This volume offers highly practical guidance and inspiring case studies that will stay with you long after the final chapter.",
                    "A gorgeous narrative full of wonder and emotional depth. It captures the essence of self-discovery and the beauty of life's unpredictable journeys. Excellent reading choice.",
                    "A brilliant analytical overview of society, economics, and human behavior. Highly informative and detailed, it challenges conventional wisdom and provides fresh, modern perspectives."
                ];
                $('#detail-desc-text').text(sampleTexts[hash % sampleTexts.length]);

                // Reset quantities
                $('#input-qty').val(1);
                
                // Reset tab states
                $('.detail-tab-header').removeClass('active');
                $('[data-tab="tab-desc"]').addClass('active');
                $('.detail-tab-pane').hide();
                $('#tab-desc').show();

                // Reset wishlist button state
                $('#btn-toggle-wishlist').find('i').attr('class', 'far fa-heart').css('color', '');
                $('#btn-toggle-wishlist').css('border-color', '#ddd').css('background', '#fff');

                // Update Chat with Book Blossom link dynamically with active book query params
                const activeBookHash = `#book-details-${encodeURIComponent(bookData.title)}`;
                const fullBookLink = window.location.origin + '/' + activeBookHash;
                const bookChatHref = `/Messages?title=${encodeURIComponent(bookData.title)}&price=${encodeURIComponent(discountedPrice.toLocaleString() + ' VND')}&img=${encodeURIComponent(bookData.imgSrc)}&link=${encodeURIComponent(fullBookLink)}`;
                $('#btn-detail-chat').attr('href', bookChatHref);

                // Display details
                $('#product-details-section').show();
                $mainNavbar.addClass('navbar-light');
                
                // Scroll to top
                window.scrollTo(0, 0);

                if (push) {
                    history.pushState({ view: 'product-details', bookData: bookData, previousActiveSection: previousActiveSection }, '', `#book-details-${encodeURIComponent(bookData.title)}`);
                }
            }

