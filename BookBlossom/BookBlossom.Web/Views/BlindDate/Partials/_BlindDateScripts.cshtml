                // [UPDATED] Update selected count in modal footer (scoped to #blind-vouchers-modal)
                const selectedCount = $('#blind-vouchers-modal .modal-blind-voucher-item.selected').length;
                $('#blind-modal-selected-count').text(selectedCount);
            });

            // [UPDATED] Prevent double-trigger when clicking the inner Apply button (scoped to #blind-vouchers-modal to prevent clashing)
            $(document).on('click', '#blind-vouchers-modal .btn-modal-apply-blind-voucher', function(e) {
                e.stopPropagation(); // Stop bubble so we don't trigger click twice
                $(this).closest('.modal-blind-voucher-item').trigger('click');
            });

            // =========================================================
            // [UPDATED] SHOPPING CART INTERFACE SPA LOGIC
            // Moved here from the second DOMContentLoaded block so that
            // showCart() and all cart handlers can access the SPA
            // section variables ($mainContent, $exploreSection, etc.)
            // that are scoped to this $(document).ready() block.
            // =========================================================
            // [UPDATED] Support multiple applied vouchers
            let appliedVouchers = [];

            function showCart(push = true) {
                // [UPDATED] Hide all SPA sections before showing cart
                $mainContent.hide();
                $exploreSection.hide();
                $dedicatedCommunity.hide();
                $tindbookFeature.hide();
                $('#blind-date-section').hide();
                $('#reviews-section').hide();
                $('#product-details-section').hide();
                $('#blind-date-details-section').hide();

                $('#cart-section').show();
                $mainNavbar.addClass('navbar-light');

                // Clear active states in navigation menu
                $navLinks.removeClass('active');
                $('#nav-cart-btn').addClass('active');

                renderCart();

                window.scrollTo(0, 0);
                if (push) {
                    history.pushState({ view: 'cart' }, '', '#cart');
                }
            }

            // [UPDATED] Click listener for nav cart button — now in correct scope
            $('#nav-cart-btn').on('click', function(e) {
                e.preventDefault();
                window.location.href = '/Cart';
            });

            // Dynamically view details from cart items
            window.viewBookDetails = function(title) {
                const item = cartItems.find(i => i.title === title);
                if (!item) return;

                if (item.isBlind) {
                    showBlindDateDetails({
                        imgSrc: item.img,
                        desc: "A handpicked mystery treasure featuring clues: " + (item.hashtags ? item.hashtags.join(', ') : '') + ". Fully wrapped with dynamic vibes and custom visual decorations. 🌸",
                        firstLine: "What is written in the stars shall blossom in your hands.",
                        price: "$" + item.price.toFixed(2),
                        hashtags: item.hashtags ? item.hashtags.join(', ') : 'Cozy, Romance'
                    });
                } else {
                    showProductDetails({
                        title: item.title,
                        // [UPDATED] Removed store-specific name check and set simple default author logic
                        author: 'Unknown Author',
                        imgSrc: item.img
                    });
                }
            };

            function renderCart() {
                const $itemsWrapper = $('#cart-items-wrapper');
                const $emptyState = $('#empty-cart-state');
                const $layoutContainer = $('#cart-layout-container');

                if (cartItems.length === 0) {
                    $layoutContainer.hide();
                    $emptyState.show();
                    syncCartBadge();
                    return;
                }

                $layoutContainer.show();
                $emptyState.hide();
                $itemsWrapper.empty();

                // [UPDATED] Group items by custom Book Types instead of generic individual shops
                const groups = {};
                cartItems.forEach(item => {
                    // Fallback to ensure correct categorization
                    let typeName = item.shop;
                    if (typeName !== 'Normal Books' && typeName !== 'Blind Date Books') {
                        typeName = item.isBlind ? 'Blind Date Books' : 'Normal Books';
                        item.shop = typeName;
                    }
                    if (!groups[typeName]) {
                        groups[typeName] = [];
                    }
                    groups[typeName].push(item);
                });

                // [UPDATED] Render each book type group (Normal Books & Blind Date Books)
                Object.keys(groups).forEach(groupName => {
                    const items = groups[groupName];
                    const allSelected = items.every(i => i.selected);

                    // Choose an appropriate icon for each type (book icon for normal, gift/mystery icon for blind date)
                    const groupIcon = groupName === 'Blind Date Books' ? 'fas fa-gift' : 'fas fa-book';

                    let groupHtml = `
                        <div class="shop-group-card mb-4" style="background: #fff; border-radius: 16px; border: 1px solid #f0f0f0; box-shadow: 0 4px 15px rgba(0,0,0,0.02); overflow: hidden;">
                            <!-- [UPDATED] Type Header (replacing generic store header and chat feature) -->
                            <div class="shop-header d-flex align-items-center justify-content-between px-4 py-3" style="background: #fafaf9; border-bottom: 1px solid #f2ede4;">
                                <div class="d-flex align-items-center gap-3">
                                    <input type="checkbox" class="shop-checkbox" data-shop="${groupName}" ${allSelected ? 'checked' : ''} style="width: 18px; height: 18px; accent-color: #C2185B; cursor: pointer;">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="${groupIcon}" style="color: #C2185B; font-size: 1.1rem;"></i>
                                        <span style="font-weight: 700; color: #111; font-size: 1rem;">${groupName}</span>
                                    </div>
                                </div>
                            </div>
                            <div class="shop-items-list">
                    `;

                    items.forEach(item => {
                        groupHtml += `
                            <div class="cart-item-row d-flex align-items-center justify-content-between p-4" data-id="${item.id}" style="border-bottom: 1px solid #f9f9f8; transition: all 0.3s ease;">
                                <div class="d-flex align-items-center gap-3 flex-grow-1">
                                    <!-- Checkbox -->
                                    <input type="checkbox" class="item-checkbox" data-id="${item.id}" ${item.selected ? 'checked' : ''} style="width: 18px; height: 18px; accent-color: #C2185B; cursor: pointer;">

                                    <!-- Cover -->
                                    <div class="book-cover-wrapper" style="width: 70px; height: 100px; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.06); border: 1px solid #eee; flex-shrink: 0; cursor: pointer;" onclick="viewBookDetails('${item.title}')">
                                        <img src="${item.img}" alt="${item.title}" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                                    </div>

                                    <!-- Info -->
                                    <div class="book-info d-flex flex-column gap-2" style="max-width: 320px; text-align: left;">
                                        ${item.isBlind ? `
                                            <div class="d-flex flex-wrap gap-1 mb-1">
                                                ${item.hashtags.map(h => `<span class="badge" style="background: #111; color: #fff; font-size: 0.7rem; font-weight: 700; padding: 3px 8px; border-radius: 4px;">#${h}</span>`).join('')}
                                            </div>
                                        ` : ''}
                                        <h4 class="book-title mb-0" style="font-size: 1rem; font-weight: 700; color: #111; line-height: 1.4; cursor: pointer;" onclick="viewBookDetails('${item.title}')">${item.title}</h4>
                                        <span class="condition-badge" style="width: fit-content; background: ${item.condition.includes('Like New') || item.condition.includes('New') ? '#e6fffa' : '#f5f4f0'}; color: ${item.condition.includes('Like New') || item.condition.includes('New') ? '#319795' : '#555'}; font-size: 0.8rem; font-weight: 600; padding: 2px 10px; border-radius: 12px;">${item.condition}</span>
                                    </div>
                                </div>

                                <!-- Quantity & Price -->
                                <div class="d-flex align-items-center gap-4 flex-shrink-0">
                                    <div class="quantity-selector-container text-center">
                                        <div class="quantity-selector d-flex align-items-center" style="background: #f5f4f0; border-radius: 20px; padding: 4px 8px; border: 1px solid #e2dcd0;">
                                            <button class="btn-qty-minus" data-id="${item.id}" style="background: none; border: none; font-size: 0.9rem; color: #666; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; cursor: pointer;"><i class="fas fa-minus"></i></button>
                                            <span class="qty-val" style="width: 30px; font-weight: 700; font-size: 0.95rem; color: #111;">${item.qty}</span>
                                            <button class="btn-qty-plus" data-id="${item.id}" style="background: none; border: none; font-size: 0.9rem; color: #666; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; cursor: pointer;"><i class="fas fa-plus"></i></button>
                                        </div>
                                        ${item.limit ? `<span style="font-size: 0.72rem; color: #888; display: block; margin-top: 4px;">Limit ${item.limit}</span>` : ''}
                                    </div>

                                    <div class="price-action-box d-flex flex-column align-items-end gap-2" style="min-width: 120px;">
                                        <!-- [UPDATED] Row total converted to VND only -->
                                        <span style="font-size: 1.15rem; font-weight: 800; color: #111;">${new Intl.NumberFormat('vi-VN').format(Math.round(item.price * 20000 * item.qty))} VND</span>
                                        <button class="btn-delete-item" data-id="${item.id}" title="Remove item" style="background: none; border: none; color: #bbb; transition: all 0.2s; cursor: pointer; padding: 3px;" onmouseover="this.style.color='#e74c3c'" onmouseout="this.style.color='#bbb'">
                                            <i class="far fa-trash-alt"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        `;
                    });

                    groupHtml += `
                            </div>
                        </div>
                    `;

                    $itemsWrapper.append(groupHtml);
                });

                calculateTotals();
                syncCartBadge();
            }

            // [UPDATED] Calculate totals dynamically in VND only based on selected cart items and standard or mystery vouchers
            function calculateTotals() {
                let subtotalVnd = 0;
                let blindSubtotalVnd = 0;
                let hasBlindBooks = false;

                cartItems.forEach(item => {
                    if (item.selected) {
                        const itemPriceVnd = Math.round(item.price * 20000);
                        subtotalVnd += itemPriceVnd * item.qty;
                        if (item.isBlind) {
                            blindSubtotalVnd += itemPriceVnd * item.qty;
                            hasBlindBooks = true;
                        }
                    }
                });

                $('#cart-subtotal').text(new Intl.NumberFormat('vi-VN').format(subtotalVnd) + ' VND');

                let discountVnd = 0;
                let discountLines = [];
                let hasFreeShipVoucher = false;
                let validVouchers = [];

                if (appliedVouchers && appliedVouchers.length > 0) {
                    appliedVouchers.forEach(v => {
                        const code = v.code;
                        const isMystery = v.isMystery;
                        let isVoucherValid = true;

                        if (isMystery) {
                            // Enforce that mystery vouchers require Blind Date Books
                            if (!hasBlindBooks) {
                                isVoucherValid = false;
                                showToast(`Mystery Voucher "${code}" requires Blind Date Books in cart!`);
                            } else {
                                if (code === 'MYSTERY15') {
                                    if (blindSubtotalVnd >= 150000) { // 150,000 VND
                                        discountVnd += 15000;
                                        discountLines.push("MYSTERY15 (-15,000 VND)");
                                    } else {
                                        isVoucherValid = false;
                                        showToast("Min purchase of Blind Date Books for MYSTERY15 is 150,000 VND!");
                                    }
                                } else if (code === 'BLOSSOM70') {
                                    if (blindSubtotalVnd >= 500000) { // 500,000 VND
                                        discountVnd += 70000;
                                        discountLines.push("BLOSSOM70 (Mystery) (-70,000 VND)");
                                    } else {
                                        isVoucherValid = false;
                                        showToast("Min purchase of Blind Date Books for BLOSSOM70 is 500,000 VND!");
                                    }
                                } else if (code === 'READMORE30') {
                                    discountVnd += 30000; // 30,000 VND
                                    discountLines.push("READMORE30 (Mystery) (-30,000 VND)");
                                } else if (code === 'SECRET50') {
                                    if (blindSubtotalVnd >= 350000) { // 350,000 VND
                                        discountVnd += 50000;
                                        discountLines.push("SECRET50 (-50,000 VND)");
                                    } else {
                                        isVoucherValid = false;
                                        showToast("Min purchase of Blind Date Books for SECRET50 is 350,000 VND!");
                                    }
                                } else if (code === 'UNBOX20') {
                                    if (blindSubtotalVnd >= 200000) { // 200,000 VND
                                        discountVnd += 20000;
                                        discountLines.push("UNBOX20 (-20,000 VND)");
                                    } else {
                                        isVoucherValid = false;
                                        showToast("Min purchase of Blind Date Books for UNBOX20 is 200,000 VND!");
                                    }
                                } else if (code === 'VIPMYSTERY') {
                                    if (blindSubtotalVnd >= 800000) { // 800,000 VND
                                        discountVnd += 100000;
                                        discountLines.push("VIPMYSTERY (-100,000 VND)");
                                    } else {
                                        isVoucherValid = false;
                                        showToast("Min purchase of Blind Date Books for VIPMYSTERY is 800,000 VND!");
                                    }
                                }
                            }
                        } else {
                            // Standard BookBlossom Vouchers
                            if (code === 'BLOSSOM70') {
                                if (subtotalVnd >= 500000) {
                                    discountVnd += 70000;
                                    discountLines.push("BLOSSOM70 (-70,000 VND)");
                                } else {
                                    isVoucherValid = false;
                                    showToast("Min order for BLOSSOM70 is 500,000 VND!");
                                }
                            } else if (code === 'READMORE30') {
                                discountVnd += 30000;
                                discountLines.push("READMORE30 (-30,000 VND)");
                            } else if (code === 'ZALOPAY50') {
                                discountVnd += 50000;
                                discountLines.push("ZALOPAY50 (-50,000 VND)");
                            } else if (code === 'MOMO12') {
                                discountVnd += 12000;
                                discountLines.push("MOMO12 (-12,000 VND)");
                            } else if (code === 'SUMMER20') {
                                const summerDiscount = Math.min(Math.round(subtotalVnd * 0.20), 50000);
                                discountVnd += summerDiscount;
                                discountLines.push("SUMMER20 (-" + new Intl.NumberFormat('vi-VN').format(summerDiscount) + " VND)");
                            } else if (code === 'FREESHIP') {
                                if (subtotalVnd >= 150000) {
                                    hasFreeShipVoucher = true;
                                    discountLines.push("FREESHIP (Free Shipping)");
                                } else {
                                    isVoucherValid = false;
                                    showToast("Min order for FREESHIP is 150,000 VND!");
                                }
                            }
                        }

                        if (isVoucherValid) {
                            validVouchers.push(v);
                        }
                    });
                }

                // Keep only valid vouchers
                appliedVouchers = validVouchers;

                // [UPDATED] Shipping fee calculation & display in VND only
                let shippingFeeVnd = subtotalVnd > 0 ? 60000 : 0;
                if (hasFreeShipVoucher && subtotalVnd >= 150000) {
                    shippingFeeVnd = 0;
                    $('#cart-shipping').html('<span style="text-decoration: line-through; color: #888; margin-right: 8px;">30,000 VND</span><span style="color: #2e7d32; font-weight: 700;">Free</span>');
                } else {
                    if (subtotalVnd > 0) {
                        $('#cart-shipping').text('30,000 VND');
                    } else {
                        $('#cart-shipping').text('0 VND');
                    }
                }

                let totalVnd = Math.max(0, subtotalVnd + shippingFeeVnd - discountVnd);
                $('#cart-total').text(new Intl.NumberFormat('vi-VN').format(totalVnd) + ' VND');

                if (discountVnd > 0 || hasFreeShipVoucher) {
                    const discountText = "Applied: " + discountLines.join(", ");
                    $('#cart-discount-badge').html('<i class="fas fa-check-circle"></i> ' + discountText).show();
                    $('#voucher-message').html('<i class="fas fa-tags"></i> ' + discountText).css('color', '#2e7d32').show();
                } else {
                    $('#cart-discount-badge').hide();
                    $('#voucher-message').hide();
                }

                // Update selected voucher label on the selector button dynamically with premium themes
                if (appliedVouchers && appliedVouchers.length > 0) {
                    const codes = appliedVouchers.map(v => v.code).join(', ');
                    $('#selected-voucher-label').text(`Vouchers: ${codes} applied`);
                    $('#btn-select-cart-voucher').css({
                        'background': '#e8f5e9',
                        'color': '#2e7d32',
                        'borderColor': '#2e7d32'
                    });
                    $('#btn-select-cart-voucher i').css('color', '#2e7d32');
                } else {
                    $('#selected-voucher-label').text('Apply BookBlossom or Mystery Voucher');
                    $('#btn-select-cart-voucher').css({
                        'background': '#fffdfb',
                        'color': '#C2185B',
                        'borderColor': '#C2185B'
                    });
                    $('#btn-select-cart-voucher i').css('color', '#C2185B');
                }
            }

            // Helper to update unified voucher modal footer selection list
            function updateModalFooterSelection() {
                const selectedCodes = [];
                $('#cart-vouchers-modal .modal-voucher-item.selected, #cart-vouchers-modal .modal-blind-voucher-item.selected').each(function() {
                    const code = $(this).attr('data-code');
                    const isMystery = $(this).hasClass('modal-blind-voucher-item');
                    selectedCodes.push(code + (isMystery ? ' (Mystery)' : ''));
                });
                if (selectedCodes.length > 0) {
                    $('#cart-modal-selected-code').text(selectedCodes.join(', '));
                } else {
                    $('#cart-modal-selected-code').text('None');
                }
            }

            // [UPDATED] Open Unified Cart Vouchers full-screen modal
            $(document).on('click', '#btn-select-cart-voucher', function() {
                // Reset selection styles
                $('#cart-vouchers-modal .modal-voucher-item, #cart-vouchers-modal .modal-blind-voucher-item').removeClass('selected');
                $('#cart-vouchers-modal .btn-modal-apply-voucher, #cart-vouchers-modal .btn-modal-apply-blind-voucher').text('Apply');

                if (appliedVouchers && appliedVouchers.length > 0) {
                    appliedVouchers.forEach(v => {
                        if (v.isMystery) {
                            const $item = $(`#mystery-vouchers-list .modal-blind-voucher-item[data-code="${v.code}"]`);
                            $item.addClass('selected');
                            $item.find('.btn-modal-apply-blind-voucher').text('Applied');
                        } else {
                            const $item = $(`#blossom-vouchers-list .modal-voucher-item[data-code="${v.code}"]`);
                            $item.addClass('selected');
                            $item.find('.btn-modal-apply-voucher').text('Applied');
                        }
                    });
                }

                updateModalFooterSelection();
                $('#tab-blossom-vouchers').trigger('click');
                $('#cart-vouchers-modal').fadeIn(250);
            });

            // Close Unified Cart Vouchers modal
            $(document).on('click', '#btn-close-cart-vouchers, #cart-vouchers-modal .modal-backdrop', function() {
                $('#cart-vouchers-modal').fadeOut(250);
            });

            // Blossom Tab selection
            $(document).on('click', '#tab-blossom-vouchers', function() {
                $('#tab-blossom-vouchers').addClass('active').css({
                    'border-bottom-color': '#C2185B',
                    'color': '#C2185B'
                });
                $('#tab-mystery-vouchers').removeClass('active').css({
                    'border-bottom-color': 'transparent',
                    'color': '#666'
                });
                $('#mystery-vouchers-list').hide();
                $('#blossom-vouchers-list').show();
            });

            // Mystery Tab selection
            $(document).on('click', '#tab-mystery-vouchers', function() {
                $('#tab-mystery-vouchers').addClass('active').css({
                    'border-bottom-color': '#6a4f8c',
                    'color': '#6a4f8c'
                });
                $('#tab-blossom-vouchers').removeClass('active').css({
                    'border-bottom-color': 'transparent',
                    'color': '#666'
                });
                $('#blossom-vouchers-list').hide();
                $('#mystery-vouchers-list').show();
            });

            // [UPDATED] Click Blossom voucher inside modal list (supporting multi-selection)
            $(document).on('click', '#blossom-vouchers-list .modal-voucher-item', function() {
                $(this).toggleClass('selected');
                if ($(this).hasClass('selected')) {
                    $(this).find('.btn-modal-apply-voucher').text('Applied');
                } else {
                    $(this).find('.btn-modal-apply-voucher').text('Apply');
                }
                updateModalFooterSelection();
            });

            $(document).on('click', '#blossom-vouchers-list .btn-modal-apply-voucher', function(e) {
                e.stopPropagation();
                $(this).closest('.modal-voucher-item').trigger('click');
            });

            // [UPDATED] Click Mystery voucher inside modal list (supporting multi-selection)
            $(document).on('click', '#mystery-vouchers-list .modal-blind-voucher-item', function() {
                $(this).toggleClass('selected');
                if ($(this).hasClass('selected')) {
                    $(this).find('.btn-modal-apply-blind-voucher').text('Applied');
                } else {
                    $(this).find('.btn-modal-apply-blind-voucher').text('Apply');
                }
                updateModalFooterSelection();
            });

            $(document).on('click', '#mystery-vouchers-list .btn-modal-apply-blind-voucher', function(e) {
                e.stopPropagation();
                $(this).closest('.modal-blind-voucher-item').trigger('click');
            });

            // [UPDATED] Confirm selected vouchers in modal (supporting multiple vouchers)
            $(document).on('click', '#btn-confirm-cart-vouchers', function() {
                appliedVouchers = [];
                const activeItems = $('#cart-vouchers-modal .modal-voucher-item.selected, #cart-vouchers-modal .modal-blind-voucher-item.selected');
                activeItems.each(function() {
                    const code = $(this).attr('data-code');
                    const isMystery = $(this).hasClass('modal-blind-voucher-item');
                    appliedVouchers.push({
                        code: code,
                        isMystery: isMystery
                    });
                });

                if (appliedVouchers.length > 0) {
                    const codes = appliedVouchers.map(v => v.code).join(', ');
                    showToast(`Applied vouchers: ${codes}!`);
                } else {
                    showToast("No vouchers applied.");
                }

                $('#cart-vouchers-modal').fadeOut(250);
                calculateTotals();
            });

            // [UPDATED] Remove all applied vouchers from cart modal
            $(document).on('click', '#btn-remove-cart-voucher', function() {
                appliedVouchers = [];
                $('#cart-vouchers-modal .modal-voucher-item, #cart-vouchers-modal .modal-blind-voucher-item').removeClass('selected');
                $('#cart-vouchers-modal .btn-modal-apply-voucher, #cart-vouchers-modal .btn-modal-apply-blind-voucher').text('Apply');
                $('#cart-modal-selected-code').text('None');
                $('#cart-vouchers-modal').fadeOut(250);
                showToast("All vouchers removed!");
                calculateTotals();
            });

            // Toggle shop items selection
            $(document).on('change', '.shop-checkbox', function() {
                const shopName = $(this).attr('data-shop');
                const isChecked = $(this).is(':checked');

                cartItems.forEach(item => {
                    if (item.shop === shopName) {
                        item.selected = isChecked;
                    }
                });

                renderCart();
            });

            // Toggle individual item selection
            $(document).on('change', '.item-checkbox', function() {
                const itemId = $(this).attr('data-id');
                const isChecked = $(this).is(':checked');

                const item = cartItems.find(i => i.id === itemId);
                if (item) {
                    item.selected = isChecked;
                }

                renderCart();
            });

            // Quantity Minus Click
            $(document).on('click', '.btn-qty-minus', function() {
                const itemId = $(this).attr('data-id');
                const item = cartItems.find(i => i.id === itemId);

                if (item) {
                    if (item.qty > 1) {
                        item.qty--;
                        renderCart();
                    } else {
                        if (confirm(`Remove "${item.title}" from your cart?`)) {
                            cartItems = cartItems.filter(i => i.id !== itemId);
                            renderCart();
                            showToast("Item removed from cart");
                        }
                    }
                }
            });

            // Quantity Plus Click
            $(document).on('click', '.btn-qty-plus', function() {
                const itemId = $(this).attr('data-id');
                const item = cartItems.find(i => i.id === itemId);

                if (item) {
                    if (item.limit && item.qty >= item.limit) {
                        showToast(`Limit ${item.limit} copy for this item.`);
                        return;
                    }
                    item.qty++;
                    renderCart();
                }
            });

            // Delete Cart Item Click
            $(document).on('click', '.btn-delete-item', function() {
                const itemId = $(this).attr('data-id');
                const item = cartItems.find(i => i.id === itemId);

                if (item && confirm(`Remove "${item.title}" from your cart?`)) {
                    cartItems = cartItems.filter(i => i.id !== itemId);
                    renderCart();
                    showToast("Item removed from cart");
                }
            });

            // Shop Now click handler
            $(document).on('click', '#btn-cart-shop-now', function() {
                showExplore();
            });

            // [UPDATED] Global callback for cart checkout success to clear items and vouchers from the cart
            window.onCartCheckoutSuccess = function() {
                cartItems = cartItems.filter(i => !i.selected);
                appliedVouchers = [];
                renderCart();
            };

            // [UPDATED] Checkout click handler aligned with direct VND calculations
            $(document).on('click', '#btn-cart-checkout', function() {
                const selectedItems = cartItems.filter(i => i.selected);
                if (selectedItems.length === 0) {
                    showToast("Please select at least one item to checkout!");
                    return;
                }

                let subtotalVnd = 0;
                let hasBlind = false;
                selectedItems.forEach(item => {
                    subtotalVnd += Math.round(item.price * 20000) * item.qty;
                    if (item.isBlind) hasBlind = true;
                });

                let discountVnd = 0;
                let hasFreeShip = false;
                if (appliedVouchers && appliedVouchers.length > 0) {
                    appliedVouchers.forEach(v => {
                        const code = v.code;
                        const isMystery = v.isMystery;
                        if (isMystery) {
                            if (code === 'MYSTERY15') discountVnd += 15000;
                            else if (code === 'BLOSSOM70') discountVnd += 70000;
                            else if (code === 'READMORE30') discountVnd += 30000;
                            else if (code === 'SECRET50') discountVnd += 50000;
                            else if (code === 'UNBOX20') discountVnd += 20000;
                            else if (code === 'VIPMYSTERY') discountVnd += 100000;
                        } else {
                            if (code === 'BLOSSOM70') discountVnd += 70000;
                            else if (code === 'READMORE30') discountVnd += 30000;
                            else if (code === 'ZALOPAY50') discountVnd += 50000;
                            else if (code === 'MOMO12') discountVnd += 12000;
                            else if (code === 'SUMMER20') discountVnd += Math.min(Math.round(subtotalVnd * 0.20), 50000);
                            else if (code === 'FREESHIP') hasFreeShip = true;
                        }
                    });
                }

                let shippingFeeVnd = subtotalVnd > 0 ? 60000 : 0;
                if (hasFreeShip && subtotalVnd >= 150000) {
                    shippingFeeVnd = 0;
                }

                window.checkoutState = {
                    isCart: true,
                    isBlind: hasBlind,
                    subtotal: subtotalVnd,
                    shippingFee: shippingFeeVnd,
                    discount: discountVnd
                };

                const container = document.getElementById('checkout-applied-vouchers-container');
                const list = document.getElementById('checkout-vouchers-list');
                list.innerHTML = '';
                if (appliedVouchers && appliedVouchers.length > 0) {
                    container.style.display = 'block';
                    appliedVouchers.forEach(v => {
                        const badge = document.createElement('div');
                        const isMystery = v.isMystery;
                        const bg = isMystery ? '#faf8fc' : '#ffebee';
                        const border = isMystery ? '1px solid #a291b5' : '1px solid #f07c7c';
                        const textCol = isMystery ? '#6a4f8c' : '#C2185B';

                        let valVnd = 0;
                        if (isMystery) {
                            if (v.code === 'MYSTERY15') valVnd = 15000;
                            else if (v.code === 'BLOSSOM70') valVnd = 70000;
                            else if (v.code === 'READMORE30') valVnd = 30000;
                            else if (v.code === 'SECRET50') valVnd = 50000;
                            else if (v.code === 'UNBOX20') valVnd = 20000;
                            else if (v.code === 'VIPMYSTERY') valVnd = 100000;
                        } else {
                            if (v.code === 'BLOSSOM70') valVnd = 70000;
                            else if (v.code === 'READMORE30') valVnd = 30000;
                            else if (v.code === 'ZALOPAY50') valVnd = 50000;
                            else if (v.code === 'MOMO12') valVnd = 12000;
                            else if (v.code === 'SUMMER20') valVnd = Math.min(Math.round(subtotalVnd * 0.20), 50000);
                            else if (v.code === 'FREESHIP') valVnd = 0;
                        }

                        badge.style.cssText = `background: ${bg}; border: ${border}; color: ${textCol}; font-weight: 700; font-size: 0.8rem; padding: 4px 10px; border-radius: 6px; display: flex; align-items: center; gap: 5px;`;
                        if (v.code === 'FREESHIP') {
                            badge.innerHTML = `<i class="fas fa-ticket"></i> FREESHIP (Free Shipping)`;
                        } else {
                            badge.innerHTML = `<i class="fas fa-ticket"></i> ${v.code} (-${new Intl.NumberFormat('vi-VN').format(valVnd)} VND)`;
                        }
                        list.appendChild(badge);
                    });
                } else {
                    container.style.display = 'none';
                }

                if (typeof window.populateCheckoutBookInfo === 'function') {
                    window.populateCheckoutBookInfo(selectedItems);
                }
                if (typeof window.updateCheckoutTotals === 'function') {
                    window.updateCheckoutTotals();
                }
                if (typeof window.openCheckout === 'function') {
                    window.openCheckout();
                }
            });
            // =========================================================
            // [END UPDATED] SHOPPING CART INTERFACE SPA LOGIC
            // =========================================================

            function calculateBlindBuyNowVoucherDiscount(subtotalVnd) {
                let discountVnd = 0;
                let shippingFeeVnd = subtotalVnd > 0 ? 60000 : 0;
                const appliedVoucherLines = [];

                // Đọc voucher mystery/blind đang chọn trên detail page
                $('.blind-coupon-card.selected, .modal-blind-voucher-item.selected').each(function() {
                    const code = $(this).attr('data-code');

                    if (!code) return;

                    if (code === 'MYSTERY15') {
                        if (subtotalVnd >= 150000) {
                            discountVnd += 15000;
                            appliedVoucherLines.push({ code: code, text: 'MYSTERY15 (-15,000 VND)' });
                        } else {
                            showToast('MYSTERY15 requires minimum Blind Date order 150,000 VND.');
                        }
                    } else if (code === 'SECRET50') {
                        if (subtotalVnd >= 350000) {
                            discountVnd += 50000;
                            appliedVoucherLines.push({ code: code, text: 'SECRET50 (-50,000 VND)' });
                        } else {
                            showToast('SECRET50 requires minimum Blind Date order 350,000 VND.');
                        }
                    } else if (code === 'UNBOX20') {
                        if (subtotalVnd >= 200000) {
                            discountVnd += 20000;
                            appliedVoucherLines.push({ code: code, text: 'UNBOX20 (-20,000 VND)' });
                        } else {
                            showToast('UNBOX20 requires minimum Blind Date order 200,000 VND.');
                        }
                    } else if (code === 'VIPMYSTERY') {
                        if (subtotalVnd >= 800000) {
                            discountVnd += 100000;
                            appliedVoucherLines.push({ code: code, text: 'VIPMYSTERY (-100,000 VND)' });
                        } else {
                            showToast('VIPMYSTERY requires minimum Blind Date order 800,000 VND.');
                        }
                    } else if (code === 'READMORE30') {
                        discountVnd += 30000;
                        appliedVoucherLines.push({ code: code, text: 'READMORE30 (-30,000 VND)' });
                    } else if (code === 'BLOSSOM70') {
                        if (subtotalVnd >= 500000) {
                            discountVnd += 70000;
                            appliedVoucherLines.push({ code: code, text: 'BLOSSOM70 (-70,000 VND)' });
                        } else {
                            showToast('BLOSSOM70 requires minimum order 500,000 VND.');
                        }
                    }
                });

                discountVnd = Math.min(discountVnd, subtotalVnd);

                return {
                    discountVnd: discountVnd,
                    shippingFeeVnd: shippingFeeVnd,
                    appliedVoucherLines: appliedVoucherLines
                };
            }

            $(document).on('click', '.btn-buy-blind, #btn-blind-buy-now, #btn-detail-blind-buy', function(e) {
                e.preventDefault();

                const desc = $('#blind-clue-hook').text().trim() || 'Blind Date Mystery Book';
                const title = 'Blind Date: ' + desc.substring(0, 40);
                const img = $('#blind-detail-main-img').attr('src') || '/images/BlindDateBook/BlindBook1.jpg';
                const qty = parseInt($('#input-blind-qty').val()) || 1;

                const priceText = $('#blind-detail-price').text() || '0 VNĐ';
                const unitPriceVnd = parseInt(priceText.replace(/[^0-9]/g, ''), 10) || 0;

                if (unitPriceVnd <= 0) {
                    showToast('Cannot checkout this mystery book because price is invalid.');
                    return;
                }

                const subtotalVnd = unitPriceVnd * qty;
                const voucherResult = calculateBlindBuyNowVoucherDiscount(subtotalVnd);

                const checkoutItem = {
                    id: 'blind-buy-now-' + Date.now(),
                    title: title,
                    shop: 'Blind Date Books',
                    price: unitPriceVnd / 20000,
                    priceVnd: unitPriceVnd,
                    qty: qty,
                    condition: 'New Curated',
                    img: img,
                    selected: true,
                    isBlind: true,
                    author: 'BookBlossom Mystery Curator'
                };

                window.checkoutState = {
                    isCart: false,
                    isBuyNow: true,
                    isBlind: true,
                    subtotal: subtotalVnd,
                    shippingFee: voucherResult.shippingFeeVnd,
                    discount: voucherResult.discountVnd
                };

                const voucherContainer = document.getElementById('checkout-applied-vouchers-container');
                const voucherList = document.getElementById('checkout-vouchers-list');

                if (voucherList) {
                    voucherList.innerHTML = '';
                }

                if (voucherContainer && voucherList && voucherResult.appliedVoucherLines.length > 0) {
                    voucherContainer.style.display = 'block';

                    voucherResult.appliedVoucherLines.forEach(function(voucher) {
                        const badge = document.createElement('div');

                        badge.style.cssText = `
                            background: #faf8fc;
                            border: 1px solid #a291b5;
                            color: #6a4f8c;
                            font-weight: 700;
                            font-size: 0.8rem;
                            padding: 4px 10px;
                            border-radius: 6px;
                            display: flex;
                            align-items: center;
                            gap: 5px;
                        `;

                        badge.innerHTML = `<i class="fas fa-ticket"></i> ${voucher.text}`;
                        voucherList.appendChild(badge);
                    });
                } else if (voucherContainer) {
                    voucherContainer.style.display = 'none';
                }

                if (typeof window.populateCheckoutBookInfo === 'function') {
                    window.populateCheckoutBookInfo([checkoutItem]);
                }

                if (typeof window.updateCheckoutTotals === 'function') {
                    window.updateCheckoutTotals();
                }

                if (typeof window.openCheckout === 'function') {
                    window.openCheckout();
                } else {
                    showToast('Checkout interface is not ready.');
                }
            });

            // Standalone Blind Date page initialization
            (function initBlindDateStandalonePage() {
                $mainNavbar.addClass('navbar-light');
                setActiveTab($navBlindDate);

                const initialHash = window.location.hash;

                if (initialHash.startsWith('#blind-details-')) {
                    const tagsDecoded = decodeURIComponent(initialHash.substring('#blind-details-'.length));

                    const mockBlindBook = {
                        imgSrc: "/images/BlindDateBook/BlindBook1.jpg",
                        desc: "A handpicked mystery treasure featuring clues: " + tagsDecoded + ". Fully wrapped with dynamic vibes and custom visual decorations. 🌸",
                        firstLine: "What is written in the stars shall blossom in your hands.",
                        price: "120.000 VNĐ",
                        hashtags: tagsDecoded,
                        condition: "Well Loved",
                        rating: "4.2",
                        ratingRange: "4.0 - 4.2",
                        year: "2021",
                        category: "Mystery & Romance",
                        keywords: "Cozy, emotional, slow-burn, surprise"
                    };

                    showBlindDateDetails(mockBlindBook, false);

                    history.replaceState(
                        {
                            view: 'blind-date-details',
                            blindBookData: mockBlindBook,
                            previousActiveSection: '#blind-date-section'
                        },
                        '',
                        `/BlindDate#blind-details-${encodeURIComponent(tagsDecoded.replace(/\s/g, ''))}`
                    );
                } else {
                    $('#blind-date-section').show();
                    $('#blind-date-details-section').hide();
                    $('#cart-section').hide();

                    history.replaceState({ view: 'blind-date' }, '', '/BlindDate');
                    window.scrollTo(0, 0);
                }
            })();
        });
    </script>
