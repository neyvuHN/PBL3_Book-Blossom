    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS8618;CS8602;CS8625;CS8604;CS8601;CS8603;CS8629;CS8600;CS8632;CS0162;CS0168;NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
