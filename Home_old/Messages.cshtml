                    // Bulletproof nested vertical offset calculation
                    const targetScrollTop = $target.offset().top - $stream.offset().top + $stream.scrollTop() - 40;
                    
                    stream.scrollTo({
                        top: targetScrollTop,
                        behavior: 'smooth'
                    });
                    
                    // Target the surrounding bubble for high-quality highlight pulse effect
                    const $highlightTarget = $target.closest('.msg-text-bubble');
                    $highlightTarget.css({
                        'box-shadow': '0 0 0 5px rgba(194, 24, 91, 0.45)',
