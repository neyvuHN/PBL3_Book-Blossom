@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Messages - BookBlossom</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        /* Base Themes and Styling for Messages Section */
        body {
            background-color: #fcf8f9;
            font-family: 'Inter', sans-serif;
            color: #333;
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* Custom Modal Layout */
        .custom-modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: all 0.3s ease;
        }

        .custom-modal.active {
            opacity: 1;
            pointer-events: auto;
        }

        .modal-backdrop {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(5px);
            z-index: 1;
        }

        .modal-box {
            position: relative;
            background: #fff;
            border-radius: 20px;
            padding: 30px;
            width: 90%;
            max-width: 500px;
            box-shadow: 0 15px 40px rgba(194, 24, 91, 0.1);
            border: 1px solid rgba(194, 24, 91, 0.1);
            z-index: 2;
            transform: scale(0.9);
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .custom-modal.active .modal-box {
            transform: scale(1);
        }

        .modal-box h3 {
            font-family: 'Lora', serif;
            font-size: 1.35rem;
            font-weight: 700;
            margin-bottom: 20px;
            color: #111;
            text-align: left;
        }

        .modal-tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            border-bottom: 1px solid #f0e2e5;
            padding-bottom: 10px;
        }

        .btn-modal-tab {
            background: none;
            border: none;
            padding: 8px 16px;
            font-size: 0.88rem;
            font-weight: 600;
            color: #777;
            cursor: pointer;
            border-radius: 20px;
            transition: all 0.25s;
        }

        .btn-modal-tab:hover {
            color: #C2185B;
            background: #fff5f6;
        }

        .btn-modal-tab.active {
            background: #C2185B;
            color: #fff;
            box-shadow: 0 4px 10px rgba(194, 24, 91, 0.2);
        }

        .modal-tab-content {
            display: none;
        }

        .modal-tab-content.active {
            display: block;
        }

        .modal-tab-content p {
            font-size: 0.88rem;
            color: #666;
            margin-bottom: 12px;
            text-align: left;
        }

        .book-select-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
            max-height: 220px;
            overflow-y: auto;
            padding-right: 5px;
        }

        .book-select-list::-webkit-scrollbar {
            width: 3px;
        }

        .book-select-list::-webkit-scrollbar-thumb {
            background: rgba(194, 24, 91, 0.1);
            border-radius: 1.5px;
        }

        .book-select-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px;
            border: 1px solid #f0e2e5;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .book-select-item:hover {
            background: #fff5f6;
            border-color: #EEC7C9;
            transform: translateY(-1px);
        }

        .book-select-item.selected {
            background: #F4E1E2;
            border-color: #C2185B;
        }

        .book-select-item img {
            width: 35px;
            height: 48px;
            object-fit: cover;
            border-radius: 4px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }

        .book-select-item div {
            flex: 1;
            min-width: 0;
            text-align: left;
        }

        .book-select-item h4 {
            font-size: 0.85rem;
            font-weight: 700;
            color: #333;
            margin: 0 0 2px 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .book-select-item p {
            font-size: 0.75rem;
            color: #888;
            margin: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .modal-btns {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            margin-top: 25px;
        }

        .btn-modal-cancel {
            background: #f7f3f5;
            color: #555;
            border: none;
            padding: 10px 20px;
            border-radius: 25px;
            font-size: 0.88rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-modal-cancel:hover {
            background: #ebdce0;
            color: #111;
        }

        .btn-modal-confirm {
            background: #C2185B;
            color: #fff;
            border: none;
            padding: 10px 20px;
            border-radius: 25px;
            font-size: 0.88rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            box-shadow: 0 4px 10px rgba(194, 24, 91, 0.2);
        }

        .btn-modal-confirm:hover {
            background: #a8124c;
        }

        /* Adjust global wrapper for Navbar offset */
        .messages-wrapper {
            margin-top: 80px; /* offset for sticky absolute navbar */
            flex: 1;
            display: flex;
            padding: 20px 40px;
            gap: 20px;
            max-width: 1600px;
            margin-left: auto;
            margin-right: auto;
            width: 100%;
            height: calc(100vh - 100px);
            box-sizing: border-box;
        }

        /* Glassmorphic Container Panels */
        .chat-panel {
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 10px 35px rgba(194, 24, 91, 0.04);
            border: 1px solid rgba(194, 24, 91, 0.06);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            height: 100%;
        }

        /* Left Side: Conversation List */
        .conversation-sidebar {
            flex: 0 0 320px;
            width: 320px;
        }

        .sidebar-header-search {
            padding: 20px;
            border-bottom: 1px solid #f9f2f4;
        }

        .sidebar-header-search h2 {
            font-family: 'Lora', serif;
            font-size: 1.4rem;
            color: #111;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .search-box-wrapper {
            position: relative;
        }

        .search-box-wrapper input {
            width: 100%;
            padding: 10px 15px 10px 40px;
            background: #f7f3f5;
            border: 1px solid transparent;
            border-radius: 10px;
            font-size: 0.88rem;
            transition: all 0.3s ease;
        }

        .search-box-wrapper input:focus {
            background: #fff;
            border-color: #EEC7C9;
            box-shadow: 0 0 0 3px rgba(238, 199, 201, 0.2);
            outline: none;
        }

        .search-box-wrapper i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #a09095;
            font-size: 0.9rem;
        }

        .conversation-list {
            flex: 1;
            overflow-y: auto;
            padding: 10px;
        }

        .conversation-list::-webkit-scrollbar {
            width: 4px;
        }

        .conversation-list::-webkit-scrollbar-thumb {
            background: rgba(194, 24, 91, 0.1);
            border-radius: 2px;
        }

        .convo-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 15px;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.25s ease;
            position: relative;
            margin-bottom: 5px;
        }

        .convo-item:hover {
            background: #fff5f6;
        }

        .convo-item.active {
            background: #F4E1E2;
            border-left: 4px solid #C2185B;
        }

        .convo-avatar-wrapper {
            position: relative;
            width: 48px;
            height: 48px;
        }

        .convo-avatar {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #fff;
            box-shadow: 0 3px 8px rgba(0,0,0,0.06);
        }

        .online-dot {
            position: absolute;
            bottom: 2px;
            right: 2px;
            width: 11px;
            height: 11px;
            border-radius: 50%;
            background-color: #2e7d32;
            border: 2px solid #fff;
            box-shadow: 0 0 0 2px rgba(46, 125, 50, 0.2);
        }

        .convo-info {
            flex: 1;
            min-width: 0;
        }

        .convo-name-time {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 4px;
        }

        .convo-name {
            font-weight: 600;
            font-size: 0.92rem;
            color: #333;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .convo-time {
            font-size: 0.72rem;
            color: #888;
        }

        .convo-preview {
            font-size: 0.8rem;
            color: #666;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .unread-badge {
            background: #C2185B;
            color: #fff;
            font-size: 0.7rem;
            font-weight: 700;
            min-width: 18px;
            height: 18px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 4px;
            box-shadow: 0 2px 5px rgba(194, 24, 91, 0.3);
        }

        /* Center Section: Main Chat Area */
        .chat-main-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        .chat-header {
            padding: 15px 25px;
            border-bottom: 1px solid #f9f2f4;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #ffffff;
            z-index: 10;
        }

        .chat-header-user {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .chat-header-title {
            font-weight: 700;
            font-size: 1.05rem;
            color: #111;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .shop-verified-tag {
            font-size: 0.7rem;
            background: #ffebee;
            color: #C2185B;
            padding: 2px 8px;
            border-radius: 20px;
            font-weight: 700;
            border: 1px solid rgba(194, 24, 91, 0.1);
        }

        .chat-header-status {
            font-size: 0.8rem;
            color: #888;
            margin-top: 2px;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .chat-header-actions {
            display: flex;
            gap: 10px;
        }

        .header-action-btn {
            background: none;
            border: 1px solid #f0e6e8;
            color: #777;
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.25s ease;
        }

        .header-action-btn:hover {
            background: #fff5f6;
            color: #C2185B;
            border-color: #EEC7C9;
        }

        /* Product context card inside chat */
        .chat-product-context {
            background: #fff5f6;
            border-bottom: 1px solid rgba(194, 24, 91, 0.08);
            padding: 12px 25px;
            display: flex;
            align-items: center;
            gap: 15px;
            position: relative;
            animation: slideDown 0.3s ease;
        }

        @@keyframes slideDown {
            from { transform: translateY(-100%); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        .product-context-img {
            width: 45px;
            height: 60px;
            object-fit: cover;
            border-radius: 6px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        }

        .product-context-details {
            flex: 1;
            min-width: 0;
        }

        .product-context-title {
            font-weight: 700;
            font-size: 0.88rem;
            color: #333;
            margin-bottom: 2px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .product-context-desc {
            font-size: 0.78rem;
            color: #666;
            margin-bottom: 4px;
        }

        .product-context-price {
            font-weight: 700;
            color: #C2185B;
            font-size: 0.85rem;
        }

        .product-context-actions {
            display: flex;
            gap: 10px;
        }

        .btn-context-action {
            font-size: 0.8rem;
            font-weight: 700;
            padding: 6px 12px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-context-buy {
            background: #C2185B;
            color: #fff;
        }

        .btn-context-buy:hover {
            background: #a8124c;
        }

        .btn-context-close {
            background: none;
            border: 1px solid rgba(0,0,0,0.1);
            color: #777;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-context-close:hover {
            background: rgba(0,0,0,0.05);
            color: #111;
        }

        /* Message Bubbles Pane */
        .chat-messages-container {
            flex: 1;
            overflow-y: auto;
            padding: 25px;
            background: #faf8f9;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .chat-messages-container::-webkit-scrollbar {
            width: 5px;
        }

        .chat-messages-container::-webkit-scrollbar-thumb {
            background: rgba(194, 24, 91, 0.1);
            border-radius: 3px;
        }

        .chat-date-separator {
            text-align: center;
            font-size: 0.75rem;
            color: #a09095;
            margin: 15px 0;
            position: relative;
        }

        .chat-date-separator span {
            background: #faf8f9;
            padding: 0 15px;
            position: relative;
            z-index: 2;
        }

        .chat-date-separator::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            width: 100%;
            height: 1px;
            background: #f0e2e5;
            z-index: 1;
        }

        .msg-bubble-group {
            display: flex;
            gap: 12px;
            max-width: 75%;
        }

        .msg-bubble-group.outgoing {
            align-self: flex-end;
            flex-direction: row-reverse;
        }

        .msg-bubble-group.incoming {
            align-self: flex-start;
        }

        .msg-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            align-self: flex-end;
        }

        .msg-bubble-content {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .msg-text-bubble {
            padding: 12px 18px;
            border-radius: 18px;
            font-size: 0.88rem;
            line-height: 1.45;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
            word-wrap: break-word;
            position: relative;
        }

        .incoming .msg-text-bubble {
            background: #ffffff;
            color: #333;
            border-bottom-left-radius: 4px;
            border: 1px solid rgba(194, 24, 91, 0.05);
        }

        .outgoing .msg-text-bubble {
            background: #EEC7C9;
            color: #000;
            border-bottom-right-radius: 4px;
        }

        .msg-meta {
            font-size: 0.72rem;
            color: #888;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .outgoing .msg-meta {
            justify-content: flex-end;
        }

        /* Typing indicator */
        .typing-indicator {
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 10px 18px;
            background: #fff;
            border-radius: 18px;
            border-bottom-left-radius: 4px;
            width: fit-content;
            border: 1px solid rgba(194, 24, 91, 0.05);
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
            animation: pulse-typing 1.5s infinite;
        }

        .typing-dot {
            width: 7px;
            height: 7px;
            background: #a8124c;
            border-radius: 50%;
            display: inline-block;
            animation: bounce-dot 1.2s infinite ease-in-out;
        }

        .typing-dot:nth-child(2) { animation-delay: 0.2s; }
        .typing-dot:nth-child(3) { animation-delay: 0.4s; }

        @@keyframes bounce-dot {
            0%, 80%, 100% { transform: translateY(0); }
            40% { transform: translateY(-5px); }
        }

        /* Bottom chat input */
        .chat-input-container {
            padding: 15px 25px;
            background: #ffffff;
            border-top: 1px solid #f9f2f4;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .quick-replies-row {
            display: flex;
            gap: 10px;
            overflow-x: auto;
            padding-bottom: 5px;
        }

        .quick-replies-row::-webkit-scrollbar {
            height: 3px;
        }

        .quick-replies-row::-webkit-scrollbar-thumb {
            background: rgba(194, 24, 91, 0.08);
            border-radius: 1.5px;
        }

        .quick-reply-chip {
            background: #faf8f9;
            color: #C2185B;
            border: 1px solid rgba(194, 24, 91, 0.08);
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            white-space: nowrap;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .quick-reply-chip:hover {
            background: #C2185B;
            color: #fff;
            transform: translateY(-1.5px);
            box-shadow: 0 3px 8px rgba(194,24,91,0.15);
        }

        .input-bar-wrapper {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .btn-input-attachment {
            background: none;
            border: none;
            color: #777;
            font-size: 1.15rem;
            cursor: pointer;
            transition: color 0.2s;
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }

        .btn-input-attachment:hover {
            color: #C2185B;
            background: #fff5f6;
        }

        .chat-main-input {
            flex: 1;
            border: 1px solid #f0e2e5;
            background: #fcf8f9;
            padding: 12px 20px;
            border-radius: 25px;
            font-size: 0.88rem;
            transition: all 0.3s ease;
        }

        .chat-main-input:focus {
            background: #fff;
            border-color: #C2185B;
            box-shadow: 0 0 0 3px rgba(194, 24, 91, 0.1);
            outline: none;
        }

        .btn-send-message {
            background: #C2185B;
            color: #fff;
            border: none;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 4px 10px rgba(194, 24, 91, 0.2);
        }

        .btn-send-message:hover {
            background: #a8124c;
            transform: scale(1.08) rotate(15deg);
        }

        .btn-send-message:active {
            transform: scale(0.95);
        }

        /* Right Section: Shop Information */
        .shop-info-sidebar {
            flex: 0 0 300px;
            width: 300px;
            display: flex;
            flex-direction: column;
            gap: 20px;
            overflow-y: auto;
            padding-right: 5px;
        }

        .shop-info-sidebar::-webkit-scrollbar {
            width: 3px;
        }

        .shop-profile-card {
            background: #fff;
            border-radius: 20px;
            padding: 25px;
            border: 1px solid rgba(194, 24, 91, 0.05);
            box-shadow: 0 8px 24px rgba(194, 24, 91, 0.02);
            text-align: center;
        }

        .shop-profile-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #F4E1E2;
            margin-bottom: 15px;
            box-shadow: 0 4px 12px rgba(194, 24, 91, 0.1);
        }

        .shop-profile-name {
            font-family: 'Lora', serif;
            font-size: 1.15rem;
            font-weight: 700;
            color: #111;
            margin-bottom: 5px;
        }

        .shop-profile-rating {
            color: #ffb400;
            font-size: 0.85rem;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
        }

        .shop-metrics-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            border-top: 1px solid #f9f2f4;
            padding-top: 15px;
            text-align: left;
        }

        .metric-item {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .metric-label {
            font-size: 0.72rem;
            color: #888;
        }

        .metric-value {
            font-size: 0.8rem;
            font-weight: 700;
            color: #333;
        }

        /* Active Shop Vouchers Card */
        .shop-vouchers-card {
            background: #fff;
            border-radius: 20px;
            padding: 20px;
            border: 1px solid rgba(194, 24, 91, 0.05);
            box-shadow: 0 8px 24px rgba(194, 24, 91, 0.02);
        }

        .vouchers-header {
            font-weight: 700;
            font-size: 0.95rem;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #111;
        }

        .voucher-mini-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .voucher-mini-item {
            background: #fffafb;
            border: 1px dashed #EEC7C9;
            border-radius: 10px;
            padding: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            transition: all 0.25s ease;
        }

        .voucher-mini-item:hover {
            transform: translateY(-1.5px);
            border-color: #C2185B;
            background: #fff5f6;
        }

        .voucher-mini-code {
            font-size: 0.72rem;
            font-weight: 700;
            color: #C2185B;
            background: #F4E1E2;
            padding: 2px 6px;
            border-radius: 4px;
            display: inline-block;
            margin-bottom: 4px;
        }

        .voucher-mini-value {
            font-weight: 700;
            font-size: 0.85rem;
            color: #333;
        }

        .voucher-mini-apply {
            font-size: 0.72rem;
            font-weight: 700;
            color: #C2185B;
            text-decoration: underline;
        }

        /* Shop policies */
        .shop-policies-card {
            background: #fff;
            border-radius: 20px;
            padding: 20px;
            border: 1px solid rgba(194, 24, 91, 0.05);
            box-shadow: 0 8px 24px rgba(194, 24, 91, 0.02);
            font-size: 0.82rem;
            color: #666;
        }

        .policy-item {
            display: flex;
            gap: 10px;
            margin-bottom: 12px;
        }

        .policy-item:last-child {
            margin-bottom: 0;
        }

        .policy-icon {
            color: #2e7d32;
            font-size: 0.95rem;
        }

        /* Responsive Breakpoints */
        @@media (max-width: 1200px) {
            .shop-info-sidebar {
                display: none; /* Hide right sidebar on tablets and below */
            }
        }

        @@media (max-width: 900px) {
            .messages-wrapper {
                padding: 10px;
                height: calc(100vh - 80px);
            }
            .conversation-sidebar {
                display: none; /* In very small mobile screens, sidebar could toggle, default to hide */
            }
        }

        /* Notification Toast styles */
        .toast-notification {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: #ffffff;
            border-left: 4px solid #2e7d32;
            border-radius: 8px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            padding: 15px 25px;
            display: none;
            align-items: center;
            gap: 12px;
            z-index: 10005;
            min-width: 320px;
        }

        .toast-progress {
            position: absolute;
            bottom: 0;
            left: 0;
            height: 3px;
            background-color: #2e7d32;
            width: 100%;
            animation: toast-timer 5s linear forwards;
        }

        @@keyframes toast-timer {
            from { width: 100%; }
            to { width: 0%; }
        }
    </style>
</head>
